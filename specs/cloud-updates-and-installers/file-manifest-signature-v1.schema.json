{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:veyon-campus:file-manifest-signature-v1-schema",
  "title": "Veyon Campus file manifest detached signature v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "algorithm", "keyId", "signature"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "algorithm": { "const": "RSA-PSS-SHA256" },
    "keyId": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "signature": {
      "type": "string",
      "minLength": 4,
      "maxLength": 16384,
      "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
    }
  }
}
