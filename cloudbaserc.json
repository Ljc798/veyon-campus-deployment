{
  "$schema": "https://static.cloudbase.net/cli/cloudbaserc.schema.json",
  "version": "2.1",
  "envId": "veyon-control-d3gs8hmuyd09c00a7",
  "region": "ap-shanghai",
  "functions": [
    {
      "name": "veyon-api",
      "dir": "cloudfunctions/veyon-api",
      "type": "HTTP",
      "buildStrategy": "zip",
      "runtime": "Nodejs20.19",
      "installDependency": false,
      "timeout": 60,
      "memorySize": 256,
      "gatewayPath": "/",
      "ignore": [
        ".git/**",
        "node_modules/**"
      ],
      "envVariables": {
        "CloudBase__EnvId": "veyon-control-d3gs8hmuyd09c00a7",
        "CloudBase__ApiKey": "{{env.CLOUDBASE_SERVICE_ROLE_KEY}}",
        "CloudBase__DeploymentPackageBucket": "deployment-package-artifacts",
        "CloudBase__ApplicationReleaseDownloadSource": "gitcode",
        "CloudBase__ApplicationReleasePublicBaseUrl": "https://veyon-control-d3gs8hmuyd09c00a7-1348081197.ap-shanghai.app.tcloudbase.com/",
        "Telemetry__DailyHashKey": "{{env.TELEMETRY_DAILY_HASH_KEY}}",
        "DeploymentPackages__FingerprintKeyRingBase64": "{{env.DEPLOYMENT_PACKAGES_FINGERPRINT_KEY_RING_BASE64}}",
        "DeploymentPackages__ActiveFingerprintKeyId": "{{env.DEPLOYMENT_PACKAGES_ACTIVE_FINGERPRINT_KEY_ID}}",
        "OperationsReporting__Enabled": "false"
      }
    }
  ],
  "hosting": [
    {
      "name": "veyon-website",
      "root": "website",
      "framework": "vite",
      "buildCommand": "npm run build",
      "outputDir": "dist",
      "deployPath": "/",
      "ignore": [
        "node_modules/**",
        ".git/**"
      ]
    }
  ]
}
