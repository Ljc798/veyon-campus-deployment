<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="using:VeyonCampus.App"
             x:Class="VeyonCampus.App.App" RequestedThemeVariant="Light">
  <Application.Resources>
    <ResourceDictionary>
      <app:LocalDateTimeDisplayConverter x:Key="LocalDateTimeDisplay" />
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme />
    <Style Selector="TextBlock"><Setter Property="Foreground" Value="#182D42" /></Style>
    <Style Selector="TextBlock.muted"><Setter Property="Foreground" Value="#617184" /></Style>
    <Style Selector="Button"><Setter Property="Padding" Value="18,11" /><Setter Property="CornerRadius" Value="9" /><Setter Property="MinHeight" Value="40" /></Style>
    <Style Selector="Button.primary"><Setter Property="Background" Value="#0B69C7" /><Setter Property="Foreground" Value="White" /><Setter Property="BorderBrush" Value="#0B69C7" /><Setter Property="BorderThickness" Value="1" /></Style>
    <Style Selector="Button.secondary"><Setter Property="Background" Value="#FFFFFF" /><Setter Property="Foreground" Value="#344054" /><Setter Property="BorderBrush" Value="#C9D3DE" /><Setter Property="BorderThickness" Value="1" /></Style>
    <Style Selector="Button.tertiary"><Setter Property="Background" Value="Transparent" /><Setter Property="Foreground" Value="#0B69C7" /><Setter Property="BorderThickness" Value="0" /><Setter Property="Padding" Value="12,8" /></Style>
    <Style Selector="Button.danger"><Setter Property="Background" Value="#B42318" /><Setter Property="Foreground" Value="White" /><Setter Property="BorderBrush" Value="#B42318" /><Setter Property="BorderThickness" Value="1" /></Style>
    <Style Selector="Button.nav"><Setter Property="Background" Value="Transparent" /><Setter Property="Foreground" Value="#E0EBEF" /><Setter Property="HorizontalContentAlignment" Value="Left" /><Setter Property="Padding" Value="14,12" /><Setter Property="BorderThickness" Value="0" /></Style>
    <Style Selector="Button.nav.selected"><Setter Property="Background" Value="#0B69C7" /><Setter Property="Foreground" Value="White" /></Style>
    <Style Selector="Button.help"><Setter Property="Width" Value="28" /><Setter Property="Height" Value="28" /><Setter Property="Padding" Value="0" /><Setter Property="CornerRadius" Value="14" /><Setter Property="Background" Value="Transparent" /><Setter Property="Foreground" Value="#175EA8" /><Setter Property="BorderThickness" Value="0" /><Setter Property="FontSize" Value="21" /><Setter Property="VerticalAlignment" Value="Center" /></Style>
    <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="#E4ECEF" /><Setter Property="Foreground" Value="#182D42" /><Setter Property="BorderBrush" Value="#E4ECEF" /></Style>
    <Style Selector="Button:pressed /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="#D4E0E5" /><Setter Property="Foreground" Value="#182D42" /><Setter Property="BorderBrush" Value="#D4E0E5" /></Style>
    <Style Selector="Button.help:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="Transparent" /><Setter Property="Foreground" Value="#084F98" /><Setter Property="BorderBrush" Value="Transparent" /></Style>
    <Style Selector="Button.help:pressed /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="Transparent" /><Setter Property="Foreground" Value="#063A71" /><Setter Property="BorderBrush" Value="Transparent" /></Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="#095AAE" /><Setter Property="Foreground" Value="White" /><Setter Property="BorderBrush" Value="#095AAE" /></Style>
    <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="#064783" /><Setter Property="Foreground" Value="White" /><Setter Property="BorderBrush" Value="#064783" /></Style>
    <Style Selector="Button.secondary:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="#F2F6FA" /><Setter Property="Foreground" Value="#123C60" /><Setter Property="BorderBrush" Value="#AAB9C9" /></Style>
    <Style Selector="Button.secondary:pressed /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="#E6EDF4" /><Setter Property="Foreground" Value="#123C60" /><Setter Property="BorderBrush" Value="#AAB9C9" /></Style>
    <Style Selector="Button.tertiary:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="#EAF2FB" /><Setter Property="Foreground" Value="#084F98" /><Setter Property="BorderBrush" Value="Transparent" /></Style>
    <Style Selector="Button.tertiary:pressed /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="#D8E8F8" /><Setter Property="Foreground" Value="#063A71" /><Setter Property="BorderBrush" Value="Transparent" /></Style>
    <Style Selector="Button.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="#912018" /><Setter Property="Foreground" Value="White" /><Setter Property="BorderBrush" Value="#912018" /></Style>
    <Style Selector="Button.danger:pressed /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="#7A271A" /><Setter Property="Foreground" Value="White" /><Setter Property="BorderBrush" Value="#7A271A" /></Style>
    <Style Selector="Button.nav:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="#315D6B" /><Setter Property="Foreground" Value="White" /><Setter Property="BorderBrush" Value="#315D6B" /></Style>
    <Style Selector="Button.nav:pressed /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="#254C59" /><Setter Property="Foreground" Value="White" /><Setter Property="BorderBrush" Value="#254C59" /></Style>
    <Style Selector="Button.nav.selected:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="#095AAE" /><Setter Property="Foreground" Value="White" /><Setter Property="BorderBrush" Value="#095AAE" /></Style>
    <Style Selector="Button.nav.selected:pressed /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="#064783" /><Setter Property="Foreground" Value="White" /><Setter Property="BorderBrush" Value="#064783" /></Style>
    <Style Selector="Border.dropzone"><Setter Property="Background" Value="#F4F8FC" /><Setter Property="BorderBrush" Value="#B8D2EA" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="10" /><Setter Property="Padding" Value="16" /></Style>
    <Style Selector="Border.dropzone.dragover"><Setter Property="Background" Value="#E5F1FC" /><Setter Property="BorderBrush" Value="#0B69C7" /></Style>
    <Style Selector="Border.card"><Setter Property="Background" Value="White" /><Setter Property="CornerRadius" Value="12" /><Setter Property="Padding" Value="20" /><Setter Property="BorderBrush" Value="#E1E7EB" /><Setter Property="BorderThickness" Value="1" /></Style>
    <Style Selector="Border.option-card"><Setter Property="Background" Value="#FFFFFF" /><Setter Property="CornerRadius" Value="12" /><Setter Property="Padding" Value="18" /><Setter Property="BorderBrush" Value="#E1E7EB" /><Setter Property="BorderThickness" Value="1" /></Style>
    <Style Selector="Border.status-panel"><Setter Property="CornerRadius" Value="10" /><Setter Property="Padding" Value="14" /><Setter Property="BorderThickness" Value="1" /></Style>
    <Style Selector="Border.status-panel.info"><Setter Property="Background" Value="#EFF6FD" /><Setter Property="BorderBrush" Value="#C7DDF2" /></Style>
    <Style Selector="Border.status-panel.info TextBlock"><Setter Property="Foreground" Value="#175EA8" /></Style>
    <Style Selector="Border.status-panel.warning"><Setter Property="Background" Value="#FFF7E8" /><Setter Property="BorderBrush" Value="#F2D19B" /></Style>
    <Style Selector="Border.status-panel.warning TextBlock"><Setter Property="Foreground" Value="#8A4B08" /></Style>
    <Style Selector="Border.status-panel.error"><Setter Property="Background" Value="#FEF0EF" /><Setter Property="BorderBrush" Value="#F3C3BE" /></Style>
    <Style Selector="Border.status-panel.error TextBlock"><Setter Property="Foreground" Value="#912018" /></Style>
    <Style Selector="Border.empty-state"><Setter Property="Background" Value="#FFFFFF" /><Setter Property="BorderBrush" Value="#DDE5EC" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="12" /><Setter Property="Padding" Value="22" /></Style>
    <Style Selector="Border.completion-panel"><Setter Property="Background" Value="#EFF6FD" /><Setter Property="BorderBrush" Value="#C7DDF2" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="14" /><Setter Property="Padding" Value="20" /></Style>
    <Style Selector="Border.completion-panel.success"><Setter Property="Background" Value="#EDF8F0" /><Setter Property="BorderBrush" Value="#B9DFC4" /></Style>
    <Style Selector="Border.completion-panel.warning"><Setter Property="Background" Value="#FFF7E8" /><Setter Property="BorderBrush" Value="#F2D19B" /></Style>
    <Style Selector="Border.completion-panel.error"><Setter Property="Background" Value="#FEF0EF" /><Setter Property="BorderBrush" Value="#F3C3BE" /></Style>
    <Style Selector="Border.completion-icon"><Setter Property="Width" Value="42" /><Setter Property="Height" Value="42" /><Setter Property="CornerRadius" Value="21" /><Setter Property="Background" Value="#E0ECF8" /></Style>
    <Style Selector="Border.completion-icon.success"><Setter Property="Background" Value="#D4F1DE" /></Style>
    <Style Selector="Border.completion-icon.warning"><Setter Property="Background" Value="#FDE7BD" /></Style>
    <Style Selector="Border.completion-icon.error"><Setter Property="Background" Value="#FADBD7" /></Style>
    <Style Selector="Border.completion-icon TextBlock"><Setter Property="Foreground" Value="#175EA8" /></Style>
    <Style Selector="Border.completion-icon.success TextBlock"><Setter Property="Foreground" Value="#18733D" /></Style>
    <Style Selector="Border.completion-icon.warning TextBlock"><Setter Property="Foreground" Value="#985800" /></Style>
    <Style Selector="Border.completion-icon.error TextBlock"><Setter Property="Foreground" Value="#B42318" /></Style>
    <Style Selector="Border.completion-panel.success TextBlock.primary-status"><Setter Property="Foreground" Value="#18733D" /></Style>
    <Style Selector="Border.completion-panel.warning TextBlock.primary-status"><Setter Property="Foreground" Value="#985800" /></Style>
    <Style Selector="Border.completion-panel.error TextBlock.primary-status"><Setter Property="Foreground" Value="#B42318" /></Style>
    <Style Selector="TextBox"><Setter Property="Padding" Value="12,10" /><Setter Property="CornerRadius" Value="8" /><Setter Property="BorderBrush" Value="#CFD9DE" /></Style>
    <Style Selector="ComboBox"><Setter Property="MinHeight" Value="42" /></Style>
  </Application.Styles>
</Application>
