<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:VeyonCampus.App"
        x:Class="VeyonCampus.App.MainWindow" x:DataType="vm:MainViewModel"
        Title="Veyon 校园部署助手" Width="1120" Height="790" MinWidth="900" MinHeight="640"
        Background="#F3F6F8">
  <Grid ColumnDefinitions="220,*">
    <Border Background="#142D3B" Padding="22,32">
      <Grid RowDefinitions="Auto,Auto,*,Auto">
        <StackPanel Spacing="8">
          <TextBlock Text="VEYON CAMPUS" Foreground="#81CBB9" FontSize="12" FontWeight="Bold" />
          <TextBlock Text="校园部署助手" Foreground="White" FontSize="23" FontWeight="Bold" />
          <TextBlock Text="离线部署 · 从这里开始" Foreground="#B5C6D0" FontSize="12" />
        </StackPanel>
        <StackPanel Grid.Row="1" Spacing="10" Margin="0,40,0,0">
          <Button Classes="nav" Classes.selected="{Binding IsStudent}" Content="学生端配置" HorizontalAlignment="Stretch" Click="ShowStudent" />
          <Button Classes="nav" Classes.selected="{Binding IsTeacher}" Content="教师端准备" HorizontalAlignment="Stretch" Click="ShowTeacher" />
        </StackPanel>
        <StackPanel Grid.Row="3" Spacing="8">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBlock Text="Veyon 实验执行" Foreground="#B5C6D0" FontSize="12" />
            <TextBlock Text="{Binding AppVersion}" Foreground="#B5C6D0" FontSize="12" />
          </StackPanel>
          <TextBlock Text="Veyon 执行功能处于实验阶段；&#10;改名与账户操作目前仅支持预览。" Foreground="#B5C6D0" FontSize="12" TextWrapping="Wrap" />
        </StackPanel>
      </Grid>
    </Border>
    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="32" Spacing="20">
        <StackPanel Spacing="8">
          <TextBlock Text="{Binding PageTitle}" FontSize="28" FontWeight="Bold" />
          <TextBlock Text="{Binding PageDescription}" Classes="muted" TextWrapping="Wrap" />
        </StackPanel>
        <Border Background="#E7F2EE" CornerRadius="8" Padding="16,12">
          <TextBlock Text="{Binding EnvironmentNote}" Foreground="#246356" TextWrapping="Wrap" />
        </Border>
        <StackPanel IsVisible="{Binding IsStudent}" Spacing="20">
          <Border Classes="card">
            <StackPanel Spacing="14">
              <TextBlock Text="01  部署资料" FontSize="18" FontWeight="SemiBold" />
              <TextBlock Text="只有选择 Veyon 配置时才需要公钥部署包。改名和账户操作可以单独预览。" Classes="muted" TextWrapping="Wrap" />
              <Border x:Name="PackageDropZone" Classes="dropzone" DragDrop.AllowDrop="True">
                <StackPanel Spacing="12">
                  <TextBlock Text="将部署包文件夹、manifest.json 或 campus.json 拖到这里" FontWeight="SemiBold" />
                  <TextBlock Text="每次拖入一个部署包，松开后读取资料；也可以使用下方按钮选择。" Classes="muted" TextWrapping="Wrap" />
                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button Content="选择部署包文件夹" Click="SelectPackage" />
                    <Button Content="清空资料" Click="ResetForm" />
                  </StackPanel>
                </StackPanel>
              </Border>
              <TextBlock Text="{Binding PackageStatus}" Classes="muted" TextWrapping="Wrap" />
              <Border Background="#FFF1E8" CornerRadius="8" Padding="12" IsVisible="{Binding HasPackageError}">
                <TextBlock Text="{Binding PackageError}" Foreground="#9C4221" TextWrapping="Wrap" />
              </Border>
              <Grid ColumnDefinitions="*,20,*" RowDefinitions="Auto,Auto">
                <TextBlock Text="校区名称（用于 Veyon 配置）" Margin="0,0,0,8" />
                <TextBlock Grid.Column="2" Text="电脑名前缀" Margin="0,0,0,8" />
                <TextBox Grid.Row="1" Text="{Binding Campus, Mode=TwoWay}" PlaceholderText="例如：演示校区" />
                <TextBox Grid.Row="1" Grid.Column="2" Text="{Binding Prefix, Mode=TwoWay}" PlaceholderText="PC-" />
              </Grid>
            </StackPanel>
          </Border>
          <Border Classes="card">
            <StackPanel Spacing="12">
              <TextBlock Text="02  选择操作" FontSize="18" FontWeight="SemiBold" />
              <TextBlock Text="四项可独立选择。当前仅支持单独执行 Veyon 操作；改名和账户操作可预览，组合选择会在修改前被拒绝。" Classes="muted" TextWrapping="Wrap" />
              <StackPanel Orientation="Horizontal" Spacing="2">
                <CheckBox Content="安装并配置 Veyon（需要有效公钥部署包）" IsChecked="{Binding InstallVeyon, Mode=TwoWay}" />
                <Button Classes="help" Content="ⓘ" Tag="在这台电脑上安装 Veyon，并导入教师端的公钥，以便教师端连接和管理。已有正确安装与配置时，可不重复执行。" Click="ShowOperationHelp" ToolTip.ShowDelay="0" ToolTip.Tip="安装 Veyon 并导入教师端公钥。已有正确配置时无需重复执行。" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="2">
                <CheckBox Content="修改电脑名（需要重启）" IsChecked="{Binding RenameComputer, Mode=TwoWay}" />
                <Button Classes="help" Content="ⓘ" Tag="首次部署时建议按机房编号设置唯一电脑名，方便教师识别。若名称已经正确，就不必再次修改；改名通常需要重启后生效。" Click="ShowOperationHelp" ToolTip.ShowDelay="0" ToolTip.Tip="按机房编号设置唯一电脑名。名称已正确时无需再改；改名通常需要重启。" />
              </StackPanel>
              <Grid IsVisible="{Binding RenameComputer}" ColumnDefinitions="160,24,*" Margin="24,0,0,6">
                <StackPanel Spacing="8">
                  <TextBlock Text="电脑编号（1–150）" />
                  <TextBox Text="{Binding Number, Mode=TwoWay}" PlaceholderText="例如：03 或 150" MaxLength="3" />
                </StackPanel>
                <StackPanel Grid.Column="2" Spacing="8" VerticalAlignment="Center">
                  <TextBlock Text="规划电脑名" Classes="muted" />
                  <TextBlock Text="{Binding ComputerName}" FontSize="22" FontWeight="SemiBold" />
                </StackPanel>
              </Grid>
              <StackPanel Orientation="Horizontal" Spacing="2">
                <CheckBox Content="创建普通学生账户" IsChecked="{Binding CreateStudent, Mode=TwoWay}" />
                <Button Classes="help" Content="ⓘ" Tag="创建不具备管理员权限的学生账户，减少学生修改系统设置和安装需要管理员权限的软件的机会。普通账户本身不能阻止下载或运行所有软件；若要限制这些行为，还需配置 Windows 策略。已有合适的学生账户时无需重复创建。" Click="ShowOperationHelp" ToolTip.ShowDelay="0" ToolTip.Tip="创建普通权限账户，减少需要管理员权限的安装和设置修改。限制下载或运行软件还需 Windows 策略。" />
              </StackPanel>
              <StackPanel IsVisible="{Binding CreateStudent}" Margin="24,0,0,6" Spacing="8">
                <TextBlock Text="学生账户名（执行前还需设置初始密码）" />
                <TextBox Text="{Binding StudentAccountName, Mode=TwoWay}" MaxLength="20" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="2">
                <CheckBox Content="修改指定本地管理员账户的密码" IsChecked="{Binding ChangeAdminPassword, Mode=TwoWay}" />
                <Button Classes="help" Content="ⓘ" Tag="更换指定本地管理员账户的密码，降低旧密码被学生使用的风险。只在确认目标账户和现有密码管理方式后操作；如果密码已安全管理，不必每次部署都修改。" Click="ShowOperationHelp" ToolTip.ShowDelay="0" ToolTip.Tip="更换指定本地管理员密码，降低旧密码被使用的风险。确认目标账户后操作，无需每次都改。" />
              </StackPanel>
              <StackPanel IsVisible="{Binding ChangeAdminPassword}" Margin="24,0,0,0" Spacing="8">
                <TextBlock Text="目标本地管理员账户名（执行前还需核对 SID）" />
                <TextBox Text="{Binding AdminAccountName, Mode=TwoWay}" PlaceholderText="明确填写目标账户" MaxLength="20" />
              </StackPanel>
              <Border Background="#EDF5F7" CornerRadius="8" Padding="12" IsVisible="{Binding HasOperationHelp}">
                <TextBlock Text="{Binding OperationHelpText}" TextWrapping="Wrap" />
              </Border>
            </StackPanel>
          </Border>
          <StackPanel Orientation="Horizontal" Spacing="12">
            <Button Classes="primary" Content="核对计划预览" Click="Preview" />
            <Button Content="只读环境检查" Click="CheckEnvironment" />
            <Button Content="① 确认计划并安装 Veyon" IsEnabled="{Binding CanInstall}" Click="InstallVeyon" />
            <Button Content="② 确认计划并配置/部署" IsEnabled="{Binding CanStartDeployment}" Click="StartDeployment" />
          </StackPanel>
          <Border Background="#FFF1E8" CornerRadius="8" Padding="16" IsVisible="{Binding HasGlobalError}">
            <TextBlock Text="{Binding Error}" Foreground="#9C4221" TextWrapping="Wrap" />
          </Border>
          <Border Classes="card" IsVisible="{Binding HasPreview}">
            <StackPanel Spacing="12">
              <TextBlock Text="部署预览" FontSize="18" FontWeight="SemiBold" />
              <TextBlock Text="{Binding PreviewText}" TextWrapping="Wrap" />
              <TextBlock Text="必须先核对本计划，再通过环境检查。确认按钮只执行当前屏幕展示的计划；当前仅支持单独执行 Veyon。改名与账户操作尚未接入，含这些选项的计划会被拒绝。" Classes="muted" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
          <Border Classes="card" IsVisible="{Binding HasPreflight}">
            <StackPanel Spacing="12">
              <TextBlock Text="只读环境检查" FontSize="18" FontWeight="SemiBold" />
              <TextBlock Text="{Binding PreflightText}" TextWrapping="Wrap" />
              <TextBlock Text="未知项目还需在 Windows 测试机核对；此报告不表示可以开始部署。" Classes="muted" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
          <Border Classes="card" IsVisible="{Binding HasExecution}">
            <StackPanel Spacing="12">
              <TextBlock Text="部署结果" FontSize="18" FontWeight="SemiBold" />
              <TextBlock Text="{Binding ExecutionText}" TextWrapping="Wrap" />
              <TextBlock Text="结果基于操作后的读回验证；失败不等于未修改，请按上方逐条核对已完成的步骤。重启后建议再次运行只读环境检查。" Classes="muted" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
        </StackPanel>
        <StackPanel IsVisible="{Binding IsTeacher}" Spacing="20">
          <Border Classes="card">
            <StackPanel Spacing="12">
              <TextBlock Text="机房清单预览 · 最多 150 台" FontSize="20" FontWeight="SemiBold" />
              <TextBlock Text="教师端与学生端使用同一命名规则；当前只生成清单预览。" Classes="muted" TextWrapping="Wrap" />
              <Grid ColumnDefinitions="*,16,*,16,*">
                <StackPanel Spacing="8"><TextBlock Text="电脑名前缀" /><TextBox Text="{Binding RoomPrefix, Mode=TwoWay}" /></StackPanel>
                <StackPanel Grid.Column="2" Spacing="8"><TextBlock Text="起始编号" /><TextBox Text="{Binding RoomStart, Mode=TwoWay}" MaxLength="3" /></StackPanel>
                <StackPanel Grid.Column="4" Spacing="8"><TextBlock Text="电脑数量" /><TextBox Text="{Binding RoomCount, Mode=TwoWay}" MaxLength="3" /></StackPanel>
              </Grid>
              <Button Classes="primary" Content="生成清单预览" Click="PreviewRoom" HorizontalAlignment="Left" />
              <TextBlock Text="{Binding RoomError}" Foreground="#9C4221" IsVisible="{Binding HasRoomError}" TextWrapping="Wrap" />
              <StackPanel IsVisible="{Binding HasRoomPreview}" Spacing="8">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                  <TextBlock Text="{Binding RoomSummary}" FontWeight="SemiBold" VerticalAlignment="Center" />
                  <Button Grid.Column="1" Content="关闭预览" Click="CloseRoomPreview" />
                </Grid>
                <ListBox ItemsSource="{Binding RoomNames}" Height="210" />
              </StackPanel>
            </StackPanel>
          </Border>
          <Border Classes="card">
            <StackPanel Spacing="16">
              <TextBlock Text="生成学生部署包" FontSize="20" FontWeight="SemiBold" />
              <TextBlock Text="输入校区 ID 与安装程序路径，生成含 Veyon 4.11.2.0 安装器的部署包（公钥、campus.json、manifest.json）。私钥保留本地，不进入学生包。" TextWrapping="Wrap" Classes="muted" />
              <StackPanel Spacing="8">
                <TextBlock Text="校区 ID" />
                <TextBox Text="{Binding CampusId, Mode=TwoWay}" PlaceholderText="例如 JJ-XUNYANG" />
                <TextBlock Text="Veyon 4.11.2.0 安装程序（.exe）" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBox Text="{Binding InstallerSource, Mode=TwoWay}" PlaceholderText="选择 veyon-4.11.2.0-win64-setup.exe" />
                  <Button Content="浏览…" Click="PickInstaller" MinWidth="72" />
                </StackPanel>
                <TextBlock Text="输出目录（留空默认到桌面）" />
                <TextBox Text="{Binding RoomOutputDir, Mode=TwoWay}" PlaceholderText="留空则生成到 桌面\Veyon-Student-Deployment-校区ID" />
              </StackPanel>
              <Button Classes="primary" Content="一键生成学生部署包" Click="GeneratePackage" HorizontalAlignment="Left" />
              <TextBlock Text="{Binding PackageOutput}" Foreground="#246356" IsVisible="{Binding HasPackageOutput}" TextWrapping="Wrap" />
              <TextBlock Text="{Binding PackageOutputError}" Foreground="#9C4221" IsVisible="{Binding HasPackageOutputError}" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
          <Border Classes="card">
            <StackPanel Spacing="10">
              <TextBlock Text="当前开发顺序" FontSize="18" FontWeight="SemiBold" />
              <TextBlock Text="基础 App → 学生端实际部署 → 教师端配置闭环 → 局域网分发" TextWrapping="Wrap" />
              <TextBlock Text="学生端部署包生成已接入；教师端 Veyon 认证、150 台电脑目录写入与密钥管理仍待后续。" Classes="muted" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Window>
