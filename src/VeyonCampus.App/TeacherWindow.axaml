<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:VeyonCampus.App"
        xmlns:core="using:VeyonCampus.Core"
        x:Class="VeyonCampus.App.TeacherWindow" x:DataType="vm:TeacherViewModel"
        Title="Veyon Campus 教师控制台" Width="1240" Height="880" MinWidth="1024" MinHeight="700"
        Background="#F3F6F8">
  <Window.Styles>
    <Style Selector="Button.seat-cell">
      <Setter Property="Background" Value="#FFFFFF" />
      <Setter Property="Foreground" Value="#173447" />
      <Setter Property="BorderBrush" Value="#DCE5E9" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="Padding" Value="12,9" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
    </Style>
    <Style Selector="Button.seat-cell:pointerover">
      <Setter Property="Background" Value="#EFF8F5" />
      <Setter Property="BorderBrush" Value="#8DDECC" />
    </Style>
    <Style Selector="Button.seat-cell.selected">
      <Setter Property="Background" Value="#E6F3EF" />
      <Setter Property="BorderBrush" Value="#1C645D" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="Border.teacher-note">
      <Setter Property="Background" Value="#E6F3EF" />
      <Setter Property="BorderBrush" Value="#C9E4DB" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="12,9" />
    </Style>
    <Style Selector="Border.teacher-note TextBlock">
      <Setter Property="Foreground" Value="#245F55" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="Button.sidebar-action">
      <Setter Property="Background" Value="#1C3A4A" />
      <Setter Property="Foreground" Value="#E5EEF1" />
      <Setter Property="BorderBrush" Value="#31505D" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="10,7" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
    </Style>
    <Style Selector="Button.sidebar-action:pointerover">
      <Setter Property="Background" Value="#315D6B" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="RadioButton.teacher-nav">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#C9D7DE" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Padding" Value="12,10" />
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="ToolTip.ShowDelay" Value="350" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}"
                  BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
            <Grid ColumnDefinitions="4,*" Margin="5,5,0,5">
              <Border Name="NavSelectionMark" Background="#8DDECC" CornerRadius="2" Opacity="0" />
              <ContentPresenter Grid.Column="1" Name="NavContent" Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}" Padding="{TemplateBinding Padding}"
                                HorizontalContentAlignment="Left" VerticalContentAlignment="Center" />
            </Grid>
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="RadioButton.teacher-nav:checked">
      <Setter Property="Background" Value="#1C645D" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="RadioButton.teacher-nav:pointerover">
      <Setter Property="Background" Value="#315D6B" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="RadioButton.teacher-nav:pressed">
      <Setter Property="Background" Value="#254C59" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="RadioButton.teacher-nav:checked:pointerover">
      <Setter Property="Background" Value="#287E72" />
    </Style>
    <Style Selector="RadioButton.teacher-nav:checked:pressed">
      <Setter Property="Background" Value="#17564F" />
    </Style>
    <Style Selector="RadioButton.teacher-nav:focus-visible">
      <Setter Property="BorderBrush" Value="#8DDECC" />
    </Style>
    <Style Selector="RadioButton.teacher-nav:checked /template/ Border#NavSelectionMark">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="RadioButton.policy-tab">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#405765" />
      <Setter Property="Padding" Value="16,9" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}">
            <ContentPresenter Name="PolicyTabContent" Content="{TemplateBinding Content}"
                              HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
              <ContentPresenter.ContentTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding}"
                             Foreground="{Binding $parent[RadioButton].Foreground}"
                             FontWeight="{Binding $parent[RadioButton].FontWeight}"
                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                </DataTemplate>
              </ContentPresenter.ContentTemplate>
            </ContentPresenter>
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="RadioButton.policy-tab:checked">
      <Setter Property="Background" Value="#173B4C" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="RadioButton.policy-tab:pointerover">
      <Setter Property="Background" Value="#DDE8EC" />
    </Style>
    <Style Selector="RadioButton.policy-tab:checked:pointerover">
      <Setter Property="Background" Value="#245D6A" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="RadioButton.policy-tab:checked /template/ ContentPresenter#PolicyTabContent">
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="RadioButton.policy-tab:checked:pointerover /template/ ContentPresenter#PolicyTabContent">
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="RadioButton.policy-tab:checked:pressed /template/ ContentPresenter#PolicyTabContent">
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="RadioButton.teacher-nav /template/ ContentPresenter">
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="RadioButton.teacher-nav:pointerover /template/ ContentPresenter">
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="RadioButton.teacher-nav:pressed /template/ ContentPresenter">
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="ComboBox">
      <Setter Property="MinHeight" Value="42" />
      <Setter Property="Padding" Value="12,8" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>
  </Window.Styles>
  <Grid ColumnDefinitions="244,*">
    <Border Background="#102A3A" Padding="20,28">
      <Grid RowDefinitions="Auto,*,Auto">
        <StackPanel Spacing="18">
          <StackPanel Orientation="Horizontal" Spacing="12">
            <Border Width="52" Height="52" CornerRadius="15" Background="#FFFFFF" Padding="4">
              <Image Source="avares://VeyonCampus.Teacher/Assets/veyon-campus-mark.png" Stretch="Uniform" />
            </Border>
            <StackPanel VerticalAlignment="Center" Spacing="2">
              <TextBlock Text="VEYON CAMPUS" Foreground="#8DDECC" FontSize="12" FontWeight="Bold" />
              <TextBlock Text="校园部署" Foreground="White" FontSize="18" FontWeight="Bold" />
            </StackPanel>
          </StackPanel>
          <TextBlock Text="课堂管理与离线部署" Foreground="#B7C9D2" FontSize="12" />
        </StackPanel>
        <ScrollViewer Grid.Row="1" Margin="0,14,0,8" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="8">
          <TextBlock Text="常用" Foreground="#8DDECC" FontSize="12" FontWeight="SemiBold" Margin="12,0,0,4" />
          <Button Classes="sidebar-action" Content="手机控制设置" Click="OpenMobileControl" />
          <RadioButton Classes="teacher-nav" GroupName="teacher-pages" ToolTip.Tip="开始课堂、应用练习限制并发送通知" IsChecked="{Binding IsClassroomExperiencePage, Mode=TwoWay}"><TextBlock Text="课堂管理" Foreground="White" /></RadioButton>
          <RadioButton Classes="teacher-nav" GroupName="teacher-pages" ToolTip.Tip="为学生电脑设置网站、应用和 Windows 限制" IsChecked="{Binding IsClassroomPage, Mode=TwoWay}"><TextBlock Text="{Binding ClassroomNavigationLabel}" Foreground="White" /></RadioButton>
          <RadioButton Classes="teacher-nav" GroupName="teacher-pages" ToolTip.Tip="检查教师端更新并向学生电脑推送更新" IsChecked="{Binding IsUpdatesPage, Mode=TwoWay}"><TextBlock Text="更新" Foreground="White" /></RadioButton>
          <TextBlock Text="一次配置" Foreground="#8DDECC" FontSize="12" FontWeight="SemiBold" Margin="12,18,0,4" />
          <RadioButton Classes="teacher-nav" GroupName="teacher-pages" ToolTip.Tip="创建 Veyon 机房地点，添加电脑编号和学生姓名" IsChecked="{Binding IsRoomPage, Mode=TwoWay}"><TextBlock Text="地点与学生名单" Foreground="White" /></RadioButton>
          <RadioButton Classes="teacher-nav" GroupName="teacher-pages" ToolTip.Tip="安装教师端并生成学生配置包" IsChecked="{Binding IsSetupPage, Mode=TwoWay}"><TextBlock Text="首次设置" Foreground="White" /></RadioButton>
        </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Spacing="7">
          <Border Height="1" Background="#31505D" Margin="0,0,0,5" />
          <TextBlock Text="反馈与联系" Foreground="#8DDECC" FontSize="12" FontWeight="SemiBold" Margin="4,0,0,0" />
          <Button Classes="sidebar-action" Content="提交反馈 ↗" Click="OpenFeedbackIssue" />
          <Button Classes="sidebar-action" Content="联系方式" Click="OpenFeedbackContacts" />
          <Border Height="1" Background="#31505D" Margin="0,5,0,5" />
          <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBlock Text="Veyon Campus" Foreground="#B5C6D0" FontSize="12" />
            <TextBlock Text="{Binding AppVersion}" Foreground="#8DDECC" FontSize="12" FontWeight="SemiBold" />
          </StackPanel>
        </StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Column="1" RowDefinitions="Auto,*">
      <Border Grid.Row="0" Background="#FFFFFF" Padding="24,12" IsVisible="{Binding IsClassroomWorkspacePage}">
        <StackPanel Spacing="8">
          <TextBlock Text="{Binding ClassroomTargetSummary}" Classes="muted" TextWrapping="Wrap" IsVisible="{Binding IsClassroomPage}" />
          <Border Background="#EEF3F5" CornerRadius="12" Padding="4" HorizontalAlignment="Left"
                  IsVisible="{Binding IsClassroomPage}">
            <StackPanel Orientation="Horizontal" Spacing="3">
              <RadioButton Classes="policy-tab" GroupName="PolicyCategory" Content="网站" IsChecked="{Binding IsWebsitePolicyPage, Mode=TwoWay}" IsCheckedChanged="PolicyCategoryChanged" />
              <RadioButton Classes="policy-tab" GroupName="PolicyCategory" Content="应用" IsChecked="{Binding IsApplicationPolicyPage, Mode=TwoWay}" IsCheckedChanged="PolicyCategoryChanged" />
              <RadioButton Classes="policy-tab" GroupName="PolicyCategory" Content="系统" IsChecked="{Binding IsSystemPolicyPage, Mode=TwoWay}" IsCheckedChanged="PolicyCategoryChanged" />
            </StackPanel>
          </Border>
        </StackPanel>
      </Border>
      <ScrollViewer x:Name="TeacherContentScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" Background="#F3F6F8">
      <StackPanel Margin="34,30,34,36" Spacing="20">
        <Border Background="#FFFFFF" CornerRadius="16" Padding="24,20" BorderBrush="#E3E9EC" BorderThickness="1">
          <Grid ColumnDefinitions="*">
            <StackPanel Spacing="7">
              <TextBlock Text="{Binding PageTitle}" FontSize="28" FontWeight="Bold" />
            </StackPanel>
          </Grid>
        </Border>
        <StackPanel IsVisible="{Binding IsRoomPage}" Spacing="20">
          <Border Classes="teacher-note"><TextBlock Text="学生姓名只保存在教师机，不会写入学生配置包。" /></Border>
          <Expander Header="保存的机房模板（可选）" IsExpanded="False">
          <Border Classes="card">
            <StackPanel Spacing="14">
              <TextBlock Text="保存常用机房设置，供以后重复使用；不会直接修改 Veyon。" Classes="muted" TextWrapping="Wrap" />
              <Grid ColumnDefinitions="*,16,*">
                <StackPanel Spacing="8">
                  <TextBlock Text="已保存的校区" />
                  <ListBox ItemsSource="{Binding CampusProfiles}" SelectedItem="{Binding SelectedCampusProfile, Mode=TwoWay}" Height="112">
                    <ListBox.ItemTemplate>
                      <DataTemplate x:DataType="core:TeacherCampusProfile">
                     <WrapPanel Orientation="Horizontal">
                          <TextBlock Text="{Binding DisplayName}" />
                     </WrapPanel>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </StackPanel>
                <StackPanel Grid.Column="2" Spacing="8">
                  <TextBlock Text="校区名称" />
                  <TextBox Text="{Binding CampusProfileName, Mode=TwoWay}" PlaceholderText="例如：东区校区" />
                     <WrapPanel Orientation="Horizontal">
                    <Button Content="新增校区" Click="NewCampusProfile" />
                    <Button Classes="primary" Content="保存校区" Click="SaveCampusProfile" />
                    <Button Content="删除所选" Click="DeleteCampusProfile" IsEnabled="{Binding HasSelectedCampusProfile}" />
                     </WrapPanel>
                </StackPanel>
              </Grid>
              <StackPanel IsVisible="{Binding HasSelectedCampusProfile}" Spacing="8">
                <TextBlock Text="已保存的机房" />
                <Grid ColumnDefinitions="*,16,*">
                  <ListBox ItemsSource="{Binding RoomProfiles}" SelectedItem="{Binding SelectedRoomProfile, Mode=TwoWay}" Height="112">
                    <ListBox.ItemTemplate>
                      <DataTemplate x:DataType="core:TeacherRoomProfile">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <TextBlock Text="{Binding DisplayName}" />
                          <TextBlock Text="·" Classes="muted" />
                          <TextBlock Text="{Binding ComputerRangeLabel}" Classes="muted" />
                        </StackPanel>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                  <StackPanel Grid.Column="2" Spacing="8">
                    <TextBox Text="{Binding RoomProfileName, Mode=TwoWay}" PlaceholderText="机房显示名，例如：三楼机房" />
                    <Grid ColumnDefinitions="*,10,*,10,*">
                    <TextBox Text="{Binding RoomProfilePrefix, Mode=TwoWay}" PlaceholderText="电脑名前缀" />
                      <TextBox Grid.Column="2" Text="{Binding RoomProfileStart, Mode=TwoWay}" PlaceholderText="起始编号" MaxLength="3" />
                      <TextBox Grid.Column="4" Text="{Binding RoomProfileCount, Mode=TwoWay}" PlaceholderText="电脑数量（最多 150 台）" MaxLength="3" />
                    </Grid>
                    <TextBlock Text="可选：每行填写一台电脑的主机名或 IP；留空使用电脑名。" Classes="muted" TextWrapping="Wrap" />
                    <TextBox Text="{Binding RoomProfileHostOverrides, Mode=TwoWay}" AcceptsReturn="True" TextWrapping="Wrap" Height="68" PlaceholderText="例如：&#10;192.168.1.21&#10;192.168.1.22" />
                    <WrapPanel Orientation="Horizontal">
                      <Button Content="新建模板" Click="NewRoomProfile" />
                      <Button Classes="primary" Content="保存模板" Click="SaveRoomProfile" />
                      <Button Content="删除所选" Click="DeleteRoomProfile" IsEnabled="{Binding HasSelectedRoomProfile}" />
                      <Button Content="填入电脑名单" Click="LoadRoomProfile" IsEnabled="{Binding HasSelectedRoomProfile}" />
                    </WrapPanel>
                  </StackPanel>
                </Grid>
              </StackPanel>
              <TextBlock Text="{Binding CampusDirectoryStatus}" Classes="muted" IsVisible="{Binding HasCampusDirectoryStatus}" TextWrapping="Wrap" />
              <TextBlock Text="{Binding CampusDirectoryError}" Foreground="#9C4221" IsVisible="{Binding HasCampusDirectoryError}" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
          </Expander>
          <Border Classes="card" IsVisible="{Binding HasSelectedRoomProfile}">
            <StackPanel Spacing="12">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                <StackPanel Spacing="4">
                  <TextBlock Text="座位排序" FontSize="20" FontWeight="SemiBold" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                  <TextBlock Text="列数" VerticalAlignment="Center" />
                  <NumericUpDown Value="{Binding SeatColumns, Mode=TwoWay}"
                                 Minimum="{Binding SeatColumnsMinimum}"
                                 Maximum="{Binding SeatColumnsMaximum}"
                                 Increment="1" FormatString="0" Width="88" />
                  <TextBlock Text="台" VerticalAlignment="Center" />
                </StackPanel>
              </Grid>
              <ItemsControl ItemsSource="{Binding SeatMapCells}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <UniformGrid Columns="{Binding SeatGridColumns}" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:TeacherSeatCell">
                    <Button Classes="seat-cell" Classes.selected="{Binding IsSelected}"
                            Tag="{Binding Index}" Click="SeatCellClicked" Margin="3">
                      <StackPanel Spacing="3">
                        <TextBlock Text="{Binding Target}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding PositionLabel}" Classes="muted" FontSize="12" />
                      </StackPanel>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Text="{Binding SeatMapStatus}" Classes="muted" IsVisible="{Binding HasSeatMapInfo}" TextWrapping="Wrap" />
              <TextBlock Text="{Binding SeatMapStatus}" Foreground="#9C4221" IsVisible="{Binding HasSeatMapError}" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
          <Border Classes="card">
            <StackPanel Spacing="14">
              <TextBlock Text="地点与电脑名单" FontSize="20" FontWeight="SemiBold" />
              <TextBlock Text="预览电脑名单，确认无冲突后添加到 Veyon。" Classes="muted" TextWrapping="Wrap" />
              <StackPanel Spacing="8">
                <TextBlock Text="Veyon 地点名称" />
                <TextBox Text="{Binding RoomLocationName, Mode=TwoWay}" PlaceholderText="例如：三楼计算机房" />
              </StackPanel>
              <Grid ColumnDefinitions="*,16,*,16,*">
                <StackPanel Spacing="8"><TextBlock Text="电脑名前缀" /><TextBox Text="{Binding RoomPrefix, Mode=TwoWay}" /></StackPanel>
                <StackPanel Grid.Column="2" Spacing="8"><TextBlock Text="起始编号" /><TextBox Text="{Binding RoomStart, Mode=TwoWay}" MaxLength="3" /></StackPanel>
                <StackPanel Grid.Column="4" Spacing="8"><TextBlock Text="电脑数量" /><TextBox Text="{Binding RoomCount, Mode=TwoWay}" MaxLength="3" /></StackPanel>
              </Grid>
              <Expander Header="学生显示名与连接地址（可选）">
                <StackPanel Spacing="10" Margin="0,8,0,0">
                  <TextBlock Text="每行对应一台电脑；留空使用电脑编号。学生姓名仅保存在教师机。" Classes="muted" TextWrapping="Wrap" />
                  <TextBox Text="{Binding StudentRoster, Mode=TwoWay}" AcceptsReturn="True" TextWrapping="Wrap" Height="76" PlaceholderText="学生显示名（每行一位，可留空）" />
                  <TextBox Text="{Binding RoomComputerHosts, Mode=TwoWay}" AcceptsReturn="True" TextWrapping="Wrap" Height="76" PlaceholderText="主机名或 IP（每行一台，可留空）" />
                </StackPanel>
              </Expander>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="检查冲突并预览" Click="PreviewRoom" IsEnabled="{Binding CanCheckRoomConflicts}" />
                <Button Classes="primary" Content="一键添加到 Veyon" Click="AddRoomToVeyon" IsEnabled="{Binding CanAddRoomToVeyon}" />
                <Button Content="打开 Veyon Configurator" Click="OpenVeyonConfigurator" IsEnabled="{Binding CanOpenVeyonConfigurator}" />
              </StackPanel>
              <TextBlock Text="{Binding RoomError}" Foreground="#9C4221" IsVisible="{Binding HasRoomError}" TextWrapping="Wrap" />
              <TextBlock Text="{Binding RoomConflictStatus}" Classes="muted" IsVisible="{Binding HasRoomConflictStatus}" TextWrapping="Wrap" />
              <TextBlock Text="{Binding RoomConflictResults}" Foreground="#9C4221" IsVisible="{Binding HasRoomConflictResults}" TextWrapping="Wrap" />
              <TextBlock Text="{Binding RoomSkippedResults}" Classes="muted" IsVisible="{Binding HasRoomSkippedResults}" TextWrapping="Wrap" />
              <TextBlock Text="{Binding RoomCreateStatus}" Classes="muted" IsVisible="{Binding HasRoomCreateStatus}" TextWrapping="Wrap" />
              <TextBlock Text="{Binding RoomCreateError}" Foreground="#9C4221" IsVisible="{Binding HasRoomCreateError}" TextWrapping="Wrap" />
              <TextBlock Text="{Binding RoomCreateResult}" Foreground="#246356" IsVisible="{Binding HasRoomCreateResult}" TextWrapping="Wrap" />
              <StackPanel IsVisible="{Binding HasRoomPreview}" Spacing="8">
                <TextBlock Text="{Binding RoomSummary}" FontWeight="SemiBold" />
                <ListBox ItemsSource="{Binding RoomPreviewRows}" Height="260" />
              </StackPanel>
            </StackPanel>
          </Border>
        </StackPanel>
        <StackPanel IsVisible="{Binding IsSetupPage}" Spacing="20">
          <Border Classes="card">
            <StackPanel Spacing="12">
              <TextBlock Text="教师端一键安装 Veyon" FontSize="20" FontWeight="SemiBold" />
              <TextBlock Text="安装 Veyon，供教师端管理学生电脑。" TextWrapping="Wrap" Classes="muted" />
              <TextBlock Text="{Binding TeacherInstallPlanText}" TextWrapping="Wrap" />
              <TextBlock Text="{Binding TeacherInstallSafetyText}" Foreground="#9C4221" TextWrapping="Wrap" />
              <Button Classes="primary" Content="安装教师端 Veyon" Click="InstallTeacherVeyon" IsEnabled="{Binding CanInstallTeacherVeyon}" HorizontalAlignment="Left" />
              <TextBlock Text="{Binding InstallerStatus}" Classes="muted" TextWrapping="Wrap" />
              <TextBlock Text="{Binding TeacherInstallResult}" Foreground="#246356" IsVisible="{Binding HasTeacherInstallResult}" TextWrapping="Wrap" />
              <TextBlock Text="{Binding TeacherInstallIssue}" Foreground="#9C4221" IsVisible="{Binding HasTeacherInstallIssue}" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
        </StackPanel>
        <StackPanel IsVisible="{Binding IsUpdatesPage}" Spacing="20">
          <Border Classes="card">
            <StackPanel Spacing="12">
              <TextBlock Text="教师控制台更新" FontSize="20" FontWeight="SemiBold" />
              <TextBlock Text="安装更新需要管理员权限。" Classes="muted" TextWrapping="Wrap" />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="检查更新" Click="CheckTeacherUpdate" IsEnabled="{Binding CanCheckTeacherUpdate}" />
                <Button Classes="primary" Content="下载并重启" Click="DownloadTeacherUpdate" IsEnabled="{Binding CanDownloadTeacherUpdate}" />
              </StackPanel>
              <TextBlock Text="{Binding TeacherUpdateStatus}" Classes="muted" TextWrapping="Wrap" />
              <Expander Header="离线更新" IsExpanded="False">
                <StackPanel Spacing="8" Margin="0,8,0,0">
                  <TextBlock Text="安装器需与同版本清单放在一起；验证通过后再安装。" Classes="muted" TextWrapping="Wrap" />
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="导出离线更新包" Click="ExportOfflineTeacherUpdate" IsEnabled="{Binding CanExportOfflineTeacherUpdate}" />
                    <Button Content="选择并验证安装器" Click="VerifyOfflineTeacherUpdate" IsEnabled="{Binding CanVerifyOfflineTeacherUpdate}" />
                    <Button Classes="primary" Content="安装并重启" Click="InstallOfflineTeacherUpdate" IsEnabled="{Binding CanInstallOfflineTeacherUpdate}" />
                  </StackPanel>
                  <TextBlock Text="{Binding OfflineTeacherUpdateStatus}" Classes="muted" TextWrapping="Wrap" />
                </StackPanel>
              </Expander>
            </StackPanel>
          </Border>
          <Border Classes="card">
            <StackPanel Spacing="12">
              <TextBlock Text="学生端静默更新" FontSize="20" FontWeight="SemiBold" />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="核对学生电脑身份" Click="TrustStudentAgentIdentities" IsEnabled="{Binding CanTrustStudentAgentIdentities}" />
                <Button Classes="primary" Content="检查并推送更新" Click="DeployStudentUpdate" IsEnabled="{Binding CanDeployStudentUpdate}" />
              </StackPanel>
              <StackPanel Spacing="6">
                <TextBlock Text="{Binding StudentAgentIdentityStatus}" Classes="muted" TextWrapping="Wrap" />
                <ToggleButton Content="{Binding StudentAgentIdentityDetailsToggleText}"
                              IsChecked="{Binding ShowStudentAgentIdentityDetails, Mode=TwoWay}"
                              IsVisible="{Binding HasStudentAgentIdentityDetails}"
                              HorizontalAlignment="Left" />
                <TextBox Text="{Binding StudentAgentIdentityDetails}" IsReadOnly="True" AcceptsReturn="True"
                         TextWrapping="Wrap" Height="180" IsVisible="{Binding ShowStudentAgentIdentityDetails}" />
              </StackPanel>
              <StackPanel Spacing="6">
                <TextBlock Text="{Binding StudentUpdateStatus}" Classes="muted" TextWrapping="Wrap" />
                <ToggleButton Content="{Binding StudentUpdateDetailsToggleText}"
                              IsChecked="{Binding ShowStudentUpdateDetails, Mode=TwoWay}"
                              IsVisible="{Binding HasStudentUpdateDetails}"
                              HorizontalAlignment="Left" />
                <TextBox Text="{Binding StudentUpdateDetails}" IsReadOnly="True" AcceptsReturn="True"
                         TextWrapping="Wrap" Height="180" IsVisible="{Binding ShowStudentUpdateDetails}" />
              </StackPanel>
            </StackPanel>
          </Border>
          <Expander Header="遇到问题？" IsExpanded="False">
            <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,8,0,0">
              <TextBlock Text="{Binding UpdateDiagnosticsStatus}" Classes="muted" TextWrapping="Wrap" VerticalAlignment="Center" IsVisible="{Binding HasUpdateDiagnosticsStatus}" />
              <Button Classes="tertiary" Content="导出问题报告…" Click="ExportUpdateDiagnostics" />
            </StackPanel>
          </Expander>
        </StackPanel>
        <StackPanel IsVisible="{Binding IsClassroomWorkspacePage}" Spacing="20">
          <Expander Header="校区与目标电脑" IsExpanded="{Binding AreClassroomTargetsExpanded, Mode=TwoWay}"
                    IsVisible="{Binding IsClassroomPage}">
            <Border Classes="card">
              <StackPanel Spacing="8">
                <TextBlock Text="校区" />
                <ComboBox ItemsSource="{Binding WebsiteSigningCampuses}" SelectedItem="{Binding SelectedWebsiteSigningCampus, Mode=TwoWay}" PlaceholderText="选择学生配置包使用的校区" />
                <TextBox Text="{Binding CampusId, Mode=TwoWay}" PlaceholderText="例如：江南校区" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                  <TextBlock Text="选择已有机房电脑" VerticalAlignment="Center" />
                  <Button Grid.Column="1" Content="从 Veyon 读取" Click="FillWebsiteTargets" IsEnabled="{Binding CanReadWebsiteLocations}" />
                </Grid>
                <TextBlock Text="也可手动填写电脑名或 IP，每行一个，最多 150 台。" Classes="muted" TextWrapping="Wrap" />
                <StackPanel IsVisible="{Binding HasMultipleWebsiteLocations}" Spacing="8">
                  <TextBlock Text="检测到多个机房，请选择本次推送目标：" />
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <ComboBox ItemsSource="{Binding WebsiteLocationChoices}" SelectedIndex="{Binding WebsiteLocationIndex, Mode=TwoWay}" />
                    <Button Grid.Column="1" Content="填入所选机房" Click="FillSelectedWebsiteLocation" IsEnabled="{Binding CanApplyWebsiteLocation}" />
                  </Grid>
                </StackPanel>
                <TextBlock Text="{Binding WebsiteDirectoryStatus}" Classes="muted" IsVisible="{Binding HasWebsiteDirectoryStatus}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding WebsiteDirectoryError}" Foreground="#9C4221" IsVisible="{Binding HasWebsiteDirectoryError}" TextWrapping="Wrap" />
                <TextBox Text="{Binding WebsiteTargets, Mode=TwoWay}" AcceptsReturn="True" TextWrapping="Wrap" Height="110" PlaceholderText="PC-01&#10;PC-02&#10;192.168.1.23" />
                <Button Content="核对学生电脑身份" IsEnabled="{Binding CanTrustStudentAgentIdentities}" Click="TrustStudentAgentIdentities" HorizontalAlignment="Left" />
                <TextBlock Text="首次控制先核对身份。电脑名无法连接时，可改填学生机实际 IPv4。" Classes="muted" TextWrapping="Wrap" />
                <StackPanel Spacing="6">
                  <TextBlock Text="{Binding StudentAgentIdentityStatus}" Classes="muted" TextWrapping="Wrap" />
                  <ToggleButton Content="{Binding StudentAgentIdentityDetailsToggleText}"
                                IsChecked="{Binding ShowStudentAgentIdentityDetails, Mode=TwoWay}"
                                IsVisible="{Binding HasStudentAgentIdentityDetails}"
                                HorizontalAlignment="Left" />
                  <TextBox Text="{Binding StudentAgentIdentityDetails}" IsReadOnly="True" AcceptsReturn="True"
                           TextWrapping="Wrap" Height="180" IsVisible="{Binding ShowStudentAgentIdentityDetails}" />
                </StackPanel>
              </StackPanel>
            </Border>
          </Expander>
        </StackPanel>
        <StackPanel IsVisible="{Binding IsClassroomExperiencePage}" Spacing="20">
          <Border Classes="card">
            <StackPanel Spacing="10">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <StackPanel Spacing="4">
                  <TextBlock Text="选择上课机房" FontSize="18" FontWeight="SemiBold" />
                  <TextBlock Text="进入课堂管理时会读取 Veyon 机房；只有一个时自动选用。" Classes="muted" TextWrapping="Wrap" />
                </StackPanel>
                <Button Grid.Column="1" Content="重新读取 Veyon 机房" Click="ReadClassroomLocations"
                        IsEnabled="{Binding CanReadWebsiteLocations}" VerticalAlignment="Center" />
              </Grid>
              <StackPanel Spacing="8" IsVisible="{Binding HasMultipleClassroomLocations}">
                <TextBlock Text="Veyon 中有多个机房，请选择本次上课机房：" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                  <ComboBox ItemsSource="{Binding ClassroomLocationChoices}"
                            SelectedIndex="{Binding ClassroomLocationIndex, Mode=TwoWay}" />
                  <Button Grid.Column="1" Content="使用所选机房" Click="UseSelectedClassroomLocation"
                          IsEnabled="{Binding CanUseSelectedClassroomLocation}" />
                </Grid>
              </StackPanel>
              <TextBlock Text="{Binding ClassroomDirectoryStatus}" Classes="muted"
                         IsVisible="{Binding HasClassroomDirectoryStatus}" TextWrapping="Wrap" />
              <TextBlock Text="{Binding ClassroomDirectoryError}" Foreground="#9C4221"
                         IsVisible="{Binding HasClassroomDirectoryError}" TextWrapping="Wrap" />
              <Grid ColumnDefinitions="*,12,*">
                <StackPanel Spacing="6">
                  <TextBlock Text="校区" Classes="muted" />
                  <ComboBox ItemsSource="{Binding CampusProfiles}" SelectedItem="{Binding SelectedCampusProfile, Mode=TwoWay}"
                            MinWidth="240">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="core:TeacherCampusProfile"><TextBlock Text="{Binding DisplayName}" /></DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                </StackPanel>
                <StackPanel Grid.Column="2" Spacing="6">
                  <TextBlock Text="机房" Classes="muted" />
                  <ComboBox ItemsSource="{Binding RoomProfiles}" SelectedItem="{Binding SelectedRoomProfile, Mode=TwoWay}"
                            MinWidth="240">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="core:TeacherRoomProfile"><TextBlock Text="{Binding DisplayName}" /></DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                </StackPanel>
              </Grid>
              <StackPanel Spacing="6">
                <TextBlock Text="校区密钥" Classes="muted" />
                <ComboBox ItemsSource="{Binding WebsiteSigningCampuses}" SelectedItem="{Binding SelectedWebsiteSigningCampus, Mode=TwoWay}"
                          PlaceholderText="选择与学生配置包相同的校区" />
              </StackPanel>
            </StackPanel>
          </Border>
          <Border Classes="card">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
              <StackPanel Spacing="5">
                <TextBlock Text="课堂" FontSize="18" FontWeight="SemiBold" />
                <TextBlock Text="{Binding ClassroomSessionSummary}" />
                <TextBlock Text="{Binding ClassroomDeliveryStatus}" Classes="muted" TextWrapping="Wrap" />
                <TextBlock Text="{Binding ClassroomEventStatus}" Classes="muted" TextWrapping="Wrap" />
              </StackPanel>
              <Button Grid.Column="1" Classes="primary" Content="{Binding ClassroomSessionActionText}"
                      IsEnabled="{Binding CanToggleClassroomSession}" Click="ToggleClassroomSession"
                      VerticalAlignment="Center" MinWidth="112" />
            </Grid>
          </Border>
          <Border Classes="card" IsVisible="{Binding HasActiveClassroomSession}">
            <StackPanel Spacing="10">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
              <TextBlock Text="练习限制" FontSize="17" FontWeight="SemiBold" />
                <TextBlock Grid.Column="1" Text="{Binding ClassroomModeLabel}" Classes="muted"
                           VerticalAlignment="Center" />
              </Grid>
              <TextBlock Text="使用最近保存的课堂规则；下课时只恢复本工具本堂课修改的设置。"
                         Classes="muted" TextWrapping="Wrap" />
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16" VerticalAlignment="Center">
                <StackPanel Spacing="4">
                  <TextBlock Text="课堂倒计时" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding ClassroomCountdownText}" FontSize="26" FontWeight="SemiBold"
                             Foreground="#1C645D" IsVisible="{Binding HasClassroomCountdown}" />
                  <TextBlock Text="{Binding ClassroomCountdownStatus}" Classes="muted"
                             IsVisible="{Binding HasClassroomCountdownInfo}" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding ClassroomCountdownStatus}" Foreground="#9C4221"
                             IsVisible="{Binding HasClassroomCountdownError}" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"
                            IsVisible="{Binding CanStartClassroomCountdown}">
                  <NumericUpDown Value="{Binding ClassroomCountdownMinutes, Mode=TwoWay}"
                                 Minimum="1" Maximum="180" Increment="1" FormatString="0" Width="76" />
                  <TextBlock Text="分钟" VerticalAlignment="Center" />
                  <Button Classes="primary" Content="开始" Click="StartClassroomCountdown" />
                </StackPanel>
                <Button Grid.Column="1" Content="结束倒计时" Click="EndClassroomCountdown"
                        IsVisible="{Binding CanEndClassroomCountdown}" VerticalAlignment="Center" />
              </Grid>
              <Button Classes="primary" Content="{Binding ClassroomModeActionText}"
                      IsEnabled="{Binding CanChangeClassroomMode}" Click="ToggleClassroomMode" />
              <ScrollViewer Height="180" VerticalScrollBarVisibility="Auto"
                            IsVisible="{Binding HasClassroomModeStatus}">
                <TextBlock Text="{Binding ClassroomModeStatus}" Classes="muted" TextWrapping="Wrap" />
              </ScrollViewer>
              <Border BorderBrush="#E4EAEE" BorderThickness="0,1,0,0" Padding="0,10,0,0">
                <StackPanel Spacing="8">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <TextBlock Text="课堂任务" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="1" Text="{Binding ClassroomTaskProgressSummary}" Classes="muted" />
                  </Grid>
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBox Text="{Binding ClassroomTaskProgressDraft, Mode=TwoWay}" MaxLength="120"
                             PlaceholderText="添加本堂课任务" />
                    <Button Grid.Column="1" Classes="primary" Content="添加"
                            IsEnabled="{Binding CanAddClassroomTask}" Click="AddClassroomTask" />
                  </Grid>
                  <TextBlock Text="{Binding ClassroomTaskProgressStatus}" Classes="muted"
                             IsVisible="{Binding HasClassroomTaskProgressStatus}" TextWrapping="Wrap" />
                  <ScrollViewer MaxHeight="180" VerticalScrollBarVisibility="Auto"
                                IsVisible="{Binding HasClassroomTaskProgress}">
                    <ItemsControl ItemsSource="{Binding ClassroomTaskProgressItems}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:TeacherClassroomTaskItem">
                          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,2">
                            <CheckBox IsChecked="{Binding IsCompleted, Mode=OneWay}" Tag="{Binding TaskId}"
                                      Click="ToggleClassroomTask">
                              <TextBlock Text="{Binding Title}" TextWrapping="Wrap" />
                            </CheckBox>
                            <Button Grid.Column="1" Content="移除" MinHeight="30" Padding="8,3"
                                    Tag="{Binding TaskId}" Click="RemoveClassroomTask" />
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ScrollViewer>
                </StackPanel>
              </Border>
            </StackPanel>
          </Border>
          <Border Classes="card" IsVisible="{Binding HasClassroomRestores}">
            <StackPanel Spacing="10">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <TextBlock Text="待恢复课堂策略" FontSize="17" FontWeight="SemiBold" />
                <TextBlock Grid.Column="1" Text="自动匹配" Classes="muted" VerticalAlignment="Center" />
              </Grid>
              <ScrollViewer MaxHeight="190" VerticalScrollBarVisibility="Auto">
                <TextBlock Text="{Binding ClassroomRestoreSummary}" Classes="muted" TextWrapping="Wrap" />
              </ScrollViewer>
              <Button Classes="primary" Content="重试待恢复项"
                      IsVisible="{Binding HasPendingClassroomRestoreItems}"
                      IsEnabled="{Binding CanRetryClassroomRestores}" Click="RetryClassroomRestores" />
            </StackPanel>
          </Border>
          <Border Classes="card" IsVisible="{Binding HasActiveClassroomSession}">
            <StackPanel Spacing="8">
              <TextBlock Text="全班通知" FontSize="17" FontWeight="SemiBold" />
              <TextBlock Text="发送给当前课堂。在线学生端收到后会自动弹出，通知两分钟后失效。"
                         Classes="muted" TextWrapping="Wrap" />
              <TextBox Text="{Binding ClassroomNoticeDraft, Mode=TwoWay}" AcceptsReturn="True"
                       TextWrapping="Wrap" Height="78" MaxLength="500" PlaceholderText="输入一条课堂通知" />
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <TextBlock Text="{Binding ClassroomNoticeStatus}" Classes="muted"
                           IsVisible="{Binding HasClassroomNoticeStatus}" TextWrapping="Wrap"
                           VerticalAlignment="Center" />
                <Button Grid.Column="1" Classes="primary" Content="发给全班"
                        IsEnabled="{Binding CanSendClassroomNotice}" Click="SendClassroomNotice" />
              </Grid>
            </StackPanel>
          </Border>
          <Border Classes="card" IsVisible="{Binding HasClassroomEventItems}">
            <StackPanel Spacing="10">
              <TextBlock Text="课堂消息" FontSize="17" FontWeight="SemiBold" />
              <ScrollViewer Height="300" VerticalScrollBarVisibility="Auto">
              <ItemsControl ItemsSource="{Binding ClassroomEventItems}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:TeacherClassroomEventItem">
                    <Border Padding="12" CornerRadius="10" Background="#F4F7F9" Margin="0,0,0,8">
                      <StackPanel Spacing="6">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                          <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                          <TextBlock Grid.Column="1" Text="{Binding Status}" Classes="muted"
                                     VerticalAlignment="Center" />
                        </Grid>
                        <TextBlock Text="{Binding SeatLocation}" Classes="muted" IsVisible="{Binding HasSeatLocation}" />
                        <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding EventTime}" Classes="muted" />
                        <TextBox Text="{Binding ReplyMessage, Mode=TwoWay}" IsVisible="{Binding CanReply}"
                                 MaxLength="500" PlaceholderText="回复学生" />
                        <Button Content="发送回复" IsVisible="{Binding CanReply}" IsEnabled="{Binding CanReply}"
                                Click="ReplyToClassroomEvent" HorizontalAlignment="Right" />
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              </ScrollViewer>
            </StackPanel>
          </Border>
        </StackPanel>
        <StackPanel IsVisible="{Binding IsClassroomPage}" Spacing="20">
          <Border Classes="card" IsVisible="{Binding IsWebsitePolicyPage}">
            <StackPanel Spacing="12">
              <TextBlock Text="学生网站黑名单 / 白名单" FontSize="20" FontWeight="SemiBold" />
              <TextBlock Text="推送后重启学生浏览器生效。" Classes="muted" TextWrapping="Wrap" />
              <StackPanel Spacing="8">
                <TextBlock Text="策略模式" />
                <ComboBox SelectedIndex="{Binding WebsiteModeIndex, Mode=TwoWay}">
                  <ComboBoxItem Content="黑名单：只阻止所列网站" />
                  <ComboBoxItem Content="白名单：只允许所列网站" />
                </ComboBox>
                <TextBlock Text="限制时长" />
                <ComboBox SelectedIndex="{Binding WebsiteDurationIndex, Mode=TwoWay}">
                  <ComboBoxItem Content="45 分钟" />
                  <ComboBoxItem Content="60 分钟" />
                  <ComboBoxItem Content="90 分钟" />
                  <ComboBoxItem Content="120 分钟" />
                  <ComboBoxItem Content="不自动到期" />
                </ComboBox>
                <TextBlock Text="网站（每行一个）" />
                <TextBox Text="{Binding WebsiteDomains, Mode=TwoWay}" AcceptsReturn="True" TextWrapping="Wrap" Height="110" PlaceholderText="example.com&#10;school.example" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Classes="primary" Content="签名并推送策略" IsEnabled="{Binding CanPushWebsitePolicy}" Click="PushWebsitePolicy" />
                  <Button Content="一键解除所选电脑的网站限制" IsEnabled="{Binding CanDisableWebsitePolicy}" Click="DisableWebsitePolicy" />
                  <Button Content="填入上次失败设备" IsEnabled="{Binding CanFillFailedWebsiteTargets}" Click="FillFailedWebsiteTargets" />
                </StackPanel>
                <TextBlock Text="{Binding WebsitePolicyHistoryText}" Classes="muted" IsVisible="{Binding HasWebsitePolicyHistory}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding WebsitePolicyError}" Foreground="#9C4221" IsVisible="{Binding HasWebsitePolicyError}" TextWrapping="Wrap" />
                <StackPanel IsVisible="{Binding HasWebsitePolicyResult}" Spacing="6">
                  <TextBlock Text="{Binding WebsitePolicyResult}" Foreground="#246356" TextWrapping="Wrap" />
                  <ToggleButton Content="{Binding WebsitePolicyDetailsToggleText}"
                                IsChecked="{Binding ShowWebsitePolicyResultDetails, Mode=TwoWay}"
                                IsEnabled="{Binding HasWebsitePolicyResultDetails}" HorizontalAlignment="Left" />
                  <TextBox Text="{Binding WebsitePolicyResultDetails}" IsReadOnly="True" AcceptsReturn="True"
                           TextWrapping="Wrap" Height="180" IsVisible="{Binding ShowWebsitePolicyResultDetails}" />
                </StackPanel>
              </StackPanel>
            </StackPanel>
          </Border>
          <Border Classes="card" IsVisible="{Binding IsApplicationPolicyPage}">
            <StackPanel Spacing="12">
              <TextBlock Text="学生应用限制" FontSize="20" FontWeight="SemiBold" />
              <Border Background="#EEF3F5" CornerRadius="12" Padding="4" HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal" Spacing="3">
                  <RadioButton Classes="policy-tab" GroupName="ApplicationSteps" Content="1 账户" IsChecked="{Binding IsApplicationAccountsStep, Mode=TwoWay}" />
                  <RadioButton Classes="policy-tab" GroupName="ApplicationSteps" Content="2 软件" IsChecked="{Binding IsApplicationSoftwareStep, Mode=TwoWay}" />
                  <RadioButton Classes="policy-tab" GroupName="ApplicationSteps" Content="3 应用" IsChecked="{Binding IsApplicationApplyStep, Mode=TwoWay}" />
                </StackPanel>
              </Border>
              <StackPanel IsVisible="{Binding IsApplicationAccountsStep}" Spacing="10">
                <TextBlock Text="选择上课使用的学生账户。限制只作用于所选账户。" FontWeight="SemiBold" TextWrapping="Wrap" />
                <Button Content="核对身份并读取账户" IsEnabled="{Binding CanReadApplicationInventory}" Click="ReadStudentAccounts" HorizontalAlignment="Left" />
                <ItemsControl ItemsSource="{Binding StudentAccountChoices}" IsEnabled="{Binding !IsExecuting}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <CheckBox Content="{Binding Summary}" IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{Binding StudentAccountsStatus}" Classes="muted" IsVisible="{Binding HasStudentAccountsStatus}" TextWrapping="Wrap" />
              </StackPanel>
              <StackPanel IsVisible="{Binding IsApplicationSoftwareStep}" Spacing="10">
              <TextBlock Text="勾选要管理的软件。" FontWeight="SemiBold" TextWrapping="Wrap" />
              <Button Content="读取所选电脑软件" IsEnabled="{Binding CanReadApplicationInventory}" Click="ReadApplicationInventory" HorizontalAlignment="Left" />
              <Expander Header="高级选项">
                <StackPanel Spacing="8">
                  <CheckBox Content="手动设置账户和规则" IsChecked="{Binding UseManualApplicationInputs, Mode=TwoWay}" />
                  <StackPanel IsVisible="{Binding UseManualApplicationInputs}" Spacing="8">
                    <TextBlock Text="学生账户 SID，每行一个。批量目标需要有相同 SID；独立安装的学生机请使用上方账户选择。" TextWrapping="Wrap" />
                    <TextBox Text="{Binding ApplicationStudentSids, Mode=TwoWay}" AcceptsReturn="True" TextWrapping="Wrap" Height="74" />
                    <TextBlock Text="publisher|名称|发布者|产品|文件.exe|最低版本|最高版本；hash|名称|文件.exe|文件SHA256|AppLocker SHA256|字节数" TextWrapping="Wrap" />
                    <TextBox Text="{Binding ApplicationRules, Mode=TwoWay}" AcceptsReturn="True" TextWrapping="Wrap" Height="112" />
                    <Button Content="将勾选软件加入手动规则" IsEnabled="{Binding CanAddSelectedApplicationRules}" Click="AddSelectedApplicationRules" HorizontalAlignment="Left" />
                  </StackPanel>
                </StackPanel>
              </Expander>
              <TextBox Text="{Binding ApplicationInventorySearch, Mode=TwoWay}" PlaceholderText="搜索程序名、发布者、文件名、路径或电脑" />
              <TextBlock Text="{Binding ApplicationInventoryStatus}" Classes="muted" IsVisible="{Binding HasApplicationInventoryStatus}" TextWrapping="Wrap" />
              <ScrollViewer Height="230" IsVisible="{Binding HasApplicationInventoryItems}" IsEnabled="{Binding !IsExecuting}">
                <ItemsControl ItemsSource="{Binding ApplicationInventoryChoices}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Padding="8" Margin="0,0,0,6" BorderBrush="#D8DFE8" BorderThickness="1" CornerRadius="6">
                        <StackPanel Spacing="3">
                          <CheckBox Content="{Binding Summary}" IsChecked="{Binding IsSelected, Mode=TwoWay}" IsEnabled="{Binding CanSelect}" />
                          <TextBlock Text="{Binding FilePath}" FontSize="11" TextWrapping="Wrap" />
                          <TextBlock Text="{Binding RuleAvailability}" Classes="muted" FontSize="11" TextWrapping="Wrap" />
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
              <TextBlock Text="{Binding SelectedApplicationSummary}" Classes="muted" TextWrapping="Wrap" />
              </StackPanel>
              <StackPanel IsVisible="{Binding IsApplicationApplyStep}" Spacing="10">
              <TextBlock Text="先检查影响，再应用限制；随时可以恢复。" FontWeight="SemiBold" TextWrapping="Wrap" />
              <ComboBox SelectedIndex="{Binding ApplicationPolicyModeIndex, Mode=TwoWay}">
                <ComboBoxItem Content="先检查影响（不禁用软件）" />
                <ComboBoxItem Content="禁用勾选软件（阻止后续启动）" />
              </ComboBox>
              <CheckBox Content="我已读取并核对审核事件，确认执行这些规则" IsChecked="{Binding ApplicationEnforcementReviewed, Mode=TwoWay}" IsVisible="{Binding IsEnforceApplicationPolicy}" />
              <TextBlock Text="限制有效时长（最多 24 小时，到期自动恢复原值）" />
              <ComboBox SelectedIndex="{Binding ApplicationPolicyDurationIndex, Mode=TwoWay}">
                <ComboBoxItem Content="45 分钟" />
                <ComboBoxItem Content="60 分钟" />
                <ComboBoxItem Content="90 分钟" />
                <ComboBoxItem Content="120 分钟" />
                <ComboBoxItem Content="24 小时" />
              </ComboBox>
              <TextBlock Text="{Binding ApplicationPolicyPreview}" Classes="muted" TextWrapping="Wrap" />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Classes="primary" Content="应用当前设置" IsEnabled="{Binding CanPushApplicationPolicy}" Click="PushApplicationPolicy" />
                <Button Content="恢复软件（解除课堂应用限制）" IsEnabled="{Binding CanDisableApplicationPolicy}" Click="DisableApplicationPolicy" />
                <Button Content="查看影响检查结果" IsEnabled="{Binding CanReadApplicationPolicyAudit}" Click="ReadApplicationPolicyAudit" />
              </StackPanel>
              <TextBlock Text="{Binding ApplicationPolicyHistoryText}" Classes="muted" IsVisible="{Binding HasApplicationPolicyHistory}" TextWrapping="Wrap" />
              <TextBlock Text="{Binding ApplicationPolicyError}" Foreground="#9C4221" IsVisible="{Binding HasApplicationPolicyError}" TextWrapping="Wrap" />
              <StackPanel IsVisible="{Binding HasApplicationPolicyResult}" Spacing="6">
                <TextBlock Text="{Binding ApplicationPolicyResult}" Foreground="#246356" TextWrapping="Wrap" />
                <ToggleButton Content="{Binding ApplicationPolicyDetailsToggleText}"
                              IsChecked="{Binding ShowApplicationPolicyResultDetails, Mode=TwoWay}"
                              IsEnabled="{Binding HasApplicationPolicyResultDetails}" HorizontalAlignment="Left" />
                <TextBox Text="{Binding ApplicationPolicyResultDetails}" IsReadOnly="True" AcceptsReturn="True"
                         TextWrapping="Wrap" Height="150" IsVisible="{Binding ShowApplicationPolicyResultDetails}" />
              </StackPanel>
              <TextBox Text="{Binding ApplicationAuditResult}" IsReadOnly="True" AcceptsReturn="True"
                       TextWrapping="Wrap" Height="180" IsVisible="{Binding HasApplicationAuditResult}" />
              </StackPanel>
            </StackPanel>
          </Border>
          <Border Classes="card" IsVisible="{Binding IsSystemPolicyPage}">
            <StackPanel Spacing="12">
              <TextBlock Text="Windows 长期限制" FontSize="20" FontWeight="SemiBold" />
              <TextBlock Text="勾选后点推送才会生效；这些限制不会自动到期，可用“解除”撤销。" Classes="muted" TextWrapping="Wrap" />
              <TextBlock Text="{Binding StudentSystemPolicyPushGuidance}" Classes="muted" TextWrapping="Wrap" />
              <CheckBox Content="统一桌面壁纸" IsChecked="{Binding StudentSystemPolicyLockWallpaper, Mode=TwoWay}" />
              <CheckBox Content="禁止修改系统日期、时间和时区" IsChecked="{Binding StudentSystemPolicyProhibitTimeChanges, Mode=TwoWay}" />
              <CheckBox Content="禁止更改网络设置" IsChecked="{Binding StudentSystemPolicyProhibitNetworkChanges, Mode=TwoWay}" />
              <CheckBox Content="限制安装软件和运行便携程序" IsChecked="{Binding StudentSystemPolicyProhibitSoftwareInstallation, Mode=TwoWay}" />
              <CheckBox Content="禁止管理账户和修改本人密码" IsChecked="{Binding StudentSystemPolicyProhibitAccountManagement, Mode=TwoWay}" />
              <CheckBox Content="禁止打开控制面板和设置" IsChecked="{Binding StudentSystemPolicyProhibitControlPanel, Mode=TwoWay}" />
              <CheckBox Content="我已确认软件安装入口限制可能影响学生软件安装与应用更新" IsChecked="{Binding StudentSystemPolicySoftwareInstallReviewed, Mode=TwoWay}" IsVisible="{Binding StudentSystemPolicyProhibitSoftwareInstallation}" />
              <TextBlock Text="{Binding StudentSystemPolicyPreview}" Classes="muted" TextWrapping="Wrap" />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Classes="primary" Content="签名并推送系统限制" IsEnabled="{Binding CanPushStudentSystemPolicy}" Click="PushStudentSystemPolicy" />
                <Button Content="解除所选电脑的系统限制" IsEnabled="{Binding CanDisableStudentSystemPolicy}" Click="DisableStudentSystemPolicy" />
              </StackPanel>
              <TextBlock Text="{Binding StudentSystemPolicyResult}" Foreground="#246356" IsVisible="{Binding HasStudentSystemPolicyResult}" TextWrapping="Wrap" />
              <TextBox Text="{Binding StudentSystemPolicyDetails}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" Height="150" IsVisible="{Binding HasStudentSystemPolicyDetails}" />
              <TextBlock Text="{Binding StudentSystemPolicyError}" Foreground="#9C4221" IsVisible="{Binding HasStudentSystemPolicyError}" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
        </StackPanel>
        <StackPanel IsVisible="{Binding IsSetupPage}" Spacing="20">
          <Expander Header="Veyon 画面卡顿？" IsExpanded="False">
            <Border Background="#FFF8E8" BorderBrush="#EED99C" BorderThickness="1" CornerRadius="14" Padding="18">
              <StackPanel Spacing="10">
                <TextBlock Text="先降低教师端画质；仍卡顿时再降低学生分辨率。" TextWrapping="Wrap" Foreground="#674E16" />
                <Button Content="打开 Veyon 设置" Click="OpenVeyonConfigurator" IsEnabled="{Binding CanOpenVeyonConfigurator}" HorizontalAlignment="Left" />
                <TextBlock Text="{Binding ConfiguratorLaunchError}" Foreground="#9C4221" IsVisible="{Binding HasConfiguratorLaunchError}" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
          </Expander>
          <Border Classes="card">
            <StackPanel Spacing="16">
              <TextBlock Text="生成学生校区配置包" FontSize="20" FontWeight="SemiBold" />
              <StackPanel Spacing="8">
                <TextBlock Text="校区名称" />
              <TextBox Text="{Binding CampusId, Mode=TwoWay}" PlaceholderText="智学前程-校区名称" />
                    <TextBlock Text="校区名称生成后不能更改。" Classes="muted" TextWrapping="Wrap" />
                <Expander Header="更改保存位置" IsExpanded="False">
                  <StackPanel Spacing="6" Margin="0,8,0,0">
                    <TextBlock Text="留空将保存到桌面。" Classes="muted" />
                    <TextBox Text="{Binding RoomOutputDir, Mode=TwoWay}" PlaceholderText="文件夹路径" />
                  </StackPanel>
                </Expander>
              </StackPanel>
              <Border Classes="status-panel info" Padding="12">
                <StackPanel Spacing="8">
                  <TextBlock Text="建议的首次操作" FontWeight="SemiBold" />
                  <TextBlock Text="学生端可调整。" Classes="muted" TextWrapping="Wrap" />
                  <CheckBox Content="安装并配置 Veyon（默认）" IsChecked="{Binding RecommendInstallVeyon, Mode=TwoWay}" />
                  <CheckBox Content="修改电脑名称" IsChecked="{Binding RecommendRenameComputer, Mode=TwoWay}" />
                  <CheckBox Content="创建学生账户" IsChecked="{Binding RecommendCreateStudentAccount, Mode=TwoWay}" />
                  <CheckBox Content="更改管理员密码（需学生确认）"
                            IsChecked="{Binding RecommendChangeAdminPassword, Mode=TwoWay}" />
                </StackPanel>
              </Border>
              <Button Classes="primary" Content="生成学生校区配置包" Click="GeneratePackage" IsEnabled="{Binding CanGenerateStudentPackage}" HorizontalAlignment="Left" />
              <StackPanel IsVisible="{Binding IsGeneratingStudentPackage}" Spacing="6">
                <ProgressBar IsIndeterminate="True" Height="6" />
                <TextBlock Text="{Binding PackageGenerationStatus}" Classes="muted" TextWrapping="Wrap" />
                <Button Classes="secondary" Content="取消配置包生成" Click="CancelPackageGeneration" IsVisible="{Binding IsBuildingStudentPackage}" IsEnabled="{Binding CanCancelStudentPackageGeneration}" HorizontalAlignment="Left" />
              </StackPanel>
              <TextBlock Text="{Binding PackageOutput}" Foreground="#246356" IsVisible="{Binding HasPackageOutput}" TextWrapping="Wrap" />
              <TextBlock Text="{Binding PackageOutputError}" Foreground="#9C4221" IsVisible="{Binding HasPackageOutputError}" TextWrapping="Wrap" />
              <Button Content="确认更换教师签名密钥并继续生成" Click="ReplaceWebsiteSigningKey" IsVisible="{Binding CanReplaceWebsiteSigningKey}" IsEnabled="{Binding CanGenerateStudentPackage}" HorizontalAlignment="Left" />
            </StackPanel>
          </Border>
          <Border Classes="card">
            <StackPanel Spacing="14">
              <TextBlock Text="发布到云端目录" FontSize="20" FontWeight="SemiBold" />
              <StackPanel Spacing="8">
                <TextBlock Text="学生搜索名称（与配置包一致）" />
                <TextBlock Text="{Binding PublishCampusName}" FontWeight="SemiBold" />
                <TextBlock Text="教师姓名" />
                <TextBox Text="{Binding PublisherName, Mode=TwoWay}" MaxLength="100" PlaceholderText="填写发布教师姓名" />
                <TextBlock Text="教师手机号后四位" />
                <TextBox Text="{Binding TeacherPhoneLast4, Mode=TwoWay}" MaxLength="4" PlaceholderText="4 位数字" />
                <TextBlock Text="供学生下载校验。" Classes="muted" />
                <TextBlock Text="{Binding PackagePublisherStatus}" Classes="muted" IsVisible="{Binding HasPackagePublisherStatus}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding PackagePublisherError}" Foreground="#9C4221" IsVisible="{Binding HasPackagePublisherError}" TextWrapping="Wrap" />
              </StackPanel>
              <StackPanel Spacing="8">
                <TextBlock Text="要上传的配置包文件夹" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                  <TextBox Text="{Binding PublishPackageDirectory, Mode=TwoWay}" PlaceholderText="生成配置包后会自动填入，也可手动选择文件夹" />
                  <Button Grid.Column="1" Content="选择文件夹…" Click="ChoosePublishPackageDirectory" />
                </Grid>
                <Button Classes="primary" Content="验证并发布到云端目录"
                        IsEnabled="{Binding CanPublishStudentPackage}"
                        Click="PublishStudentPackage" HorizontalAlignment="Left" />
                <TextBlock Text="{Binding PackagePublishResult}" Foreground="#246356" IsVisible="{Binding HasPackagePublishResult}" TextWrapping="Wrap" />
              </StackPanel>
            </StackPanel>
          </Border>
        </StackPanel>
      </StackPanel>
      </ScrollViewer>
    </Grid>
  </Grid>
</Window>
