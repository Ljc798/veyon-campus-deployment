<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:VeyonCampus.App"
        xmlns:core="using:VeyonCampus.Core"
        x:Class="VeyonCampus.App.TeacherWindow" x:DataType="vm:TeacherViewModel"
        Title="Veyon Campus 教师控制台" Width="1240" Height="880" MinWidth="1024" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Teacher.Color.Background}">
  <Window.Styles>
    <StyleInclude Source="avares://VeyonCampus.Teacher/Presentation/Theme/TeacherControls.axaml" />
    <StyleInclude Source="avares://VeyonCampus.Teacher/Presentation/Components/TeacherComponents.axaml" />
    <Style Selector="Button.setup-step">
      <Setter Property="Background" Value="#FFFFFF" />
      <Setter Property="BorderBrush" Value="#D7E0E8" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="14,10" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
    </Style>
    <Style Selector="Button.setup-step.current">
      <Setter Property="Background" Value="#EAF3FD" />
      <Setter Property="BorderBrush" Value="#0B69C7" />
    </Style>
    <Style Selector="Button.setup-step.current TextBlock">
      <Setter Property="Foreground" Value="#0B69C7" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.seat-cell">
      <Setter Property="Background" Value="#FFFFFF" />
      <Setter Property="Foreground" Value="#173447" />
      <Setter Property="BorderBrush" Value="#DCE5E9" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="Padding" Value="12,9" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
    </Style>
    <Style Selector="Button.seat-cell:pointerover">
      <Setter Property="Background" Value="#EFF8F5" />
      <Setter Property="BorderBrush" Value="#8DDECC" />
    </Style>
    <Style Selector="Button.seat-cell.aisle">
      <Setter Property="Background" Value="#EDF1F4" />
      <Setter Property="Foreground" Value="#63717B" />
      <Setter Property="BorderBrush" Value="#E0E6EA" />
    </Style>
    <Style Selector="Button.seat-cell.selected">
      <Setter Property="Background" Value="#E6F3EF" />
      <Setter Property="BorderBrush" Value="#1C645D" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="Border.teacher-note">
      <Setter Property="Background" Value="#E6F3EF" />
      <Setter Property="BorderBrush" Value="#C9E4DB" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="12,9" />
    </Style>
    <Style Selector="Border.teacher-note TextBlock">
      <Setter Property="Foreground" Value="#245F55" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="Button.sidebar-action">
      <Setter Property="Background" Value="{DynamicResource Teacher.Color.SidebarHover}" />
      <Setter Property="Foreground" Value="{DynamicResource Teacher.Color.SidebarText}" />
      <Setter Property="BorderBrush" Value="#31505D" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="10,7" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="MinHeight" Value="48" />
    </Style>
    <Style Selector="Button.sidebar-action:pointerover">
      <Setter Property="Background" Value="#245565" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderBrush" Value="{DynamicResource Teacher.Color.SidebarAccent}" />
    </Style>
    <Style Selector="Button.sidebar-action:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#245565" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderBrush" Value="{DynamicResource Teacher.Color.SidebarAccent}" />
    </Style>
    <Style Selector="Button.sidebar-action:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Teacher.Color.SidebarActive}" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderBrush" Value="{DynamicResource Teacher.Color.SidebarAccent}" />
    </Style>
    <Style Selector="Button.quick-control-choice">
      <Setter Property="Background" Value="#F7F8FA" />
      <Setter Property="Foreground" Value="#173447" />
      <Setter Property="BorderBrush" Value="#E3E8ED" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="12" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="VerticalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Height" Value="124" />
    </Style>
    <Style Selector="Button.quick-control-choice:pointerover">
      <Setter Property="Background" Value="#EDF5F3" />
      <Setter Property="BorderBrush" Value="#8DDECC" />
    </Style>
    <Style Selector="Button.quick-control-choice:disabled">
      <Setter Property="Opacity" Value="0.62" />
    </Style>
    <Style Selector="RadioButton.teacher-nav">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource Teacher.Color.SidebarText}" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Padding" Value="12,10" />
      <Setter Property="MinHeight" Value="48" />
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="ToolTip.ShowDelay" Value="350" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}"
                  BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
            <Grid ColumnDefinitions="4,*" Margin="5,5,0,5">
              <Border Name="NavSelectionMark" Background="#8DDECC" CornerRadius="2" Opacity="0" />
              <ContentPresenter Grid.Column="1" Name="NavContent" Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}" Padding="{TemplateBinding Padding}"
                                HorizontalContentAlignment="Left" VerticalContentAlignment="Center" />
            </Grid>
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="RadioButton.teacher-nav:checked">
      <Setter Property="Background" Value="{DynamicResource Teacher.Color.SidebarActive}" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="RadioButton.teacher-nav:pointerover">
      <Setter Property="Background" Value="{DynamicResource Teacher.Color.SidebarHover}" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="RadioButton.teacher-nav:pressed">
      <Setter Property="Background" Value="#163B4A" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="RadioButton.teacher-nav:checked:pointerover">
      <Setter Property="Background" Value="#1E756D" />
    </Style>
    <Style Selector="RadioButton.teacher-nav:checked:pressed">
      <Setter Property="Background" Value="#15564F" />
    </Style>
    <Style Selector="RadioButton.teacher-nav:focus-visible">
      <Setter Property="BorderBrush" Value="{DynamicResource Teacher.Color.Focus}" />
    </Style>
    <Style Selector="RadioButton.teacher-nav.teacher-nav-admin">
      <Setter Property="Background" Value="#173B4C" />
      <Setter Property="BorderBrush" Value="#315766" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="MinHeight" Value="48" />
    </Style>
    <Style Selector="RadioButton.teacher-nav.teacher-nav-admin:pointerover">
      <Setter Property="Background" Value="#245D6A" />
      <Setter Property="BorderBrush" Value="#8DDECC" />
    </Style>
    <Style Selector="RadioButton.teacher-nav.teacher-nav-admin:checked">
      <Setter Property="Background" Value="#1C766A" />
      <Setter Property="BorderBrush" Value="#8DDECC" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="RadioButton.teacher-nav:checked /template/ Border#NavSelectionMark">
      <Setter Property="Background" Value="{DynamicResource Teacher.Color.SidebarAccent}" />
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="RadioButton.teacher-nav Path">
      <Setter Property="Width" Value="20" />
      <Setter Property="Height" Value="20" />
      <Setter Property="Stroke" Value="{DynamicResource Teacher.Color.SidebarText}" />
      <Setter Property="StrokeThickness" Value="1.7" />
      <Setter Property="Fill" Value="Transparent" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="RadioButton.teacher-nav:checked Path">
      <Setter Property="Stroke" Value="White" />
    </Style>
    <Style Selector="RadioButton.teacher-nav:pointerover Path">
      <Setter Property="Stroke" Value="White" />
    </Style>
    <Style Selector="Button.sidebar-action Path">
      <Setter Property="Width" Value="20" />
      <Setter Property="Height" Value="20" />
      <Setter Property="Stroke" Value="{DynamicResource Teacher.Color.SidebarText}" />
      <Setter Property="StrokeThickness" Value="1.7" />
      <Setter Property="Fill" Value="Transparent" />
    </Style>
    <Style Selector="RadioButton.policy-tab">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#405765" />
      <Setter Property="Padding" Value="16,9" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}">
            <ContentPresenter Name="PolicyTabContent" Content="{TemplateBinding Content}"
                              HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
              <ContentPresenter.ContentTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding}"
                             Foreground="{Binding $parent[RadioButton].Foreground}"
                             FontWeight="{Binding $parent[RadioButton].FontWeight}"
                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                </DataTemplate>
              </ContentPresenter.ContentTemplate>
            </ContentPresenter>
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="RadioButton.policy-tab:checked">
      <Setter Property="Background" Value="#173B4C" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="RadioButton.policy-tab:pointerover">
      <Setter Property="Background" Value="#DDE8EC" />
    </Style>
    <Style Selector="RadioButton.policy-tab:checked:pointerover">
      <Setter Property="Background" Value="#245D6A" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="RadioButton.policy-tab:checked /template/ ContentPresenter#PolicyTabContent">
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="RadioButton.policy-tab:checked:pointerover /template/ ContentPresenter#PolicyTabContent">
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="RadioButton.policy-tab:checked:pressed /template/ ContentPresenter#PolicyTabContent">
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="RadioButton.teacher-nav /template/ ContentPresenter">
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="RadioButton.teacher-nav:pointerover /template/ ContentPresenter">
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="RadioButton.teacher-nav:pressed /template/ ContentPresenter">
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="ComboBox">
      <Setter Property="MinHeight" Value="42" />
      <Setter Property="Padding" Value="12,8" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>
  </Window.Styles>
  <Grid ColumnDefinitions="224,*">
    <Border Classes="teacher-sidebar">
      <Grid RowDefinitions="Auto,*,Auto">
        <StackPanel Spacing="18">
          <StackPanel Orientation="Horizontal" Spacing="12">
            <Border Width="52" Height="52" CornerRadius="15" Background="#FFFFFF" Padding="4">
              <Image Source="avares://VeyonCampus.Teacher/Assets/veyon-campus-mark.png" Stretch="Uniform" />
            </Border>
            <StackPanel VerticalAlignment="Center" Spacing="2">
              <TextBlock Text="VEYON CAMPUS" Foreground="#8DDECC" FontSize="12" FontWeight="Bold" />
              <TextBlock Text="教师控制台" Foreground="White" FontSize="18" FontWeight="Bold" />
            </StackPanel>
          </StackPanel>
        </StackPanel>
        <ScrollViewer Grid.Row="1" Margin="0,14,0,8" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="8">
          <TextBlock Text="常用功能" Foreground="{DynamicResource Teacher.Color.SidebarAccent}" FontSize="12" FontWeight="SemiBold" Margin="12,14,0,4" />
          <RadioButton Classes="teacher-nav" GroupName="teacher-pages" ToolTip.Tip="查看当前教室、课堂互动和设备控制入口" IsChecked="{Binding IsClassroomExperiencePage, Mode=TwoWay}">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <Path Data="M3,4 L21,4 L21,16 L3,16 Z M12,16 L12,20 M8,20 L16,20" />
              <TextBlock Text="{Binding ClassroomInteractionNavigationLabel}" Foreground="White" TextWrapping="Wrap" />
            </StackPanel>
          </RadioButton>
          <RadioButton Classes="teacher-nav" GroupName="teacher-pages" ToolTip.Tip="查看所选学生电脑的 Veyon 服务、策略与更新状态" IsChecked="{Binding IsHealthCenterPage, Mode=TwoWay}">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <Path Data="M12,3 L14,9 L20,9 L15,13 L17,20 L12,16 L7,20 L9,13 L4,9 L10,9 Z" />
              <TextBlock Text="设备健康" Foreground="White" />
            </StackPanel>
          </RadioButton>
          <RadioButton Classes="teacher-nav" GroupName="teacher-pages" ToolTip.Tip="管理网站名单、应用限制和 Windows 长期策略" IsChecked="{Binding IsClassroomPage, Mode=TwoWay}">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <Path Data="M12,2 L20,5 L20,11 C20,16 16,20 12,22 C8,20 4,16 4,11 L4,5 Z" />
              <TextBlock Text="策略与预设" Foreground="White" />
            </StackPanel>
          </RadioButton>
          <RadioButton Classes="teacher-nav" GroupName="teacher-pages" ToolTip.Tip="管理教师端和学生端更新及设备运维" IsChecked="{Binding IsUpdatesPage, Mode=TwoWay}">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <Path Data="M4,7 L8,3 L12,7 M8,4 L8,11 M20,17 L16,21 L12,17 M16,20 L16,13" />
              <TextBlock Text="更新与运维" Foreground="White" />
            </StackPanel>
          </RadioButton>
          <TextBlock Text="其他工具" Foreground="{DynamicResource Teacher.Color.SidebarAccent}" FontSize="12" FontWeight="SemiBold" Margin="12,16,0,4" />
          <Button Classes="sidebar-action" Click="OpenMobileControl" HorizontalContentAlignment="Left">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <Path Data="M7,2 L17,2 L17,22 L7,22 Z M10,18 L14,18" />
              <TextBlock Text="手机配对与连接" Foreground="White" />
            </StackPanel>
          </Button>
        </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Spacing="7">
          <Border Height="1" Background="#31505D" Margin="0,0,0,5" />
          <Expander Classes="sidebar-help" IsExpanded="False" ExpandDirection="Up">
            <Expander.Header>
              <Border Background="#173B4C" BorderBrush="#315766" BorderThickness="1"
                      CornerRadius="8" Padding="10,9" HorizontalAlignment="Stretch">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                  <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                    <Border Width="22" Height="22" CornerRadius="11" Background="#25495C">
                      <TextBlock Text="?" Foreground="{DynamicResource Teacher.Color.SidebarAccent}"
                                 FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="遇到问题？" Foreground="{DynamicResource Teacher.Color.SidebarText}"
                               FontWeight="SemiBold" VerticalAlignment="Center" />
                  </StackPanel>
                  <Path Grid.Column="1" Data="M2,4 L7,9 L12,4" Width="14" Height="10"
                        Stroke="{DynamicResource Teacher.Color.SidebarText}" StrokeThickness="1.6"
                        Fill="Transparent" VerticalAlignment="Center" />
                </Grid>
              </Border>
            </Expander.Header>
            <ScrollViewer MaxHeight="420" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled" Margin="4,8,0,0">
              <StackPanel Spacing="7">
                <TextBlock Text="配置与部署" Foreground="#8DDECC" FontSize="11"
                           FontWeight="SemiBold" Margin="10,4,0,0" />
                <RadioButton Classes="teacher-nav teacher-nav-admin" GroupName="teacher-pages"
                             ToolTip.Tip="选择 Veyon 教室地点，维护电脑编号、学生姓名和座位"
                             IsChecked="{Binding IsRoomPage, Mode=TwoWay}">
                  <StackPanel Spacing="2">
                    <TextBlock Text="地点与学生名单" Foreground="White" FontWeight="SemiBold" />
                    <TextBlock Text="教室、电脑编号和学生信息" Foreground="#C7D9DF" FontSize="11" />
                  </StackPanel>
                </RadioButton>
                <RadioButton Classes="teacher-nav teacher-nav-admin" GroupName="teacher-pages"
                             ToolTip.Tip="运行首次部署向导，安装教师端并生成学生配置包"
                             IsChecked="{Binding IsSetupPage, Mode=TwoWay}">
                  <StackPanel Spacing="2">
                    <TextBlock Text="首次设置向导" Foreground="White" FontWeight="SemiBold" />
                    <TextBlock Text="安装教师端并配置学生电脑" Foreground="#C7D9DF" FontSize="11" />
                  </StackPanel>
                </RadioButton>
                <Border Height="1" Background="#31505D" Margin="2,4" />
              <Button Classes="danger" Content="清空本机配置…" Click="ClearAllConfiguration"
                      ToolTip.Tip="重置本机 Veyon Campus 和 Veyon 配置" />
              <Button Classes="sidebar-action" Content="导出问题报告…" Click="ExportUpdateDiagnostics" />
              <TextBlock Text="{Binding UpdateDiagnosticsStatus}" Classes="muted" FontSize="11"
                         TextWrapping="Wrap" IsVisible="{Binding HasUpdateDiagnosticsStatus}" />
              <Button Classes="sidebar-action" Content="提交反馈 ↗" Click="OpenFeedbackIssue" />
              <Button Classes="sidebar-action" Content="联系方式" Click="OpenFeedbackContacts" />
              </StackPanel>
            </ScrollViewer>
          </Expander>
        </StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Column="1" RowDefinitions="Auto,*">
      <Border Grid.Row="0" Classes="teacher-page-header">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
          <StackPanel Spacing="3" VerticalAlignment="Center">
            <TextBlock Classes="page-title" Text="课堂控制" IsVisible="{Binding IsClassroomExperiencePage}" />
            <TextBlock Classes="page-title" Text="设备健康" IsVisible="{Binding IsHealthCenterPage}" />
            <TextBlock Classes="page-title" Text="策略与预设" IsVisible="{Binding IsClassroomPage}" />
            <TextBlock Classes="page-title" Text="更新与运维" IsVisible="{Binding IsUpdatesPage}" />
            <TextBlock Classes="page-title" Text="地点与学生名单" IsVisible="{Binding IsRoomPage}" />
            <TextBlock Classes="page-title" Text="首次设置向导" IsVisible="{Binding IsSetupPage}" />
            <TextBlock Text="{Binding ClassroomRoomContextSummary}" Classes="supporting-copy"
                       IsVisible="{Binding IsClassroomExperiencePage}" />
            <TextBlock Text="{Binding WebsitePolicyTargetSelectionSummary}" Classes="supporting-copy"
                       IsVisible="{Binding IsHealthCenterPage}" />
            <TextBlock Text="{Binding ClassroomTargetSummary}" Classes="supporting-copy"
                       IsVisible="{Binding IsClassroomPage}" />
            <TextBlock Text="{Binding TeacherUpdateVersionSummary}" Classes="supporting-copy"
                       IsVisible="{Binding IsUpdatesPage}" />
          </StackPanel>
          <Border Grid.Column="1" Classes="status-chip success"
                  IsVisible="{Binding HasActiveClassroomSession}" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="7">
              <Ellipse Width="8" Height="8" Fill="{DynamicResource Teacher.Color.Success}" VerticalAlignment="Center" />
              <TextBlock Text="课堂进行中" />
            </StackPanel>
          </Border>
        </Grid>
      </Border>
      <Grid Grid.Row="1" RowDefinitions="Auto,*">
      <Border Grid.Row="0" Background="{DynamicResource Teacher.Color.Surface}" Padding="24,6"
              IsVisible="{Binding IsClassroomPage}">
        <StackPanel Spacing="8">
          <Border Background="#EEF3F5" CornerRadius="12" Padding="4" HorizontalAlignment="Left"
                  IsVisible="{Binding IsClassroomPage}">
            <StackPanel Orientation="Horizontal" Spacing="3">
              <RadioButton Classes="policy-tab" GroupName="PolicyCategory" Content="学生代理" IsChecked="{Binding IsWebsitePolicyPage, Mode=TwoWay}" IsCheckedChanged="PolicyCategoryChanged" />
              <RadioButton Classes="policy-tab" GroupName="PolicyCategory" Content="应用限制" IsChecked="{Binding IsApplicationPolicyPage, Mode=TwoWay}" IsCheckedChanged="PolicyCategoryChanged" />
              <RadioButton Classes="policy-tab" GroupName="PolicyCategory" Content="系统限制" IsChecked="{Binding IsSystemPolicyPage, Mode=TwoWay}" IsCheckedChanged="PolicyCategoryChanged" />
            </StackPanel>
          </Border>
        </StackPanel>
      </Border>
      <ScrollViewer x:Name="TeacherContentScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                    Background="{DynamicResource Teacher.Color.Background}">
      <StackPanel Margin="24,24,24,28" Spacing="20">
        <StackPanel IsVisible="{Binding IsRoomPage}" Spacing="20">
          <Border Classes="card">
            <StackPanel Spacing="12">
              <Grid ColumnDefinitions="*" ColumnSpacing="14">
                <StackPanel Spacing="4">
                  <TextBlock Text="机房座位图" FontSize="20" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding SeatGridContext}" Classes="muted" TextWrapping="Wrap"
                             IsVisible="{Binding HasSeatMap}" />
                  <TextBlock Text="座位图和学生姓名保存在教师电脑；从 Veyon 删除地点不会删除本机档案。"
                             Classes="muted" TextWrapping="Wrap" IsVisible="{Binding HasSeatMap}" />
                </StackPanel>
              </Grid>
              <Grid ColumnDefinitions="*,16,*" IsVisible="{Binding HasNoSeatMap}">
                <StackPanel Spacing="8">
                  <TextBlock Text="配置包 / 校区名称" />
                  <TextBox Text="{Binding RoomCampusName, Mode=TwoWay}" IsEnabled="{Binding CanEditRoomPlan}"
                           PlaceholderText="例如：东区校区" />
                </StackPanel>
                <StackPanel Grid.Column="2" Spacing="8">
                  <TextBlock Text="机房名称" />
                  <TextBox Text="{Binding RoomLocationName, Mode=TwoWay}" IsEnabled="{Binding CanEditRoomPlan}"
                           PlaceholderText="默认使用配置包名称" />
                </StackPanel>
              </Grid>
              <TextBlock Text="默认 15×15；可点按或按住鼠标拖动连续添加桌位。电脑编号固定跟随座位；填写姓名且编号留空时，从本机已登记地点的最大编号后续排。空姓名桌位不编号，也不生成学生电脑。"
                         Classes="muted" IsVisible="{Binding HasNoSeatMap}" TextWrapping="Wrap" />
              <Button Classes="primary" Content="开始编辑座位图" Click="PrepareRoomSeatGrid"
                      IsEnabled="{Binding CanPrepareRoomSeatGrid}" IsVisible="{Binding HasNoSeatMap}"
                      HorizontalAlignment="Left" />
              <StackPanel IsVisible="{Binding HasSeatMap}">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Margin="0,4,0,8">
                  <TextBlock Text="{Binding SeatGridSummary}" VerticalAlignment="Center" />
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button Content="{Binding SeatMapEditButtonLabel}" Click="ToggleSeatMapEditing"
                            IsEnabled="{Binding CanToggleSeatMapEditing}" />
                    <Button Classes="secondary" Content="取消编辑" Click="CancelSeatMapEditing"
                            IsEnabled="{Binding CanCancelSeatMapEditing}"
                            IsVisible="{Binding IsSeatMapEditing}" />
                    <Button Content="打印座位表" Click="PrintSeatChart"
                            IsEnabled="{Binding CanPrintSeatMap}" />
                    <Button Content="打开 Veyon 配置器" Click="OpenVeyonConfigurator"
                            IsEnabled="{Binding CanOpenVeyonConfigurator}" />
                    <Button Content="删除本机机房" Click="DeleteRoomProfile"
                            IsEnabled="{Binding CanDeleteRoomProfile}" />
                  </StackPanel>
                </Grid>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Margin="0,4,0,6">
                  <TextBlock Text="{Binding SeatGridContext}" Classes="muted" VerticalAlignment="Center" />
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <TextBlock Text="行" VerticalAlignment="Center" />
                    <NumericUpDown Value="{Binding SeatRowsDraft, Mode=TwoWay}"
                                   Minimum="{Binding SeatDimensionMinimum}"
                                   Maximum="{Binding SeatDimensionMaximum}"
                                   Increment="1" FormatString="0" Width="144"
                                   IsEnabled="{Binding CanEditSeatMap}" />
                    <TextBlock Text="列" VerticalAlignment="Center" />
                    <NumericUpDown Value="{Binding SeatColumnsDraft, Mode=TwoWay}"
                                   Minimum="{Binding SeatDimensionMinimum}"
                                   Maximum="{Binding SeatDimensionMaximum}"
                                   Increment="1" FormatString="0" Width="144"
                                   IsEnabled="{Binding CanEditSeatMap}" />
                    <Button Content="应用行列" Click="ApplySeatGridDimensions"
                            IsEnabled="{Binding CanApplySeatGridDimensions}"
                            IsVisible="{Binding IsSeatMapEditing}" />
                  </StackPanel>
                </Grid>
                <TextBlock Text="{Binding SeatDimensionRemovalSummary}" Classes="muted"
                           IsVisible="{Binding IsSeatMapEditing}" TextWrapping="Wrap" Margin="0,0,0,6" />
                <TextBlock Text="预览 · 悬停查看桌位和学生姓名。" Classes="muted"
                           IsVisible="{Binding IsSeatMapPreview}" TextWrapping="Wrap" Margin="0,0,0,8" />
                <TextBlock Text="编辑 · 填写姓名且编号留空时，按本机已登记地点的最大编号后续排；也可手动指定。点击已有桌位修改姓名和编号；已绑定 Veyon 电脑的编号会锁定。"
                           Classes="muted" IsVisible="{Binding IsSeatMapEditing}" TextWrapping="Wrap" Margin="0,0,0,8" />
                <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,0,0,8">
                  <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                    <Border Width="14" Height="14" Background="#EEF2F5" BorderBrush="#DCE3E8"
                            BorderThickness="1" CornerRadius="4" />
                    <TextBlock Text="过道" Classes="muted" VerticalAlignment="Center" />
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                    <Border Width="14" Height="14" Background="#FFFFFF" BorderBrush="#9CB4C0"
                            BorderThickness="1" CornerRadius="4" />
                    <TextBlock Text="桌位" Classes="muted" VerticalAlignment="Center" />
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                    <Border Width="14" Height="14" Background="#FFF3D6" BorderBrush="#D99A26"
                            BorderThickness="2" CornerRadius="4" />
                    <TextBlock Text="姓名座位待编号" Classes="muted" VerticalAlignment="Center" />
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center"
                              IsVisible="{Binding IsSeatMapEditing}">
                    <Border Width="14" Height="14" Background="#FFF1C2" BorderBrush="#C98900"
                            BorderThickness="3" CornerRadius="4" />
                    <TextBlock Text="本次新增" Classes="muted" VerticalAlignment="Center" />
                  </StackPanel>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,0,8">
                  <CheckBox Content="换座模式" IsChecked="{Binding SeatSwapMode, Mode=TwoWay}"
                            IsEnabled="{Binding CanToggleSeatSwapMode}"
                            VerticalAlignment="Center" />
                  <TextBlock Text="{Binding SeatSwapSelectionSummary}" Classes="muted"
                             VerticalAlignment="Center" />
                  <Button Classes="primary" Content="交换所选座位" Click="SwapSelectedSeats"
                          IsEnabled="{Binding CanSwapSeats}" />
                  <Button Classes="primary" Content="{Binding SeatAddRemoveModeButtonLabel}"
                          Click="ToggleSeatAddRemoveMode" IsEnabled="{Binding CanToggleSeatAddRemoveMode}"
                          IsVisible="{Binding IsSeatMapEditing}" />
                  <Button Content="{Binding AssignMissingSeatComputerNumbersLabel}"
                          Click="AssignMissingSeatComputerNumbers" IsEnabled="{Binding CanAssignMissingSeatComputerNumbers}"
                          IsVisible="{Binding IsSeatMapEditing}" />
                  <Button Classes="primary" Content="创建地点和学生电脑" Click="AddRoomToVeyon"
                          IsEnabled="{Binding CanStartRoomCreation}"
                          IsVisible="{Binding IsSeatMapEditing}" />
                </StackPanel>
                <TextBlock Text="{Binding SeatSwapStatus}" Classes="muted"
                           IsVisible="{Binding HasSeatSwapStatus}" TextWrapping="Wrap" />
                <ListBox ItemsSource="{Binding SeatSwapTargetResults}" Height="100"
                         IsVisible="{Binding HasSeatSwapTargetResults}" />
                <ItemsControl x:Name="SeatMapGrid" ItemsSource="{Binding SeatMapCells}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <UniformGrid Columns="{Binding SeatGridColumns}" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:TeacherSeatCell">
                      <Button Classes="seat-dot" Classes.aisle="{Binding IsAisle}"
                              Classes.seat="{Binding IsSeat}"
                              Classes.namedSeat="{Binding HasStudentName}"
                              Classes.needsComputerNumber="{Binding NeedsComputerNumber}"
                              Classes.addRemoveMode="{Binding IsSeatAddRemoveMode}"
                              Classes.newSeat="{Binding IsNewlyAdded}"
                              Classes.selected="{Binding IsSwapSelected}"
                              ToolTip.Tip="{Binding TooltipText}"
                              Click="SeatCellClicked"
                              Margin="1" Width="24" Height="24" MinHeight="24" Padding="0">
                        <TextBlock Text="{Binding GridLabel}" FontSize="9" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
              <TextBlock Text="{Binding RoomError}" Foreground="#9C4221" IsVisible="{Binding HasRoomError}" TextWrapping="Wrap" />
              <TextBlock Text="{Binding RoomConflictStatus}" Classes="muted" IsVisible="{Binding HasRoomConflictStatus}" TextWrapping="Wrap" />
              <TextBlock Text="{Binding RoomConflictResults}" Foreground="#9C4221" IsVisible="{Binding HasRoomConflictResults}" TextWrapping="Wrap" />
              <TextBlock Text="{Binding RoomSkippedResults}" Classes="muted" IsVisible="{Binding HasRoomSkippedResults}" TextWrapping="Wrap" />
              <TextBlock Text="{Binding RoomCreateStatus}" Classes="muted" IsVisible="{Binding HasRoomCreateStatus}" TextWrapping="Wrap" />
              <TextBlock Text="{Binding RoomCreateError}" Foreground="#9C4221" IsVisible="{Binding HasRoomCreateError}" TextWrapping="Wrap" />
              <TextBlock Text="{Binding RoomCreateResult}" Foreground="#246356" IsVisible="{Binding HasRoomCreateResult}" TextWrapping="Wrap" />
              <TextBlock Text="{Binding SeatMapStatus}" Classes="muted" IsVisible="{Binding HasSeatMapInfo}" TextWrapping="Wrap" />
              <TextBlock Text="{Binding SeatMapStatus}" Foreground="#9C4221" IsVisible="{Binding HasSeatMapError}" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
        </StackPanel>
        <StackPanel IsVisible="{Binding IsSetupPage}" Spacing="20">
          <Border Classes="card">
            <StackPanel Spacing="12">
              <TextBlock Text="教师端首次设置" FontSize="20" FontWeight="SemiBold" />
              <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                <Button Classes="setup-step" Classes.current="{Binding IsTeacherSetupStep1}"
                        Content="{Binding TeacherSetupStep1Label}" Click="TeacherSetupStep1" />
                <Button Grid.Column="1" Classes="setup-step" Classes.current="{Binding IsTeacherSetupStep2}"
                        Content="{Binding TeacherSetupStep2Label}" IsEnabled="{Binding CanOpenTeacherSetupStep2}"
                        Click="TeacherSetupStep2" />
                <Button Grid.Column="2" Classes="setup-step" Classes.current="{Binding IsTeacherSetupStep3}"
                        Content="{Binding TeacherSetupStep3Label}" IsEnabled="{Binding CanOpenTeacherSetupStep3}"
                        Click="TeacherSetupStep3" />
              </Grid>
              <ProgressBar Minimum="1" Maximum="3" Value="{Binding TeacherSetupWizardStep}" Height="5" />
              <TextBlock Text="依次确认教师端环境、填写机房桌位与学生姓名，再生成学生配置包。空姓名桌位只作物理桌位，不会生成学生电脑。"
                         Classes="muted" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
          <Border Classes="card" IsVisible="{Binding IsTeacherSetupStep1}">
            <StackPanel Spacing="12">
              <TextBlock Text="教师端一键安装 Veyon" FontSize="20" FontWeight="SemiBold" />
              <TextBlock Text="{Binding TeacherInstallPlanText}" TextWrapping="Wrap" />
              <TextBlock Text="{Binding TeacherInstallSafetyText}" Foreground="#9C4221" TextWrapping="Wrap" />
              <Button Classes="primary" Content="安装/修复教师端 Veyon" Click="InstallTeacherVeyon" IsEnabled="{Binding CanInstallTeacherVeyon}" HorizontalAlignment="Left" />
              <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsInstallingTeacherVeyon}" Height="6" />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="重新检查 Veyon 状态" Click="RefreshTeacherSetupVeyon"
                        IsEnabled="{Binding CanRefreshTeacherSetupVeyon}" />
                <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsCheckingTeacherSetupVeyon}"
                             Width="120" Height="6" VerticalAlignment="Center" />
              </StackPanel>
              <TextBlock Text="{Binding TeacherSetupVeyonStatus}" Classes="muted" TextWrapping="Wrap"
                         IsVisible="{Binding HasTeacherSetupVeyonStatus}" />
              <TextBlock Text="{Binding InstallerStatus}" Classes="muted" TextWrapping="Wrap"
                         IsVisible="{Binding HasInstallerStatus}" />
              <TextBlock Text="{Binding TeacherInstallResult}" Foreground="#246356" IsVisible="{Binding HasTeacherInstallResult}" TextWrapping="Wrap" />
              <TextBlock Text="{Binding TeacherInstallIssue}" Foreground="#9C4221" IsVisible="{Binding HasTeacherInstallIssue}" TextWrapping="Wrap" />
              <Button Classes="primary" Content="下一步：配置机房与座位" Click="TeacherSetupNext"
                      IsEnabled="{Binding CanProceedTeacherSetupToRooms}" HorizontalAlignment="Left" />
            </StackPanel>
          </Border>
          <Border Classes="card" IsVisible="{Binding IsTeacherSetupStep2}">
            <StackPanel Spacing="12">
              <TextBlock Text="机房地点与学生座位" FontSize="20" FontWeight="SemiBold" />
              <TextBlock Text="{Binding TeacherSetupRoomSummary}" Classes="muted" TextWrapping="Wrap" />
              <Border Classes="status-panel info" Padding="12">
                <TextBlock Text="座位图只记录桌位和学生姓名。填写姓名的桌位会生成学生电脑；未填写姓名的桌位只是空桌子，不会生成电脑。"
                           TextWrapping="Wrap" />
              </Border>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Classes="primary" Content="配置机房座位图" Click="OpenRoomSetupFromTeacherWizard" />
                <Button Classes="primary" Content="下一步：生成学生配置包" Click="TeacherSetupNext"
                        IsEnabled="{Binding IsTeacherSetupRoomComplete}" />
                <Button Content="暂时跳过机房设置" Click="SkipTeacherSetupRoom"
                        IsEnabled="{Binding CanSkipTeacherSetupRoom}" />
              </StackPanel>
            </StackPanel>
          </Border>
        </StackPanel>
        <StackPanel IsVisible="{Binding IsUpdatesPage}" Spacing="20">
          <Border Classes="card">
            <StackPanel Spacing="12">
              <TextBlock Text="教师控制台更新" FontSize="20" FontWeight="SemiBold" />
              <TextBlock Text="安装更新需要管理员权限。" Classes="muted" TextWrapping="Wrap" />
              <TextBlock Text="{Binding TeacherUpdateVersionSummary}" Classes="muted" />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="检查更新" Click="CheckTeacherUpdate" IsEnabled="{Binding CanCheckTeacherUpdate}" />
                <Button Classes="primary" Content="下载并重启" Click="DownloadTeacherUpdate" IsEnabled="{Binding CanDownloadTeacherUpdate}" />
              </StackPanel>
              <ProgressBar Minimum="0" Maximum="100" Value="{Binding TeacherUpdateProgressPercent}"
                           IsIndeterminate="{Binding TeacherUpdateProgressIsIndeterminate}"
                           IsVisible="{Binding IsTeacherUpdateProgressVisible}" Height="8" />
              <TextBlock Text="{Binding TeacherUpdateProgressText}" Classes="muted" TextWrapping="Wrap"
                         IsVisible="{Binding IsTeacherUpdateProgressVisible}" />
              <TextBlock Text="{Binding TeacherUpdateStatus}" Classes="muted" TextWrapping="Wrap" />
              <Expander Header="离线更新" IsExpanded="False">
                <StackPanel Spacing="8" Margin="0,8,0,0">
                  <TextBlock Text="安装器需与同版本清单放在一起；验证通过后再安装。" Classes="muted" TextWrapping="Wrap" />
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="导出离线更新包" Click="ExportOfflineTeacherUpdate" IsEnabled="{Binding CanExportOfflineTeacherUpdate}" />
                    <Button Content="选择并验证安装器" Click="VerifyOfflineTeacherUpdate" IsEnabled="{Binding CanVerifyOfflineTeacherUpdate}" />
                    <Button Classes="primary" Content="安装并重启" Click="InstallOfflineTeacherUpdate" IsEnabled="{Binding CanInstallOfflineTeacherUpdate}" />
                  </StackPanel>
                  <TextBlock Text="{Binding OfflineTeacherUpdateStatus}" Classes="muted" TextWrapping="Wrap" />
                </StackPanel>
              </Expander>
            </StackPanel>
          </Border>
          <Border Classes="card">
            <StackPanel Spacing="12">
              <TextBlock Text="学生 Setup 与 Agent 更新" FontSize="20" FontWeight="SemiBold" />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="首次/身份变化时核对" Click="TrustStudentAgentIdentities" IsEnabled="{Binding CanTrustStudentAgentIdentities}" />
                <Button Classes="primary" Content="检查并更新 Setup + Agent" Click="DeployStudentUpdate" IsEnabled="{Binding CanDeployStudentUpdate}" />
              </StackPanel>
              <TextBlock Text="会将 StudentSetup 和 SYSTEM Agent 更新到同一签名版本；已是最新的电脑会跳过。首次连接或身份变化时需先核对。"
                         Classes="muted" TextWrapping="Wrap" />
              <StackPanel Spacing="6">
                <TextBlock Text="{Binding StudentAgentIdentityStatus}" Classes="muted" TextWrapping="Wrap" />
                <ToggleButton Content="{Binding StudentAgentIdentityDetailsToggleText}"
                              IsChecked="{Binding ShowStudentAgentIdentityDetails, Mode=TwoWay}"
                              IsVisible="{Binding HasStudentAgentIdentityDetails}"
                              HorizontalAlignment="Left" />
                <TextBox Text="{Binding StudentAgentIdentityDetails}" IsReadOnly="True" AcceptsReturn="True"
                         TextWrapping="Wrap" Height="180" IsVisible="{Binding ShowStudentAgentIdentityDetails}" />
              </StackPanel>
              <StackPanel Spacing="6">
                <TextBlock Text="{Binding StudentUpdateStatus}" Classes="muted" TextWrapping="Wrap" />
                <StackPanel Spacing="5" IsVisible="{Binding HasStudentUpdatePerformanceReport}">
                  <Button Content="导出本次匿名性能汇总…" Click="ExportStudentUpdatePerformanceReport"
                          HorizontalAlignment="Left" />
                  <TextBlock Text="{Binding StudentUpdatePerformanceReportExportStatus}"
                             Classes="muted" TextWrapping="Wrap" />
                  <TextBlock Text="文件只含整批汇总、阶段耗时和版本分组；不含电脑名、IP 或校区身份，不会自动上传。"
                             Classes="muted" TextWrapping="Wrap" />
                </StackPanel>
                <ProgressBar Minimum="0" Maximum="100" Value="{Binding StudentUpdateProgressPercent}"
                             IsIndeterminate="{Binding StudentUpdateProgressIsIndeterminate}"
                             IsVisible="{Binding IsStudentUpdateProgressVisible}" Height="8" />
                <TextBlock Text="{Binding StudentUpdateProgressText}" Classes="muted" TextWrapping="Wrap"
                           IsVisible="{Binding IsStudentUpdateProgressVisible}" />
                <StackPanel Spacing="8" IsVisible="{Binding HasStudentUpdateTargetProgressItems}">
                  <TextBlock Text="逐台进度与结果" FontWeight="SemiBold" />
                  <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding StudentUpdateTargetProgressItems}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:StudentApplicationUpdateTargetProgressItem">
                          <Border BorderBrush="#DDE5E9" BorderThickness="1" CornerRadius="8"
                                  Padding="10" Margin="0,0,0,7" Background="#FFFFFF">
                            <StackPanel Spacing="5">
                              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="1" Text="{Binding StatusText}" Classes="muted" />
                              </Grid>
                              <ProgressBar Minimum="0" Maximum="100" Value="{Binding ProgressPercent}"
                                           IsIndeterminate="{Binding IsIndeterminate}" Height="7" />
                              <TextBlock Text="{Binding Detail}" Classes="muted" TextWrapping="Wrap"
                                         IsVisible="{Binding HasDetail}" />
                              <Expander Header="更新阶段耗时" IsVisible="{Binding HasPhaseTimings}">
                                <ItemsControl ItemsSource="{Binding PhaseTimings}">
                                  <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:StudentUpdatePhaseTimingDisplayItem">
                                      <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10" Margin="0,3,0,0">
                                        <TextBlock Text="{Binding Phase}" TextWrapping="Wrap" />
                                        <TextBlock Grid.Column="1" Text="{Binding Duration}" Classes="muted" />
                                        <TextBlock Grid.Column="2" Text="{Binding Outcome}" Classes="muted" />
                                      </Grid>
                                    </DataTemplate>
                                  </ItemsControl.ItemTemplate>
                                </ItemsControl>
                              </Expander>
                            </StackPanel>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ScrollViewer>
                </StackPanel>
              </StackPanel>
            </StackPanel>
          </Border>
        </StackPanel>
        <StackPanel IsVisible="{Binding IsClassroomExperiencePage}" Spacing="16">
          <Border Classes="card">
            <StackPanel Spacing="10">
              <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                <ComboBox ItemsSource="{Binding RoomProfiles}"
                          SelectedItem="{Binding SelectedRoomProfile, Mode=TwoWay}"
                          IsVisible="{Binding HasMultipleRoomProfiles}"
                          PlaceholderText="选择当前教室" MinWidth="220" HorizontalAlignment="Left">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="core:TeacherRoomProfile">
                      <TextBlock Text="{Binding DisplayName}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
                <Button Grid.Column="1" Classes="secondary" Content="重新读取名单"
                        Click="ReadClassroomLocations" IsEnabled="{Binding CanReadWebsiteLocations}"
                        ToolTip.Tip="重新读取当前教室的 Veyon 电脑名单。" />
                <Button Grid.Column="2" Classes="danger" Content="结束互动"
                        IsVisible="{Binding HasActiveClassroomSession}"
                        IsEnabled="{Binding CanToggleClassroomSession}" Click="ToggleClassroomSession"
                        MinWidth="128" />
                <Button Grid.Column="2" Classes="primary" Content="开始互动"
                        IsVisible="{Binding HasNoActiveClassroomSession}"
                        IsEnabled="{Binding CanToggleClassroomSession}" Click="ToggleClassroomSession"
                        MinWidth="128" />
              </Grid>
              <TextBlock Text="{Binding RoomSelectionStatus}" Classes="muted" TextWrapping="Wrap"
                         IsVisible="{Binding HasRoomSelectionStatus}" />
              <TextBlock Text="{Binding ClassroomDirectoryStatus}" Classes="muted" TextWrapping="Wrap"
                         IsVisible="{Binding HasClassroomDirectoryStatus}" />
              <TextBlock Text="{Binding ClassroomDirectoryError}" Foreground="#9C4221" TextWrapping="Wrap"
                         IsVisible="{Binding HasClassroomDirectoryError}" />
              <TextBlock Text="{Binding ClassroomDeliveryStatus}" Classes="muted" TextWrapping="Wrap"
                         IsVisible="{Binding HasClassroomDeliveryStatus}" />
              <TextBlock Text="{Binding ClassroomEventStatus}" Classes="muted" TextWrapping="Wrap"
                         IsVisible="{Binding HasActiveClassroomEventStatus}" />
            </StackPanel>
          </Border>

          <Border Classes="card">
            <StackPanel Spacing="12">
              <TextBlock Text="课堂概览" Classes="section-title" />
              <UniformGrid Columns="4">
                <Border Classes="stat-card info" Margin="0,0,8,0">
                  <Grid ColumnDefinitions="30,*" ColumnSpacing="8" VerticalAlignment="Center">
                    <Border Classes="stat-icon info">
                      <Path Classes="stat-icon-shape" Data="M3,5 L17,5 L17,15 L3,15 Z M7,19 L13,19 M10,15 L10,19" />
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                      <TextBlock Classes="stat-value" FontSize="20" Text="{Binding ClassroomOverviewSessionValue}" />
                      <TextBlock Classes="stat-label" Text="课堂状态" />
                    </StackPanel>
                  </Grid>
                </Border>
                <Border Classes="stat-card info" Margin="0,0,8,0">
                  <Grid ColumnDefinitions="30,*" ColumnSpacing="8" VerticalAlignment="Center">
                    <Border Classes="stat-icon info">
                      <Path Classes="stat-icon-shape" Data="M2,4 L18,4 L18,15 L2,15 Z M7,19 L13,19 M10,15 L10,19" />
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                      <TextBlock Classes="stat-value" Text="{Binding ClassroomOverviewDeviceCount}" />
                      <TextBlock Classes="stat-label" Text="学生电脑" />
                    </StackPanel>
                  </Grid>
                </Border>
                <Border Classes="stat-card success" Margin="0,0,8,0">
                  <Grid ColumnDefinitions="30,*" ColumnSpacing="8" VerticalAlignment="Center">
                    <Border Classes="stat-icon success">
                      <Path Classes="stat-icon-shape" Data="M4,10 L8,14 L16,5" />
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                      <TextBlock Classes="stat-value" Text="{Binding ClassroomOverviewReceiptCount}" />
                      <TextBlock Classes="stat-label" Text="已回执 / 核验" />
                    </StackPanel>
                  </Grid>
                </Border>
                <Border Classes="stat-card warning">
                  <Grid ColumnDefinitions="30,*" ColumnSpacing="8" VerticalAlignment="Center">
                    <Border Classes="stat-icon warning">
                      <Path Classes="stat-icon-shape" Data="M10,3 L18,17 L2,17 Z M10,7 L10,11 M10,14 L10,14.5" />
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                      <TextBlock Classes="stat-value" Text="{Binding ClassroomOverviewPendingCount}" />
                      <TextBlock Classes="stat-label" Text="待处理 / 核对" />
                    </StackPanel>
                  </Grid>
                </Border>
              </UniformGrid>
            </StackPanel>
          </Border>

          <Border Classes="card">
            <StackPanel Spacing="12">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <StackPanel Spacing="3">
                  <TextBlock Text="课堂快捷管控" Classes="section-title" />
                  <TextBlock Text="对本堂课全部学生电脑执行" Classes="muted" />
                </StackPanel>
                <TextBlock x:Name="ClassroomQuickControlBadge" Grid.Column="1"
                           Text="{Binding ClassroomQuickControlBadgeText}"
                           Foreground="{Binding ClassroomQuickControlBadgeBrush}" VerticalAlignment="Center" />
              </Grid>
              <Border Background="#F5F6F7" CornerRadius="10" Padding="12,10">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                  <StackPanel Spacing="3">
                    <TextBlock Text="当前网站名单" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding ClassroomQuickControlPresetSummary}" Classes="muted"
                               TextWrapping="Wrap" />
                  </StackPanel>
                  <Button Grid.Column="1" Classes="secondary" Content="管理规则"
                          Click="OpenQuickControlWebsitePolicy" VerticalAlignment="Center" />
                </Grid>
              </Border>
              <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                <Button x:Name="EnableClassroomWebsiteControlButton" Classes="quick-control-choice"
                        Height="96" Click="EnableClassroomWebsiteControl"
                        IsEnabled="{Binding CanStartClassroomQuickControl}">
                  <Grid ColumnDefinitions="44,*" ColumnSpacing="12" HorizontalAlignment="Left">
                    <Border Width="42" Height="42" CornerRadius="12" Background="#E1F3EA"
                            VerticalAlignment="Center">
                      <Path Data="M19,5 L12,2 L5,5 L5,11 C5,16 8,20 12,22 C16,20 19,16 19,11 Z"
                            Width="23" Height="23" Stretch="Uniform" Fill="Transparent"
                            Stroke="#16803C" StrokeThickness="1.8" HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                      <TextBlock Text="启用网站限制" FontWeight="SemiBold" />
                      <TextBlock Text="使用已保存的网站名单" Classes="muted" FontSize="11"
                                 TextWrapping="Wrap" />
                    </StackPanel>
                  </Grid>
                </Button>
                <Button x:Name="LockClassroomInputButton" Grid.Column="1" Classes="quick-control-choice"
                        Height="96" Click="LockClassroomInput"
                        IsEnabled="{Binding CanStartClassroomQuickControl}">
                  <Grid ColumnDefinitions="44,*" ColumnSpacing="12" HorizontalAlignment="Left">
                    <Border Width="42" Height="42" CornerRadius="12" Background="#EAF1F5"
                            VerticalAlignment="Center">
                      <Path Data="M6,3 L19,14 L12.5,15 L9.5,21 Z" Width="23" Height="23"
                            Stretch="Uniform" Fill="Transparent" Stroke="#53636D"
                            StrokeThickness="1.8" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                      <TextBlock Text="锁定键盘与鼠标" FontWeight="SemiBold" />
                      <TextBlock Text="短时锁定，断线后自动释放" Classes="muted" FontSize="11"
                                 TextWrapping="Wrap" />
                    </StackPanel>
                  </Grid>
                </Button>
              </Grid>
              <Border Background="#F5F6F7" CornerRadius="10" Padding="12,9">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                  <StackPanel Spacing="3" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ClassroomQuickControlSelectionSummary}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding ClassroomQuickControlProgressSummary}" Classes="muted"
                               TextWrapping="Wrap" />
                  </StackPanel>
                  <Button x:Name="ReleaseClassroomQuickControlButton" Grid.Column="1"
                          Classes="secondary" Content="解除课堂管控" Click="ReleaseClassroomQuickControl"
                          IsEnabled="{Binding CanReleaseClassroomQuickControl}"
                          VerticalAlignment="Center"
                          ToolTip.Tip="仅解除本工具持有且能验证归属的课堂管控。" />
                </Grid>
              </Border>
              <Expander Header="{Binding ClassroomQuickControlProgressHeader}" IsExpanded="True"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                        IsVisible="{Binding HasClassroomQuickControlDevices}">
                <ScrollViewer MaxHeight="210" HorizontalAlignment="Stretch" VerticalScrollBarVisibility="Auto">
                  <ItemsControl ItemsSource="{Binding ClassroomQuickControlDevices}"
                                HorizontalAlignment="Stretch">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:TeacherClassroomQuickControlDeviceItem">
                        <Border BorderBrush="#E3E8ED" BorderThickness="0,0,0,1">
                          <Expander IsExpanded="{Binding IsExpanded, Mode=TwoWay}"
                                    HorizontalAlignment="Stretch">
                            <Expander.Header>
                              <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10" MinHeight="42">
                                <TextBlock Classes="device-row-name" Text="{Binding DisplayName}"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <Border Grid.Column="1" Background="{Binding StatusBackground}"
                                        CornerRadius="8" Padding="8,4" VerticalAlignment="Center">
                                  <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusBrush}"
                                             FontSize="12" FontWeight="SemiBold" />
                                </Border>
                                <TextBlock Grid.Column="2" Classes="device-row-detail" Text="{Binding UpdatedText}"
                                           VerticalAlignment="Center" />
                              </Grid>
                            </Expander.Header>
                            <TextBlock Text="{Binding Detail}" Classes="device-row-detail"
                                       TextWrapping="Wrap" Margin="12,0,12,10" />
                          </Expander>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </Expander>
              <Border Classes="empty-state" Padding="12" IsVisible="{Binding HasNoClassroomQuickControlDevices}">
                <TextBlock Text="{Binding ClassroomQuickControlProgressSummary}" Classes="muted"
                           TextWrapping="Wrap" />
              </Border>
            </StackPanel>
          </Border>

          <Border Classes="card" IsVisible="{Binding HasActiveClassroomSession}">
            <StackPanel Spacing="12">
              <TextBlock Text="学生一对一聊天" FontSize="17" FontWeight="SemiBold" />
              <ComboBox ItemsSource="{Binding ClassroomChatThreads}"
                        SelectedItem="{Binding SelectedClassroomChatThread, Mode=TwoWay}"
                        PlaceholderText="选择学生" SelectionChanged="ClassroomChatThreadSelectionChanged">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:TeacherClassroomChatThread">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16" MinWidth="360">
                      <StackPanel Spacing="2">
                        <TextBlock Text="{Binding DisplayTitle}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Detail}" Classes="muted" FontSize="11"
                                   IsVisible="{Binding HasDetail}" />
                      </StackPanel>
                      <TextBlock Grid.Column="1" Text="{Binding CapabilityStatus}" Classes="muted"
                                 VerticalAlignment="Center" />
                    </Grid>
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <Border Padding="12" CornerRadius="10" Background="#F4F7F9" MinHeight="170">
                <ScrollViewer Name="TeacherChatHistoryScroller" Height="190"
                              VerticalScrollBarVisibility="Auto">
                  <ItemsControl ItemsSource="{Binding SelectedClassroomChatMessages}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:TeacherClassroomChatMessageItem">
                        <Border Padding="8" CornerRadius="8" Background="#FFFFFF" Margin="0,0,0,7">
                          <StackPanel Spacing="4">
                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                              <TextBlock Text="{Binding Speaker}" FontWeight="SemiBold" />
                              <TextBlock Grid.Column="1" Text="{Binding EventTime}" Classes="muted" />
                              <TextBlock Grid.Column="2" Text="{Binding DeliveryStatus}" Classes="muted"
                                         IsVisible="{Binding HasDeliveryStatus}" />
                            </Grid>
                            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
                            <Button Content="重试" IsVisible="{Binding CanRetry}"
                                    HorizontalAlignment="Right" Padding="10,4"
                                    Click="RetryClassroomChatMessage" />
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </Border>
              <TextBox x:Name="ClassroomChatDraftInput" Text="{Binding ClassroomChatDraft, Mode=TwoWay}" AcceptsReturn="True"
                       TextWrapping="Wrap" Height="72" MaxLength="500" PlaceholderText="输入消息" />
              <TextBlock Text="Enter 发送 · Shift+Enter 换行" Classes="muted" FontSize="10" />
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <TextBlock Text="{Binding ClassroomChatStatus}" Classes="muted" TextWrapping="Wrap"
                           IsVisible="{Binding HasClassroomChatStatus}" VerticalAlignment="Center" />
                <Button Grid.Column="1" Classes="primary" Content="发送给该学生"
                        IsEnabled="{Binding CanSendClassroomChat}" Click="SendClassroomChatMessage" />
              </Grid>
            </StackPanel>
          </Border>

          <Border Classes="card" IsVisible="{Binding HasClassroomEventItems}">
            <StackPanel Spacing="10">
              <TextBlock Text="学生消息" FontSize="17" FontWeight="SemiBold" />
              <ScrollViewer Height="300" VerticalScrollBarVisibility="Auto">
              <ItemsControl ItemsSource="{Binding ClassroomEventItems}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:TeacherClassroomEventItem">
                    <Border Padding="12" CornerRadius="10" Background="#F4F7F9" Margin="0,0,0,8">
                      <StackPanel Spacing="6">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                          <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                          <TextBlock Grid.Column="1" Text="{Binding Status}" Classes="muted"
                                     VerticalAlignment="Center" />
                        </Grid>
                        <TextBlock Text="{Binding SeatLocation}" Classes="muted" IsVisible="{Binding HasSeatLocation}" />
                        <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding EventTime}" Classes="muted" />
                        <TextBox Text="{Binding ReplyMessage, Mode=TwoWay}" IsVisible="{Binding CanReply}"
                                 MaxLength="500" PlaceholderText="回复学生" />
                        <Button Content="发送回复" IsVisible="{Binding CanReply}" IsEnabled="{Binding CanReply}"
                                Click="ReplyToClassroomEvent" HorizontalAlignment="Right" />
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              </ScrollViewer>
            </StackPanel>
          </Border>
          <Border Classes="card" IsVisible="{Binding HasClassroomRestores}">
            <StackPanel Spacing="10">
              <TextBlock Text="待恢复学生策略" FontSize="17" FontWeight="SemiBold" />
              <ScrollViewer MaxHeight="190" VerticalScrollBarVisibility="Auto">
                <TextBlock Text="{Binding ClassroomRestoreSummary}" Classes="muted" TextWrapping="Wrap" />
              </ScrollViewer>
              <Button Classes="primary" Content="重试恢复"
                      IsVisible="{Binding HasPendingClassroomRestoreItems}"
                      IsEnabled="{Binding CanRetryClassroomRestores}" Click="RetryClassroomRestores" />
            </StackPanel>
          </Border>
          <Border Classes="card" IsVisible="{Binding HasActiveClassroomSession}">
            <StackPanel Spacing="8">
              <TextBlock Text="学生通知" FontSize="17" FontWeight="SemiBold" />
              <TextBlock Text="在线学生电脑会弹出通知；2 分钟后失效。"
                         Classes="muted" TextWrapping="Wrap" />
              <TextBox Text="{Binding ClassroomNoticeDraft, Mode=TwoWay}" AcceptsReturn="True"
                       TextWrapping="Wrap" Height="78" MaxLength="500" PlaceholderText="输入通知内容" />
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <TextBlock Text="{Binding ClassroomNoticeStatus}" Classes="muted"
                           IsVisible="{Binding HasClassroomNoticeStatus}" TextWrapping="Wrap"
                           VerticalAlignment="Center" />
                <Button Grid.Column="1" Classes="primary" Content="发送通知"
                        IsEnabled="{Binding CanSendClassroomNotice}" Click="SendClassroomNotice" />
              </Grid>
            </StackPanel>
          </Border>

        </StackPanel>
        <StackPanel IsVisible="{Binding IsHealthCenterPage}" Spacing="16">
          <Border Classes="card">
            <StackPanel Spacing="12">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                <StackPanel Spacing="4">
                  <TextBlock Text="设备状态概览" Classes="section-title" />
                </StackPanel>
                <Button Grid.Column="1" Classes="primary" Content="读取完整诊断"
                        ToolTip.Tip="手动读取详细 v4 健康快照；轻量设备状态会在此页自动更新。"
                        Click="ReadStudentDeviceHealth" IsEnabled="{Binding CanReadDeviceHealth}"
                        VerticalAlignment="Center" />
              </Grid>
              <UniformGrid Columns="5">
                <Border Classes="stat-card success" Margin="0,0,8,0">
                  <Grid ColumnDefinitions="30,*" ColumnSpacing="8" VerticalAlignment="Center">
                    <Border Classes="stat-icon success">
                      <Path Classes="stat-icon-shape" Data="M4,10 L8,14 L16,5" />
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                      <TextBlock Classes="stat-value" Text="{Binding DeviceHealthHealthyCount}" />
                      <TextBlock Classes="stat-label" Text="正常" />
                    </StackPanel>
                  </Grid>
                </Border>
                <Border Classes="stat-card warning" Margin="0,0,8,0">
                  <Grid ColumnDefinitions="30,*" ColumnSpacing="8" VerticalAlignment="Center">
                    <Border Classes="stat-icon warning">
                      <Path Classes="stat-icon-shape" Data="M10,3 L18,17 L2,17 Z M10,7 L10,11 M10,14 L10,14.5" />
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                      <TextBlock Classes="stat-value" Text="{Binding DeviceHealthAttentionCount}" />
                      <TextBlock Classes="stat-label" Text="需关注" />
                    </StackPanel>
                  </Grid>
                </Border>
                <Border Classes="stat-card danger" Margin="0,0,8,0">
                  <Grid ColumnDefinitions="30,*" ColumnSpacing="8" VerticalAlignment="Center">
                    <Border Classes="stat-icon danger">
                      <Path Classes="stat-icon-shape" Data="M4,4 L16,16 M16,4 L4,16" />
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                      <TextBlock Classes="stat-value" Text="{Binding DeviceHealthManualReviewCount}" />
                      <TextBlock Classes="stat-label" Text="需人工处理" />
                    </StackPanel>
                  </Grid>
                </Border>
                <Border Classes="stat-card unknown">
                  <Grid ColumnDefinitions="30,*" ColumnSpacing="8" VerticalAlignment="Center">
                    <Border Classes="stat-icon unknown">
                      <Path Classes="stat-icon-shape" Data="M10,4 L10,10 M10,14 L10,14.5" />
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                      <TextBlock Classes="stat-value" Text="{Binding DeviceHealthNoResponseCount}" />
                      <TextBlock Classes="stat-label" Text="未收到回执" />
                    </StackPanel>
                  </Grid>
                </Border>
                <Border Classes="stat-card unknown" Margin="8,0,0,0">
                  <Grid ColumnDefinitions="30,*" ColumnSpacing="8" VerticalAlignment="Center">
                    <Border Classes="stat-icon unknown">
                      <Path Classes="stat-icon-shape" Data="M5,3 L15,3 L15,6 L10,10 L15,14 L15,17 L5,17 L5,14 L10,10 L5,6 Z" />
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                      <TextBlock Classes="stat-value" Text="{Binding DeviceHealthPendingCount}" />
                      <TextBlock Classes="stat-label" Text="等待读取" />
                    </StackPanel>
                  </Grid>
                </Border>
              </UniformGrid>
              <TextBlock Text="轻量状态每 5 秒轮询一批；异常请求会自动退避。完整诊断仅在点击按钮后读取。"
                         Classes="muted" FontSize="11" TextWrapping="Wrap" />
              <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsPollingDeviceRuntimeSummary}"
                           Height="4" />
              <TextBlock Text="{Binding DeviceRuntimeSummaryStatus}" Classes="muted" TextWrapping="Wrap" />
              <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsReadingDeviceHealth}" Height="6" />
              <TextBlock Text="{Binding DeviceHealthStatus}" Classes="muted" TextWrapping="Wrap" />
              <TextBlock Text="{Binding DeviceHealthCacheStatus}" Classes="muted" TextWrapping="Wrap" />
              <TextBlock Text="“未收到回执”表示连接或身份尚未确认，不代表电脑已关机。"
                         Classes="muted" FontSize="11" TextWrapping="Wrap" />
              <TextBlock Text="学生姓名以本软件名单为准；Veyon 电脑名用于定位设备。读取地点时会按已保存关联、电脑编号和电脑名匹配；后续新增电脑从已有最大编号继续分配。"
                         Classes="muted" FontSize="11" TextWrapping="Wrap" />
              <TextBlock Text="{Binding DeviceHealthBatchPreview}" Classes="muted" TextWrapping="Wrap" />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="批量确保 Veyon 服务运行" Click="EnsureSelectedVeyonServicesRunning"
                        IsEnabled="{Binding CanBatchEnsureVeyonServiceRunning}" />
                <Button Content="批量排入 Edge 策略刷新" Click="RefreshSelectedLegacyEdgePolicies"
                        IsEnabled="{Binding CanBatchRefreshLegacyEdgePolicy}" />
                <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsRunningDeviceHealthBatch}"
                             Width="96" Height="6" VerticalAlignment="Center" />
              </StackPanel>
              <TextBlock Text="{Binding DeviceHealthBatchStatus}" Classes="muted" TextWrapping="Wrap" />
              <Border IsVisible="{Binding HasDeviceHealthAlerts}" Background="#FBFCFD"
                      BorderBrush="#D8E0E3" BorderThickness="1" CornerRadius="8" Padding="12">
                <StackPanel Spacing="8">
                  <StackPanel Spacing="3">
                    <TextBlock Text="需要处理" FontSize="17" FontWeight="SemiBold" />
                    <TextBlock Text="异常按类型归并；打开诊断可查看详情和安全操作。"
                               Classes="muted" FontSize="11" TextWrapping="Wrap" />
                  </StackPanel>
                  <ItemsControl ItemsSource="{Binding DeviceHealthAlerts}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:TeacherDeviceHealthAlert">
                        <Border BorderBrush="#D8E0E3" BorderThickness="0,1,0,0" Padding="0,8,0,4">
                          <StackPanel Spacing="6">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                              <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding AffectedCountSummary}" Classes="muted" />
                              </StackPanel>
                                <Border Grid.Column="1" Background="{Binding SeverityBackground}"
                                        CornerRadius="8" Padding="8,3" VerticalAlignment="Center">
                                  <TextBlock Text="{Binding SeverityLabel}" Foreground="{Binding SeverityForeground}"
                                             FontWeight="SemiBold" />
                                </Border>
                            </Grid>
                            <TextBlock Text="{Binding AffectedTargets}" Classes="muted"
                                       TextWrapping="Wrap" />
                            <WrapPanel>
                              <Button Content="{Binding AcknowledgementLabel}" Click="AcknowledgeDeviceHealthAlert"
                                      IsEnabled="{Binding CanAcknowledge}" Margin="0,0,8,4" />
                              <Button Content="重新检测" Click="RecheckDeviceHealthAlert"
                                      IsEnabled="{Binding CanRecheck}" Margin="0,0,8,4" />
                              <Button Content="查看设备" Click="FocusDeviceHealthAlert"
                                      Margin="0,0,8,4" />
                              <Button Content="尝试可用修复" Click="RepairDeviceHealthAlert"
                                      IsEnabled="{Binding CanAttemptRepair}" Margin="0,0,8,4" />
                            </WrapPanel>
                            <Expander Header="诊断详情" HorizontalAlignment="Stretch">
                              <StackPanel Spacing="4" Margin="0,6,0,0">
                                <TextBlock Text="{Binding SeenSummary}" Classes="muted" FontSize="11" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Diagnostics}" Classes="muted" TextWrapping="Wrap" />
                              </StackPanel>
                            </Expander>
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>
            </StackPanel>
          </Border>

          <Border Classes="card">
            <StackPanel Spacing="10">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <TextBlock Text="学生电脑" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding DeviceHealthListSummary}" Classes="muted"
                           VerticalAlignment="Center" />
              </Grid>
              <Grid ColumnDefinitions="*,220" ColumnSpacing="10">
                <TextBox Text="{Binding DeviceHealthSearchText, Mode=TwoWay}"
                         PlaceholderText="搜索学生姓名、状态或异常原因" />
                <ComboBox Grid.Column="1" ItemsSource="{Binding DeviceHealthCategoryFilters}"
                          SelectedIndex="{Binding DeviceHealthCategoryFilterIndex, Mode=TwoWay}" />
              </Grid>
              <TextBlock Text="启动 Veyon 服务可恢复教师端屏幕监看或控制；同步 Edge 网站策略可重新应用当前有效的网站限制。设备状态未确认时，这些操作会保持禁用。"
                         Classes="muted" FontSize="11" TextWrapping="Wrap" />
              <TextBlock Text="打开此页后，所选电脑会自动出现在列表；状态未知时会明确显示为未知。"
                         Classes="muted"
                         IsVisible="{Binding !HasDeviceHealthRows}" />
              <TextBlock Text="没有符合条件的电脑，请调整搜索内容或状态筛选。" Classes="muted"
                         IsVisible="{Binding HasDeviceHealthFilterEmpty}" />
              <ListBox x:Name="DeviceHealthRowsList" ItemsSource="{Binding DeviceHealthPageRows}" Height="430"
                       IsVisible="{Binding HasDeviceHealthFilteredRows}">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:TeacherDeviceHealthRow">
                    <Border BorderBrush="#DDE5E9" BorderThickness="0,0,0,1" Background="#FFFFFF"
                            Padding="10,8">
                      <StackPanel Spacing="7">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                          <TextBlock Text="{Binding IdentitySummary}" FontWeight="SemiBold" FontSize="12"
                                     TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding IdentitySummary}"
                                     VerticalAlignment="Center" />
                          <Border Grid.Column="1" Background="{Binding CategoryBackground}" CornerRadius="8"
                                  Padding="8,3" VerticalAlignment="Center">
                            <TextBlock Text="{Binding CategoryLabel}" Foreground="{Binding CategoryForeground}"
                                       FontWeight="SemiBold" FontSize="12" />
                          </Border>
                        </Grid>
                        <TextBlock Text="{Binding CompactSummary}" Classes="muted" FontSize="11"
                                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                        <TextBlock Text="{Binding InputGuardSummary}" Foreground="{Binding InputGuardForeground}"
                                   FontSize="11" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                        <WrapPanel>
                          <Button Content="启动 Veyon 服务" Click="EnsureVeyonServiceRunning"
                                  IsEnabled="{Binding CanEnsureVeyonServiceRunning}"
                                  ToolTip.Tip="启动学生电脑上的 Veyon 服务，用于恢复教师端屏幕监看或控制。仅在设备回执确认服务可安全启动时启用。"
                                  Margin="0,0,8,0" />
                          <Button Content="同步 Edge 网站策略" Click="RefreshLegacyEdgePolicy"
                                  IsEnabled="{Binding CanRefreshLegacyEdgePolicy}"
                                  ToolTip.Tip="重新应用当前有效的网站限制。仅支持已确认使用旧版注册表模式且策略有效的设备。"
                                  Margin="0,0,8,0" />
                        </WrapPanel>
                        <Expander Header="详情" HorizontalAlignment="Stretch">
                          <StackPanel Spacing="4" Margin="0,6,0,0">
                            <TextBlock Text="{Binding AgentSummary}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding ServiceSummary}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding PolicySummary}" Classes="muted" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding UpdateSummary}" Classes="muted" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding CollectedText}" Classes="muted" FontSize="11" />
                            <TextBlock Text="{Binding Detail}" Foreground="#9C4221" TextWrapping="Wrap"
                                       IsVisible="{Binding HasDetail}" />
                            <TextBlock Text="{Binding BatchOperationStatus}" Classes="muted" TextWrapping="Wrap"
                                       IsVisible="{Binding HasBatchOperationStatus}" />
                            <TextBlock Text="{Binding RepairStatus}" Classes="muted" TextWrapping="Wrap"
                                       IsVisible="{Binding HasRepairStatus}" />
                          </StackPanel>
                        </Expander>
                        <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsRepairing}"
                                     Width="96" Height="5" HorizontalAlignment="Left" />
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" HorizontalAlignment="Right">
                <Button Content="上一页" Click="PreviousDeviceHealthPage"
                        IsEnabled="{Binding CanPreviousDeviceHealthPage}" />
                <TextBlock Grid.Column="1" Text="{Binding DeviceHealthPageLabel}" Classes="muted"
                           VerticalAlignment="Center" Margin="6,0" />
                <Button Grid.Column="2" Content="下一页" Click="NextDeviceHealthPage"
                        IsEnabled="{Binding CanNextDeviceHealthPage}" />
              </Grid>
            </StackPanel>
          </Border>
        </StackPanel>
        <StackPanel IsVisible="{Binding IsClassroomPage}" Spacing="20">
          <Border Classes="card" IsVisible="{Binding IsWebsitePolicyPage}">
            <StackPanel Spacing="16">
              <TextBlock Text="学生策略与目标电脑" FontSize="20" FontWeight="SemiBold" />
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <StackPanel Spacing="8">
                  <TextBlock Text="校区" FontWeight="SemiBold" />
                  <ComboBox ItemsSource="{Binding WebsiteSigningCampuses}"
                            SelectedItem="{Binding SelectedWebsiteSigningCampus, Mode=TwoWay}"
                            Text="{Binding CampusId, Mode=TwoWay}" IsEditable="True" IsEnabled="{Binding !IsExecuting}"
                            PlaceholderText="选择已有校区或输入名称" />
                </StackPanel>
                <Button Grid.Column="1" Content="从 Veyon 读取电脑" Click="FillWebsiteTargets"
                        IsEnabled="{Binding CanReadWebsiteLocations}" VerticalAlignment="Bottom" />
              </Grid>
              <StackPanel IsVisible="{Binding HasMultipleWebsiteLocations}" Spacing="8">
                <TextBlock Text="选择地点并填入电脑名单：" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                  <ComboBox ItemsSource="{Binding WebsiteLocationChoices}"
                            SelectedIndex="{Binding WebsiteLocationIndex, Mode=TwoWay}" />
                  <Button Grid.Column="1" Content="填入所选电脑" Click="FillSelectedWebsiteLocation"
                          IsEnabled="{Binding CanApplyWebsiteLocation}" />
                </Grid>
              </StackPanel>
              <TextBlock Text="{Binding WebsiteDirectoryStatus}" Classes="muted"
                         IsVisible="{Binding HasWebsiteDirectoryStatus}" TextWrapping="Wrap" />
              <TextBlock Text="{Binding WebsiteDirectoryError}" Foreground="#9C4221"
                         IsVisible="{Binding HasWebsiteDirectoryError}" TextWrapping="Wrap" />
              <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                <TextBlock Text="{Binding WebsitePolicyTargetSelectionSummary}" Classes="muted"
                           VerticalAlignment="Center" />
                <Button Grid.Column="1" Content="全选" Click="SelectAllWebsitePolicyTargets" IsEnabled="{Binding !IsExecuting}" />
                <Button Grid.Column="2" Content="清空" Click="ClearWebsitePolicyTargets" IsEnabled="{Binding !IsExecuting}" />
              </Grid>
              <ScrollViewer MaxHeight="170" VerticalScrollBarVisibility="Auto" IsEnabled="{Binding !IsExecuting}">
                <ItemsControl ItemsSource="{Binding WebsitePolicyTargetChoices}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <UniformGrid Columns="4" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:TeacherPolicyTargetChoice">
                      <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" Margin="0,2">
                        <TextBlock Text="{Binding StudentName}" FontWeight="SemiBold" />
                      </CheckBox>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
              <Expander Header="手动修改电脑名单">
                <TextBox Text="{Binding WebsiteTargets, Mode=TwoWay}" AcceptsReturn="True" IsEnabled="{Binding !IsExecuting}"
                         TextWrapping="Wrap" Height="80" PlaceholderText="每行一台电脑名称或地址" />
              </Expander>
              <Button Content="核对学生电脑身份" IsEnabled="{Binding CanTrustStudentAgentIdentities}"
                      Click="TrustStudentAgentIdentities" HorizontalAlignment="Left" />
              <StackPanel Spacing="6">
                <TextBlock Text="{Binding StudentAgentIdentityStatus}" Classes="muted" TextWrapping="Wrap" />
                <ToggleButton Content="{Binding StudentAgentIdentityDetailsToggleText}"
                              IsChecked="{Binding ShowStudentAgentIdentityDetails, Mode=TwoWay}"
                              IsVisible="{Binding HasStudentAgentIdentityDetails}"
                              HorizontalAlignment="Left" />
                <TextBox Text="{Binding StudentAgentIdentityDetails}" IsReadOnly="True" AcceptsReturn="True"
                         TextWrapping="Wrap" Height="140" IsVisible="{Binding ShowStudentAgentIdentityDetails}" />
              </StackPanel>
              <Border Height="1" Background="#DDE5E9" />
              <TextBlock Text="学生代理" FontSize="17" FontWeight="SemiBold" />
              <TextBlock Text="Edge 实时同步启用后，可在这里读取逐台名单和扩展状态。"
                         Classes="muted" TextWrapping="Wrap" />
              <StackPanel Spacing="8">
                <Grid ColumnDefinitions="*,12,*,12,280" ColumnSpacing="0">
                  <StackPanel Spacing="8">
                    <TextBlock Text="要阻止的网站" FontWeight="SemiBold" />
                    <Button Content="导入常见娱乐网站" IsEnabled="{Binding CanImportCommonWebsiteBlacklist}"
                            Click="ImportCommonWebsiteBlacklist" HorizontalAlignment="Left" />
                    <TextBox Text="{Binding WebsiteBlockDomains, Mode=TwoWay}" AcceptsReturn="True"
                             TextWrapping="Wrap" Height="120" PlaceholderText="每行一个域名" />
                  </StackPanel>
                  <StackPanel Grid.Column="2" Spacing="8">
                    <TextBlock Text="允许的网站" FontWeight="SemiBold" />
                    <Button Content="导入学习网站" IsEnabled="{Binding CanImportCommonWebsiteAllowlist}"
                            Click="ImportCommonWebsiteAllowlist" HorizontalAlignment="Left" />
                    <TextBox Text="{Binding WebsiteAllowDomains, Mode=TwoWay}" AcceptsReturn="True"
                             TextWrapping="Wrap" Height="120" PlaceholderText="每行一个域名" />
                  </StackPanel>
                  <StackPanel Grid.Column="4" Spacing="8">
                    <TextBlock Text="限制截止时间" FontWeight="SemiBold" />
                    <DatePicker SelectedDate="{Binding WebsiteDeadlineDate, Mode=TwoWay}" />
                    <TimePicker SelectedTime="{Binding WebsiteDeadlineTime, Mode=TwoWay}" />
                    <TextBlock Text="{Binding WebsiteModeGuidance}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
                  </StackPanel>
                </Grid>
                <TextBlock Text="{Binding WebsitePolicyDraftStatus}" Classes="muted" TextWrapping="Wrap" />
                <Border Classes="status-panel info" Padding="12">
                  <StackPanel Spacing="8">
                    <TextBlock Text="从浏览器地址添加" FontWeight="SemiBold" />
                    <TextBox Text="{Binding WebsiteObservedAddress, Mode=TwoWay}"
                             PlaceholderText="粘贴网址或域名" />
                    <TextBlock Text="详细网址会保存在此电脑；当前浏览器名单按域名及其子域名匹配。"
                               Classes="muted" TextWrapping="Wrap" />
                    <WrapPanel Orientation="Horizontal">
                      <Button Content="加入阻止列表" IsEnabled="{Binding CanAddObservedWebsite}"
                              Click="AddObservedWebsiteToBlacklist" Margin="0,0,8,8" />
                      <Button Content="加入允许列表" IsEnabled="{Binding CanAddObservedWebsite}"
                              Click="AddObservedWebsiteToAllowlist" Margin="0,0,8,8" />
                    </WrapPanel>
                    <TextBlock Text="{Binding WebsiteEntryStatus}" Foreground="#246356"
                               IsVisible="{Binding HasWebsiteEntryStatus}" TextWrapping="Wrap" />
                  </StackPanel>
                </Border>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Classes="primary" Content="应用限制" IsEnabled="{Binding CanPushWebsitePolicy}" Click="PushWebsitePolicy" />
                  <Button Content="解除限制" IsEnabled="{Binding CanDisableWebsitePolicy}" Click="DisableWebsitePolicy" />
                  <Button Content="读取逐台状态" IsEnabled="{Binding CanReadWebsitePolicyStatus}" Click="ReadWebsitePolicyStatus" />
                  <Button Content="{Binding EdgeRealtimeMigrationButtonLabel}" IsVisible="{Binding CanMigrateEdgeRealtime}" Click="MigrateEdgeRealtime" />
                  <Button Content="恢复 Edge 注册表策略" IsVisible="{Binding CanMigrateEdgeRealtime}" Click="RestoreEdgeLegacy" />
                  <Button Content="重试失败设备" IsVisible="{Binding CanFillFailedWebsiteTargets}" Click="FillFailedWebsiteTargets" />
                </StackPanel>
                <TextBlock Text="试用版不会自动加载 Edge 扩展。请在学生机每个实际使用的 Edge 配置中手动加载扩展，Edge 打开后先读取状态；所有 Profile 显示“已读回应用”后再启用实时同步。"
                           Classes="muted" IsVisible="{Binding IsEdgeRealtimePilotBuild}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding WebsitePolicyHistoryText}" Classes="muted" IsVisible="{Binding HasWebsitePolicyHistory}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding WebsitePolicyError}" Foreground="#9C4221" IsVisible="{Binding HasWebsitePolicyError}" TextWrapping="Wrap" />
                <StackPanel IsVisible="{Binding HasWebsitePolicyResult}" Spacing="6">
                  <TextBlock Text="{Binding WebsitePolicyResult}" Foreground="#246356" TextWrapping="Wrap" />
                  <ToggleButton Content="{Binding WebsitePolicyDetailsToggleText}"
                                IsChecked="{Binding ShowWebsitePolicyResultDetails, Mode=TwoWay}"
                                IsEnabled="{Binding HasWebsitePolicyResultDetails}" HorizontalAlignment="Left" />
                  <TextBox Text="{Binding WebsitePolicyResultDetails}" IsReadOnly="True" AcceptsReturn="True"
                           TextWrapping="Wrap" Height="180" IsVisible="{Binding ShowWebsitePolicyResultDetails}" />
                </StackPanel>
              </StackPanel>
            </StackPanel>
          </Border>
          <Border Classes="card" IsVisible="{Binding IsApplicationPolicyPage}">
            <StackPanel Spacing="12">
              <TextBlock Text="学生应用限制" FontSize="20" FontWeight="SemiBold" />
              <TextBlock Text="正式机房启用前请先在可还原的测试机完成验证；禁用软件前，请先检查影响并阅读结果。"
                         Classes="muted" TextWrapping="Wrap" />
              <Border Classes="status-panel info" Padding="12">
                <StackPanel Spacing="7">
                  <TextBlock Text="长期软件运行保护不需要先扫描软件目录" FontWeight="SemiBold" />
                  <TextBlock Text="在系统限制中选择学生账户并开启长期软件运行保护；Student Agent 会先做系统与目录安全检查，再逐台应用并签名确认结果。AppLocker 仅管桌面 EXE；Appx 保留签名应用放行，MSI/Script 集合不由 AppLocker 修改。"
                             Classes="muted" TextWrapping="Wrap" />
                  <Button Content="配置长期软件运行保护" Click="OpenLongTermSoftwareProtection"
                          IsEnabled="{Binding !IsExecuting}" HorizontalAlignment="Left" />
                </StackPanel>
              </Border>
              <Border Background="#EEF3F5" CornerRadius="12" Padding="4" HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal" Spacing="3">
                  <RadioButton Classes="policy-tab" GroupName="ApplicationSteps" Content="1 账户" IsChecked="{Binding IsApplicationAccountsStep, Mode=TwoWay}" />
                  <RadioButton Classes="policy-tab" GroupName="ApplicationSteps" Content="2 软件" IsChecked="{Binding IsApplicationSoftwareStep, Mode=TwoWay}" />
                  <RadioButton Classes="policy-tab" GroupName="ApplicationSteps" Content="3 应用" IsChecked="{Binding IsApplicationApplyStep, Mode=TwoWay}" />
                </StackPanel>
              </Border>
              <StackPanel IsVisible="{Binding IsApplicationAccountsStep}" Spacing="10">
                <TextBlock Text="先勾选确实需要限制的学生账户。可按电脑名和账户名逐项选择。" Classes="muted" TextWrapping="Wrap" />
                <Button Content="读取目标电脑账户" IsEnabled="{Binding CanReadApplicationInventory}" Click="ReadStudentAccounts" HorizontalAlignment="Left" />
                <TextBlock Text="{Binding StudentAccountsStatus}" Classes="muted" IsVisible="{Binding HasStudentAccountsStatus}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding StudentAccountSelectionSummary}" Classes="muted" IsVisible="{Binding HasStudentAccountChoices}" TextWrapping="Wrap" />
                <WrapPanel IsVisible="{Binding HasStudentAccountChoices}">
                  <Button Content="全选已读取账户" Click="SelectAllStudentAccounts" IsEnabled="{Binding !IsExecuting}" Margin="0,0,8,6" />
                  <Button Content="清空选择" Click="ClearStudentAccountSelection" IsEnabled="{Binding !IsExecuting}" Margin="0,0,8,6" />
                </WrapPanel>
                <ScrollViewer Height="230" IsVisible="{Binding HasStudentAccountChoices}" IsEnabled="{Binding !IsExecuting}">
                  <ItemsControl ItemsSource="{Binding StudentAccountChoices}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border Padding="8" Margin="0,0,0,6" BorderBrush="#D8DFE8" BorderThickness="1" CornerRadius="6">
                          <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}">
                            <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" />
                          </CheckBox>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </StackPanel>
              <StackPanel IsVisible="{Binding IsApplicationSoftwareStep}" Spacing="10">
                <TextBlock Text="精确封禁只检查你勾选的产品：先读取轻量目录，再为选中条目生成发布者/哈希候选。"
                           Classes="muted" TextWrapping="Wrap" />
                <Button Content="快速读取所选电脑的软件目录" IsEnabled="{Binding CanReadApplicationInventory}"
                        Click="ReadApplicationCatalog" HorizontalAlignment="Left" />
                <TextBlock Text="{Binding ApplicationCatalogStatus}" Classes="muted"
                           IsVisible="{Binding HasApplicationCatalogStatus}" TextWrapping="Wrap" />
                <Expander Header="查看目录读取问题" IsVisible="{Binding HasApplicationCatalogFailureDetails}">
                  <TextBlock Text="{Binding ApplicationCatalogFailureDetails}" Classes="muted"
                             TextWrapping="Wrap" Margin="4,0,4,8" />
                </Expander>
                <TextBox Text="{Binding ApplicationCatalogSearch, Mode=TwoWay}" PlaceholderText="按软件产品、公司或程序名搜索" />
                <TextBlock Text="{Binding ApplicationCatalogSelectionSummary}" Classes="muted" TextWrapping="Wrap" />
                <ScrollViewer Height="250" IsVisible="{Binding HasApplicationCatalogChoices}" IsEnabled="{Binding !IsExecuting}">
                  <ItemsControl ItemsSource="{Binding ApplicationCatalogChoices}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border Padding="9" Margin="0,0,0,6" BorderBrush="#D8DFE8" BorderThickness="1" CornerRadius="6">
                          <StackPanel Spacing="4">
                            <CheckBox Content="{Binding Summary}" IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                            <TextBlock Text="{Binding Details}" Classes="muted" FontSize="11" TextWrapping="Wrap" />
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
                <Button Classes="primary" Content="为选中产品生成精确候选" IsEnabled="{Binding CanGenerateApplicationCandidates}"
                        Click="GenerateApplicationCandidates" HorizontalAlignment="Left" />
                <TextBox Text="{Binding ApplicationInventorySearch, Mode=TwoWay}"
                         PlaceholderText="筛选已生成候选：软件名、发布者、文件名、路径或电脑"
                         IsVisible="{Binding HasApplicationInventoryItems}" />
                <TextBlock Text="{Binding ApplicationInventoryStatus}" Classes="muted"
                           IsVisible="{Binding HasApplicationInventoryStatus}" TextWrapping="Wrap" />
                <Expander Header="查看候选生成问题" IsVisible="{Binding HasApplicationInventoryFailureDetails}">
                  <TextBlock Text="{Binding ApplicationInventoryFailureDetails}" Classes="muted"
                             TextWrapping="Wrap" Margin="4,0,4,8" />
                </Expander>
                <Expander Header="查看已生成的精确候选" IsVisible="{Binding HasApplicationInventoryItems}" IsExpanded="True">
                  <StackPanel Spacing="8">
                    <TextBlock Text="核对实际文件与规则类型。发布者信息需能由 AppLocker 读取；哈希规则升级后需要重新生成。"
                               Classes="muted" TextWrapping="Wrap" />
                    <WrapPanel>
                      <Button Content="勾选常见应用" Click="SelectCommonApplicationChoices"
                              IsEnabled="{Binding !IsExecuting}" Margin="0,0,8,6" />
                      <Button Content="清空软件选择" Click="ClearApplicationChoiceSelection"
                              IsEnabled="{Binding !IsExecuting}" Margin="0,0,8,6" />
                    </WrapPanel>
                    <ScrollViewer Height="230" IsEnabled="{Binding !IsExecuting}">
                      <ItemsControl ItemsSource="{Binding ApplicationInventoryChoices}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <Border Padding="8" Margin="0,0,0,6" BorderBrush="#D8DFE8" BorderThickness="1" CornerRadius="6">
                              <StackPanel Spacing="3">
                                <CheckBox Content="{Binding Summary}" IsChecked="{Binding IsSelected, Mode=TwoWay}" IsEnabled="{Binding CanSelect}" />
                                <TextBlock Text="{Binding FilePath}" FontSize="11" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding RuleAvailability}" Classes="muted" FontSize="11" TextWrapping="Wrap" />
                              </StackPanel>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </ScrollViewer>
                    <TextBlock Text="{Binding SelectedApplicationSummary}" Classes="muted" TextWrapping="Wrap" />
                  </StackPanel>
                </Expander>
                <Expander Header="管理员工具：完整软件扫描和手工规则">
                  <StackPanel Spacing="8" Margin="4,8,4,4">
                    <TextBlock Text="完整扫描沿用现有读取 API：最多检查 400 个已登记 EXE，逐项计算文件哈希，最长约 45 秒；它不是完整软件盘点，也不会运行 AppLocker 安全预检。正式策略每次写入仍会独立完成全部安全预检。"
                               Classes="muted" TextWrapping="Wrap" />
                    <Button Content="完整扫描（旧版读取 API）" IsEnabled="{Binding CanReadApplicationInventory}"
                            Click="ReadApplicationInventory" HorizontalAlignment="Left" />
                    <Expander Header="手工设置账户和规则">
                      <StackPanel Spacing="8" Margin="4,8,4,4">
                        <CheckBox Content="启用手动规则输入" IsChecked="{Binding UseManualApplicationInputs, Mode=TwoWay}" />
                        <StackPanel IsVisible="{Binding UseManualApplicationInputs}" Spacing="8">
                          <TextBlock Text="手动 SID 仅支持单台电脑，会覆盖上方账户选择；系统限制仍按上方账户清单逐台选择。仅建议熟悉 Windows 账户的管理员使用。"
                                     Classes="muted" TextWrapping="Wrap" />
                          <TextBlock Text="学生账户 SID" />
                          <TextBox Text="{Binding ApplicationStudentSids, Mode=TwoWay}" AcceptsReturn="True"
                                   TextWrapping="Wrap" Height="74" PlaceholderText="每行一个 SID" />
                          <TextBlock Text="应用规则" />
                          <TextBox Text="{Binding ApplicationRules, Mode=TwoWay}" AcceptsReturn="True"
                                   TextWrapping="Wrap" Height="112" />
                          <Expander Header="查看手动输入格式">
                            <TextBlock Text="publisher|名称|发布者|产品|文件.exe|最低版本|最高版本；hash|名称|文件.exe|文件SHA256|AppLocker SHA256|字节数"
                                       Classes="muted" TextWrapping="Wrap" Margin="4,8,4,4" />
                          </Expander>
                          <Button Content="将勾选软件加入规则" IsEnabled="{Binding CanAddSelectedApplicationRules}"
                                  Click="AddSelectedApplicationRules" HorizontalAlignment="Left" />
                        </StackPanel>
                      </StackPanel>
                    </Expander>
                  </StackPanel>
                </Expander>
              </StackPanel>
              <StackPanel IsVisible="{Binding IsApplicationApplyStep}" Spacing="10">
              <ComboBox SelectedIndex="{Binding ApplicationPolicyModeIndex, Mode=TwoWay}">
                <ComboBoxItem Content="先检查影响（不禁用软件）" />
                <ComboBoxItem Content="禁用勾选软件（阻止后续启动）" />
              </ComboBox>
              <CheckBox Content="我已查看影响结果，确认应用限制" IsChecked="{Binding ApplicationEnforcementReviewed, Mode=TwoWay}" IsVisible="{Binding IsEnforceApplicationPolicy}" />
              <TextBlock Text="限制时长（到期自动恢复）" />
              <ComboBox SelectedIndex="{Binding ApplicationPolicyDurationIndex, Mode=TwoWay}">
                <ComboBoxItem Content="45 分钟" />
                <ComboBoxItem Content="60 分钟" />
                <ComboBoxItem Content="90 分钟" />
                <ComboBoxItem Content="120 分钟" />
                <ComboBoxItem Content="24 小时" />
              </ComboBox>
              <TextBlock Text="{Binding ApplicationPolicyPreview}" Classes="muted" TextWrapping="Wrap" />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Classes="primary" Content="应用当前设置" IsEnabled="{Binding CanPushApplicationPolicy}" Click="PushApplicationPolicy" />
                <Button Content="解除应用限制" IsEnabled="{Binding CanDisableApplicationPolicy}" Click="DisableApplicationPolicy" />
                <Button Content="查看影响结果" IsEnabled="{Binding CanReadApplicationPolicyAudit}" Click="ReadApplicationPolicyAudit" />
              </StackPanel>
              <TextBlock Text="{Binding ApplicationPolicyHistoryText}" Classes="muted" IsVisible="{Binding HasApplicationPolicyHistory}" TextWrapping="Wrap" />
              <TextBlock Text="{Binding ApplicationPolicyError}" Foreground="#9C4221" IsVisible="{Binding HasApplicationPolicyError}" TextWrapping="Wrap" />
              <StackPanel IsVisible="{Binding HasApplicationPolicyResult}" Spacing="6">
                <TextBlock Text="{Binding ApplicationPolicyResult}" Foreground="#246356" TextWrapping="Wrap" />
                <ToggleButton Content="{Binding ApplicationPolicyDetailsToggleText}"
                              IsChecked="{Binding ShowApplicationPolicyResultDetails, Mode=TwoWay}"
                              IsEnabled="{Binding HasApplicationPolicyResultDetails}" HorizontalAlignment="Left" />
                <TextBox Text="{Binding ApplicationPolicyResultDetails}" IsReadOnly="True" AcceptsReturn="True"
                         TextWrapping="Wrap" Height="150" IsVisible="{Binding ShowApplicationPolicyResultDetails}" />
              </StackPanel>
              <TextBox Text="{Binding ApplicationAuditResult}" IsReadOnly="True" AcceptsReturn="True"
                       TextWrapping="Wrap" Height="180" IsVisible="{Binding HasApplicationAuditResult}" />
              </StackPanel>
            </StackPanel>
          </Border>
          <Border Classes="card" IsVisible="{Binding IsSystemPolicyPage}">
            <StackPanel Spacing="12">
              <TextBlock Text="系统限制" FontSize="20" FontWeight="SemiBold" />
              <Border Classes="status-panel warning" Padding="12">
                <TextBlock Text="Agent 签名回执表示本机策略状态已读回，不代表限制效果已验证。Windows 10/11 效果仍待机房验收；请先在可还原测试机逐项验证。"
                           TextWrapping="Wrap" />
              </Border>
              <Border Background="#F3F6F9" BorderBrush="#D7E0E8" BorderThickness="1" CornerRadius="10" Padding="12">
                <StackPanel Spacing="7">
                  <TextBlock Text="建议先选择课堂基础限制" FontWeight="SemiBold" />
                  <TextBlock Text="限制改时间、网络设置和账户管理；安装软件、壁纸及控制面板按机房需要单独选择。软件安装限制可能影响软件维护。"
                             Classes="muted" TextWrapping="Wrap" />
                  <WrapPanel>
                    <Button Content="选择基础限制" Click="SelectRecommendedStudentSystemRestrictions"
                            IsEnabled="{Binding !IsExecuting}" Margin="0,0,8,0" />
                    <Button Content="清空选择" Click="ClearStudentSystemRestrictionSelection"
                            IsEnabled="{Binding !IsExecuting}" />
                  </WrapPanel>
                </StackPanel>
              </Border>
              <Border Background="#EEF3F5" CornerRadius="8" Padding="12">
                <StackPanel Spacing="8">
                  <TextBlock Text="目标学生账户" FontWeight="SemiBold" />
                  <TextBlock Text="先勾选确实需要限制的学生账户。账户选择按电脑分别保存。" Classes="muted" TextWrapping="Wrap" />
                  <Button Content="读取目标电脑账户" IsEnabled="{Binding CanReadApplicationInventory}"
                          Click="ReadStudentAccounts" HorizontalAlignment="Left" />
                  <TextBlock Text="{Binding StudentAccountsStatus}" Classes="muted"
                             IsVisible="{Binding HasStudentAccountsStatus}" TextWrapping="Wrap" />
                  <Expander Header="查看并选择账户" IsVisible="{Binding HasStudentAccountChoices}">
                    <StackPanel Spacing="8">
                      <TextBlock Text="{Binding StudentAccountSelectionSummary}" Classes="muted" TextWrapping="Wrap" />
                      <WrapPanel>
                        <Button Content="全选已读取账户" Click="SelectAllStudentAccounts" IsEnabled="{Binding !IsExecuting}" Margin="0,0,8,6" />
                        <Button Content="清空选择" Click="ClearStudentAccountSelection" IsEnabled="{Binding !IsExecuting}" Margin="0,0,8,6" />
                      </WrapPanel>
                      <ScrollViewer Height="180" IsEnabled="{Binding !IsExecuting}">
                        <ItemsControl ItemsSource="{Binding StudentAccountChoices}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <Border Padding="8" Margin="0,0,0,6" BorderBrush="#D8DFE8" BorderThickness="1" CornerRadius="6">
                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}">
                                  <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" />
                                </CheckBox>
                              </Border>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </ScrollViewer>
                    </StackPanel>
                  </Expander>
                </StackPanel>
              </Border>
              <TextBlock Text="{Binding StudentSystemPolicyPushGuidance}" Classes="muted" TextWrapping="Wrap" />
              <TextBlock Text="推送前检查账户和环境。不支持的壁纸或网络限制会跳过，其他选项仍可应用；检查失败的电脑不会应用任何系统限制。"
                         Classes="muted" TextWrapping="Wrap" />
              <StackPanel Spacing="2">
                <CheckBox Content="统一桌面壁纸" IsChecked="{Binding StudentSystemPolicyLockWallpaper, Mode=TwoWay}" />
                <TextBlock Text="把所选学生账户的桌面设为统一壁纸。" Classes="muted" FontSize="12" Margin="28,0,0,0" TextWrapping="Wrap" />
              </StackPanel>
              <StackPanel Spacing="2">
                <CheckBox Content="禁止修改系统日期、时间和时区" IsChecked="{Binding StudentSystemPolicyProhibitTimeChanges, Mode=TwoWay}" />
                <TextBlock Text="阻止所选学生账户更改日期、时间和时区。" Classes="muted" FontSize="12" Margin="28,0,0,0" TextWrapping="Wrap" />
              </StackPanel>
              <StackPanel Spacing="2">
                <CheckBox Content="禁止更改网络设置" IsChecked="{Binding StudentSystemPolicyProhibitNetworkChanges, Mode=TwoWay}" />
                <TextBlock Text="禁止修改网络配置；保留现有连接及 Veyon、学生代理通信。" Classes="muted" FontSize="12" Margin="28,0,0,0" TextWrapping="Wrap" />
              </StackPanel>
              <StackPanel Spacing="2">
                <CheckBox Content="长期软件运行保护（含部分安装限制）" IsChecked="{Binding StudentSystemPolicyProhibitSoftwareInstallation, Mode=TwoWay}" />
                <TextBlock Text="不需要扫描软件清单。对所选学生账户启用 EXE 运行基线：保留系统与 Program Files 教育软件，限制未登记的便携程序；AppLocker 的 Appx 保持签名应用放行，MSI/Script 集合不由此功能修改。可能影响从用户目录运行的程序和软件维护。"
                           Classes="muted" FontSize="12" Margin="28,0,0,0" TextWrapping="Wrap" />
              </StackPanel>
              <StackPanel Spacing="2">
                <CheckBox Content="禁止管理账户和修改本人密码" IsChecked="{Binding StudentSystemPolicyProhibitAccountManagement, Mode=TwoWay}" />
                <TextBlock Text="阻止学生管理本机账户或修改本人密码，教师管理员仍可维护。" Classes="muted" FontSize="12" Margin="28,0,0,0" TextWrapping="Wrap" />
              </StackPanel>
              <StackPanel Spacing="2">
                <CheckBox Content="禁止打开控制面板和设置" IsChecked="{Binding StudentSystemPolicyProhibitControlPanel, Mode=TwoWay}" />
                <TextBlock Text="限制所选学生账户打开控制面板和 Windows 设置。" Classes="muted" FontSize="12" Margin="28,0,0,0" TextWrapping="Wrap" />
              </StackPanel>
              <CheckBox Content="我已了解：学生可能无法安装或更新部分软件" IsChecked="{Binding StudentSystemPolicySoftwareInstallReviewed, Mode=TwoWay}" IsVisible="{Binding StudentSystemPolicyProhibitSoftwareInstallation}" />
              <TextBlock Text="{Binding StudentSystemPolicyPreview}" Classes="muted" TextWrapping="Wrap" />
              <CheckBox Content="我已阅读以上影响和目标预览，确认应用所选系统限制"
                        IsChecked="{Binding StudentSystemPolicyImpactReviewed, Mode=TwoWay}"
                        IsVisible="{Binding HasSelectedStudentSystemPolicy}" />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Classes="primary" Content="应用系统限制" IsEnabled="{Binding CanPushStudentSystemPolicy}" Click="PushStudentSystemPolicy" />
                <Button Content="解除所选电脑的系统限制" IsEnabled="{Binding CanDisableStudentSystemPolicy}" Click="DisableStudentSystemPolicy" />
              </StackPanel>
              <TextBlock Text="{Binding StudentSystemPolicyResult}" Foreground="#246356" IsVisible="{Binding HasStudentSystemPolicyResult}" TextWrapping="Wrap" />
              <TextBox Text="{Binding StudentSystemPolicyDetails}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" Height="150" IsVisible="{Binding HasStudentSystemPolicyDetails}" />
              <TextBlock Text="{Binding StudentSystemPolicyError}" Foreground="#9C4221" IsVisible="{Binding HasStudentSystemPolicyError}" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
        </StackPanel>
        <StackPanel IsVisible="{Binding IsTeacherSetupPackageStepVisible}" Spacing="20">
          <Border Classes="card">
            <StackPanel Spacing="16">
              <TextBlock Text="生成学生校区配置包" FontSize="20" FontWeight="SemiBold" />
              <StackPanel Spacing="8">
                <TextBlock Text="校区名称" />
              <TextBox Text="{Binding CampusId, Mode=TwoWay}" PlaceholderText="智学前程-校区名称"
                       IsEnabled="{Binding !IsExecuting}" />
                    <TextBlock Text="{Binding CampusSetupHint}" Classes="muted" TextWrapping="Wrap" />
                <Expander Header="更改保存位置" IsExpanded="False">
                  <StackPanel Spacing="6" Margin="0,8,0,0">
                    <TextBlock Text="留空将保存到桌面。" Classes="muted" />
                    <TextBox Text="{Binding RoomOutputDir, Mode=TwoWay}" PlaceholderText="文件夹路径" />
                  </StackPanel>
                </Expander>
              </StackPanel>
              <Border Classes="status-panel info" Padding="12">
                <StackPanel Spacing="8">
                  <TextBlock Text="推荐首次设置" FontWeight="SemiBold" />
                  <TextBlock Text="默认安装 Veyon、修改电脑名称、创建学生账户并更改管理员密码（学生端会再次确认）。"
                             Classes="muted" TextWrapping="Wrap" />
                  <Expander Header="调整首次设置" IsExpanded="False">
                    <StackPanel Spacing="8" Margin="0,8,0,0">
                      <CheckBox Content="安装并配置 Veyon" IsChecked="{Binding RecommendInstallVeyon, Mode=TwoWay}" />
                      <CheckBox Content="修改电脑名称" IsChecked="{Binding RecommendRenameComputer, Mode=TwoWay}" />
                      <CheckBox Content="创建学生账户" IsChecked="{Binding RecommendCreateStudentAccount, Mode=TwoWay}" />
                      <CheckBox Content="更改管理员密码（学生端确认）"
                                IsChecked="{Binding RecommendChangeAdminPassword, Mode=TwoWay}" />
                    </StackPanel>
                  </Expander>
                </StackPanel>
              </Border>
              <Button Classes="primary" Content="生成学生校区配置包" Click="GeneratePackage" IsEnabled="{Binding CanGenerateStudentPackage}" HorizontalAlignment="Left" />
              <StackPanel IsVisible="{Binding IsGeneratingStudentPackage}" Spacing="6">
                <ProgressBar IsIndeterminate="True" Height="6" />
                <TextBlock Text="{Binding PackageGenerationStatus}" Classes="muted" TextWrapping="Wrap" />
                <Button Classes="secondary" Content="取消配置包生成" Click="CancelPackageGeneration" IsVisible="{Binding IsBuildingStudentPackage}" IsEnabled="{Binding CanCancelStudentPackageGeneration}" HorizontalAlignment="Left" />
              </StackPanel>
              <TextBlock Text="{Binding PackageOutput}" Foreground="#246356" IsVisible="{Binding HasPackageOutput}" TextWrapping="Wrap" />
              <TextBlock Text="{Binding PackageOutputError}" Foreground="#9C4221" IsVisible="{Binding HasPackageOutputError}" TextWrapping="Wrap" />
              <Button Content="确认更换校区密钥并继续" Click="ReplaceWebsiteSigningKey" IsVisible="{Binding CanReplaceWebsiteSigningKey}" IsEnabled="{Binding CanGenerateStudentPackage}" HorizontalAlignment="Left" />
            </StackPanel>
          </Border>
          <Border Classes="card">
            <StackPanel Spacing="14">
              <TextBlock Text="可选：发布到云端目录" FontSize="20" FontWeight="SemiBold" />
              <TextBlock Text="配置包已在本机生成即可完成首次设置。只有需要让学生从云端搜索和下载时，才需要填写并发布。"
                         Classes="muted" TextWrapping="Wrap" />
              <StackPanel Spacing="8">
                <TextBlock Text="学生搜索名称（与配置包一致）" />
                <TextBlock Text="{Binding PublishCampusName}" FontWeight="SemiBold" />
                <TextBlock Text="教师姓名" />
                <TextBox Text="{Binding PublisherName, Mode=TwoWay}" MaxLength="100" PlaceholderText="填写发布教师姓名" />
                <TextBlock Text="教师手机号后四位" />
                <TextBox Text="{Binding TeacherPhoneLast4, Mode=TwoWay}" MaxLength="4" PlaceholderText="4 位数字" />
                <TextBlock Text="供学生下载校验。" Classes="muted" />
                <TextBlock Text="{Binding PackagePublisherStatus}" Classes="muted" IsVisible="{Binding HasPackagePublisherStatus}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding PackagePublisherError}" Foreground="#9C4221" IsVisible="{Binding HasPackagePublisherError}" TextWrapping="Wrap" />
              </StackPanel>
              <StackPanel Spacing="8">
                <TextBlock Text="要上传的配置包文件夹" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                  <TextBox Text="{Binding PublishPackageDirectory, Mode=TwoWay}" PlaceholderText="生成配置包后会自动填入，也可手动选择文件夹" />
                  <Button Grid.Column="1" Content="选择文件夹…" Click="ChoosePublishPackageDirectory" />
                </Grid>
                <Button Classes="primary" Content="验证并发布到云端目录"
                        IsEnabled="{Binding CanPublishStudentPackage}"
                        Click="PublishStudentPackage" HorizontalAlignment="Left" />
                <TextBlock Text="{Binding PackagePublishResult}" Foreground="#246356" IsVisible="{Binding HasPackagePublishResult}" TextWrapping="Wrap" />
              </StackPanel>
            </StackPanel>
          </Border>
        </StackPanel>
      </StackPanel>
      </ScrollViewer>
      </Grid>
    </Grid>
  </Grid>
</Window>
