<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:VeyonCampus.App"
        xmlns:core="using:VeyonCampus.Core"
        x:Class="VeyonCampus.App.TeacherWindow" x:DataType="vm:TeacherViewModel"
        Title="Veyon Campus 教师控制台" Width="1240" Height="880" MinWidth="1024" MinHeight="700"
        Background="#F3F6F8">
  <Window.Styles>
    <Style Selector="Border.teacher-note">
      <Setter Property="Background" Value="#E6F3EF" />
      <Setter Property="BorderBrush" Value="#C9E4DB" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="12,9" />
    </Style>
    <Style Selector="Border.teacher-note TextBlock">
      <Setter Property="Foreground" Value="#245F55" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="Button.sidebar-action">
      <Setter Property="Background" Value="#1C3A4A" />
      <Setter Property="Foreground" Value="#E5EEF1" />
      <Setter Property="BorderBrush" Value="#31505D" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="10,7" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
    </Style>
    <Style Selector="Button.sidebar-action:pointerover">
      <Setter Property="Background" Value="#315D6B" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="RadioButton.teacher-nav">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#C9D7DE" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Padding" Value="12,10" />
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="ToolTip.ShowDelay" Value="350" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}"
                  BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
            <Grid ColumnDefinitions="4,*" Margin="5,5,0,5">
              <Border Name="NavSelectionMark" Background="#8DDECC" CornerRadius="2" Opacity="0" />
              <ContentPresenter Grid.Column="1" Name="NavContent" Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}" Padding="{TemplateBinding Padding}"
                                HorizontalContentAlignment="Left" VerticalContentAlignment="Center" />
            </Grid>
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="RadioButton.teacher-nav:checked">
      <Setter Property="Background" Value="#1C645D" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="RadioButton.teacher-nav:pointerover">
      <Setter Property="Background" Value="#315D6B" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="RadioButton.teacher-nav:pressed">
      <Setter Property="Background" Value="#254C59" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="RadioButton.teacher-nav:checked:pointerover">
      <Setter Property="Background" Value="#287E72" />
    </Style>
    <Style Selector="RadioButton.teacher-nav:checked:pressed">
      <Setter Property="Background" Value="#17564F" />
    </Style>
    <Style Selector="RadioButton.teacher-nav:focus-visible">
      <Setter Property="BorderBrush" Value="#8DDECC" />
    </Style>
    <Style Selector="RadioButton.teacher-nav:checked /template/ Border#NavSelectionMark">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="RadioButton.teacher-nav /template/ ContentPresenter">
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="RadioButton.teacher-nav:pointerover /template/ ContentPresenter">
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="RadioButton.teacher-nav:pressed /template/ ContentPresenter">
      <Setter Property="Foreground" Value="White" />
    </Style>
  </Window.Styles>
  <Grid ColumnDefinitions="244,*">
    <Border Background="#102A3A" Padding="20,28">
      <Grid RowDefinitions="Auto,*,Auto">
        <StackPanel Spacing="18">
          <StackPanel Orientation="Horizontal" Spacing="12">
            <Border Width="52" Height="52" CornerRadius="15" Background="#FFFFFF" Padding="4">
              <Image Source="avares://VeyonCampus.Teacher/Assets/veyon-campus-mark.png" Stretch="Uniform" />
            </Border>
            <StackPanel VerticalAlignment="Center" Spacing="2">
              <TextBlock Text="VEYON CAMPUS" Foreground="#8DDECC" FontSize="12" FontWeight="Bold" />
              <TextBlock Text="校园部署" Foreground="White" FontSize="18" FontWeight="Bold" />
            </StackPanel>
          </StackPanel>
          <TextBlock Text="课堂管理与离线部署" Foreground="#B7C9D2" FontSize="12" />
        </StackPanel>
        <StackPanel Grid.Row="1" Spacing="8" Margin="0,36,0,0">
          <TextBlock Text="常用" Foreground="#8DDECC" FontSize="12" FontWeight="SemiBold" Margin="12,0,0,4" />
          <Button Classes="sidebar-action" Content="手机控制设置" Click="OpenMobileControl" />
          <RadioButton Classes="teacher-nav" GroupName="teacher-pages" ToolTip.Tip="向学生电脑推送网站黑名单、白名单或解除网站限制" IsChecked="{Binding IsClassroomPage, Mode=TwoWay}"><TextBlock Text="课堂控制" Foreground="White" /></RadioButton>
          <RadioButton Classes="teacher-nav" GroupName="teacher-pages" ToolTip.Tip="检查教师端更新并向学生电脑推送更新" IsChecked="{Binding IsUpdatesPage, Mode=TwoWay}"><TextBlock Text="更新" Foreground="White" /></RadioButton>
          <TextBlock Text="一次配置" Foreground="#8DDECC" FontSize="12" FontWeight="SemiBold" Margin="12,18,0,4" />
          <RadioButton Classes="teacher-nav" GroupName="teacher-pages" ToolTip.Tip="创建 Veyon 机房地点，添加电脑编号和学生姓名" IsChecked="{Binding IsRoomPage, Mode=TwoWay}"><TextBlock Text="地点与学生名单" Foreground="White" /></RadioButton>
          <RadioButton Classes="teacher-nav" GroupName="teacher-pages" ToolTip.Tip="安装教师端、配置密钥认证并生成学生校区配置包" IsChecked="{Binding IsSetupPage, Mode=TwoWay}"><TextBlock Text="首次设置" Foreground="White" /></RadioButton>
        </StackPanel>
        <StackPanel Grid.Row="2" Spacing="7">
          <Border Height="1" Background="#31505D" Margin="0,0,0,5" />
          <TextBlock Text="反馈与联系" Foreground="#8DDECC" FontSize="12" FontWeight="SemiBold" Margin="4,0,0,0" />
          <Button Classes="sidebar-action" Content="提交反馈 ↗" Click="OpenFeedbackIssue" />
          <Button Classes="sidebar-action" Content="联系方式" Click="OpenFeedbackContacts" />
          <Border Height="1" Background="#31505D" Margin="0,5,0,5" />
          <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBlock Text="Veyon Campus" Foreground="#B5C6D0" FontSize="12" />
            <TextBlock Text="{Binding AppVersion}" Foreground="#8DDECC" FontSize="12" FontWeight="SemiBold" />
          </StackPanel>
        </StackPanel>
      </Grid>
    </Border>
    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Background="#F3F6F8">
      <StackPanel Margin="34,30,34,36" Spacing="20">
        <Border Background="#FFFFFF" CornerRadius="16" Padding="24,20" BorderBrush="#E3E9EC" BorderThickness="1">
          <Grid ColumnDefinitions="*">
            <StackPanel Spacing="7">
              <TextBlock Text="{Binding PageTitle}" FontSize="28" FontWeight="Bold" />
              <TextBlock Text="{Binding PageDescription}" Classes="muted" TextWrapping="Wrap" />
            </StackPanel>
          </Grid>
        </Border>
        <StackPanel IsVisible="{Binding IsRoomPage}" Spacing="20">
          <Border Classes="teacher-note"><TextBlock Text="学生姓名只保存在教师机，不会写入学生配置包。" /></Border>
          <Border Classes="card">
            <StackPanel Spacing="14">
              <TextBlock Text="本机校区与机房档案" FontSize="20" FontWeight="SemiBold" />
              <TextBlock Text="在这台教师电脑保存校区和机房，方便下次使用。保存档案后，点击“检查冲突并预览”再添加到 Veyon。" Classes="muted" TextWrapping="Wrap" />
              <Grid ColumnDefinitions="*,16,*">
                <StackPanel Spacing="8">
                  <TextBlock Text="校区档案" />
                  <ListBox ItemsSource="{Binding CampusProfiles}" SelectedItem="{Binding SelectedCampusProfile, Mode=TwoWay}" Height="112">
                    <ListBox.ItemTemplate>
                      <DataTemplate x:DataType="core:TeacherCampusProfile">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <TextBlock Text="{Binding DisplayName}" />
                        </StackPanel>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </StackPanel>
                <StackPanel Grid.Column="2" Spacing="8">
                  <TextBlock Text="校区显示名" />
                  <TextBox Text="{Binding CampusProfileName, Mode=TwoWay}" PlaceholderText="例如：东区校区" />
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="新增校区" Click="NewCampusProfile" />
                    <Button Classes="primary" Content="保存校区" Click="SaveCampusProfile" />
                    <Button Content="删除所选" Click="DeleteCampusProfile" IsEnabled="{Binding HasSelectedCampusProfile}" />
                  </StackPanel>
                </StackPanel>
              </Grid>
              <StackPanel IsVisible="{Binding HasSelectedCampusProfile}" Spacing="8">
                <TextBlock Text="机房档案（显示名 · 本机 ID · 电脑范围）" />
                <Grid ColumnDefinitions="*,16,*">
                  <ListBox ItemsSource="{Binding RoomProfiles}" SelectedItem="{Binding SelectedRoomProfile, Mode=TwoWay}" Height="112">
                    <ListBox.ItemTemplate>
                      <DataTemplate x:DataType="core:TeacherRoomProfile">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <TextBlock Text="{Binding DisplayName}" />
                          <TextBlock Text="·" Classes="muted" />
                          <TextBlock Text="{Binding StableIdLabel}" Classes="muted" />
                          <TextBlock Text="·" Classes="muted" />
                          <TextBlock Text="{Binding ComputerRangeLabel}" Classes="muted" />
                        </StackPanel>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                  <StackPanel Grid.Column="2" Spacing="8">
                    <TextBox Text="{Binding RoomProfileName, Mode=TwoWay}" PlaceholderText="机房显示名，例如：三楼机房" />
                    <Grid ColumnDefinitions="*,10,*,10,*">
                      <TextBox Text="{Binding RoomProfilePrefix, Mode=TwoWay}" PlaceholderText="前缀" />
                      <TextBox Grid.Column="2" Text="{Binding RoomProfileStart, Mode=TwoWay}" PlaceholderText="起始编号" MaxLength="3" />
                      <TextBox Grid.Column="4" Text="{Binding RoomProfileCount, Mode=TwoWay}" PlaceholderText="电脑数量（最多 150）" MaxLength="3" />
                    </Grid>
                    <TextBlock Text="可选主机名/IP 覆盖：每行对应一台电脑，留空使用生成的电脑名；只保存在本机档案。" Classes="muted" TextWrapping="Wrap" />
                    <TextBox Text="{Binding RoomProfileHostOverrides, Mode=TwoWay}" AcceptsReturn="True" TextWrapping="Wrap" Height="68" PlaceholderText="例如：&#10;192.168.1.21&#10;192.168.1.22" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <Button Content="新增机房" Click="NewRoomProfile" />
                      <Button Classes="primary" Content="保存机房" Click="SaveRoomProfile" />
                      <Button Content="删除所选" Click="DeleteRoomProfile" IsEnabled="{Binding HasSelectedRoomProfile}" />
                      <Button Content="填入下方清单" Click="LoadRoomProfile" IsEnabled="{Binding HasSelectedRoomProfile}" />
                    </StackPanel>
                  </StackPanel>
                </Grid>
              </StackPanel>
              <TextBlock Text="{Binding CampusDirectoryStatus}" Classes="muted" IsVisible="{Binding HasCampusDirectoryStatus}" TextWrapping="Wrap" />
              <TextBlock Text="{Binding CampusDirectoryError}" Foreground="#9C4221" IsVisible="{Binding HasCampusDirectoryError}" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
          <Border Classes="card">
            <StackPanel Spacing="14">
              <TextBlock Text="地点与电脑名单" FontSize="20" FontWeight="SemiBold" />
              <TextBlock Text="预览 1–150 台电脑编号、显示名和连接主机；冲突检查通过后才可写入本机 Veyon 静态目录。" Classes="muted" TextWrapping="Wrap" />
              <StackPanel Spacing="8">
                <TextBlock Text="Veyon 地点名称" />
                <TextBox Text="{Binding RoomLocationName, Mode=TwoWay}" PlaceholderText="例如：三楼计算机房" />
              </StackPanel>
              <Grid ColumnDefinitions="*,16,*,16,*">
                <StackPanel Spacing="8"><TextBlock Text="电脑名前缀" /><TextBox Text="{Binding RoomPrefix, Mode=TwoWay}" /></StackPanel>
                <StackPanel Grid.Column="2" Spacing="8"><TextBlock Text="起始编号" /><TextBox Text="{Binding RoomStart, Mode=TwoWay}" MaxLength="3" /></StackPanel>
                <StackPanel Grid.Column="4" Spacing="8"><TextBlock Text="电脑数量" /><TextBox Text="{Binding RoomCount, Mode=TwoWay}" MaxLength="3" /></StackPanel>
              </Grid>
              <StackPanel Spacing="8">
                <TextBlock Text="显示名可选（通常填学生姓名）；每行对应一台电脑，空行使用电脑编号作为显示名。档案只保留电脑规划，不保存学生姓名。" Classes="muted" TextWrapping="Wrap" />
                <TextBox Text="{Binding StudentRoster, Mode=TwoWay}" AcceptsReturn="True" TextWrapping="Wrap" Height="92" PlaceholderText="张三&#10;李四&#10;王五" />
              </StackPanel>
              <StackPanel Spacing="8">
                <TextBlock Text="连接主机名或 IP 可选；每行对应一台电脑，空行使用生成的电脑编号。支持 DNS、IPv4、IPv6；不要填写 URL 或端口。" Classes="muted" TextWrapping="Wrap" />
                <TextBox Text="{Binding RoomComputerHosts, Mode=TwoWay}" AcceptsReturn="True" TextWrapping="Wrap" Height="92" PlaceholderText="192.168.1.21&#10;&#10;pc-03.school.local" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="检查冲突并预览" Click="PreviewRoom" IsEnabled="{Binding CanCheckRoomConflicts}" />
                <Button Classes="primary" Content="一键添加到 Veyon" Click="AddRoomToVeyon" IsEnabled="{Binding CanAddRoomToVeyon}" />
                <Button Content="打开 Veyon Configurator" Click="OpenVeyonConfigurator" IsEnabled="{Binding CanOpenVeyonConfigurator}" />
              </StackPanel>
              <TextBlock Text="{Binding RoomError}" Foreground="#9C4221" IsVisible="{Binding HasRoomError}" TextWrapping="Wrap" />
              <TextBlock Text="{Binding RoomConflictStatus}" Classes="muted" IsVisible="{Binding HasRoomConflictStatus}" TextWrapping="Wrap" />
              <TextBlock Text="{Binding RoomConflictResults}" Foreground="#9C4221" IsVisible="{Binding HasRoomConflictResults}" TextWrapping="Wrap" />
              <TextBlock Text="{Binding RoomSkippedResults}" Classes="muted" IsVisible="{Binding HasRoomSkippedResults}" TextWrapping="Wrap" />
              <TextBlock Text="{Binding RoomCreateStatus}" Classes="muted" IsVisible="{Binding HasRoomCreateStatus}" TextWrapping="Wrap" />
              <TextBlock Text="{Binding RoomCreateError}" Foreground="#9C4221" IsVisible="{Binding HasRoomCreateError}" TextWrapping="Wrap" />
              <TextBlock Text="{Binding RoomCreateResult}" Foreground="#246356" IsVisible="{Binding HasRoomCreateResult}" TextWrapping="Wrap" />
              <StackPanel IsVisible="{Binding HasRoomPreview}" Spacing="8">
                <TextBlock Text="{Binding RoomSummary}" FontWeight="SemiBold" />
                <ListBox ItemsSource="{Binding RoomPreviewRows}" Height="260" />
              </StackPanel>
            </StackPanel>
          </Border>
        </StackPanel>
        <StackPanel IsVisible="{Binding IsSetupPage}" Spacing="20">
          <Border Classes="teacher-note"><TextBlock Text="教师签名私钥保存在本机用户证书库。" /></Border>
          <Border Classes="card">
            <StackPanel Spacing="12">
              <TextBlock Text="教师端一键安装 Veyon" FontSize="20" FontWeight="SemiBold" />
              <TextBlock Text="离线安装已验证的 Veyon 教师组件。" TextWrapping="Wrap" Classes="muted" />
              <TextBlock Text="{Binding TeacherInstallPlanText}" TextWrapping="Wrap" />
              <TextBlock Text="{Binding TeacherInstallSafetyText}" Foreground="#9C4221" TextWrapping="Wrap" />
              <Button Classes="primary" Content="校验内嵌安装器并安装教师端 Veyon" Click="InstallTeacherVeyon" IsEnabled="{Binding CanInstallTeacherVeyon}" HorizontalAlignment="Left" />
              <TextBlock Text="{Binding InstallerStatus}" Classes="muted" TextWrapping="Wrap" />
              <TextBlock Text="{Binding TeacherInstallResult}" Foreground="#246356" IsVisible="{Binding HasTeacherInstallResult}" TextWrapping="Wrap" />
              <TextBlock Text="{Binding TeacherInstallIssue}" Foreground="#9C4221" IsVisible="{Binding HasTeacherInstallIssue}" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
        </StackPanel>
        <StackPanel IsVisible="{Binding IsUpdatesPage}" Spacing="20">
          <Border Classes="teacher-note"><TextBlock Text="更新包会先验证签名，再安装或推送。" /></Border>
          <Border Classes="card">
            <StackPanel Spacing="12">
              <TextBlock Text="教师控制台更新" FontSize="20" FontWeight="SemiBold" />
              <TextBlock Text="更新包会验签；安装需管理员权限。" Classes="muted" TextWrapping="Wrap" />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="检查更新" Click="CheckTeacherUpdate" IsEnabled="{Binding CanCheckTeacherUpdate}" />
                <Button Classes="primary" Content="下载并重启" Click="DownloadTeacherUpdate" IsEnabled="{Binding CanDownloadTeacherUpdate}" />
                <Button Content="导出离线更新包" Click="ExportOfflineTeacherUpdate" IsEnabled="{Binding CanExportOfflineTeacherUpdate}" />
              </StackPanel>
              <TextBlock Text="{Binding TeacherUpdateStatus}" Classes="muted" TextWrapping="Wrap" />
              <Border Height="1" Background="#DCE5E9" Margin="0,4" />
              <TextBlock Text="离线安装器验证" FontWeight="SemiBold" />
              <TextBlock Text="将安装器与同版本 .release.json 清单放在同一文件夹。本机已安装版本使用内嵌的固定公钥验签和校验 SHA-256；验证通过后可交给带回滚能力的更新助手安装。" Classes="muted" TextWrapping="Wrap" />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="选择并验证离线安装器" Click="VerifyOfflineTeacherUpdate" IsEnabled="{Binding CanVerifyOfflineTeacherUpdate}" />
                <Button Classes="primary" Content="安装已验证版本并重启" Click="InstallOfflineTeacherUpdate" IsEnabled="{Binding CanInstallOfflineTeacherUpdate}" />
              </StackPanel>
              <TextBlock Text="{Binding OfflineTeacherUpdateStatus}" Classes="muted" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
          <Border Classes="card">
            <StackPanel Spacing="12">
              <TextBlock Text="学生端静默更新" FontSize="20" FontWeight="SemiBold" />
              <TextBlock Text="更新命令由校区密钥签名。只有 Agent 身份已固定且更新/状态回执验签通过时才标记成功；未固定的旧版电脑可先升级，但结果会显示需核对。教师机需开放 TCP 39175（本地子网）。" Classes="muted" TextWrapping="Wrap" />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="读取并核对 Agent 身份" Click="TrustStudentAgentIdentities" IsEnabled="{Binding CanTrustStudentAgentIdentities}" />
                <Button Classes="primary" Content="检查并推送更新" Click="DeployStudentUpdate" IsEnabled="{Binding CanDeployStudentUpdate}" />
              </StackPanel>
              <TextBlock Text="{Binding StudentUpdateStatus}" Classes="muted" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
        </StackPanel>
        <StackPanel IsVisible="{Binding IsClassroomPage}" Spacing="20">
          <Border Classes="teacher-note"><TextBlock Text="网站规则只推送至所选学生电脑。" /></Border>
          <Border Classes="card">
            <StackPanel Spacing="12">
              <TextBlock Text="学生网站黑名单 / 白名单" FontSize="20" FontWeight="SemiBold" />
              <TextBlock Text="先完成学生端部署，再推送策略。电脑名无法连接时请填学生机 IP，并确认两端在同一局域网。推送后等待 15 秒并重启学生浏览器。" Classes="muted" TextWrapping="Wrap" />
              <StackPanel Spacing="8">
                <TextBlock Text="签名校区（须与学生配置包一致）" />
                <ComboBox ItemsSource="{Binding WebsiteSigningCampuses}" SelectedItem="{Binding SelectedWebsiteSigningCampus, Mode=TwoWay}" PlaceholderText="读取机房后，可选择已记录的密钥所属校区" />
                <TextBox Text="{Binding CampusId, Mode=TwoWay}" PlaceholderText="例如：江南校区" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                  <TextBlock Text="学生电脑名或 IP，每行一个；最多 150 台" VerticalAlignment="Center" />
                  <Button Grid.Column="1" Content="读取 Veyon 当前机房" Click="FillWebsiteTargets" IsEnabled="{Binding CanReadWebsiteLocations}" />
                </Grid>
                <Button Content="按电脑名前缀规则填入" Click="FillWebsiteTargetsFromRoom" HorizontalAlignment="Left" />
                <StackPanel IsVisible="{Binding HasMultipleWebsiteLocations}" Spacing="8">
                  <TextBlock Text="检测到多个机房，请选择本次推送目标：" />
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <ComboBox ItemsSource="{Binding WebsiteLocationChoices}" SelectedIndex="{Binding WebsiteLocationIndex, Mode=TwoWay}" />
                    <Button Grid.Column="1" Content="填入所选机房" Click="FillSelectedWebsiteLocation" IsEnabled="{Binding CanApplyWebsiteLocation}" />
                  </Grid>
                </StackPanel>
                <TextBlock Text="{Binding WebsiteDirectoryStatus}" Classes="muted" IsVisible="{Binding HasWebsiteDirectoryStatus}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding WebsiteDirectoryError}" Foreground="#9C4221" IsVisible="{Binding HasWebsiteDirectoryError}" TextWrapping="Wrap" />
                <TextBox Text="{Binding WebsiteTargets, Mode=TwoWay}" AcceptsReturn="True" TextWrapping="Wrap" Height="110" PlaceholderText="PC-01&#10;PC-02&#10;192.168.1.23" />
                <TextBlock Text="策略模式" />
                <ComboBox SelectedIndex="{Binding WebsiteModeIndex, Mode=TwoWay}">
                  <ComboBoxItem Content="黑名单：只阻止所列网站" />
                  <ComboBoxItem Content="白名单：只允许所列网站" />
                </ComboBox>
                <TextBlock Text="限制有效时长（默认 60 分钟，到期自动清除本工具设置的规则）" />
                <ComboBox SelectedIndex="{Binding WebsiteDurationIndex, Mode=TwoWay}">
                  <ComboBoxItem Content="45 分钟" />
                  <ComboBoxItem Content="60 分钟" />
                  <ComboBoxItem Content="90 分钟" />
                  <ComboBoxItem Content="120 分钟" />
                  <ComboBoxItem Content="不自动到期" />
                </ComboBox>
                <TextBlock Text="网站域名，每行一个；允许输入裸域名或不带路径的 HTTP/HTTPS 地址" />
                <TextBox Text="{Binding WebsiteDomains, Mode=TwoWay}" AcceptsReturn="True" TextWrapping="Wrap" Height="110" PlaceholderText="example.com&#10;school.example" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Classes="primary" Content="签名并推送策略" IsEnabled="{Binding CanPushWebsitePolicy}" Click="PushWebsitePolicy" />
                  <Button Content="一键解除所选电脑的网站限制" IsEnabled="{Binding CanDisableWebsitePolicy}" Click="DisableWebsitePolicy" />
                  <Button Content="填入上次失败设备" IsEnabled="{Binding CanFillFailedWebsiteTargets}" Click="FillFailedWebsiteTargets" />
                </StackPanel>
                <TextBlock Text="{Binding WebsitePolicyHistoryText}" Classes="muted" IsVisible="{Binding HasWebsitePolicyHistory}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding WebsitePolicyError}" Foreground="#9C4221" IsVisible="{Binding HasWebsitePolicyError}" TextWrapping="Wrap" />
                <StackPanel IsVisible="{Binding HasWebsitePolicyResult}" Spacing="6">
                  <TextBlock Text="{Binding WebsitePolicyResult}" Foreground="#246356" TextWrapping="Wrap" />
                  <ToggleButton Content="{Binding WebsitePolicyDetailsToggleText}"
                                IsChecked="{Binding ShowWebsitePolicyResultDetails, Mode=TwoWay}"
                                IsEnabled="{Binding HasWebsitePolicyResultDetails}" HorizontalAlignment="Left" />
                  <TextBox Text="{Binding WebsitePolicyResultDetails}" IsReadOnly="True" AcceptsReturn="True"
                           TextWrapping="Wrap" Height="180" IsVisible="{Binding ShowWebsitePolicyResultDetails}" />
                </StackPanel>
              </StackPanel>
            </StackPanel>
          </Border>
          <Border Classes="card">
            <StackPanel Spacing="12">
              <TextBlock Text="学生应用限制（AppLocker）" FontSize="20" FontWeight="SemiBold" />
              <TextBlock Text="只针对所列学生账户 SID 和 AppLocker 可执行文件规则（包括 EXE/COM 等 PE 文件）。同时写入允许已签名打包应用的基线，避免执行规则时连带阻断商店应用。默认先用审核模式观察；执行前应读取并核对审核事件。不会结束已经运行的程序。学生端检测到本机或有效策略冲突时会拒绝写入。" Classes="muted" TextWrapping="Wrap" />
              <TextBlock Text="学生账户 SID，每行一个（可用学生电脑上的 whoami /user 查询；仅接受普通账户 SID）" />
              <TextBox Text="{Binding ApplicationStudentSids, Mode=TwoWay}" AcceptsReturn="True" TextWrapping="Wrap" Height="82" PlaceholderText="S-1-5-21-111111111-222222222-333333333-1001" />
              <TextBlock Text="应用规则，每行一条。发布者规则：publisher|显示名称|发布者名|产品名|文件.exe|最低四段版本|最高四段版本；哈希规则：hash|显示名称|文件.exe|文件SHA256|AppLocker SHA256|文件长度（字节）" TextWrapping="Wrap" />
              <TextBox Text="{Binding ApplicationRules, Mode=TwoWay}" AcceptsReturn="True" TextWrapping="Wrap" Height="112" PlaceholderText="publisher|游戏示例|CN=Example Publisher|Example Game|Game.exe|1.0.0.0|9.9.9.9&#10;hash|旧版工具|LegacyTool.exe|填写64位文件SHA256|填写64位AppLockerSHA256|123456" />
              <TextBlock Text="应用目录：读取上方所选学生电脑的已安装桌面程序。扫描只在学生电脑本机完成，结果不上传云端；成功清单回执已核验 Agent 身份签名和本次请求，发布规则前仍请核对文件路径和签名者。" Classes="muted" TextWrapping="Wrap" />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="读取所选电脑应用清单" IsEnabled="{Binding CanReadApplicationInventory}" Click="ReadApplicationInventory" />
                <Button Content="将选中程序加入规则" IsEnabled="{Binding CanAddSelectedApplicationRules}" Click="AddSelectedApplicationRules" />
              </StackPanel>
              <TextBox Text="{Binding ApplicationInventorySearch, Mode=TwoWay}" PlaceholderText="搜索程序名、发布者、文件名、路径或电脑" />
              <TextBlock Text="{Binding ApplicationInventoryStatus}" Classes="muted" IsVisible="{Binding HasApplicationInventoryStatus}" TextWrapping="Wrap" />
              <ScrollViewer Height="230" IsVisible="{Binding HasApplicationInventoryItems}">
                <ItemsControl ItemsSource="{Binding ApplicationInventoryChoices}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Padding="8" Margin="0,0,0,6" BorderBrush="#D8DFE8" BorderThickness="1" CornerRadius="6">
                        <StackPanel Spacing="3">
                          <CheckBox Content="{Binding Summary}" IsChecked="{Binding IsSelected, Mode=TwoWay}" IsEnabled="{Binding CanSelect}" />
                          <TextBlock Text="{Binding FilePath}" FontSize="11" TextWrapping="Wrap" />
                          <TextBlock Text="{Binding RuleAvailability}" Classes="muted" FontSize="11" TextWrapping="Wrap" />
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
              <TextBlock Text="策略模式" />
              <ComboBox SelectedIndex="{Binding ApplicationPolicyModeIndex, Mode=TwoWay}">
                <ComboBoxItem Content="审核：课堂规则不拦截；读取事件或登记程序影响模拟（推荐先推送）" />
                <ComboBoxItem Content="执行：阻止所列应用的后续启动" />
              </ComboBox>
              <CheckBox Content="我已读取并核对审核事件，确认执行这些规则" IsChecked="{Binding ApplicationEnforcementReviewed, Mode=TwoWay}" IsVisible="{Binding IsEnforceApplicationPolicy}" />
              <TextBlock Text="限制有效时长（最多 24 小时，到期自动恢复原值）" />
              <ComboBox SelectedIndex="{Binding ApplicationPolicyDurationIndex, Mode=TwoWay}">
                <ComboBoxItem Content="45 分钟" />
                <ComboBoxItem Content="60 分钟" />
                <ComboBoxItem Content="90 分钟" />
                <ComboBoxItem Content="120 分钟" />
                <ComboBoxItem Content="24 小时" />
              </ComboBox>
              <TextBlock Text="{Binding ApplicationPolicyPreview}" Classes="muted" TextWrapping="Wrap" />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Classes="primary" Content="签名并推送应用策略" IsEnabled="{Binding CanPushApplicationPolicy}" Click="PushApplicationPolicy" />
                <Button Content="解除所选电脑的应用限制" IsEnabled="{Binding CanDisableApplicationPolicy}" Click="DisableApplicationPolicy" />
                <Button Content="读取审核事件/影响模拟" IsEnabled="{Binding CanReadApplicationPolicyAudit}" Click="ReadApplicationPolicyAudit" />
              </StackPanel>
              <TextBlock Text="{Binding ApplicationPolicyHistoryText}" Classes="muted" IsVisible="{Binding HasApplicationPolicyHistory}" TextWrapping="Wrap" />
              <TextBlock Text="{Binding ApplicationPolicyError}" Foreground="#9C4221" IsVisible="{Binding HasApplicationPolicyError}" TextWrapping="Wrap" />
              <StackPanel IsVisible="{Binding HasApplicationPolicyResult}" Spacing="6">
                <TextBlock Text="{Binding ApplicationPolicyResult}" Foreground="#246356" TextWrapping="Wrap" />
                <ToggleButton Content="{Binding ApplicationPolicyDetailsToggleText}"
                              IsChecked="{Binding ShowApplicationPolicyResultDetails, Mode=TwoWay}"
                              IsEnabled="{Binding HasApplicationPolicyResultDetails}" HorizontalAlignment="Left" />
                <TextBox Text="{Binding ApplicationPolicyResultDetails}" IsReadOnly="True" AcceptsReturn="True"
                         TextWrapping="Wrap" Height="150" IsVisible="{Binding ShowApplicationPolicyResultDetails}" />
              </StackPanel>
              <TextBox Text="{Binding ApplicationAuditResult}" IsReadOnly="True" AcceptsReturn="True"
                       TextWrapping="Wrap" Height="180" IsVisible="{Binding HasApplicationAuditResult}" />
            </StackPanel>
          </Border>
          <Border Classes="card">
            <StackPanel Spacing="12">
              <TextBlock Text="学生机系统限制（长期基线）" FontSize="20" FontWeight="SemiBold" />
              <TextBlock Text="用于所选电脑上的本地普通学生账户，无自动到期时间。启用后即使教师离线或课堂网站/应用策略到期也会继续保留。Agent 回执只证明命令已接受并读回，仍需在 Windows 实机核对实际效果。" Classes="muted" TextWrapping="Wrap" />
              <TextBlock Text="复用上方应用限制中的学生账户 SID；只接受启用的本地标准账户。" Classes="muted" />
              <CheckBox Content="锁定为统一蓝色 Windows 风格桌面壁纸" IsChecked="{Binding StudentSystemPolicyLockWallpaper, Mode=TwoWay}" />
              <CheckBox Content="禁止修改系统日期、时间和时区" IsChecked="{Binding StudentSystemPolicyProhibitTimeChanges, Mode=TwoWay}" />
              <CheckBox Content="限制网络连接属性、组件和新连接配置入口" IsChecked="{Binding StudentSystemPolicyProhibitNetworkChanges, Mode=TwoWay}" />
              <CheckBox Content="限制 MSI、Store/Appx 安装并阻止学生可写位置中的便携程序" IsChecked="{Binding StudentSystemPolicyProhibitSoftwareInstallation, Mode=TwoWay}" />
              <CheckBox Content="禁止学生管理用户账户，并禁止本人修改登录密码（管理员仍可维护/重置）" IsChecked="{Binding StudentSystemPolicyProhibitAccountManagement, Mode=TwoWay}" />
              <CheckBox Content="禁止访问 Control Panel 和 Settings（默认关闭）" IsChecked="{Binding StudentSystemPolicyProhibitControlPanel, Mode=TwoWay}" />
              <CheckBox Content="我已确认软件安装入口限制可能影响学生软件安装与应用更新" IsChecked="{Binding StudentSystemPolicySoftwareInstallReviewed, Mode=TwoWay}" IsVisible="{Binding StudentSystemPolicyProhibitSoftwareInstallation}" />
              <TextBlock Text="{Binding StudentSystemPolicyPreview}" Classes="muted" TextWrapping="Wrap" />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Classes="primary" Content="签名并推送系统限制" IsEnabled="{Binding CanPushStudentSystemPolicy}" Click="PushStudentSystemPolicy" />
                <Button Content="解除所选电脑的系统限制" IsEnabled="{Binding CanDisableStudentSystemPolicy}" Click="DisableStudentSystemPolicy" />
              </StackPanel>
              <TextBlock Text="{Binding StudentSystemPolicyResult}" Foreground="#246356" IsVisible="{Binding HasStudentSystemPolicyResult}" TextWrapping="Wrap" />
              <TextBox Text="{Binding StudentSystemPolicyDetails}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" Height="150" IsVisible="{Binding HasStudentSystemPolicyDetails}" />
              <TextBlock Text="{Binding StudentSystemPolicyError}" Foreground="#9C4221" IsVisible="{Binding HasStudentSystemPolicyError}" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
          <Border Background="#FFF8E8" BorderBrush="#EED99C" BorderThickness="1" CornerRadius="14" Padding="18">
            <StackPanel Spacing="10">
              <TextBlock Text="电脑较多或画面运行较慢？" FontSize="17" FontWeight="SemiBold" Foreground="#674E16" />
              <TextBlock Text="电脑多或画面卡顿时，降低 Master 画质并调长刷新间隔；学生分辨率过高时再降低分辨率。" TextWrapping="Wrap" Foreground="#674E16" />
              <Button Content="打开 Veyon Configurator" Click="OpenVeyonConfigurator" IsEnabled="{Binding CanOpenVeyonConfigurator}" HorizontalAlignment="Left" />
              <TextBlock Text="{Binding ConfiguratorLaunchError}" Foreground="#9C4221" IsVisible="{Binding HasConfiguratorLaunchError}" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
        </StackPanel>
        <StackPanel IsVisible="{Binding IsSetupPage}" Spacing="20">
          <Border Classes="card">
            <StackPanel Spacing="16">
              <TextBlock Text="生成学生校区配置包" FontSize="20" FontWeight="SemiBold" />
              <TextBlock Text="配置包仅含校区公钥；教师私钥留在本机。" TextWrapping="Wrap" Classes="muted" />
              <StackPanel Spacing="8">
                <TextBlock Text="校区名称" />
              <TextBox Text="{Binding CampusId, Mode=TwoWay}" PlaceholderText="智学前程-校区名称" />
              <TextBlock Text="默认以“智学前程-”开头；生成后请勿更改校区名。" Classes="muted" TextWrapping="Wrap" />
                <TextBlock Text="输出目录（默认桌面）" />
                <TextBox Text="{Binding RoomOutputDir, Mode=TwoWay}" PlaceholderText="留空则生成到 桌面\Veyon-学生配置包-校区ID" />
              </StackPanel>
              <Border Classes="status-panel info" Padding="12">
                <StackPanel Spacing="8">
                  <TextBlock Text="学生端首次部署建议" FontWeight="SemiBold" />
                  <TextBlock Text="这些设置只作为配置包中的初始建议。学生端仍会检查环境、展示完整计划并等待维护人员确认；管理员密码建议不会自动勾选。"
                             Classes="muted" TextWrapping="Wrap" />
                  <CheckBox Content="建议安装并配置 Veyon（默认）" IsChecked="{Binding RecommendInstallVeyon, Mode=TwoWay}" />
                  <CheckBox Content="建议修改电脑名称" IsChecked="{Binding RecommendRenameComputer, Mode=TwoWay}" />
                  <CheckBox Content="建议创建学生账户" IsChecked="{Binding RecommendCreateStudentAccount, Mode=TwoWay}" />
                  <CheckBox Content="建议维护管理员密码（学生端需核对账户后手动选择）"
                            IsChecked="{Binding RecommendChangeAdminPassword, Mode=TwoWay}" />
                </StackPanel>
              </Border>
              <Button Classes="primary" Content="生成学生校区配置包" Click="GeneratePackage" IsEnabled="{Binding CanGenerateStudentPackage}" HorizontalAlignment="Left" />
              <StackPanel IsVisible="{Binding IsGeneratingStudentPackage}" Spacing="6">
                <ProgressBar IsIndeterminate="True" Height="6" />
                <TextBlock Text="{Binding PackageGenerationStatus}" Classes="muted" TextWrapping="Wrap" />
                <Button Content="取消配置包生成" Click="CancelPackageGeneration" IsVisible="{Binding IsBuildingStudentPackage}" IsEnabled="{Binding CanCancelStudentPackageGeneration}" HorizontalAlignment="Left" />
              </StackPanel>
              <TextBlock Text="{Binding PackageOutput}" Foreground="#246356" IsVisible="{Binding HasPackageOutput}" TextWrapping="Wrap" />
              <TextBlock Text="{Binding PackageOutputError}" Foreground="#9C4221" IsVisible="{Binding HasPackageOutputError}" TextWrapping="Wrap" />
              <Button Content="确认更换教师签名密钥并继续生成" Click="ReplaceWebsiteSigningKey" IsVisible="{Binding CanReplaceWebsiteSigningKey}" IsEnabled="{Binding CanGenerateStudentPackage}" HorizontalAlignment="Left" />
            </StackPanel>
          </Border>
          <Border Classes="card">
            <StackPanel Spacing="14">
              <TextBlock Text="发布到 CloudBase 云端目录" FontSize="20" FontWeight="SemiBold" />
              <StackPanel Spacing="8">
                <TextBlock Text="学生搜索名称（与配置包一致）" />
                <TextBlock Text="{Binding PublishCampusName}" FontWeight="SemiBold" />
                <TextBlock Text="教师姓名" />
                <TextBox Text="{Binding PublisherName, Mode=TwoWay}" MaxLength="100" PlaceholderText="填写发布教师姓名" />
                <TextBlock Text="教师手机号后四位" />
                <TextBox Text="{Binding TeacherPhoneLast4, Mode=TwoWay}" MaxLength="4" PlaceholderText="4 位数字" />
                <TextBlock Text="供学生下载校验。" Classes="muted" />
                <TextBlock Text="{Binding PackagePublisherStatus}" Classes="muted" IsVisible="{Binding HasPackagePublisherStatus}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding PackagePublisherError}" Foreground="#9C4221" IsVisible="{Binding HasPackagePublisherError}" TextWrapping="Wrap" />
              </StackPanel>
              <StackPanel Spacing="8">
                <TextBlock Text="要上传的配置包文件夹" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                  <TextBox Text="{Binding PublishPackageDirectory, Mode=TwoWay}" PlaceholderText="生成配置包后会自动填入，也可手动选择文件夹" />
                  <Button Grid.Column="1" Content="选择文件夹…" Click="ChoosePublishPackageDirectory" />
                </Grid>
                <TextBlock Text="仅发布已校验的配置包（ZIP 不超过 64 KiB）。" Classes="muted" TextWrapping="Wrap" />
                <Button Classes="primary" Content="验证并发布到云端目录"
                        IsEnabled="{Binding CanPublishStudentPackage}"
                        Click="PublishStudentPackage" HorizontalAlignment="Left" />
                <TextBlock Text="{Binding PackagePublishResult}" Foreground="#246356" IsVisible="{Binding HasPackagePublishResult}" TextWrapping="Wrap" />
              </StackPanel>
            </StackPanel>
          </Border>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Window>
