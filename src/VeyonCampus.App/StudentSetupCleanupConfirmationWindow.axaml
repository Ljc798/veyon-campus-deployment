<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="VeyonCampus.App.StudentSetupCleanupConfirmationWindow"
        Title="清理学生部署工具前确认" Width="620" SizeToContent="Height"
        CanResize="False" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Background="#F3F6F8">
  <Border Background="White" CornerRadius="14" BorderBrush="#E3E9EC" BorderThickness="1" Padding="24" Margin="18">
    <StackPanel Spacing="14">
      <TextBlock Text="清理前，请确认本机配置已完成" FontSize="21" FontWeight="Bold" />
      <TextBlock Text="移除工具后将无法补做设置；尚未完成请返回。" TextWrapping="Wrap" Foreground="#536671" />
      <Border Background="#F7F9FA" BorderBrush="#E3E9EC" BorderThickness="1" CornerRadius="10" Padding="14">
        <StackPanel Spacing="12">
          <CheckBox x:Name="OtherSettingsCheck" IsCheckedChanged="UpdateConfirmationState">
            <TextBlock Text="所需设置已完成，或确认无需调整。" TextWrapping="Wrap" />
          </CheckBox>
          <CheckBox x:Name="StudentAccountCheck" IsCheckedChanged="UpdateConfirmationState">
            <TextBlock Text="学生账户已就绪，并具有普通权限。" TextWrapping="Wrap" />
          </CheckBox>
          <CheckBox x:Name="ComputerNameCheck" IsCheckedChanged="UpdateConfirmationState">
            <TextBlock Text="电脑名称已修改并重启，或确认无需修改。" TextWrapping="Wrap" />
          </CheckBox>
        </StackPanel>
      </Border>
      <TextBlock Text="只移除部署工具文件；Veyon、后台代理和校区配置会保留。" TextWrapping="Wrap" Foreground="#536671" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
        <Button Content="返回继续配置" IsCancel="True" MinWidth="130" Classes="secondary" />
        <Button x:Name="ConfirmCleanupButton" Content="确认退出并清理" IsDefault="True" IsEnabled="False" Click="ConfirmCleanup" MinWidth="150" Classes="primary" />
      </StackPanel>
    </StackPanel>
  </Border>
</Window>
