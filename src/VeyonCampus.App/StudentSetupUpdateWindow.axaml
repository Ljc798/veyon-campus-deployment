<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:VeyonCampus.App" x:Class="VeyonCampus.App.StudentSetupUpdateWindow" x:DataType="vm:StudentSetupUpdateViewModel" Title="学生部署工具更新" Width="640" Height="560" MinWidth="560" MinHeight="490" WindowStartupLocation="CenterOwner" CanResize="True">
  <Grid RowDefinitions="Auto,*,Auto" Margin="26" RowSpacing="18">
    <StackPanel Spacing="4">
      <TextBlock Text="学生部署工具更新" FontSize="22" FontWeight="Bold" />
      <TextBlock Text="只更新这台电脑；批量更新请用教师端。" Classes="muted" TextWrapping="Wrap" />
      <TextBlock Text="当前版本：" Classes="muted" />
      <TextBlock Text="{Binding CurrentVersion}" FontSize="15" FontWeight="SemiBold" />
    </StackPanel>
    <StackPanel Grid.Row="1" Spacing="12">
      <Border Background="#F1F6FC" CornerRadius="8" Padding="14">
        <StackPanel Spacing="8">
          <TextBlock Text="在线更新" FontSize="16" FontWeight="SemiBold" />
          <TextBlock Text="{Binding Status}" TextWrapping="Wrap" MinHeight="42" />
          <WrapPanel>
            <Button Content="检查更新" Click="CheckLatest" IsEnabled="{Binding CanCheckLatest}" Margin="0,0,8,0" />
            <Button Content="下载并重启" Click="DownloadAndInstall" IsEnabled="{Binding CanDownloadAndInstall}" Margin="0,0,8,0" />
          </WrapPanel>
        </StackPanel>
      </Border>
      <Expander Header="离线更新" IsExpanded="False">
        <StackPanel Spacing="8" Margin="0,8,0,0">
          <TextBlock Text="在有网络的电脑导出更新包，再复制到离线电脑。" Classes="muted" TextWrapping="Wrap" />
          <TextBlock Text="{Binding OfflineStatus}" TextWrapping="Wrap" />
          <WrapPanel>
            <Button Content="导出离线更新包…" Click="ExportOfflineUpdate" IsEnabled="{Binding CanExportOfflineUpdate}" Margin="0,0,8,0" />
            <Button Content="选择并验证更新包…" Click="SelectOfflineUpdate" IsEnabled="{Binding CanVerifyOfflineUpdate}" Margin="0,0,8,0" />
            <Button Content="安装更新并重启" Click="InstallOfflineUpdate" IsEnabled="{Binding CanInstallOfflineUpdate}" />
          </WrapPanel>
        </StackPanel>
      </Expander>
      <Expander Header="遇到问题？" IsExpanded="False">
        <StackPanel Spacing="8" Margin="0,8,0,0">
          <TextBlock Text="{Binding DiagnosticsStatus}" Classes="muted" TextWrapping="Wrap" IsVisible="{Binding HasDiagnosticsStatus}" />
          <Button Content="导出问题报告…" Click="ExportUpdateDiagnostics" HorizontalAlignment="Left" />
        </StackPanel>
      </Expander>
    </StackPanel>
    <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="8">
      <Button Grid.Column="1" Content="关闭" Click="Cancel" MinWidth="90" />
    </Grid>
  </Grid>
</Window>
