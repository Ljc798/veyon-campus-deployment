<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="using:VeyonCampus.App"
        x:Class="VeyonCampus.App.TeacherMacRemoteAccessWindow"
        x:DataType="app:TeacherMacRemoteAccessWindow"
        Title="MacBook 远程连接" Width="680" SizeToContent="Height" MinWidth="540" CanResize="False"
        WindowStartupLocation="CenterOwner" Background="#F3F6F8">
  <StackPanel Margin="24" Spacing="16">
    <StackPanel Spacing="5">
      <TextBlock Text="从 MacBook 配置教师机" FontSize="22" FontWeight="SemiBold" />
      <TextBlock Text="用 Microsoft Windows App 远程打开这台 Windows 教师机上的完整教师控制台。配置和密钥仍保存在教师机。"
                 Classes="muted" TextWrapping="Wrap" />
    </StackPanel>

    <Border Classes="card">
      <StackPanel Spacing="9">
        <TextBlock Text="教师机电脑名称" FontWeight="SemiBold" />
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
          <TextBox x:Name="ComputerNameInput" IsReadOnly="True" />
          <Button Grid.Column="1" Classes="secondary" Content="复制电脑名称" Click="CopyComputerName" />
        </Grid>
        <TextBlock Text="在 Windows App 的“添加电脑”中，将此名称填入“电脑名称”。如果 Mac 无法解析此名称，请让校园网络管理员配置电脑名解析或 VPN DNS。"
                   Classes="muted" TextWrapping="Wrap" />
      </StackPanel>
    </Border>

    <Border Classes="card">
      <StackPanel Spacing="10">
        <TextBlock Text="连接步骤" FontWeight="SemiBold" />
        <TextBlock Text="1. 确认教师机使用支持远程桌面主机的 Windows 版本（Microsoft 面向 Windows 10/11 的说明要求 Pro），并允许你的 Windows 账户远程登录。"
                   TextWrapping="Wrap" />
        <Button Classes="secondary" Content="打开 Windows 远程桌面设置" Click="OpenRemoteDesktopSettings"
                HorizontalAlignment="Left" />
        <TextBlock Text="2. 在 MacBook 安装并打开 Microsoft Windows App，选择“添加电脑”，输入上方电脑名称。"
                   TextWrapping="Wrap" />
        <TextBlock Text="3. 连接到校园可信 LAN；从校外使用时先连接学校 VPN。Windows App 提示时输入获准登录的 Windows 账户。"
                   TextWrapping="Wrap" />
        <TextBlock x:Name="ActionStatus" Classes="muted" TextWrapping="Wrap" />
      </StackPanel>
    </Border>

    <Border Classes="status-panel warning" Padding="14">
      <StackPanel Spacing="5">
        <TextBlock Text="远程登录会切换教师机本地会话" FontWeight="SemiBold" />
        <TextBlock Text="远程连接期间，教师机本地显示器会切到登录/锁定画面。正在课堂投屏或有其他人使用教师机时，不要建立远程桌面连接。"
                   TextWrapping="Wrap" />
      </StackPanel>
    </Border>

    <Border Classes="status-panel info" Padding="14">
      <TextBlock Text="连接只通过校园内网或学校 VPN。不要把远程桌面 3389 端口直接转发到公网；本工具不会开启远程桌面、改防火墙或保存 Windows 密码。"
                 TextWrapping="Wrap" />
    </Border>

    <Button Content="关闭" Click="CloseWindow" HorizontalAlignment="Right" />
  </StackPanel>
</Window>
