<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="VeyonCampus.App.TeacherReleaseNoticeWindow"
        Title="发现新版本" Width="460" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner" Background="#F5F7FA">
  <StackPanel Margin="24" Spacing="16">
    <TextBlock Text="发现可用的新版本" FontSize="22" FontWeight="Bold" />
    <TextBlock x:Name="ReleaseDetails" TextWrapping="Wrap" />
    <TextBlock Text="可在更新页安装教师端更新，也可向学生电脑推送更新。"
               Classes="muted" TextWrapping="Wrap" />
    <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
      <Button Content="稍后" Click="CloseWindow" IsCancel="True" Classes="secondary" />
      <Button Content="打开更新页面" Click="OpenUpdates" IsDefault="True" Classes="primary" />
    </StackPanel>
  </StackPanel>
</Window>
