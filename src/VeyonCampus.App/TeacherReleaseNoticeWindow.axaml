<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="VeyonCampus.App.TeacherReleaseNoticeWindow"
        Title="发现新版本" Width="460" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner" Background="#F5F7FA">
  <StackPanel Margin="24" Spacing="16">
    <TextBlock Text="发现可用的新版本" FontSize="22" FontWeight="Bold" />
    <TextBlock x:Name="ReleaseDetails" TextWrapping="Wrap" />
    <TextBlock Text="当前仅提供版本提醒，下载和安装入口尚未完成测试，请暂勿在此处更新。"
               Classes="muted" TextWrapping="Wrap" />
    <Button Content="知道了" Click="CloseWindow" HorizontalAlignment="Right" />
  </StackPanel>
</Window>
