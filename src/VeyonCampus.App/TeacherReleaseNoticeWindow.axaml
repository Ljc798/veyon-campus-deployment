<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="VeyonCampus.App.TeacherReleaseNoticeWindow"
        Title="发现新版本" Width="460" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner" Background="#F5F7FA">
  <StackPanel Margin="24" Spacing="16">
    <TextBlock Text="发现可用的新版本" FontSize="22" FontWeight="Bold" />
    <TextBlock x:Name="ReleaseDetails" TextWrapping="Wrap" />
    <TextBlock Text="打开更新页即可检查并安装教师端版本，或向选中的学生电脑推送学生端更新。安装前仍会验证发布签名和策略兼容能力。"
               Classes="muted" TextWrapping="Wrap" />
    <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
      <Button Content="稍后" Click="CloseWindow" IsCancel="True" />
      <Button Content="打开更新页面" Click="OpenUpdates" IsDefault="True" />
    </StackPanel>
  </StackPanel>
</Window>
