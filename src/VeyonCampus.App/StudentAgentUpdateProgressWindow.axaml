<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:VeyonCampus.App"
        x:Class="VeyonCampus.App.StudentAgentUpdateProgressWindow"
        x:DataType="vm:MainViewModel"
        Title="Student Agent 更新/修复"
        Width="540" Height="300"
        MinWidth="500" MinHeight="280"
        CanResize="False" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Background="#F5F7FA">
  <Border Margin="16" Padding="24" Background="#FFFFFF" BorderBrush="#D8E0E8"
          BorderThickness="1" CornerRadius="12">
    <Grid RowDefinitions="Auto,*">
      <TextBlock Text="Student Agent 更新/修复" FontSize="20" FontWeight="SemiBold" />
      <Grid Grid.Row="1" Margin="0,18,0,0">
        <StackPanel Spacing="13" IsVisible="{Binding IsStudentAgentInstallInProgress}">
          <TextBlock Text="管理员维护任务正在后台运行，请保持此窗口打开。" TextWrapping="Wrap" />
          <ProgressBar Value="{Binding StudentAgentInstallProgressPercent}" Maximum="100" Height="14" />
          <TextBlock Text="{Binding StudentAgentInstallProgressText}" FontWeight="SemiBold" />
          <TextBlock Text="{Binding StudentAgentInstallElapsedText}" Classes="muted" TextWrapping="Wrap" />
          <TextBlock Text="进度会随处理时间前进；请等待操作结果提示。" Classes="muted" TextWrapping="Wrap" />
        </StackPanel>
        <Grid IsVisible="{Binding HasStudentAgentInstallResult}" RowDefinitions="*,Auto">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <TextBlock Text="{Binding StudentAgentInstallResultText}" TextWrapping="Wrap" />
          </ScrollViewer>
          <Button Grid.Row="1" Content="关闭" HorizontalAlignment="Right" MinWidth="96"
                  Margin="0,16,0,0" Click="CloseDialog" />
        </Grid>
      </Grid>
    </Grid>
  </Border>
</Window>
