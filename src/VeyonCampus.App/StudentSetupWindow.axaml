<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:VeyonCampus.App"
        x:Class="VeyonCampus.App.StudentSetupWindow" x:DataType="vm:MainViewModel"
        Title="Veyon Campus 学生部署工具" Width="1240" Height="880" MinWidth="1024" MinHeight="700"
        Background="#F3F6F8">
  <Grid ColumnDefinitions="244,*">
    <Border Background="#102A3A" Padding="20,28">
      <Grid RowDefinitions="Auto,*,Auto">
        <StackPanel Spacing="18">
          <StackPanel Orientation="Horizontal" Spacing="12">
            <Border Width="52" Height="52" CornerRadius="15" Background="#FFFFFF" Padding="4">
              <Image Source="avares://VeyonCampus.StudentSetup/Assets/veyon-campus-mark.png" Stretch="Uniform" />
            </Border>
            <StackPanel VerticalAlignment="Center" Spacing="2">
              <TextBlock Text="VEYON CAMPUS" Foreground="#8DDECC" FontSize="12" FontWeight="Bold" />
              <TextBlock Text="校园部署助手" Foreground="White" FontSize="18" FontWeight="Bold" />
            </StackPanel>
          </StackPanel>
          <TextBlock Text="课堂设备管理与离线部署" Foreground="#B7C9D2" FontSize="12" />
        </StackPanel>
        <StackPanel Grid.Row="1" Spacing="10" Margin="0,36,0,0">
          <TextBlock Text="学生部署工具" Foreground="#8DDECC" FontSize="13" FontWeight="SemiBold" />
          <TextBlock Text="仅用于初始化本机学生端；部署通过后可清理此工具。" Foreground="#B7C9D2" FontSize="12" TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Grid.Row="2" Spacing="8">
          <Border Height="1" Background="#31505D" Margin="0,0,0,8" />
          <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBlock Text="Veyon Campus" Foreground="#B5C6D0" FontSize="12" />
            <TextBlock Text="{Binding AppVersion}" Foreground="#8DDECC" FontSize="12" FontWeight="SemiBold" />
          </StackPanel>
          <TextBlock Text="系统修改与后台代理需在可还原的 Windows 测试机验收。" Foreground="#B5C6D0" FontSize="12" TextWrapping="Wrap" />
        </StackPanel>
      </Grid>
    </Border>
    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Background="#F3F6F8">
      <StackPanel Margin="34,30,34,36" Spacing="20">
        <Border Background="#FFFFFF" CornerRadius="16" Padding="24,20" BorderBrush="#E3E9EC" BorderThickness="1">
          <StackPanel Spacing="7">
            <TextBlock Text="{Binding PageTitle}" FontSize="28" FontWeight="Bold" />
            <TextBlock Text="{Binding PageDescription}" Classes="muted" TextWrapping="Wrap" />
          </StackPanel>
        </Border>
        <Border Background="#E6F3EF" BorderBrush="#C9E4DB" BorderThickness="1" CornerRadius="12" Padding="16,13">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
            <Border Width="4" CornerRadius="2" Background="#168574" />
            <TextBlock Grid.Column="1" Text="{Binding EnvironmentNote}" Foreground="#245F55" TextWrapping="Wrap" VerticalAlignment="Center" />
          </Grid>
        </Border>
<StackPanel IsEnabled="{Binding IsStudentControlsEnabled}" Spacing="20">
          <Border Classes="card">
            <StackPanel Spacing="12">
              <TextBlock Text="01  选择操作" FontSize="18" FontWeight="SemiBold" />
              <TextBlock Text="四项可分别执行，也可组合执行；只运行明确勾选的操作。创建学生账户时可不设密码；修改管理员密码仍需输入两次新密码。计划和运行记录不会保存密码。" Classes="muted" TextWrapping="Wrap" />
              <StackPanel Orientation="Horizontal" Spacing="2">
                <CheckBox Content="安装并配置 Veyon" IsChecked="{Binding InstallVeyon, Mode=TwoWay}" />
                <Button Classes="help" Content="ⓘ" Tag="在这台电脑上安装 Veyon，并导入教师端的公钥，以便教师端连接和管理。已有正确安装与配置时，可不重复执行。" Click="ShowOperationHelp" ToolTip.ShowDelay="0" ToolTip.Tip="安装 Veyon 并导入教师端公钥。已有正确配置时无需重复执行。" />
              </StackPanel>
              <Border Background="#EDF5F7" CornerRadius="8" Padding="12" Margin="24,0,0,6">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                  <TextBlock Text="{Binding VeyonStatusText}" TextWrapping="Wrap" VerticalAlignment="Center" />
                  <Button Grid.Column="1" Content="重新检测" IsEnabled="{Binding CanRefreshVeyonStatus}" Click="RefreshVeyonStatus" VerticalAlignment="Center" />
                </Grid>
              </Border>
              <StackPanel Orientation="Horizontal" Spacing="2">
                <CheckBox Content="修改电脑名（需要重启）" IsChecked="{Binding RenameComputer, Mode=TwoWay}" />
                <Button Classes="help" Content="ⓘ" Tag="首次部署时建议按机房编号设置唯一电脑名，方便教师识别。若名称已经正确，就不必再次修改；改名通常需要重启后生效。" Click="ShowOperationHelp" ToolTip.ShowDelay="0" ToolTip.Tip="按机房编号设置唯一电脑名。名称已正确时无需再改；改名通常需要重启。" />
              </StackPanel>
              <Grid IsVisible="{Binding RenameComputer}" ColumnDefinitions="160,24,*" Margin="24,0,0,6">
                <StackPanel Spacing="8">
                  <TextBlock Text="电脑编号（1–150）" />
                  <TextBox Text="{Binding Number, Mode=TwoWay}" PlaceholderText="例如：03 或 150" MaxLength="3" />
                </StackPanel>
                <StackPanel Grid.Column="2" Spacing="8" VerticalAlignment="Center">
                  <TextBlock Text="规划电脑名" Classes="muted" />
                  <TextBlock Text="{Binding ComputerName}" FontSize="22" FontWeight="SemiBold" />
                </StackPanel>
              </Grid>
              <StackPanel Orientation="Horizontal" Spacing="2">
                <CheckBox Content="创建普通学生账户" IsChecked="{Binding CreateStudent, Mode=TwoWay}" />
                <Button Classes="help" Content="ⓘ" Tag="创建不具备管理员权限的学生账户，减少学生修改系统设置和安装需要管理员权限的软件的机会。普通账户本身不能阻止下载或运行所有软件；若要限制这些行为，还需配置 Windows 策略。已有合适的学生账户时无需重复创建。" Click="ShowOperationHelp" ToolTip.ShowDelay="0" ToolTip.Tip="创建普通权限账户，减少需要管理员权限的安装和设置修改。限制下载或运行软件还需 Windows 策略。" />
              </StackPanel>
              <StackPanel IsVisible="{Binding CreateStudent}" Margin="24,0,0,6" Spacing="8">
                <TextBlock Text="学生账户名" />
                <TextBox Text="{Binding StudentAccountName, Mode=TwoWay}" MaxLength="20" />
                <TextBlock Text="新账户初始密码（两处都留空则不设密码，登录限制受 Windows 策略影响；填写时两次一致；已有合格普通账户会跳过）" Classes="muted" TextWrapping="Wrap" />
                <TextBox x:Name="StudentInitialPasswordBox" PasswordChar="●" PlaceholderText="初始密码（可留空）" MaxLength="127" />
                <TextBox x:Name="StudentInitialPasswordConfirmationBox" PasswordChar="●" PlaceholderText="确认初始密码（可留空）" MaxLength="127" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="2">
                <CheckBox Content="设置指定本地管理员账户密码" IsChecked="{Binding ChangeAdminPassword, Mode=TwoWay}" />
                <Button Classes="help" Content="ⓘ" Tag="更换指定本地管理员账户的密码，降低旧密码被学生使用的风险。只在确认目标账户和现有密码管理方式后操作；如果密码已安全管理，不必每次部署都修改。" Click="ShowOperationHelp" ToolTip.ShowDelay="0" ToolTip.Tip="更换指定本地管理员密码，降低旧密码被使用的风险。确认目标账户后操作，无需每次都改。" />
              </StackPanel>
              <StackPanel IsVisible="{Binding ChangeAdminPassword}" Margin="24,0,0,0" Spacing="8">
                <TextBlock Text="目标本地管理员账户名（默认 Administrator）" />
                <TextBox Text="{Binding AdminAccountName, Mode=TwoWay}" PlaceholderText="Administrator" MaxLength="20" />
                <TextBlock Text="新密码（两次输入一致；首尾空格按原样保留）" Classes="muted" TextWrapping="Wrap" />
                <TextBox x:Name="AdminPasswordBox" PasswordChar="●" PlaceholderText="新密码" MaxLength="127" />
                <TextBox x:Name="AdminPasswordConfirmationBox" PasswordChar="●" PlaceholderText="再次输入新密码" MaxLength="127" />
              </StackPanel>
              <Grid ColumnDefinitions="*,20,*" RowDefinitions="Auto,Auto">
                <TextBlock Text="校区名称（用于 Veyon 配置）" Margin="0,0,0,8" />
                <TextBlock Grid.Column="2" Text="电脑名前缀" Margin="0,0,0,8" />
                <TextBox Grid.Row="1" Text="{Binding Campus, Mode=TwoWay}" PlaceholderText="例如：演示校区" />
                <TextBox Grid.Row="1" Grid.Column="2" Text="{Binding Prefix, Mode=TwoWay}" PlaceholderText="PC-" />
              </Grid>
              <TextBlock Text="只改名或执行账户操作时不需要校区配置包；校区与前缀仍可填写。" Classes="muted" IsVisible="{Binding NeedsVeyonPackage}" TextWrapping="Wrap" />
              <Border Background="#EDF5F7" CornerRadius="8" Padding="12" IsVisible="{Binding HasOperationHelp}">
                <TextBlock Text="{Binding OperationHelpText}" TextWrapping="Wrap" />
              </Border>
            </StackPanel>
          </Border>
          <Border Classes="card" IsVisible="{Binding InstallVeyon}">
            <StackPanel Spacing="14">
              <TextBlock Text="02  校区配置资料" FontSize="18" FontWeight="SemiBold" />
              <TextBlock Text="选择 Veyon 操作时需要有效的校区公钥和命名配置。Veyon 安装器已内嵌在 App 中，学生端无需联网下载；修改已导入的校区或前缀会使旧资料失效。" Classes="muted" TextWrapping="Wrap" />
              <Border Background="#EDF5F7" CornerRadius="8" Padding="14">
                <StackPanel Spacing="9">
                  <TextBlock Text="从教师电脑通过局域网获取" FontWeight="SemiBold" />
                  <TextBlock Text="先在教师端开启局域网分发，然后照抄教师端显示的完整地址和两组代码。请先对照证书核对码；匹配后才会在 HTTPS 连接中发送配对码。下载先写入临时文件，完整性和校区信息通过校验后保存到本机配置目录并载入。" Classes="muted" TextWrapping="Wrap" />
                  <TextBlock Text="教师端 HTTPS 地址" />
                  <TextBox x:Name="LanTeacherAddressBox" PlaceholderText="https://192.168.1.10:48731/v1/campus-configuration" />
                  <TextBlock Text="服务器证书核对码" />
                  <TextBox x:Name="LanCertificateCodeBox" PlaceholderText="例如：12AB-34CD-56EF-7890" MaxLength="23" />
                  <TextBlock Text="临时配对码" />
                  <TextBox x:Name="LanPairingCodeBox" PasswordChar="●" PlaceholderText="例如：ABCD-EFGH-JKLM-NPQR-STUV" MaxLength="24" />
                  <WrapPanel>
                    <Button x:Name="DownloadLanPackageButton" Classes="primary" Content="安全获取校区配置" IsEnabled="{Binding IsStudentControlsEnabled}" Click="DownloadLanPackage" Margin="0,0,8,8" />
                    <Button x:Name="CancelLanPackageDownloadButton" Content="取消下载" IsVisible="False" Click="CancelLanPackageDownload" Margin="0,0,8,8" />
                  </WrapPanel>
                  <TextBlock x:Name="LanPackageTransferStatus" Classes="muted" TextWrapping="Wrap" />
                </StackPanel>
              </Border>
              <Border x:Name="PackageDropZone" Classes="dropzone" DragDrop.AllowDrop="True">
                <StackPanel Spacing="12">
                  <TextBlock Text="将校区配置包文件夹、manifest.json 或 campus.json 拖到这里" FontWeight="SemiBold" />
                  <TextBlock Text="普通权限运行时可拖入。以管理员身份运行时，Windows 会阻止从普通文件资源管理器拖放到管理员窗口，请使用下方“选择校区配置包”。" Classes="muted" TextWrapping="Wrap" />
                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button Content="选择校区配置包" Click="SelectPackage" />
                    <Button Content="清除配置包" Click="ClearPackage" />
                    <Button Content="重置表单" Click="ResetForm" />
                  </StackPanel>
                </StackPanel>
              </Border>
              <TextBlock Text="{Binding PackageStatus}" Classes="muted" TextWrapping="Wrap" />
              <Border Background="#FFF1E8" CornerRadius="8" Padding="12" IsVisible="{Binding HasPackageError}">
                <TextBlock Text="{Binding PackageError}" Foreground="#9C4221" TextWrapping="Wrap" />
              </Border>
            </StackPanel>
          </Border>
          <Border Classes="card">
            <StackPanel Spacing="10">
              <TextBlock Text="03  核对计划并检查环境" FontSize="18" FontWeight="SemiBold" />
              <TextBlock Text="点击一次即可同时生成部署计划并检查本机环境。计划说明将执行什么；只读检查确认 Windows、权限、账户、Veyon 与安装资源当前是否满足条件。检查不会修改系统，两项都通过后才可执行。" Classes="muted" TextWrapping="Wrap" />
              <Button Classes="primary" Content="生成预览并检查环境" IsEnabled="{Binding CanPrepareDeployment}" Click="PrepareDeployment" HorizontalAlignment="Left" Margin="0,0,8,8" />
              <TextBlock Text="{Binding PreparationStatusText}" IsVisible="{Binding HasPreparationStatus}" Classes="muted" TextWrapping="Wrap" />
              <TextBlock Text="04  确认执行" FontWeight="SemiBold" />
              <WrapPanel>
                <Button Content="确认并仅安装 Veyon" IsEnabled="{Binding CanInstall}" Click="InstallVeyon" Margin="0,0,8,8" />
                <Button Content="确认并执行所选操作" IsEnabled="{Binding CanStartDeployment}" Click="StartDeployment" Margin="0,0,8,8" />
              </WrapPanel>
              <StackPanel Spacing="4">
                <TextBlock Text="{Binding InstallAvailabilityText}" Classes="muted" TextWrapping="Wrap" />
                <TextBlock Text="{Binding DeploymentAvailabilityText}" Classes="muted" TextWrapping="Wrap" />
              </StackPanel>
            </StackPanel>
          </Border>
          <Border Background="#FFF1E8" CornerRadius="8" Padding="16" IsVisible="{Binding HasGlobalError}">
            <TextBlock Text="{Binding Error}" Foreground="#9C4221" TextWrapping="Wrap" />
          </Border>
          <Border Classes="card" IsVisible="{Binding HasPreview}">
            <StackPanel Spacing="12">
              <TextBlock Text="部署准备结果" FontSize="18" FontWeight="SemiBold" />
              <TextBlock Text="计划预览 · 本次将执行的步骤和影响" FontWeight="SemiBold" />
              <TextBlock Text="{Binding PreviewText}" TextWrapping="Wrap" />
              <TextBlock Text="执行前会再次核对本地账户 SID 和系统状态。密码不会显示在计划中，执行结束后输入框会清空；密码修改无法自动恢复旧值。" Classes="muted" TextWrapping="Wrap" />
              <Border Height="1" Background="#E3E9EC" Margin="0,4" IsVisible="{Binding HasPreflight}" />
              <TextBlock Text="只读环境检查 · 当前电脑是否满足执行条件" FontWeight="SemiBold" IsVisible="{Binding HasPreflight}" />
              <TextBlock Text="{Binding PreflightText}" TextWrapping="Wrap" IsVisible="{Binding HasPreflight}" />
              <TextBlock Text="未知项目仍需在 Windows 测试机核对；此检查不会修改系统，且需无阻断项后才能执行。" Classes="muted" TextWrapping="Wrap" IsVisible="{Binding HasPreflight}" />
            </StackPanel>
          </Border>
          <Border Classes="card" IsVisible="{Binding HasExecution}">
            <StackPanel Spacing="12">
              <TextBlock Text="部署结果" FontSize="18" FontWeight="SemiBold" />
              <TextBlock Text="{Binding ExecutionText}" TextWrapping="Wrap" />
              <TextBlock Text="结果基于操作后的读回验证；失败不等于未修改，请按上方逐条核对已完成的步骤。重启后建议再次运行只读环境检查。" Classes="muted" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
          <Border Classes="card">
            <StackPanel Spacing="12">
              <TextBlock Text="05  部署后只读检查与清理" FontSize="18" FontWeight="SemiBold" />
              <TextBlock Text="部署完成或按要求重启后，重新载入本校区配置包并检查 Veyon 公钥、服务和独立网站代理。只有后台组件全部确认，才会允许清理便携 GUI 部署工具。清理前还会请你确认其他配置、普通学生账户和电脑名称都已处理，或确认本次无需处理。清理仅删除发布清单中的 App 文件，不删除 Veyon、后台代理、校区包或其他文件。" Classes="muted" TextWrapping="Wrap" />
              <WrapPanel>
                <Button Content="运行部署后只读检查" IsEnabled="{Binding CanVerifyStudentDeployment}" Click="VerifyStudentDeployment" Margin="0,0,8,8" />
                <Button Classes="primary" Content="完成配置后退出并清理部署工具" IsEnabled="{Binding CanFinishStudentSetup}" Click="FinishStudentSetup" Margin="0,0,8,8" />
              </WrapPanel>
              <TextBlock Text="{Binding StudentSetupCleanupAvailability}" Classes="muted" TextWrapping="Wrap" />
              <TextBlock Text="{Binding StudentDeploymentVerificationText}" TextWrapping="Wrap" IsVisible="{Binding HasStudentDeploymentVerification}" />
              <TextBlock Text="{Binding StudentSetupCleanupText}" Foreground="#246356" TextWrapping="Wrap" IsVisible="{Binding HasStudentSetupCleanupText}" />
            </StackPanel>
          </Border>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Window>
