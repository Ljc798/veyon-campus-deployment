<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:VeyonCampus.App" x:Class="VeyonCampus.App.StudentSetupWindow" x:DataType="vm:MainViewModel" Title="Veyon Campus 学生部署工具" Width="1080" Height="760" Background="#F5F7FA" CanResize="True" WindowStartupLocation="CenterScreen">
  <Window.Styles>
    <Style Selector="Button.wizard-step">
      <Setter Property="Background" Value="#FFFFFF" />
      <Setter Property="BorderBrush" Value="#D8E0E8" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Padding" Value="10,7" />
      <Setter Property="MinHeight" Value="58" />
    </Style>
    <Style Selector="Button.wizard-step TextBlock.step-title">
      <Setter Property="Foreground" Value="#475467" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Border.step-number">
      <Setter Property="Background" Value="#E9EEF3" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="Width" Value="28" />
      <Setter Property="Height" Value="28" />
    </Style>
    <Style Selector="Border.step-number TextBlock">
      <Setter Property="Foreground" Value="#526171" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.wizard-step.complete">
      <Setter Property="Background" Value="#EEF7F1" />
      <Setter Property="BorderBrush" Value="#B7DEC4" />
    </Style>
    <Style Selector="Button.wizard-step.complete Border.step-number">
      <Setter Property="Background" Value="#16834A" />
    </Style>
    <Style Selector="Button.wizard-step.complete Border.step-number TextBlock">
      <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>
    <Style Selector="Button.wizard-step.error">
      <Setter Property="Background" Value="#FFF8EE" />
      <Setter Property="BorderBrush" Value="#F3C47A" />
    </Style>
    <Style Selector="Button.wizard-step.error Border.step-number">
      <Setter Property="Background" Value="#B54708" />
    </Style>
    <Style Selector="Button.wizard-step.error Border.step-number TextBlock">
      <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>
    <Style Selector="Button.wizard-step.current">
      <Setter Property="Background" Value="#0B69C7" />
      <Setter Property="BorderBrush" Value="#0B69C7" />
    </Style>
    <Style Selector="Button.wizard-step.current TextBlock.step-title">
      <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>
    <Style Selector="Button.wizard-step.current Border.step-number">
      <Setter Property="Background" Value="#FFFFFF" />
    </Style>
    <Style Selector="Button.wizard-step.current Border.step-number TextBlock">
      <Setter Property="Foreground" Value="#0B69C7" />
    </Style>
    <Style Selector="Button.wizard-step:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="BorderBrush" Value="#0B69C7" />
    </Style>
    <Style Selector="Border.status-pill">
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="9,4" />
      <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <Style Selector="Border.status-pill.success">
      <Setter Property="Background" Value="#E8F5EC" />
    </Style>
    <Style Selector="Border.status-pill.success TextBlock">
      <Setter Property="Foreground" Value="#18733D" />
    </Style>
    <Style Selector="Border.status-pill.warning">
      <Setter Property="Background" Value="#FFF3DB" />
    </Style>
    <Style Selector="Border.status-pill.warning TextBlock">
      <Setter Property="Foreground" Value="#985800" />
    </Style>
    <Style Selector="Border.status-pill.error">
      <Setter Property="Background" Value="#FDECEC" />
    </Style>
    <Style Selector="Border.status-pill.error TextBlock">
      <Setter Property="Foreground" Value="#B42318" />
    </Style>
    <Style Selector="Border.status-pill.info">
      <Setter Property="Background" Value="#EAF2FB" />
    </Style>
    <Style Selector="Border.status-pill.info TextBlock">
      <Setter Property="Foreground" Value="#175EA8" />
    </Style>
    <Style Selector="Border.status-pill.neutral">
      <Setter Property="Background" Value="#EEF1F4" />
    </Style>
    <Style Selector="Border.status-pill.neutral TextBlock">
      <Setter Property="Foreground" Value="#526171" />
    </Style>
    <Style Selector="Border.preflight-row">
      <Setter Property="Background" Value="#FFFFFF" />
      <Setter Property="BorderBrush" Value="#E2E7ED" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="13,10" />
      <Setter Property="Margin" Value="0,0,0,7" />
    </Style>
    <Style Selector="Border.execution-row">
      <Setter Property="Background" Value="#FFFFFF" />
      <Setter Property="BorderBrush" Value="#E2E7ED" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="14,11" />
      <Setter Property="Margin" Value="0,0,0,8" />
    </Style>
    <Style Selector="Border.execution-row.active">
      <Setter Property="Background" Value="#EFF6FD" />
      <Setter Property="BorderBrush" Value="#75AEE3" />
    </Style>
    <Style Selector="Border.catalog-item">
      <Setter Property="Background" Value="#FFFFFF" />
      <Setter Property="BorderBrush" Value="#E1E6EC" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style Selector="Button.source-choice">
      <Setter Property="Background" Value="#FFFFFF" />
      <Setter Property="BorderBrush" Value="#D6E2EE" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="11" />
      <Setter Property="Padding" Value="14" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="MinHeight" Value="92" />
    </Style>
    <Style Selector="Button.source-choice:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#F5F9FD" />
      <Setter Property="BorderBrush" Value="#80B4E3" />
    </Style>
    <Style Selector="Button">
      <Setter Property="Height" Value="40" />
    </Style>
    <Style Selector="Button">
      <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="TextBox">
      <Setter Property="Height" Value="40" />
    </Style>
    <Style Selector="TextBox">
      <Setter Property="Padding" Value="12,8" />
    </Style>
    <Style Selector="Border.card">
      <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style Selector="Border.option-card">
      <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style Selector="Button.source-choice">
      <Setter Property="Height" Value="92" />
    </Style>
    <Style Selector="Button.source-choice">
      <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style Selector="Button.wizard-step">
      <Setter Property="Height" Value="60" />
    </Style>
    <Style Selector="Button.wizard-step">
      <Setter Property="CornerRadius" Value="4" />
    </Style>
    <Style Selector="Button.wizard-step.complete">
      <Setter Property="Background" Value="#EDF3F9" />
    </Style>
    <Style Selector="Button.wizard-step.complete">
      <Setter Property="BorderBrush" Value="#D8E3EF" />
    </Style>
    <Style Selector="Button.wizard-step.error">
      <Setter Property="Background" Value="#F1F4F8" />
    </Style>
    <Style Selector="Button.wizard-step.error">
      <Setter Property="BorderBrush" Value="#D8E0E8" />
    </Style>
    <Style Selector="Button.wizard-step.current">
      <Setter Property="Background" Value="#0B69C7" />
    </Style>
    <Style Selector="Button.wizard-step.current">
      <Setter Property="BorderBrush" Value="#0B69C7" />
    </Style>
    <Style Selector="Button.wizard-step">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="Height" Value="56" />
      <Setter Property="Background" Value="#EDF4FC" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Template">
        <ControlTemplate>
          <Grid>
            <Path Data="M0,0 L184,0 L202,28 L184,56 L0,56 L18,28 Z" Stretch="Fill" Fill="{TemplateBinding Background}" />
            <ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20,0,12,0" />
          </Grid>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="Button.wizard-step.current">
      <Setter Property="Background" Value="#1479F5" />
    </Style>
    <Style Selector="Button.wizard-step:disabled">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Button.wizard-step.complete">
      <Setter Property="Background" Value="#EDF4FC" />
    </Style>
    <Style Selector="Button.wizard-step:pointerover">
      <Setter Property="Background" Value="#DEECFD" />
    </Style>
    <Style Selector="Button.wizard-step.current:pointerover">
      <Setter Property="Background" Value="#086BE2" />
    </Style>
    <Style Selector="Border.option-card">
      <Setter Property="Padding" Value="16,12" />
      <Setter Property="BorderBrush" Value="#DBE6F3" />
    </Style>
    <Style Selector="Border.card">
      <Setter Property="BorderBrush" Value="#DBE6F3" />
    </Style>
    <Style Selector="Button.primary:disabled /template/ ContentPresenter">
      <Setter Property="Background" Value="#DCE6F2" />
      <Setter Property="Foreground" Value="#788CA5" />
    </Style>
    <Style Selector="Button.wizard-step.current">
      <Setter Property="Background" Value="#1479F5" />
    </Style>
    <Style Selector="Button.wizard-step.current:pointerover">
      <Setter Property="Background" Value="#086BE2" />
    </Style>
    <Style Selector="Button.wizard-step.current TextBlock.step-title">
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.wizard-step.first /template/ Path">
      <Setter Property="Data" Value="M0,0 L184,0 L202,28 L184,56 L0,56 Z" />
    </Style>
    <Style Selector="RadioButton.operation-picker">
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="6">
            <ContentPresenter Content="{TemplateBinding Content}" VerticalAlignment="Center" />
          </Border>
        </ControlTemplate>
      </Setter>
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="RadioButton.operation-picker:checked">
      <Setter Property="Background" Value="#E5F0FF" />
    </Style>
    <Style Selector="RadioButton.operation-picker:pointerover">
      <Setter Property="Background" Value="#EEF5FF" />
    </Style>
    <Style Selector="Button.wizard-step.first">
      <Setter Property="Template">
        <ControlTemplate>
          <Grid>
            <Path Data="M0,0 L184,0 L202,28 L184,56 L0,56 Z" Stretch="Fill" Fill="{TemplateBinding Background}" />
            <ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12,0" />
          </Grid>
        </ControlTemplate>
      </Setter>
    </Style>
  </Window.Styles>
  <Grid RowDefinitions="60,80,*,68" Background="#F8FAFD">
    <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E1E6EC" BorderThickness="0,0,0,1" Padding="28,8">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="10">
        <Border Width="42" Height="42" CornerRadius="11" Background="#FFFFFF" Padding="3" BorderBrush="#E5EAF0" BorderThickness="1">
          <Image Source="avares://VeyonCampus.StudentSetup/Assets/veyon-campus-mark.png" Stretch="Uniform" />
        </Border>
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
          <TextBlock Text="Veyon Campus" FontSize="15" FontWeight="Bold" />
          <TextBlock Text="学生部署助手" Classes="muted" FontSize="12" />
        </StackPanel>
        <TextBlock Grid.Column="2" Text="遇到问题或有建议？" Classes="muted" FontSize="12" VerticalAlignment="Center" />
        <Button Grid.Column="3" Classes="tertiary" Content="提交反馈 ↗" Click="OpenFeedbackIssue"
                ToolTip.Tip="提交问题或建议。" VerticalAlignment="Center" />
        <Button Grid.Column="4" Classes="tertiary" Content="联系方式" Click="OpenFeedbackContacts" VerticalAlignment="Center" />
        <TextBlock Grid.Column="5" Text="{Binding AppVersion}" Classes="muted" FontSize="12" VerticalAlignment="Center" />
        <Button Grid.Column="6" Classes="tertiary" Content="管理员维护" IsEnabled="{Binding CanOpenMaintenance}" ToolTip.Tip="{Binding MaintenanceAccessHint}" Click="OpenMaintenance" VerticalAlignment="Center" />
      </Grid>
    </Border>
    <Grid Grid.Row="1" Margin="28,12,28,12" ColumnDefinitions="*,*,*,*,*" ColumnSpacing="0">
      <Button x:Name="WizardStepSource" Classes="wizard-step first" Tag="0" Click="NavigateWizardStep" Grid.Column="0">
        <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
          <Border Classes="step-number">
            <TextBlock x:Name="WizardStepSourceNumber" Text="1" />
          </Border>
          <StackPanel Spacing="1" VerticalAlignment="Center">
            <TextBlock Classes="step-title" Text="配置来源" />
          </StackPanel>
        </StackPanel>
      </Button>
      <Button Grid.Column="1" x:Name="WizardStepContent" Classes="wizard-step" Tag="1" Click="NavigateWizardStep">
        <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
          <Border Classes="step-number">
            <TextBlock x:Name="WizardStepContentNumber" Text="2" />
          </Border>
          <StackPanel Spacing="1" VerticalAlignment="Center">
            <TextBlock Classes="step-title" Text="部署内容" />
          </StackPanel>
        </StackPanel>
      </Button>
      <Button Grid.Column="2" x:Name="WizardStepCheck" Classes="wizard-step" Tag="2" Click="NavigateWizardStep">
        <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
          <Border Classes="step-number">
            <TextBlock x:Name="WizardStepCheckNumber" Text="3" />
          </Border>
          <StackPanel Spacing="1" VerticalAlignment="Center">
            <TextBlock Classes="step-title" Text="环境检查" />
          </StackPanel>
        </StackPanel>
      </Button>
      <Button Grid.Column="3" x:Name="WizardStepDeploy" Classes="wizard-step" Tag="3" Click="NavigateWizardStep">
        <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
          <Border Classes="step-number">
            <TextBlock x:Name="WizardStepDeployNumber" Text="4" />
          </Border>
          <StackPanel Spacing="1" VerticalAlignment="Center">
            <TextBlock Classes="step-title" Text="执行部署" />
          </StackPanel>
        </StackPanel>
      </Button>
      <Button Grid.Column="4" x:Name="WizardStepComplete" Classes="wizard-step" Tag="4" Click="NavigateWizardStep">
        <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
          <Border Classes="step-number">
            <TextBlock x:Name="WizardStepCompleteNumber" Text="5" />
          </Border>
          <StackPanel Spacing="1" VerticalAlignment="Center">
            <TextBlock Classes="step-title" Text="完成" />
          </StackPanel>
        </StackPanel>
      </Button>
    </Grid>
    <Grid Grid.Row="2" RowDefinitions="68,*" Margin="28,0,28,16">
      <Grid ColumnDefinitions="64,*" ColumnSpacing="16">
        <StackPanel Spacing="4" VerticalAlignment="Center" Grid.Column="1">
          <TextBlock Text="{Binding WizardPageTitle}" FontSize="25" FontWeight="Bold" />
        </StackPanel>
        <Border Width="60" Height="60" Background="#EAF3FF" CornerRadius="12">
          <Path x:Name="PageHeadingIcon" Data="M5,2 H14 L20,8 V22 H5 Z M14,2 V8 H20 M8,12 H16 M8,16 H16" Width="30" Height="30" Stretch="Uniform" Stroke="#1479F5" StrokeThickness="1.8" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
      </Grid>
      <Grid Grid.Row="1" ClipToBounds="True">
        <Grid IsVisible="{Binding IsSourcePage}" RowSpacing="8" RowDefinitions="Auto,Auto,Auto">
          <Border Classes="card" Grid.Row="0">
            <StackPanel Spacing="10">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="18">
                  <StackPanel Spacing="5">
                    <TextBlock Text="当前配置" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding LoadedPackageSummary}" IsVisible="{Binding HasLoadedPackage}" TextWrapping="Wrap" />
                    <TextBlock Text="尚未选择校区配置" IsVisible="{Binding HasNoLoadedPackage}" Classes="muted" />
                  </StackPanel>
                  <Button Grid.Column="1" Classes="tertiary" Content="清除配置" IsVisible="{Binding HasLoadedPackage}" Click="ClearPackage" VerticalAlignment="Center" />
                </Grid>
                <Border Classes="status-panel warning" IsVisible="{Binding NeedsPreviousRunReview}" Padding="12">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                    <TextBlock Text="上次部署需要检查。查看标记步骤和执行日志后，重新开始。" TextWrapping="Wrap" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Classes="tertiary" Content="查看上次结果" Click="OpenSavedExecutionHistory" VerticalAlignment="Center" />
                  </Grid>
                </Border>
                <Border Classes="status-panel error" IsVisible="{Binding HasPackageError}">
                  <StackPanel Spacing="3">
                    <TextBlock Text="配置未能载入" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding PackageError}" TextWrapping="Wrap" />
                  </StackPanel>
                </Border>
            </StackPanel>
          </Border>
          <StackPanel Orientation="Horizontal" Spacing="16" Grid.Row="2" Margin="0,0,0,2">
            <Button Content="查看本地导入说明  ›" Classes="tertiary" Click="OpenDetails" Tag="0" HorizontalAlignment="Left" />
            <Button Content="查看配置校验详情  ›" Classes="tertiary" Click="OpenDetails" Tag="1" HorizontalAlignment="Left" IsVisible="{Binding HasLoadedPackage}" />
            <Button Content="查看最近部署结果  ›" Classes="tertiary" Click="OpenSavedExecutionHistory" HorizontalAlignment="Left" IsVisible="{Binding HasSavedExecutionHistory}" />
          </StackPanel>
          <StackPanel Grid.Row="1" Spacing="8" VerticalAlignment="Top">
            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
              <Button Classes="source-choice" Click="OpenCloudPackageDialog" Height="92" HorizontalAlignment="Stretch">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                  <Border Width="42" Height="42" CornerRadius="11" Background="#EAF2FB" VerticalAlignment="Center">
                    <Path Data="M6,18 C0,18 0,9 6,9 C6,1 18,1 18,9 C24,9 24,18 18,18 M12,10 V22 M8,18 L12,22 L16,18" Width="24" Height="24" Stretch="Uniform" Stroke="#1479F5" StrokeThickness="1.8" HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                  <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                    <TextBlock Text="从云端获取" FontWeight="SemiBold" />
                    <TextBlock Text="搜索教师已发布的校区配置" Classes="muted" FontSize="12" TextWrapping="Wrap" />
                  </StackPanel>
                </Grid>
              </Button>
              <Button Grid.Column="1" Classes="source-choice" Click="SelectPackage" Height="92" HorizontalAlignment="Stretch">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                  <Border Width="42" Height="42" CornerRadius="11" Background="#EEF0FE" VerticalAlignment="Center">
                    <Path Data="M5,2 H14 L20,8 V22 H5 Z M14,2 V8 H20 M8,12 H16 M8,16 H16" Width="24" Height="24" Stretch="Uniform" Stroke="#1479F5" StrokeThickness="1.8" HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                  <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                    <TextBlock Text="导入本地配置" FontWeight="SemiBold" />
                    <TextBlock Text="选择本机上的校区配置文件夹" Classes="muted" FontSize="12" TextWrapping="Wrap" />
                  </StackPanel>
                </Grid>
              </Button>
            </Grid>
          </StackPanel>
        </Grid>
        <Grid IsVisible="{Binding IsContentPage}" RowSpacing="12" RowDefinitions="68,*,40">
          <Border Classes="status-panel info" Padding="16,10">
            <Grid ColumnDefinitions="76,*,Auto" ColumnSpacing="16">
              <TextBlock Text="目标校区" Classes="muted" VerticalAlignment="Center" />
              <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden">
                <TextBlock Text="{Binding LoadedPackageInlineSummary}" TextWrapping="Wrap" FontWeight="SemiBold" VerticalAlignment="Center" />
              </ScrollViewer>
              <Button Grid.Column="2" Classes="tertiary" Content="更换配置" Tag="0" Click="NavigateWizardStep" VerticalAlignment="Center" />
            </Grid>
          </Border>
          <Border Classes="status-panel warning" IsVisible="{Binding HasVeyonPackageRequirement}" Grid.Row="0" Padding="14,8">
            <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <TextBlock Text="安装或配置 Veyon 需要先载入校区配置。" TextWrapping="Wrap" VerticalAlignment="Center" />
                <Button Grid.Column="1" Classes="secondary" Content="选择配置" Tag="0" Click="NavigateWizardStep" />
              </Grid>
            </ScrollViewer>
          </Border>
          <Grid Grid.Row="1" ColumnDefinitions="254,*,218" ColumnSpacing="14">
            <Grid RowDefinitions="*,*,*,*" RowSpacing="10">
              <Border Classes="option-card" Grid.Row="0" Padding="12,8">
                <Grid ColumnDefinitions="32,*" ColumnSpacing="8">
                  <CheckBox Content="" IsChecked="{Binding InstallVeyon, Mode=TwoWay}" Tag="0" Click="SelectOperation" VerticalAlignment="Center" />
                  <RadioButton Classes="operation-picker" Grid.Column="1" GroupName="OperationEditor" Tag="0" Click="SelectOperation" IsChecked="True" Theme="{x:Null}" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                      <Path Data="M12,2 L21,6 V12 C21,18 12,22 12,22 C12,22 3,18 3,12 V6 Z M8,12 L11,15 L17,9" Width="24" Height="24" Stretch="Uniform" Stroke="#1479F5" StrokeThickness="1.8" HorizontalAlignment="Center" VerticalAlignment="Center" />
                      <TextBlock Text="配置 Veyon" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                  </RadioButton>
                </Grid>
              </Border>
              <Border Classes="option-card" Grid.Row="1" Padding="12,8">
                <Grid ColumnDefinitions="32,*" ColumnSpacing="8">
                  <CheckBox Content="" IsChecked="{Binding RenameComputer, Mode=TwoWay}" Tag="1" Click="SelectOperation" VerticalAlignment="Center" />
                  <RadioButton Classes="operation-picker" Grid.Column="1" GroupName="OperationEditor" Tag="1" Click="SelectOperation" IsChecked="False" Theme="{x:Null}" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                      <Path Data="M3,4 H21 V17 H3 Z M8,21 H16 M12,17 V21" Width="24" Height="24" Stretch="Uniform" Stroke="#1479F5" StrokeThickness="1.8" HorizontalAlignment="Center" VerticalAlignment="Center" />
                      <TextBlock Text="修改电脑名称" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                  </RadioButton>
                </Grid>
              </Border>
              <Border Classes="option-card" Grid.Row="2" Padding="12,8">
                <Grid ColumnDefinitions="32,*" ColumnSpacing="8">
                  <CheckBox Content="" IsChecked="{Binding CreateStudent, Mode=TwoWay}" Tag="2" Click="SelectOperation" VerticalAlignment="Center" />
                  <RadioButton Classes="operation-picker" Grid.Column="1" GroupName="OperationEditor" Tag="2" Click="SelectOperation" IsChecked="False" Theme="{x:Null}" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                      <Path Data="M16,7 A4,4 0 1 1 8,7 A4,4 0 1 1 16,7 M4,22 V18 C4,12 20,12 20,18 V22 Z" Width="24" Height="24" Stretch="Uniform" Stroke="#1479F5" StrokeThickness="1.8" HorizontalAlignment="Center" VerticalAlignment="Center" />
                      <TextBlock Text="创建学生账户" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                  </RadioButton>
                </Grid>
              </Border>
              <Border Classes="option-card" Grid.Row="3" Padding="12,8">
                <Grid ColumnDefinitions="32,*" ColumnSpacing="8">
                  <CheckBox Content="" IsChecked="{Binding ChangeAdminPassword, Mode=TwoWay}" Tag="3" Click="SelectOperation" VerticalAlignment="Center" />
                  <RadioButton Classes="operation-picker" Grid.Column="1" GroupName="OperationEditor" Tag="3" Click="SelectOperation" IsChecked="False" Theme="{x:Null}" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                      <Path Data="M12,2 L21,6 V12 C21,18 12,22 12,22 C12,22 3,18 3,12 V6 Z M8,12 L11,15 L17,9" Width="24" Height="24" Stretch="Uniform" Stroke="#1479F5" StrokeThickness="1.8" HorizontalAlignment="Center" VerticalAlignment="Center" />
                      <TextBlock Text="修改管理员密码" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                  </RadioButton>
                </Grid>
              </Border>
            </Grid>
            <Border Grid.Column="1" Classes="card" Padding="20,16">
              <Grid x:Name="OperationEditors">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden" IsVisible="True">
                  <StackPanel Spacing="8">
                    <TextBlock Text="配置 Veyon" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <TextBlock Text="让教师端可以管理这台电脑。" Classes="muted" TextWrapping="Wrap" />
                    <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding InstallVeyon}">
                      <TextBlock Text="{Binding VeyonStatusSummary}" Classes="muted" VerticalAlignment="Center" />
                      <Button Grid.Column="1" Classes="tertiary" Content="重新检测" IsEnabled="{Binding CanRefreshVeyonStatus}" Click="RefreshVeyonStatus" />
                    </Grid>
                    <Button Content="查看 Veyon 检测详情  ›" Classes="tertiary" Click="OpenDetails" Tag="2" HorizontalAlignment="Left" IsVisible="{Binding InstallVeyon}" />
                  </StackPanel>
                </ScrollViewer>
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden" IsVisible="False">
                  <StackPanel Spacing="8">
                    <TextBlock Text="修改电脑名称" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <TextBlock Text="按房间编号设置唯一名称；更改通常需要重启。" Classes="muted" TextWrapping="Wrap" />
                    <Grid IsVisible="{Binding RenameComputer}" ColumnDefinitions="*,*" ColumnSpacing="12" Margin="0,4,0,0">
                      <StackPanel Spacing="6">
                        <TextBlock Text="电脑编号（1–150）" FontSize="12" Classes="muted" />
                        <TextBox Text="{Binding Number, Mode=TwoWay}" PlaceholderText="例如 03 或 150" MaxLength="3" />
                      </StackPanel>
                      <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                        <TextBlock Text="目标名称" FontSize="12" Classes="muted" />
                        <TextBlock Text="{Binding ComputerName}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" />
                      </StackPanel>
                    </Grid>
                  </StackPanel>
                </ScrollViewer>
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden" IsVisible="False">
                  <StackPanel Spacing="8">
                    <TextBlock Text="创建学生账户" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <TextBlock Text="创建不具备管理员权限的账户。已有合适账户时无需重复创建。" Classes="muted" TextWrapping="Wrap" />
                    <StackPanel IsVisible="{Binding CreateStudent}" Spacing="7" Margin="0,4,0,0">
                      <TextBox Text="{Binding StudentAccountName, Mode=TwoWay}" PlaceholderText="学生账户名" MaxLength="20" />
                      <TextBlock Text="初始密码可留空；Windows 密码策略可能要求设置。" Classes="muted" FontSize="12" TextWrapping="Wrap" />
                      <TextBox x:Name="StudentInitialPasswordBox" PasswordChar="●" PlaceholderText="初始密码（可留空）" MaxLength="127" />
                      <TextBox x:Name="StudentInitialPasswordConfirmationBox" PasswordChar="●" PlaceholderText="确认初始密码" MaxLength="127" />
                    </StackPanel>
                  </StackPanel>
                </ScrollViewer>
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden" IsVisible="False">
                  <StackPanel Spacing="8">
                    <TextBlock Text="修改管理员密码" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <TextBlock Text="默认关闭。" Classes="muted" TextWrapping="Wrap" />
                    <Border Classes="status-panel warning" IsVisible="{Binding ChangeAdminPassword}" Padding="10">
                      <TextBlock Text="此操作会替换指定账户当前密码，请确保新密码已妥善保存。" TextWrapping="Wrap" />
                    </Border>
                    <StackPanel IsVisible="{Binding ChangeAdminPassword}" Spacing="7">
                      <TextBox Text="{Binding AdminAccountName, Mode=TwoWay}" PlaceholderText="本地管理员账户名（默认 Administrator）" MaxLength="20" />
                      <TextBlock Text="两次输入需一致。" Classes="muted" FontSize="12" TextWrapping="Wrap" />
                      <TextBox x:Name="AdminPasswordBox" PasswordChar="●" PlaceholderText="新密码" MaxLength="127" />
                      <TextBox x:Name="AdminPasswordConfirmationBox" PasswordChar="●" PlaceholderText="再次输入新密码" MaxLength="127" />
                    </StackPanel>
                  </StackPanel>
                </ScrollViewer>
              </Grid>
            </Border>
            <Border Grid.Column="2" Classes="card" Padding="16">
              <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden">
                <StackPanel Spacing="16">
                  <TextBlock Text="将执行" FontSize="17" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding PackageRecommendationNotice}" Classes="muted" FontSize="12"
                             TextWrapping="Wrap" IsVisible="{Binding HasPackageRecommendationNotice}" />
                  <Border Classes="status-panel warning" Padding="8" IsVisible="{Binding HasAdminPasswordRecommendation}">
                    <TextBlock Text="{Binding AdminPasswordRecommendationWarning}" TextWrapping="Wrap" FontSize="12" />
                  </Border>
                  <Separator />
                  <TextBlock Text="{Binding DeploymentSelectionSummary}" TextWrapping="Wrap" LineHeight="24" />
                </StackPanel>
              </ScrollViewer>
            </Border>
          </Grid>
          <Button Classes="tertiary" Content="重置表单" Click="ResetForm" HorizontalAlignment="Left" Grid.Row="2" />
          <Border Classes="status-panel error" IsVisible="{Binding HasError}" Grid.Row="2" Margin="110,0,0,0" Padding="10,6">
            <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
              <TextBlock Text="{Binding Error}" TextWrapping="Wrap" />
            </ScrollViewer>
          </Border>
        </Grid>
        <Grid IsVisible="{Binding IsCheckPage}" RowSpacing="12" RowDefinitions="64,*,40" ColumnDefinitions="*,280" ColumnSpacing="16">
          <Border Classes="card" Grid.Row="0" Padding="16,10">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
              <StackPanel Spacing="4">
                <TextBlock Text="环境检查" FontSize="18" FontWeight="SemiBold" />
              </StackPanel>
              <Button Grid.Column="1" Classes="secondary" Content="重新检查" IsEnabled="{Binding CanPrepareDeployment}" Click="PrepareDeployment" VerticalAlignment="Center" />
            </Grid>
          </Border>
          <Border Classes="empty-state" IsVisible="{Binding HasNoPreflight}" Grid.Row="1" Padding="12">
            <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
              <StackPanel Spacing="6">
                <TextBlock Text="尚未检查这台电脑" FontWeight="SemiBold" />
                <TextBlock Text="检查通过后才能继续部署。" Classes="muted" TextWrapping="Wrap" />
                <TextBlock Text="{Binding PreparationStatusText}" IsVisible="{Binding HasPreparationStatus}" Classes="muted" />
              </StackPanel>
            </ScrollViewer>
          </Border>
          <Border Classes="card" IsVisible="{Binding HasPreflight}" Grid.Row="1" Padding="12">
            <Grid RowDefinitions="36,*">
              <Grid ColumnDefinitions="*" ColumnSpacing="12">
                <TextBlock Text="检查结果" FontSize="18" FontWeight="SemiBold" />
              </Grid>
              <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" Grid.Row="1">
                <StackPanel Spacing="12">
                  <Border Background="#EAF2FB" CornerRadius="8" Padding="10,8">
                    <TextBlock Text="提示不影响部署；未通过项需要处理。" Classes="muted" TextWrapping="Wrap" />
                  </Border>
                  <Border Classes="status-panel warning" IsVisible="{Binding NeedsPreviousRunReview}" Padding="10">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                      <TextBlock Text="上次部署需要检查。请看标记步骤和执行日志，再检查本机状态。"
                                 TextWrapping="Wrap" VerticalAlignment="Center" />
                      <Button Grid.Column="1" Classes="tertiary" Content="查看上次结果" Click="OpenSavedExecutionHistory"
                              VerticalAlignment="Center" />
                    </Grid>
                  </Border>
                  <ItemsControl ItemsSource="{Binding PreflightItems}" IsVisible="{Binding HasPreflightItems}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:StudentPreflightItem">
                        <Border Classes="preflight-row" Padding="12,8" Margin="0,0,0,6">
                          <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="2">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Top" TextWrapping="Wrap" />
                            <TextBlock Grid.Row="1" Text="{Binding Hint}" Classes="muted" FontSize="12" TextWrapping="Wrap" IsVisible="{Binding ShowHint}" />
                            <StackPanel Grid.Column="1" Grid.RowSpan="2" VerticalAlignment="Center">
                              <Border Classes="status-pill success" IsVisible="{Binding IsPass}" ToolTip.Tip="已通过" AutomationProperties.Name="已通过">
                                <Path Data="M4,12 L10,18 L21,5" Stroke="#16834A" StrokeThickness="2" Width="20" Height="20" Stretch="Uniform" />
                              </Border>
                              <Border Classes="status-pill warning" IsVisible="{Binding IsWarning}" ToolTip.Tip="提示（非错误）" AutomationProperties.Name="提示（非错误）">
                                <Path Data="M12,3 L23,22 H1 Z M12,9 V15 M12,18 V20" Stroke="#B96B12" StrokeThickness="2" Width="20" Height="20" Stretch="Uniform" />
                              </Border>
                              <Border Classes="status-pill error" IsVisible="{Binding IsBlocked}" ToolTip.Tip="未通过" AutomationProperties.Name="未通过">
                                <Path Data="M5,5 L19,19 M19,5 L5,19" Stroke="#C63636" StrokeThickness="2" Width="20" Height="20" Stretch="Uniform" />
                              </Border>
                              <Border Classes="status-pill info" IsVisible="{Binding IsUnknown}" ToolTip.Tip="进行中或需要核对" AutomationProperties.Name="进行中或需要核对">
                                <Path Data="M21,12 A9,9 0 1 1 12,3 M12,7 V12 L16,14" Stroke="#1479F5" StrokeThickness="2" Width="20" Height="20" Stretch="Uniform" />
                              </Border>
                              <Border Classes="status-pill neutral" IsVisible="{Binding IsNotApplicable}" ToolTip.Tip="等待或不适用" AutomationProperties.Name="等待或不适用">
                                <Path Data="M4,5 L14,12 L4,19 Z M20,5 V19" Stroke="#64748B" StrokeThickness="2" Width="20" Height="20" Stretch="Uniform" />
                              </Border>
                            </StackPanel>
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </ScrollViewer>
            </Grid>
          </Border>
          <StackPanel Orientation="Horizontal" Spacing="16" Grid.Row="2" Grid.ColumnSpan="2">
            <Button Content="查看部署计划  ›" Classes="tertiary" Click="OpenDetails" Tag="3" HorizontalAlignment="Left" IsVisible="{Binding HasPreview}" />
            <Button Content="查看检查详情  ›" Classes="tertiary" Click="OpenDetails" Tag="4" HorizontalAlignment="Left" IsVisible="{Binding HasPreflight}" />
          </StackPanel>
          <Border Grid.Column="1" Grid.RowSpan="2" Classes="card" Classes.success="{Binding CheckAllPassed}" Background="#F0F6FE" Padding="24">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden">
              <StackPanel Spacing="20" Margin="0,24,0,0">
                <Grid Height="60">
                  <Path IsVisible="{Binding CheckAllPassed}" Data="M4,12 L10,18 L21,5" Stroke="#16834A" StrokeThickness="2" Width="44" Height="44" Stretch="Uniform" HorizontalAlignment="Center" />
                  <Path IsVisible="{Binding CheckHasBlocker}" Data="M5,5 L19,19 M19,5 L5,19" Stroke="#C63636" StrokeThickness="2" Width="40" Height="40" Stretch="Uniform" HorizontalAlignment="Center" />
                  <Path IsVisible="{Binding CheckNeedsAttention}" Data="M12,3 L23,22 H1 Z M12,9 V15 M12,18 V20" Stroke="#B96B12" StrokeThickness="2" Width="44" Height="44" Stretch="Uniform" HorizontalAlignment="Center" />
                  <TextBlock x:Name="PreflightSpinner" Text="◴" FontSize="25" FontWeight="Bold"
                             HorizontalAlignment="Center" VerticalAlignment="Center"
                             IsVisible="{Binding IsPreparingDeployment}"
                             AutomationProperties.Name="正在检查电脑环境" ToolTip.Tip="正在检查，请稍候" />
                </Grid>
                <TextBlock Text="{Binding CheckConclusionTitle}" FontSize="21" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" />
                <TextBlock Text="{Binding CheckConclusionHint}" Classes="muted" TextAlignment="Center" TextWrapping="Wrap" />
                <Separator />
                <TextBlock Text="{Binding PreflightSummaryText}" Classes="muted" TextWrapping="Wrap" />
              </StackPanel>
            </ScrollViewer>
          </Border>
        </Grid>
        <Grid IsVisible="{Binding IsDeployPage}" RowSpacing="12" RowDefinitions="100,*,40">
          <Border Classes="card" Grid.Row="0" Padding="18,14">
            <StackPanel Spacing="12">
              <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="14">
                <StackPanel Spacing="3">
                  <TextBlock Text="部署进度" FontSize="18" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding ExecutionOverallStatusText}" Classes="muted" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding ExecutionProgressText}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock x:Name="ExecutionSpinner" Grid.Column="2" Text="◴" FontSize="21" FontWeight="Bold"
                           VerticalAlignment="Center" IsVisible="{Binding IsExecuting}"
                           AutomationProperties.Name="正在部署" ToolTip.Tip="正在部署，请稍候" />
              </Grid>
              <ProgressBar Minimum="0" Maximum="100" Value="{Binding ExecutionProgressPercent}" Height="8" />
            </StackPanel>
          </Border>
          <Border Classes="card" Grid.Row="1" Padding="16">
            <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
              <StackPanel Spacing="10">
                <TextBlock Text="逐项执行" FontSize="18" FontWeight="SemiBold" />
                <ItemsControl ItemsSource="{Binding ExecutionStepStatuses}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:StudentExecutionStepStatus">
                      <Border Classes="execution-row" Classes.active="{Binding IsRunning}" Padding="14,12">
                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="5">
                          <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                          <StackPanel Grid.Column="1">
                            <Border Classes="status-pill success" IsVisible="{Binding IsSuccess}" ToolTip.Tip="{Binding Status}" AutomationProperties.Name="{Binding Status}">
                              <Path Data="M4,12 L10,18 L21,5" Stroke="#16834A" StrokeThickness="2" Width="20" Height="20" Stretch="Uniform" />
                            </Border>
                            <Border Classes="status-pill info" IsVisible="{Binding IsRunning}" ToolTip.Tip="{Binding Status}" AutomationProperties.Name="{Binding Status}">
                              <Path Data="M21,12 A9,9 0 1 1 12,3 M12,7 V12 L16,14" Stroke="#1479F5" StrokeThickness="2" Width="20" Height="20" Stretch="Uniform" />
                            </Border>
                            <Border Classes="status-pill error" IsVisible="{Binding IsError}" ToolTip.Tip="{Binding Status}" AutomationProperties.Name="{Binding Status}">
                              <Path Data="M5,5 L19,19 M19,5 L5,19" Stroke="#C63636" StrokeThickness="2" Width="20" Height="20" Stretch="Uniform" />
                            </Border>
                            <Border Classes="status-pill warning" IsVisible="{Binding IsWarning}" ToolTip.Tip="{Binding Status}" AutomationProperties.Name="{Binding Status}">
                              <Path Data="M12,3 L23,22 H1 Z M12,9 V15 M12,18 V20" Stroke="#B96B12" StrokeThickness="2" Width="20" Height="20" Stretch="Uniform" />
                            </Border>
                            <Border Classes="status-pill neutral" IsVisible="{Binding IsNeutral}" ToolTip.Tip="{Binding Status}" AutomationProperties.Name="{Binding Status}">
                              <Path Data="M4,5 L14,12 L4,19 Z M20,5 V19" Stroke="#64748B" StrokeThickness="2" Width="20" Height="20" Stretch="Uniform" />
                            </Border>
                          </StackPanel>
                          <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Detail}" Classes="muted"
                                     FontSize="12" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"
                                     IsVisible="{Binding ShowDetail}" />
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="正在准备所选部署操作……" Classes="muted" IsVisible="{Binding HasNoExecution}" />
                <TextBlock Text="未能继续，请查看执行详情。" IsVisible="{Binding HasError}" Foreground="#C63636" />
              </StackPanel>
            </ScrollViewer>
          </Border>
          <Grid Grid.Row="2" ColumnDefinitions="*,Auto">
            <Button Content="查看执行详情  ›" Classes="tertiary" Click="OpenDetails" Tag="5" HorizontalAlignment="Left" />
            <Button Grid.Column="1" Content="当前步骤结束后停止" Classes="secondary"
                    IsEnabled="{Binding CanRequestStopAfterCurrentStep}"
                    IsVisible="{Binding CanRequestStopAfterCurrentStep}"
                    Click="RequestStopAfterCurrentStep" />
          </Grid>
        </Grid>
        <Grid IsVisible="{Binding IsCompletePage}" RowSpacing="12" RowDefinitions="88,*,40" ColumnDefinitions="*,*" ColumnSpacing="16">
          <Border Classes="completion-panel" Classes.success="{Binding IsExecutionSuccessful}" Classes.warning="{Binding IsExecutionWarning}" Classes.error="{Binding IsExecutionFailed}" Grid.Row="0" Grid.ColumnSpan="2">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
              <Border Classes="completion-icon" Classes.success="{Binding IsExecutionSuccessful}" Classes.warning="{Binding IsExecutionWarning}" Classes.error="{Binding IsExecutionFailed}">
                <TextBlock Text="{Binding ExecutionStatusSymbol}" FontSize="23" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                <TextBlock Classes="primary-status" Text="{Binding ExecutionOverallStatusText}" FontSize="21" FontWeight="Bold" />
                <TextBlock Text="{Binding ExecutionSummaryDescription}" Classes="muted" IsVisible="{Binding HasExecutionSummaryDescription}" TextWrapping="Wrap" />
                <TextBlock Text="尚无部署记录。" Classes="muted" IsVisible="{Binding HasNoExecution}" TextWrapping="Wrap" />
              </StackPanel>
            </Grid>
          </Border>
          <Border Classes="card" IsVisible="{Binding HasExecutionStepStatuses}" Grid.Row="1">
            <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
              <StackPanel Spacing="10">
                <TextBlock Text="{Binding ExecutionResultsHeading}" FontSize="17" FontWeight="SemiBold" />
                <ItemsControl ItemsSource="{Binding ExecutionStepStatuses}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:StudentExecutionStepStatus">
                      <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="5" Margin="0,8,0,16">
                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Grid.Column="1" Text="{Binding Status}" FontWeight="SemiBold" />
                        <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Detail}" Classes="muted"
                                   FontSize="12" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"
                                   IsVisible="{Binding ShowDetail}" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </ScrollViewer>
          </Border>
          <WrapPanel Grid.Row="2" Grid.ColumnSpan="2">
            <Button Content="管理员维护  ›" Classes="tertiary" Click="OpenDetails" Tag="9" IsEnabled="{Binding CanOpenMaintenance}" ToolTip.Tip="{Binding MaintenanceAccessHint}" Margin="0,0,16,0" />
            <Button Content="查看执行日志  ›" Classes="tertiary" Click="OpenDetails" Tag="8" IsVisible="{Binding HasExecution}" Margin="0,0,16,0" />
            <Button Content="查看执行前快照  ›" Classes="tertiary" Click="OpenDetails" Tag="10" IsVisible="{Binding HasRecoverableStateBackup}" />
          </WrapPanel>
          <Border Grid.Row="1" Grid.Column="1" Classes="card">
            <Grid RowDefinitions="40,*">
              <TextBlock Text="设备摘要" FontSize="18" FontWeight="SemiBold" />
              <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden">
                <StackPanel Spacing="18">
                  <Grid ColumnDefinitions="100,*">
                    <TextBlock Text="电脑名称" Classes="muted" />
                    <TextBlock Grid.Column="1" Text="{Binding DeviceComputerName}" FontWeight="SemiBold" TextWrapping="Wrap" />
                  </Grid>
                  <Separator />
                  <Grid ColumnDefinitions="100,*">
                    <TextBlock Text="校区" Classes="muted" />
                    <TextBlock Grid.Column="1" Text="{Binding Campus}" TextWrapping="Wrap" />
                  </Grid>
                  <Separator />
                  <Grid ColumnDefinitions="100,*">
                    <TextBlock Text="Veyon" Classes="muted" />
                    <TextBlock Grid.Column="1" Text="{Binding VeyonStatusSummary}" TextWrapping="Wrap" />
                  </Grid>
                  <Button Classes="tertiary" Content="重新检测" Click="RefreshVeyonStatus" IsEnabled="{Binding CanRefreshVeyonStatus}" />
                </StackPanel>
              </ScrollViewer>
            </Grid>
          </Border>
        </Grid>
      </Grid>
    </Grid>
    <Border Grid.Row="3" Background="#FFFFFF" BorderBrush="#E1E6EC" BorderThickness="0,1,0,0" Padding="24,11">
      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
        <Button Content="关闭" IsEnabled="{Binding CanExitSetup}" IsVisible="{Binding IsNotCompletePage}" Click="CloseSetup" VerticalAlignment="Center" />
        <TextBlock Grid.Column="1" Text="{Binding WizardFooterStatus}" Classes="muted" TextWrapping="Wrap" VerticalAlignment="Center" IsVisible="{Binding ShowWizardFooterStatus}" />
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Button Classes="secondary" Content="上一步" IsEnabled="{Binding CanGoPreviousWizardPage}" Click="PreviousWizardPage" IsVisible="{Binding IsNotSourcePage}" />
          <Button Classes="primary" Content="下一步：部署内容" IsEnabled="{Binding CanGoNextWizardPage}" Click="NextWizardPage" IsVisible="{Binding IsSourcePage}" />
          <Button Classes="primary" Content="下一步：环境检查" IsEnabled="{Binding CanGoNextWizardPage}" Click="NextWizardPage" IsVisible="{Binding IsContentPage}" />
          <Button Classes="primary" Content="确认并开始部署" IsEnabled="{Binding CanProceedToDeploy}" Click="StartDeployment" IsVisible="{Binding IsCheckPage}" />
          <Button Classes="secondary" Content="重新检查" IsEnabled="{Binding CanPrepareDeployment}" Click="PrepareDeployment" IsVisible="{Binding IsDeployPage}" />
          <Button Classes="secondary" Content="检查完成，重新开始" IsEnabled="{Binding CanAcknowledgePreviousRun}"
                  IsVisible="{Binding CanAcknowledgePreviousRun}" Click="AcknowledgePreviousRunReview"
                  ToolTip.Tip="保存检查状态并清空旧部署结果。" />
          <Button Classes="primary" Content="完成并退出" IsEnabled="{Binding CanExitSetup}" Click="CloseSetup" IsVisible="{Binding IsCompletePage}" />
        </StackPanel>
      </Grid>
    </Border>
    <Border x:Name="DetailsDrawer" Grid.Row="2" Width="500" HorizontalAlignment="Right" Margin="0,0,24,16" Background="White" BorderBrush="#D8E0EA" BorderThickness="1" CornerRadius="10" Padding="24" IsVisible="False">
      <Grid RowDefinitions="48,*">
        <Grid ColumnDefinitions="*,80">
          <TextBlock x:Name="DetailsTitle" FontSize="18" FontWeight="SemiBold" />
          <Button Grid.Column="1" Content="关闭" Click="CloseDetails" Classes="tertiary" />
        </Grid>
        <Grid x:Name="DetailsHost" Grid.Row="1">
          <ScrollViewer IsVisible="False" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
            <Border Classes="card" Margin="0,8,0,0">
              <StackPanel Spacing="10">
                <Border x:Name="PackageDropZone" Classes="dropzone" DragDrop.AllowDrop="True" Height="100">
                  <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                      <Border Width="42" Height="42" CornerRadius="21" Background="#EAF2FB">
                        <Path Data="M12,2 V18 M6,12 L12,18 L18,12 M3,18 V22 H21 V18" Width="24" Height="24" Stretch="Uniform" Stroke="#1479F5" StrokeThickness="1.8" HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Border>
                      <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                        <TextBlock Text="也可以拖入本地校区配置文件夹" FontWeight="SemiBold" />
                        <TextBlock Text="请使用“导入本地配置”选择文件夹。" Classes="muted" TextWrapping="Wrap" />
                      </StackPanel>
                    </Grid>
                  </ScrollViewer>
                </Border>
                <TextBlock Text="无网络时，从管理员提供的文件夹导入配置。" Classes="muted" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
          </ScrollViewer>
          <ScrollViewer IsVisible="False" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
            <Border Classes="card" Margin="0,8,0,0">
              <StackPanel Spacing="8">
                <TextBlock Text="{Binding PackageStatus}" Classes="muted" TextWrapping="Wrap" />
                <TextBlock Text="Veyon 安装器已随应用提供；不会从网络下载。" Classes="muted" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
          </ScrollViewer>
          <ScrollViewer IsVisible="False" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
            <TextBlock Text="{Binding VeyonStatusText}" Classes="muted" TextWrapping="Wrap" Margin="0,8,0,0" />
          </ScrollViewer>
          <ScrollViewer IsVisible="False" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
            <Border Classes="card" Margin="0,8,0,0">
              <TextBlock Text="{Binding PreviewText}" TextWrapping="Wrap" />
            </Border>
          </ScrollViewer>
          <ScrollViewer IsVisible="False" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="12">
              <Border Classes="card" Margin="0,8,0,0">
                <TextBlock Text="{Binding PreflightText}" TextWrapping="Wrap" />
              </Border>
              <TextBlock Text="{Binding Error}" TextWrapping="Wrap" />
            </StackPanel>
          </ScrollViewer>
          <ScrollViewer IsVisible="False" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="12">
              <Border Classes="card" Margin="0,8,0,0">
                <TextBlock Text="{Binding ExecutionText}" TextWrapping="Wrap" />
              </Border>
              <TextBlock Text="{Binding Error}" TextWrapping="Wrap" />
            </StackPanel>
          </ScrollViewer>
          <ScrollViewer IsVisible="False" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
            <TextBlock Text="{Binding VeyonStatusText}" Classes="muted" TextWrapping="Wrap" Margin="0,8,0,0" />
          </ScrollViewer>
          <ScrollViewer IsVisible="False" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
            <TextBlock Text="{Binding PackageStatus}" Classes="muted" TextWrapping="Wrap" Margin="0,8,0,0" />
          </ScrollViewer>
          <ScrollViewer IsVisible="False" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
            <Border Classes="card" Margin="0,8,0,0">
              <TextBlock Text="{Binding ExecutionText}" TextWrapping="Wrap" />
            </Border>
          </ScrollViewer>
          <Border Classes="card" IsVisible="False">
            <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
              <StackPanel Spacing="14">
                <StackPanel Spacing="3">
                  <TextBlock Text="管理员维护" FontSize="18" FontWeight="SemiBold" />
                </StackPanel>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                  <StackPanel Spacing="4">
                    <TextBlock Text="Veyon" Classes="muted" FontSize="12" />
                    <TextBlock Text="{Binding VeyonStatusSummary}" FontSize="16" FontWeight="SemiBold" />
                  </StackPanel>
                  <Button Grid.Column="1" Classes="secondary" Content="重新检测" IsEnabled="{Binding CanRefreshVeyonStatus}" Click="RefreshVeyonStatus" VerticalAlignment="Center" />
                </Grid>
                <Button Content="查看 Veyon 详细状态  ›" Classes="tertiary" Click="OpenDetails" Tag="6" HorizontalAlignment="Left" />
                <WrapPanel>
                  <Button Classes="primary" Content="运行只读部署检查" IsEnabled="{Binding CanVerifyStudentDeployment}" Click="VerifyStudentDeployment" Margin="0,0,8,8" />
                  <Button Classes="secondary" Content="安装 / 修复网站策略 Agent" IsEnabled="{Binding CanInstallWebsitePolicyAgent}" Click="InstallWebsitePolicyAgent" Margin="0,0,8,8" />
                  <Button Classes="tertiary" Content="返回配置来源" IsEnabled="{Binding CanNavigateWizard}" Tag="0" Click="NavigateWizardStep" Margin="0,0,8,8" />
                </WrapPanel>
                <Border Classes="status-panel info" Padding="12">
                  <StackPanel Spacing="8">
                    <TextBlock Text="更新部署工具" FontWeight="SemiBold" />
                    <Button Content="更新学生部署工具…" IsEnabled="{Binding CanExitSetup}" Click="OpenAppUpdates" HorizontalAlignment="Left" />
                  </StackPanel>
                </Border>
                <Border Classes="status-panel error" Padding="12">
                  <StackPanel Spacing="6">
                    <TextBlock Text="卸载网站策略 Agent" FontWeight="SemiBold" />
                    <TextBlock Text="移除本机网站策略代理。" Classes="muted" TextWrapping="Wrap" />
                    <Button Classes="danger" Content="卸载本机网站策略 Agent…" IsEnabled="{Binding CanRemoveWebsitePolicyAgent}" Click="RemoveWebsitePolicyAgent" HorizontalAlignment="Left" />
                  </StackPanel>
                </Border>
                <TextBlock Text="{Binding WebsiteAgentInstallStatus}" Classes="muted" TextWrapping="Wrap" IsVisible="{Binding HasWebsiteAgentInstallStatus}" />
                <TextBlock Text="{Binding WebsiteAgentRemovalStatus}" Classes="muted" TextWrapping="Wrap" IsVisible="{Binding HasWebsiteAgentRemovalStatus}" />
                <TextBlock Text="{Binding StudentDeploymentVerificationText}" Classes="muted" TextWrapping="Wrap" IsVisible="{Binding HasStudentDeploymentVerification}" />
                <Button Content="查看配置与验证详情  ›" Classes="tertiary" Click="OpenDetails" Tag="7" HorizontalAlignment="Left" IsVisible="{Binding HasLoadedPackage}" />
              </StackPanel>
            </ScrollViewer>
          </Border>
          <ScrollViewer IsVisible="False" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
            <Border Classes="card" Margin="0,8,0,0">
              <StackPanel Spacing="12">
                <StackPanel Spacing="4">
                  <TextBlock Text="执行前快照" FontSize="18" FontWeight="SemiBold" />
                </StackPanel>
                <TextBlock Text="{Binding StateBackupReviewText}" TextWrapping="Wrap" />
                <WrapPanel>
                  <Button Classes="secondary" Content="核对当前名称和账户" IsEnabled="{Binding CanCompareCurrentSystemBackup}" Click="CompareCurrentSystemBackup" Margin="0,0,8,8" />
                  <Button Classes="secondary" Content="比对当前 Veyon 配置" IsEnabled="{Binding CanCompareCurrentStateBackup}" Click="CompareCurrentStateBackup" Margin="0,0,8,8" />
                  <Button Classes="secondary" Content="导出执行前配置…" IsEnabled="{Binding CanExportStateBackup}" Click="ExportStateBackupConfig" Margin="0,0,8,8" />
                </WrapPanel>
                <TextBlock Text="{Binding StateBackupSystemComparisonText}" Classes="muted" TextWrapping="Wrap" />
                <TextBlock Text="{Binding StateBackupComparisonText}" Classes="muted" TextWrapping="Wrap" />
                <TextBlock Text="导出的配置可能包含敏感设置。" Classes="muted" TextWrapping="Wrap" />
                <TextBlock Text="{Binding StateBackupExportText}" TextWrapping="Wrap" IsVisible="{Binding HasStateBackupExportText}" />
              </StackPanel>
            </Border>
          </ScrollViewer>
        </Grid>
      </Grid>
    </Border>
  </Grid>
</Window>
