<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:VeyonCampus.App"
        xmlns:core="using:VeyonCampus.Core"
        x:Class="VeyonCampus.App.StudentCloudPackageWindow" x:DataType="vm:MainViewModel"
        Title="获取校区配置" Width="720" Height="680" CanResize="False"
        WindowStartupLocation="CenterOwner" Background="#F5F7FA">
  <Grid RowDefinitions="Auto,*,Auto" Margin="26" RowSpacing="18">
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
      <TextBox Text="{Binding CloudPackageQuery, Mode=TwoWay}" PlaceholderText="输入校区名称，按 Enter 搜索" KeyDown="SearchQueryKeyDown" />
      <Button Grid.Column="1" Classes="secondary" Content="搜索" IsEnabled="{Binding CanSearchCloudPackages}" Click="SearchPackages" />
    </Grid>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Spacing="12">
      <ListBox ItemsSource="{Binding CloudPackages}" SelectedItem="{Binding SelectedCloudPackage, Mode=TwoWay}"
               IsEnabled="{Binding IsStudentControlsEnabled}" Height="220" ScrollViewer.VerticalScrollBarVisibility="Hidden">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="core:DeploymentPackageCatalogEntry">
            <Border Classes="catalog-item" Padding="12,10" Margin="2,2,2,6">
              <StackPanel Spacing="3">
                <TextBlock Text="{Binding CampusName}" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Summary}" Classes="muted" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <Border Classes="status-panel info" IsVisible="{Binding IsCloudPackageTeacherPhoneLast4Required}">
        <StackPanel Spacing="7">
          <TextBlock Text="输入教师手机号后四位" FontWeight="SemiBold" />
          <TextBox Text="{Binding CloudPackageTeacherPhoneLast4, Mode=TwoWay}" MaxLength="4" PlaceholderText="4 位数字" />
        </StackPanel>
      </Border>
      <TextBlock Text="{Binding CloudPackageStatus}" Classes="muted" TextWrapping="Wrap" />
      <Expander Header="保存配置供离线使用">
        <Button Classes="tertiary" Content="保存到文件" IsEnabled="{Binding CanSaveSelectedCloudPackage}"
                Click="SavePackage" HorizontalAlignment="Left" Margin="0,8,0,0" />
      </Expander>
    </StackPanel>

    </ScrollViewer>
    <Border Grid.Row="2" BorderBrush="#E1E7EB" BorderThickness="0,1,0,0" Padding="0,14,0,0">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
        <Button Classes="secondary" Content="取消" Click="Cancel" HorizontalAlignment="Left" />
        <Button Grid.Column="1" Classes="primary" Content="下载并使用" IsEnabled="{Binding CanLoadSelectedCloudPackage}" Click="LoadPackage" />
      </Grid>
    </Border>
  </Grid>
</Window>
