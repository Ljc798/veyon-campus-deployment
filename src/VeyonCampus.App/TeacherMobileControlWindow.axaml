<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="using:VeyonCampus.App"
        xmlns:core="using:VeyonCampus.Core"
        x:Class="VeyonCampus.App.TeacherMobileControlWindow"
        x:ClassModifier="internal"
        x:DataType="app:TeacherMobileControlManager"
        Title="手机控制" Width="760" Height="720" MinWidth="420" MinHeight="360" CanResize="True"
        WindowStartupLocation="CenterOwner">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="16" Spacing="14">
      <TextBlock Text="{Binding Status}" TextWrapping="Wrap" />
      <WrapPanel Orientation="Horizontal">
        <Button Content="启动服务" Click="StartService" IsVisible="{Binding CanStart}" Margin="0,0,8,6" />
        <Button Content="停止服务" Click="StopService" IsVisible="{Binding IsRunning}" IsEnabled="{Binding CanStop}" Margin="0,0,8,6" />
        <Button Content="刷新" Click="RefreshLists" Margin="0,0,8,6" />
      </WrapPanel>
      <TextBlock Text="{Binding StartupPreferenceStatus}" Classes="muted" TextWrapping="Wrap" />

      <Border Padding="14" CornerRadius="10" Background="#F2F6F8">
        <StackPanel Spacing="9">
          <TextBlock Text="连接手机" FontWeight="SemiBold" />
          <Button Content="生成连接二维码" Click="CreatePairingCode" IsEnabled="{Binding IsRunning}" HorizontalAlignment="Left" />
          <Border Padding="8" Background="White" CornerRadius="6" HorizontalAlignment="Left"
                  IsVisible="{Binding HasPairingQr}">
            <Image x:Name="PairingQrImage" Width="220" Height="220" Stretch="Uniform" />
          </Border>
          <TextBlock Text="8 位连接码" />
          <TextBlock Text="{Binding PairingCode}" FontSize="26" FontWeight="Bold" />
          <TextBlock Text="{Binding PairingExpiry}" TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <Border Padding="14" CornerRadius="10" Background="#FFF4E5">
        <StackPanel Spacing="9">
          <TextBlock Text="等待确认的手机" FontWeight="SemiBold" />
          <TextBlock Text="确认是本人手机后，点“允许连接”。" TextWrapping="Wrap" />
          <ListBox ItemsSource="{Binding PendingPairings}" SelectedItem="{Binding SelectedPairing, Mode=TwoWay}" Height="110">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="app:MobilePendingPairingView">
                <StackPanel Spacing="3" Margin="0,3">
                  <TextBlock Text="{Binding DeviceName}" FontWeight="SemiBold" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding SourceAddress}" Opacity="0.7" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding RequestedLocalTime}" Opacity="0.7" TextWrapping="Wrap" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <WrapPanel Orientation="Horizontal">
            <Button Content="允许所选手机连接" Click="ApprovePairing" IsEnabled="{Binding CanApproveSelectedPairing}" Margin="0,0,8,6" />
            <Button Content="拒绝连接" Click="RejectPairing" IsEnabled="{Binding CanRejectSelectedPairing}" Margin="0,0,8,6" />
          </WrapPanel>
        </StackPanel>
      </Border>

      <Border Padding="14" CornerRadius="10" Background="#F2F6F8">
        <StackPanel Spacing="9">
          <TextBlock Text="已连接手机" FontWeight="SemiBold" />
          <ListBox ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice, Mode=TwoWay}" Height="120">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="core:MobilePairedDeviceView">
                <StackPanel Spacing="3" Margin="0,3">
                  <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding PairedUtc, Converter={StaticResource LocalDateTimeDisplay}}" Opacity="0.7" TextWrapping="Wrap" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <Button Content="解除所选手机连接" Click="RevokeDevice" IsEnabled="{Binding CanRevokeSelectedDevice}" HorizontalAlignment="Left" />
        </StackPanel>
      </Border>

      <Expander Header="连接帮助" IsExpanded="False">
        <Border Padding="14" CornerRadius="10" Background="#F2F6F8">
          <StackPanel Spacing="9">
            <TextBlock Text="首次连接：按手机提示安装安全证书，再核对安全码。" TextWrapping="Wrap" />
            <TextBlock Text="手机连接地址" FontWeight="SemiBold" />
            <TextBox Text="{Binding LanUrl}" IsReadOnly="True" TextWrapping="Wrap" />
            <TextBlock Text="连接说明地址" FontWeight="SemiBold" />
            <TextBox Text="{Binding BootstrapUrl}" IsReadOnly="True" TextWrapping="Wrap" />
            <TextBlock Text="连接安全码（须与手机页面一致）" FontWeight="SemiBold" />
            <TextBox Text="{Binding CertificateFingerprint}" IsReadOnly="True" TextWrapping="Wrap" />
            <TextBlock Text="iPhone 还需在设置中开启“完全信任”。" Classes="muted" TextWrapping="Wrap" />
          </StackPanel>
        </Border>
      </Expander>

      <Expander Header="操作记录">
        <Border Padding="14" CornerRadius="10" Background="#F2F6F8">
          <StackPanel Spacing="9">
            <TextBlock Text="{Binding AuditStatus}" TextWrapping="Wrap" />
            <ListBox ItemsSource="{Binding AuditEntries}" Height="170">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="app:MobileControlAuditView">
                  <StackPanel Spacing="3" Margin="0,4">
                    <TextBlock Text="{Binding TimeUtc, Converter={StaticResource LocalDateTimeDisplay}}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Action}" />
                    <TextBlock Text="{Binding Targets}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Outcome}" TextWrapping="Wrap" Opacity="0.75" />
                    <TextBlock Text="{Binding Device}" Opacity="0.6" />
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </StackPanel>
        </Border>
      </Expander>
      <Button Content="关闭" Click="CloseWindow" HorizontalAlignment="Right" MinWidth="90" />
    </StackPanel>
  </ScrollViewer>
</Window>
