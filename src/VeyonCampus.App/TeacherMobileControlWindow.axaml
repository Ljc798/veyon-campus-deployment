<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="using:VeyonCampus.App"
        xmlns:core="using:VeyonCampus.Core"
        x:Class="VeyonCampus.App.TeacherMobileControlWindow"
        x:ClassModifier="internal"
        x:DataType="app:TeacherMobileControlManager"
        Title="手机控制设置" Width="760" Height="720" MinWidth="420" MinHeight="360" CanResize="True"
        WindowStartupLocation="CenterOwner">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="16" Spacing="14">
      <TextBlock Text="手机控制" FontSize="24" FontWeight="Bold" />
      <TextBlock Text="{Binding Status}" TextWrapping="Wrap" />
      <WrapPanel Orientation="Horizontal">
        <Button Content="启动服务" Click="StartService" IsEnabled="{Binding CanStart}" Margin="0,0,8,6" />
        <Button Content="停止服务" Click="StopService" IsEnabled="{Binding CanStop}" Margin="0,0,8,6" />
        <Button Content="刷新列表和记录" Click="RefreshLists" Margin="0,0,8,6" />
      </WrapPanel>

      <Border Padding="14" CornerRadius="10" Background="#F2F6F8">
        <StackPanel Spacing="9">
          <TextBlock Text="手机连接地址（校园网）" FontWeight="SemiBold" />
          <TextBox Text="{Binding LanUrl}" IsReadOnly="True" TextWrapping="Wrap" />
          <TextBlock Text="首次连接：用手机打开证书下载地址并安装教师根证书，再按手机系统提示启用信任。" TextWrapping="Wrap" />
          <TextBox Text="{Binding BootstrapUrl}" IsReadOnly="True" TextWrapping="Wrap" />
          <TextBlock Text="根证书 SHA-256 指纹" FontWeight="SemiBold" />
          <TextBox Text="{Binding CertificateFingerprint}" IsReadOnly="True" TextWrapping="Wrap" />
          <TextBlock Text="iPhone 需在证书信任设置中启用完整信任；Android 按系统提示安装 CA 证书。仅在受信任的校园网使用。" TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <Border Padding="14" CornerRadius="10" Background="#FFF4E5">
        <StackPanel Spacing="9">
          <TextBlock Text="等待教师批准的手机" FontWeight="SemiBold" />
          <TextBlock Text="输入配对码的手机不会自动获得访问权；请核对设备名称和校园网 IP。" TextWrapping="Wrap" />
          <ListBox ItemsSource="{Binding PendingPairings}" SelectedItem="{Binding SelectedPairing, Mode=TwoWay}" Height="110">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="app:MobilePendingPairingView">
                <StackPanel Spacing="3" Margin="0,3">
                  <TextBlock Text="{Binding DeviceName}" FontWeight="SemiBold" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding SourceAddress}" Opacity="0.7" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding RequestedUtc}" Opacity="0.7" TextWrapping="Wrap" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <WrapPanel Orientation="Horizontal">
            <Button Content="批准所选手机" Click="ApprovePairing" IsEnabled="{Binding CanApproveSelectedPairing}" Margin="0,0,8,6" />
            <Button Content="拒绝所选手机" Click="RejectPairing" IsEnabled="{Binding CanRejectSelectedPairing}" Margin="0,0,8,6" />
          </WrapPanel>
        </StackPanel>
      </Border>

      <Border Padding="14" CornerRadius="10" Background="#F2F6F8">
        <StackPanel Spacing="9">
          <TextBlock Text="扫码配对（5 分钟有效）" FontWeight="SemiBold" />
          <TextBlock Text="手机信任教师根证书后，扫码提交配对请求；教师核对设备后批准。" TextWrapping="Wrap" />
          <Button Content="生成二维码和一次性配对码" Click="CreatePairingCode" IsEnabled="{Binding IsRunning}" HorizontalAlignment="Left" />
          <Border Padding="8" Background="White" CornerRadius="6" HorizontalAlignment="Left"
                  IsVisible="{Binding HasPairingQr}">
            <Image x:Name="PairingQrImage" Width="220" Height="220" Stretch="Uniform" />
          </Border>
          <TextBlock Text="无法扫码时，打开上方连接地址并输入配对码。教师仍需核对并批准。" TextWrapping="Wrap" />
          <TextBlock Text="{Binding PairingCode}" FontSize="26" FontWeight="Bold" />
          <TextBlock Text="{Binding PairingExpiry}" TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <Border Padding="14" CornerRadius="10" Background="#F2F6F8">
        <StackPanel Spacing="9">
          <TextBlock Text="已配对手机（教师可随时撤销）" FontWeight="SemiBold" />
          <ListBox ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice, Mode=TwoWay}" Height="120">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="core:MobilePairedDeviceView">
                <StackPanel Spacing="3" Margin="0,3">
                  <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding PairedUtc}" Opacity="0.7" TextWrapping="Wrap" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <Button Content="撤销所选手机" Click="RevokeDevice" IsEnabled="{Binding CanRevokeSelectedDevice}" HorizontalAlignment="Left" />
        </StackPanel>
      </Border>

      <Border Padding="14" CornerRadius="10" Background="#F2F6F8">
        <StackPanel Spacing="9">
          <TextBlock Text="保存当前策略为手机预设" FontWeight="SemiBold" />
          <TextBox x:Name="ProfileNameInput" PlaceholderText="预设名称" MaxLength="64" />
          <WrapPanel Orientation="Horizontal">
            <Button Content="保存当前网站策略" Click="SaveWebsiteProfile" Margin="0,0,8,6" />
            <Button Content="保存当前应用策略" Click="SaveApplicationProfile" Margin="0,0,8,6" />
            <Button Content="保存当前系统限制" Click="SaveSystemProfile" Margin="0,0,8,6" />
          </WrapPanel>
          <TextBlock Text="规则、学生 SID 和六项长期系统限制在教师桌面编辑；手机只选择预设并启用或解除。系统限制不会自动到期。应用阻止模式仍须先读取并确认审核统计。" TextWrapping="Wrap" />
          <ListBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile, Mode=TwoWay}" Height="130">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="core:MobilePolicyProfile">
                <StackPanel Spacing="3" Margin="0,3">
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding Kind}" Opacity="0.7" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding UpdatedUtc}" Opacity="0.7" TextWrapping="Wrap" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <Button Content="删除所选预设" Click="DeleteProfile" IsEnabled="{Binding CanDeleteSelectedProfile}" HorizontalAlignment="Left" />
        </StackPanel>
      </Border>

      <Border Padding="14" CornerRadius="10" Background="#F2F6F8">
        <StackPanel Spacing="9">
          <TextBlock Text="手机控制操作记录（教师电脑本机）" FontWeight="SemiBold" />
          <TextBlock Text="{Binding AuditStatus}" TextWrapping="Wrap" />
          <ListBox ItemsSource="{Binding AuditEntries}" Height="170">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="app:MobileControlAuditView">
                <StackPanel Spacing="3" Margin="0,4">
                  <TextBlock Text="{Binding TimeUtc}" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding Action}" />
                  <TextBlock Text="{Binding Targets}" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding Outcome}" TextWrapping="Wrap" Opacity="0.75" />
                  <TextBlock Text="{Binding Device}" Opacity="0.6" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </StackPanel>
      </Border>
      <Button Content="关闭" Click="CloseWindow" HorizontalAlignment="Right" MinWidth="90" />
    </StackPanel>
  </ScrollViewer>
</Window>
