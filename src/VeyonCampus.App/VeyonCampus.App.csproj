<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <VeyonCampusRole Condition="'$(VeyonCampusRole)' == ''">StudentSetup</VeyonCampusRole>
    <AssemblyName Condition="'$(VeyonCampusRole)' == 'StudentSetup'">VeyonCampus.StudentSetup</AssemblyName>
    <AssemblyName Condition="'$(VeyonCampusRole)' == 'TeacherConsole'">VeyonCampus.Teacher</AssemblyName>
    <VeyonCampusProduct Condition="'$(VeyonCampusRole)' == 'StudentSetup'">VeyonCampus.StudentSetup</VeyonCampusProduct>
    <VeyonCampusProduct Condition="'$(VeyonCampusRole)' == 'TeacherConsole'">VeyonCampus.TeacherConsole</VeyonCampusProduct>
    <DefineConstants Condition="'$(VeyonCampusRole)' == 'StudentSetup'">$(DefineConstants);STUDENT_SETUP_APP</DefineConstants>
    <DefineConstants Condition="'$(VeyonCampusRole)' == 'TeacherConsole'">$(DefineConstants);TEACHER_CONSOLE</DefineConstants>
    <Version>0.4.54</Version>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationIcon Condition="$([MSBuild]::IsOSPlatform('Windows'))">Assets/veyon-campus.ico</ApplicationIcon>
    <ApplicationManifest Condition="$([MSBuild]::IsOSPlatform('Windows'))">app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets/**/*" />
    <EmbeddedResource Include="MobileWeb/**/*"
                      Condition="'$(VeyonCampusRole)' == 'TeacherConsole'"
                      LogicalName="VeyonCampus.App.MobileWeb.%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="12.1.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.3" />
    <ProjectReference Include="../VeyonCampus.Core/VeyonCampus.Core.csproj" />
    <ProjectReference Include="../VeyonCampus.Worker/VeyonCampus.Worker.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <ItemGroup Condition="'$(VeyonCampusRole)' == 'TeacherConsole'">
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup Condition="'$(VeyonCampusRole)' == 'StudentSetup'">
    <ProjectReference Include="../VeyonCampus.Agent/VeyonCampus.Agent.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <ItemGroup Condition="'$(VeyonCampusRole)' == 'StudentSetup'">
    <AvaloniaXaml Remove="TeacherWindow.axaml" />
    <Compile Remove="TeacherWindow.axaml.cs" />
    <Compile Remove="TeacherViewModel.cs" />
    <AvaloniaXaml Remove="TeacherMobileControlWindow.axaml" />
    <Compile Remove="TeacherMobileControlWindow.axaml.cs" />
    <Compile Remove="TeacherMobileControlServer.cs" />
    <Compile Remove="MobileControlTlsIdentity.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(VeyonCampusRole)' == 'TeacherConsole'">
    <AvaloniaXaml Remove="StudentSetupWindow.axaml" />
    <AvaloniaXaml Remove="StudentCloudPackageWindow.axaml" />
    <AvaloniaXaml Remove="StudentSetupCleanupConfirmationWindow.axaml" />
    <Compile Remove="StudentSetupWindow.axaml.cs" />
    <AvaloniaXaml Remove="StudentSetupUpdateWindow.axaml" />
    <Compile Remove="StudentSetupUpdateWindow.axaml.cs" />
    <Compile Remove="StudentSetupUpdateViewModel.cs" />
    <Compile Remove="StudentCloudPackageWindow.axaml.cs" />
    <Compile Remove="StudentSetupCleanupConfirmationWindow.axaml.cs" />
    <Compile Remove="MainViewModel.cs" />
  </ItemGroup>

  <Target Name="ValidateVeyonCampusRole" BeforeTargets="PrepareForBuild"
          Condition="'$(VeyonCampusRole)' != 'StudentSetup' and '$(VeyonCampusRole)' != 'TeacherConsole'">
    <Error Text="VeyonCampusRole must be StudentSetup or TeacherConsole." />
  </Target>

  <Target Name="CopyWebsitePolicyAgentToBuildOutput" AfterTargets="Build"
          Condition="'$(VeyonCampusRole)' == 'StudentSetup'">
    <ItemGroup>
      <WebsitePolicyAgentBuildFiles Include="$(MSBuildThisFileDirectory)../VeyonCampus.Agent/bin/$(Configuration)/$(TargetFramework)/*" />
    </ItemGroup>
    <MakeDir Directories="$(OutDir)WebsitePolicyAgent" />
    <Copy SourceFiles="@(WebsitePolicyAgentBuildFiles)" DestinationFolder="$(OutDir)WebsitePolicyAgent" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="PublishWebsitePolicyAgent" AfterTargets="Publish"
          Condition="'$(RuntimeIdentifier)' != '' and '$(VeyonCampusRole)' == 'StudentSetup'">
    <MSBuild Projects="$(MSBuildThisFileDirectory)../VeyonCampus.Agent/VeyonCampus.Agent.csproj"
             Targets="Publish"
             Properties="Configuration=$(Configuration);RuntimeIdentifier=$(RuntimeIdentifier);SelfContained=$(SelfContained);PublishDir=$(PublishDir)WebsitePolicyAgent/;UseAppHost=true;VeyonCampusReleasePublicKeyPath=$(VeyonCampusReleasePublicKeyPath);VeyonCampusCoreLockFile=$(VeyonCampusCoreLockFile);VeyonCampusIncludeInstaller=false" />
  </Target>

  <Target Name="PublishElevatedWorker" AfterTargets="Publish"
          Condition="'$(RuntimeIdentifier)' != ''">
    <MSBuild Projects="$(MSBuildThisFileDirectory)../VeyonCampus.Worker/VeyonCampus.Worker.csproj"
             Targets="Publish"
             Properties="Configuration=$(Configuration);RuntimeIdentifier=$(RuntimeIdentifier);SelfContained=$(SelfContained);PublishDir=$(PublishDir)Worker/;UseAppHost=true;Version=$(Version);VeyonCampusIncludeInstaller=false" />
  </Target>

  <Target Name="WriteVeyonCampusRoleMetadata" AfterTargets="Publish">
    <WriteLinesToFile File="$(PublishDir)veyon-campus-role.json"
                      Lines="{&quot;schemaVersion&quot;:1,&quot;role&quot;:&quot;$(VeyonCampusRole)&quot;,&quot;product&quot;:&quot;$(VeyonCampusProduct)&quot;,&quot;version&quot;:&quot;$(Version)&quot;}"
                      Overwrite="true" Encoding="UTF-8" />
  </Target>
</Project>
