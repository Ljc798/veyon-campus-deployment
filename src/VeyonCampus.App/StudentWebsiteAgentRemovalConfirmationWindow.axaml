<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="VeyonCampus.App.StudentWebsiteAgentRemovalConfirmationWindow"
        Title="移除网站限制" Width="520" SizeToContent="Height"
        CanResize="False" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Background="#F3F6F8">
  <Border Background="White" CornerRadius="14" BorderBrush="#E3E9EC" BorderThickness="1" Padding="24" Margin="18">
    <StackPanel Spacing="14">
      <TextBlock Text="移除这台电脑的网站限制" FontSize="21" FontWeight="Bold" />
      <TextBlock Text="之后，教师将无法再为这台电脑推送网站规则。" TextWrapping="Wrap" Foreground="#536671" />
      <Border Background="#F7F9FA" BorderBrush="#E3E9EC" BorderThickness="1" CornerRadius="10" Padding="14">
        <StackPanel Spacing="8">
          <TextBlock Text="需要管理员权限。Veyon、账户和其他管理员设置会保留。" TextWrapping="Wrap" Foreground="#536671" />
        </StackPanel>
      </Border>
      <CheckBox x:Name="ConfirmRemovalCheck" IsCheckedChanged="UpdateConfirmationState">
        <TextBlock Text="确认移除网站限制" TextWrapping="Wrap" />
      </CheckBox>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
        <Button Content="返回" IsCancel="True" MinWidth="100" />
        <Button x:Name="ConfirmRemovalButton" Content="移除限制" IsDefault="True" IsEnabled="False" Click="ConfirmRemoval" MinWidth="120" Classes="danger" />
      </StackPanel>
    </StackPanel>
  </Border>
</Window>
