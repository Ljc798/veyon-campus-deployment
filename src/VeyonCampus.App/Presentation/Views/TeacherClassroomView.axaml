<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VeyonCampus.App"
             xmlns:core="using:VeyonCampus.Core"
             xmlns:views="using:VeyonCampus.App.Presentation.Views"
             xmlns:flowery="clr-namespace:Flowery.Controls;assembly=Flowery.NET"
             xmlns:floweryTheme="clr-namespace:Flowery;assembly=Flowery.NET"
             x:Class="VeyonCampus.App.Presentation.Views.TeacherClassroomView"
             x:DataType="vm:TeacherViewModel">
      <StackPanel Margin="24,24,24,28" Spacing="20">
        <StackPanel IsVisible="{Binding IsClassroomExperiencePage}" Spacing="16">
          <Border Classes="card">
            <StackPanel Spacing="12">
              <TextBlock Text="课堂概览" Classes="section-title" />
              <UniformGrid Columns="3">
                <Border Classes="stat-card info" Margin="0,0,8,0">
                  <Grid ColumnDefinitions="30,*" ColumnSpacing="8" VerticalAlignment="Center">
                    <Border Classes="stat-icon info">
                      <Path Classes="stat-icon-shape" Data="M2,4 L18,4 L18,15 L2,15 Z M7,19 L13,19 M10,15 L10,19" />
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                      <TextBlock Classes="stat-value" Text="{Binding ClassroomOverviewDeviceCount}" />
                      <TextBlock Classes="stat-label" Text="学生电脑" />
                    </StackPanel>
                  </Grid>
                </Border>
                <Border Classes="stat-card success" Margin="0,0,8,0">
                  <Grid ColumnDefinitions="30,*" ColumnSpacing="8" VerticalAlignment="Center">
                    <Border Classes="stat-icon success">
                      <Path Classes="stat-icon-shape" Data="M4,10 L8,14 L16,5" />
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                      <TextBlock Classes="stat-value" Text="{Binding ClassroomOverviewReceiptCount}" />
                      <TextBlock Classes="stat-label" Text="已回执 / 核验" />
                    </StackPanel>
                  </Grid>
                </Border>
                <Border Classes="stat-card warning">
                  <Grid ColumnDefinitions="30,*" ColumnSpacing="8" VerticalAlignment="Center">
                    <Border Classes="stat-icon warning">
                      <Path Classes="stat-icon-shape" Data="M10,3 L18,17 L2,17 Z M10,7 L10,11 M10,14 L10,14.5" />
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                      <TextBlock Classes="stat-value" Text="{Binding ClassroomOverviewPendingCount}" />
                      <TextBlock Classes="stat-label" Text="待处理 / 核对" />
                    </StackPanel>
                  </Grid>
                </Border>
              </UniformGrid>
            </StackPanel>
          </Border>

          <Border Classes="card">
            <StackPanel Spacing="12">
              <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                <StackPanel Spacing="3">
                  <TextBlock Text="课堂快捷管控" Classes="section-title" />
                </StackPanel>
                <ComboBox Grid.Column="1" ItemsSource="{Binding RoomProfiles}"
                          SelectedItem="{Binding SelectedRoomProfile, Mode=TwoWay}"
                          IsVisible="{Binding HasMultipleRoomProfiles}"
                          PlaceholderText="选择当前教室" MinWidth="180" VerticalAlignment="Center">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="core:TeacherRoomProfile">
                      <TextBlock Text="{Binding DisplayName}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock x:Name="ClassroomQuickControlBadge" Grid.Column="2"
                           Text="{Binding ClassroomQuickControlBadgeText}"
                           Foreground="{Binding ClassroomQuickControlBadgeBrush}" VerticalAlignment="Center" />
              </Grid>
              <TextBlock Text="{Binding ClassroomRoomContextSummary}"
                         IsVisible="{Binding !HasMultipleRoomProfiles}"
                         Classes="muted" TextWrapping="Wrap" />
              <Border Background="{DynamicResource Teacher.Color.SurfaceSubtle}" CornerRadius="10" Padding="12,10">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                  <StackPanel Spacing="3">
                    <TextBlock Text="当前网站名单" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding ClassroomQuickControlPresetSummary}" Classes="muted"
                               TextWrapping="Wrap" />
                  </StackPanel>
                  <Button Grid.Column="1" Classes="secondary" Content="管理规则"
                          Click="RequestOpenQuickControlWebsitePolicy" VerticalAlignment="Center" />
                </Grid>
              </Border>
              <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                <Button x:Name="EnableClassroomWebsiteControlButton"
                        Classes="quick-control-choice"
                        Classes.active="{Binding IsClassroomWebsiteControlActive}"
                        Height="96" Click="RequestEnableClassroomWebsiteControl"
                        IsEnabled="{Binding CanStartClassroomWebsiteControl}"
                        ToolTip.Tip="网站策略由 Student Agent 处理，不依赖键鼠 Guard 状态。">
                  <Grid ColumnDefinitions="44,*" ColumnSpacing="12" HorizontalAlignment="Left">
                    <Border Width="42" Height="42" CornerRadius="12" Background="{DynamicResource Teacher.Color.SuccessSubtle}"
                            VerticalAlignment="Center">
                      <Path Data="M19,5 L12,2 L5,5 L5,11 C5,16 8,20 12,22 C16,20 19,16 19,11 Z"
                            Width="23" Height="23" Stretch="Uniform" Fill="Transparent"
                            Stroke="{DynamicResource Teacher.Color.Success}" StrokeThickness="1.8" HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                      <TextBlock Text="{Binding ClassroomWebsiteControlTitle}" FontWeight="SemiBold" />
                      <TextBlock Text="{Binding ClassroomWebsiteControlSubtitle}" Classes="muted" FontSize="12"
                                 TextWrapping="Wrap" />
                    </StackPanel>
                  </Grid>
                </Button>
                <Button x:Name="LockClassroomInputButton" Grid.Column="1"
                        Classes="quick-control-choice"
                        Classes.active="{Binding IsClassroomInputControlActive}"
                        Classes.needs-review="{Binding HasUnverifiedClassroomInputControl}"
                        Height="96" Click="RequestLockClassroomInput"
                        IsEnabled="{Binding CanToggleClassroomInputControl}"
                        ToolTip.Tip="键鼠操作需要 InputGuard 提供可信的签名状态。">
                  <Grid ColumnDefinitions="44,*" ColumnSpacing="12" HorizontalAlignment="Left">
                    <Border Width="42" Height="42" CornerRadius="12" Background="{DynamicResource Teacher.Color.InfoSubtle}"
                            VerticalAlignment="Center">
                      <Path Data="M6,3 L19,14 L12.5,15 L9.5,21 Z" Width="23" Height="23"
                            Stretch="Uniform" Fill="Transparent" Stroke="{DynamicResource Teacher.Color.TextSecondary}"
                            StrokeThickness="1.8" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                      <TextBlock Text="{Binding ClassroomInputControlTitle}" FontWeight="SemiBold" />
                      <TextBlock Text="{Binding ClassroomInputControlSubtitle}" Classes="muted" FontSize="12"
                                 TextWrapping="Wrap" />
                    </StackPanel>
                  </Grid>
                </Button>
              </Grid>
              <Border Classes="subtle-panel" Padding="12">
                <StackPanel Spacing="12">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                    <Grid ColumnDefinitions="42,*" ColumnSpacing="10" VerticalAlignment="Center">
                      <Border Width="38" Height="38" CornerRadius="12"
                              Background="{DynamicResource Teacher.Color.InfoSubtle}">
                        <Grid Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                          <Ellipse Stroke="{DynamicResource Teacher.Color.Info}" StrokeThickness="1.8" />
                          <Path Data="M10,4 L10,10 L14,12" Stroke="{DynamicResource Teacher.Color.Info}"
                                StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round" />
                        </Grid>
                      </Border>
                      <TextBlock Grid.Column="1" Text="自动解除" FontWeight="SemiBold"
                                 VerticalAlignment="Center" />
                    </Grid>
                    <Border Grid.Column="1" Classes="status-chip info" VerticalAlignment="Center"
                            IsVisible="{Binding HasCurrentClassroomQuickControlDeadline}">
                      <TextBlock Text="{Binding CurrentClassroomQuickControlDeadlineText}" />
                    </Border>
                  </Grid>
                  <Grid ColumnDefinitions="*,Auto,*">
                    <Border Grid.Column="1" Classes="quick-countdown-host" VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            IsVisible="{Binding HasCurrentClassroomQuickControlDeadline}">
                      <Border.Styles>
                        <floweryTheme:DaisyUITheme />
                      </Border.Styles>
                      <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <TextBlock Text="剩余" Classes="muted" FontSize="12" VerticalAlignment="Center" />
                        <flowery:DaisyNumberFlow Value="{Binding CurrentClassroomQuickControlCountdownHours}"
                            FormatString="00" ShowDigitBoxes="False" ShowControls="False"
                            Duration="0:0:0.45" FontSize="21" Height="34" MinWidth="34"
                            DigitForeground="#0B69C7" AccessibleText="剩余小时" />
                        <TextBlock Text=":" Classes="countdown-separator" />
                        <flowery:DaisyNumberFlow Value="{Binding CurrentClassroomQuickControlCountdownMinutes}"
                            FormatString="00" ShowDigitBoxes="False" ShowControls="False"
                            Duration="0:0:0.45" FontSize="21" Height="34" MinWidth="34"
                            DigitForeground="#0B69C7" AccessibleText="剩余分钟" />
                        <TextBlock Text=":" Classes="countdown-separator" />
                        <flowery:DaisyNumberFlow Value="{Binding CurrentClassroomQuickControlCountdownSeconds}"
                            FormatString="00" ShowDigitBoxes="False" ShowControls="False"
                            Duration="0:0:0.45" FontSize="21" Height="34" MinWidth="34"
                            DigitForeground="#0B69C7" AccessibleText="剩余秒" />
                      </StackPanel>
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="6" HorizontalAlignment="Center"
                                IsVisible="{Binding !HasScheduledClassroomQuickControlDeadline}">
                      <TextBlock Text="截止时间" Classes="muted" FontSize="12" HorizontalAlignment="Center" />
                      <TimePicker SelectedTime="{Binding ClassroomQuickControlDeadlineTime, Mode=TwoWay}"
                                  ClockIdentifier="24HourClock" UseSeconds="False"
                                  Width="220" Height="40" HorizontalAlignment="Center"
                                  IsEnabled="{Binding CanEditClassroomQuickControlDeadline}" />
                      <TextBlock Text="{Binding ClassroomQuickControlDeadlineSummary}"
                                 Classes="muted" FontSize="12" TextWrapping="Wrap"
                                 HorizontalAlignment="Center"
                                 IsVisible="{Binding !HasValidClassroomQuickControlDeadline}" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding ClassroomQuickControlDeadlineSummary}"
                               Classes="muted" FontSize="12" TextWrapping="Wrap"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               IsVisible="{Binding IsClassroomQuickControlDeadlinePending}" />
                  </Grid>
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                    <Button x:Name="ReleaseClassroomQuickControlButton"
                            Classes="secondary" Content="一键恢复全部"
                            Click="RequestReleaseClassroomQuickControl"
                            IsEnabled="{Binding CanReleaseClassroomQuickControl}"
                            ToolTip.Tip="解除本工具设置的网站限制和键鼠锁定；其他来源的策略保留。" />
                  </StackPanel>
                </StackPanel>
              </Border>
              <TextBlock Text="当前版本未启用快捷管控试点。"
                         Foreground="{DynamicResource Teacher.Color.Warning}" FontSize="12"
                         TextWrapping="Wrap" IsVisible="{Binding IsClassroomQuickControlPilotDisabled}" />

              <TextBlock Text="{Binding ClassroomQuickControlActivityText}" Classes="muted" FontSize="12"
                         IsVisible="{Binding IsClassroomQuickControlBusy}" />
              <Border Background="{DynamicResource Teacher.Color.SurfaceSubtle}" CornerRadius="10" Padding="12,9">
                <Grid ColumnDefinitions="*" ColumnSpacing="8">
                  <StackPanel Spacing="3" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ClassroomQuickControlSelectionSummary}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding ClassroomQuickControlProgressSummary}" Classes="muted"
                               TextWrapping="Wrap" IsVisible="{Binding HasClassroomQuickControlDevices}" />
                  </StackPanel>
                </Grid>
              </Border>
              <Border BorderBrush="{DynamicResource Teacher.Color.Border}" BorderThickness="1" CornerRadius="12"
                      IsVisible="{Binding HasClassroomQuickControlDevices}">
                <StackPanel>
                  <Border Padding="16,13" BorderBrush="{DynamicResource Teacher.Color.Border}" BorderThickness="0,0,0,1">
                    <TextBlock Text="{Binding ClassroomQuickControlProgressHeader}" Classes="component-title" />
                  </Border>
                  <ScrollViewer MaxHeight="360" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding ClassroomQuickControlDevices}">
                      <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:TeacherClassroomQuickControlDeviceItem">
                        <Border BorderBrush="{DynamicResource Teacher.Color.Border}" BorderThickness="0,0,0,1">
                          <Expander Theme="{StaticResource App.DetailExpander}" IsExpanded="{Binding IsExpanded, Mode=TwoWay}">
                            <Expander.Header>
                              <Grid ColumnDefinitions="32,*,Auto" ColumnSpacing="12" MinHeight="44">
                                <Border Width="32" Height="32" CornerRadius="9" Background="{DynamicResource Teacher.Color.InfoSubtle}" VerticalAlignment="Center">
                                  <Path Data="M2,3 L18,3 L18,14 L2,14 Z M10,14 L10,18 M6,18 L14,18" Width="18" Height="18"
                                        Stretch="Uniform" Stroke="{DynamicResource Teacher.Color.Primary}" StrokeThickness="1.5" />
                                </Border>
                                <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                  <TextBlock Classes="device-row-name" Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                                  <TextBlock Text="{Binding Summary}" Classes="supporting-copy" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Spacing="5" VerticalAlignment="Center" HorizontalAlignment="Right">
                                  <Border Background="{Binding StatusBackground}" CornerRadius="12" Padding="9,4" HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusBrush}" FontSize="12" FontWeight="SemiBold" />
                                  </Border>
                                  <TextBlock Text="{Binding UpdatedText}" Classes="supporting-copy" FontSize="12"
                                             ToolTip.Tip="该任务最近一次进度的本机记录时间，不代表设备当前在线。" />
                                </StackPanel>
                              </Grid>
                            </Expander.Header>
                            <Border Background="{DynamicResource Teacher.Color.SurfaceSubtle}" CornerRadius="8" Padding="14,12" Margin="12,0,12,10">
                              <StackPanel Spacing="8">
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                  <Border Background="{Binding WebsiteControlStatusBackground}" CornerRadius="8" Padding="9,6">
                                    <TextBlock Text="{Binding WebsiteControlStatus}" Foreground="{Binding WebsiteControlStatusBrush}"
                                               FontSize="12" TextWrapping="Wrap" />
                                  </Border>
                                  <Border Grid.Column="1" Background="{Binding InputControlStatusBackground}" CornerRadius="8" Padding="9,6">
                                    <TextBlock Text="{Binding InputControlStatus}" Foreground="{Binding InputControlStatusBrush}"
                                               FontSize="12" TextWrapping="Wrap" />
                                  </Border>
                                </Grid>
                                <TextBlock Text="{Binding Detail}" Classes="supporting-copy" TextWrapping="Wrap" />
                              </StackPanel>
                            </Border>
                          </Expander>
                        </Border>
                      </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ScrollViewer>
                </StackPanel>
              </Border>
            </StackPanel>
          </Border>

          <Border Classes="card" IsVisible="{Binding HasClassroomEventItems}">
            <StackPanel Spacing="10">
              <TextBlock Text="学生消息" FontSize="17" FontWeight="SemiBold" />
              <ScrollViewer Height="300" VerticalScrollBarVisibility="Auto">
              <ItemsControl ItemsSource="{Binding ClassroomEventItems}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <VirtualizingStackPanel />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:TeacherClassroomEventItem">
                    <Border Padding="12" CornerRadius="10" Background="{DynamicResource Teacher.Color.SurfaceSubtle}" Margin="0,0,0,8">
                      <StackPanel Spacing="6">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                          <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                          <TextBlock Grid.Column="1" Text="{Binding Status}" Classes="muted"
                                     VerticalAlignment="Center" />
                        </Grid>
                        <TextBlock Text="{Binding SeatLocation}" Classes="muted" IsVisible="{Binding HasSeatLocation}" />
                        <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding EventTime}" Classes="muted" />
                        <TextBox Text="{Binding ReplyMessage, Mode=TwoWay}" IsVisible="{Binding CanReply}"
                                 MaxLength="500" PlaceholderText="回复学生" />
                        <Button Content="发送回复" IsVisible="{Binding CanReply}" IsEnabled="{Binding CanReply}"
                                Click="RequestReplyToClassroomEvent" HorizontalAlignment="Right" />
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              </ScrollViewer>
            </StackPanel>
          </Border>
          <Border Classes="card" IsVisible="{Binding HasClassroomRestores}">
            <StackPanel Spacing="10">
              <TextBlock Text="待恢复学生策略" FontSize="17" FontWeight="SemiBold" />
              <ScrollViewer MaxHeight="190" VerticalScrollBarVisibility="Auto">
                <TextBlock Text="{Binding ClassroomRestoreSummary}" Classes="muted" TextWrapping="Wrap" />
              </ScrollViewer>
              <Button Classes="primary" Content="重试恢复"
                      IsVisible="{Binding HasPendingClassroomRestoreItems}"
                      IsEnabled="{Binding CanRetryClassroomRestores}" Click="RequestRetryClassroomRestores" />
            </StackPanel>
          </Border>
        </StackPanel>
      </StackPanel>
</UserControl>
