<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VeyonCampus.App"
             xmlns:suki="clr-namespace:SukiUI.Controls;assembly=SukiUI"
             xmlns:flowery="clr-namespace:Flowery.Controls;assembly=Flowery.NET"
             xmlns:floweryTheme="clr-namespace:Flowery;assembly=Flowery.NET"
             x:Class="VeyonCampus.App.Presentation.Views.TeacherSetupView"
             x:DataType="vm:TeacherViewModel">
  <StackPanel Margin="24,24,24,28" Spacing="20">
    <StackPanel IsVisible="{Binding IsSetupPage}" Spacing="20">
      <Border Classes="card">
        <StackPanel Spacing="12">
          <TextBlock Text="教师端首次设置" FontSize="20" FontWeight="SemiBold" />
          <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
            <Button Classes="setup-step" Classes.current="{Binding IsTeacherSetupStep1}"
                    Content="{Binding TeacherSetupStep1Label}" Click="RequestTeacherSetupStep1" />
            <Button Grid.Column="1" Classes="setup-step" Classes.current="{Binding IsTeacherSetupStep2}"
                    Content="{Binding TeacherSetupStep2Label}" IsEnabled="{Binding CanOpenTeacherSetupStep2}"
                    Click="RequestTeacherSetupStep2" />
            <Button Grid.Column="2" Classes="setup-step" Classes.current="{Binding IsTeacherSetupStep3}"
                    Content="{Binding TeacherSetupStep3Label}" IsEnabled="{Binding CanOpenTeacherSetupStep3}"
                    Click="RequestTeacherSetupStep3" />
          </Grid>
          <Border Height="7" ClipToBounds="True" CornerRadius="4">
            <Border.Styles>
              <floweryTheme:DaisyUITheme />
            </Border.Styles>
            <flowery:DaisyProgress Value="{Binding TeacherSetupWizardProgress}"
                                   AccessibleText="教师端首次设置进度"
                                   AutomationProperties.Name="{Binding TeacherSetupWizardProgressText}"
                                   Height="7" VerticalAlignment="Center" />
          </Border>
          <TextBlock Text="确认教师端环境、配置学生座位，再生成学生配置包。空座位不会生成电脑。"
                     Classes="muted" TextWrapping="Wrap" />
        </StackPanel>
      </Border>
      <Border Classes="card" IsVisible="{Binding IsTeacherSetupStep1}">
        <StackPanel Spacing="12" IsVisible="{Binding IsWindowsTeacherHost}">
          <TextBlock Text="教师端一键安装 Veyon" FontSize="20" FontWeight="SemiBold" />
          <TextBlock Text="{Binding TeacherInstallPlanText}" TextWrapping="Wrap" />
          <TextBlock Text="{Binding TeacherInstallSafetyText}" Foreground="{DynamicResource Teacher.Color.Danger}" TextWrapping="Wrap" />
          <Button Classes="primary" Content="安装/修复教师端 Veyon" Click="RequestInstallTeacherVeyon" IsEnabled="{Binding CanInstallTeacherVeyon}" HorizontalAlignment="Left" />
          <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsInstallingTeacherVeyon}" Height="6" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="重新检查 Veyon 状态" Click="RequestRefreshTeacherSetupVeyon"
                    IsEnabled="{Binding CanRefreshTeacherSetupVeyon}" />
            <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsCheckingTeacherSetupVeyon}"
                         Width="120" Height="6" VerticalAlignment="Center" />
          </StackPanel>
          <TextBlock Text="{Binding TeacherSetupVeyonStatus}" Classes="muted" TextWrapping="Wrap"
                     IsVisible="{Binding HasTeacherSetupVeyonStatus}" />
          <TextBlock Text="{Binding InstallerStatus}" Classes="muted" TextWrapping="Wrap"
                     IsVisible="{Binding HasInstallerStatus}" />
          <TextBlock Text="{Binding TeacherInstallResult}" Foreground="{DynamicResource Teacher.Color.Success}" IsVisible="{Binding HasTeacherInstallResult}" TextWrapping="Wrap" />
          <TextBlock Text="{Binding TeacherInstallIssue}" Foreground="{DynamicResource Teacher.Color.Danger}" IsVisible="{Binding HasTeacherInstallIssue}" TextWrapping="Wrap" />
          <Button Classes="primary" Content="下一步：配置机房与座位" Click="RequestTeacherSetupNext"
                  IsEnabled="{Binding CanProceedTeacherSetupToRooms}" HorizontalAlignment="Left" />
        </StackPanel>
      </Border>
      <Border Classes="card" IsVisible="{Binding IsTeacherSetupStep1}">
        <StackPanel Spacing="12" IsVisible="{Binding IsMacTeacherHost}">
          <TextBlock Text="Mac 教师端已就绪" FontSize="20" FontWeight="SemiBold" />
          <suki:InfoBar Message="教师端直接运行在 Mac 本机，不需要 Windows 远程桌面。首次连接已部署学生机前，请先在第三步生成并部署策略密钥更新包。"
                        Severity="Information" IsOpen="True" IsClosable="False" IsOpaque="False" />
          <Border Classes="subtle-panel">
            <Border.Styles>
              <floweryTheme:DaisyUITheme />
            </Border.Styles>
            <StackPanel Spacing="10">
              <TextBlock Text="Mac 教师端能力" FontWeight="SemiBold" />
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                <flowery:DaisyStatusIndicator Color="Success" Size="Small"
                                              AccessibleText="Mac 本机支持" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="地点、座位、活动课堂和教师控制台可在 Mac 本机运行。"
                           TextWrapping="Wrap" />
              </Grid>
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                <flowery:DaisyStatusIndicator Color="Info" Size="Small"
                                              AccessibleText="需要学生信任迁移" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1"
                           Text="策略和签名状态需要学生先应用 Mac 生成的更新包并固定 Agent 身份；未完成时显示未知，不会假报成功。"
                           TextWrapping="Wrap" />
              </Grid>
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                <flowery:DaisyStatusIndicator Color="Info" Size="Small"
                                              AccessibleText="屏幕巡视有前置条件" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1"
                           Text="手机屏幕巡视需要准备 ARM64 Veyon helper、导入匹配的 Veyon 私钥并打通校园网；真实学生画面仍待现场验证。"
                           TextWrapping="Wrap" />
              </Grid>
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                <flowery:DaisyStatusIndicator Color="Warning" Size="Small"
                                              AccessibleText="Windows 本机操作不可用" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1"
                           Text="Mac 不提供 Windows Veyon 安装/修复或学生端批量更新；这些操作需在学生电脑上完成。"
                           TextWrapping="Wrap" />
              </Grid>
            </StackPanel>
          </Border>
          <Border Classes="subtle-panel">
            <StackPanel Spacing="10">
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                <flowery:DaisyStatusIndicator Color="Success" Size="Small"
                                              AccessibleText="屏幕巡视环境已就绪" VerticalAlignment="Top"
                                              IsVisible="{Binding IsMacVeyonHelperReady}" />
                <flowery:DaisyStatusIndicator Color="Warning" Size="Small"
                                              AccessibleText="屏幕巡视环境需要准备" VerticalAlignment="Top"
                                              IsVisible="{Binding !IsMacVeyonHelperReady}" />
                <StackPanel Grid.Column="1" Spacing="4">
                  <TextBlock Text="手机屏幕巡视环境" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding MacVeyonHelperStatus}" Classes="muted" TextWrapping="Wrap" />
                </StackPanel>
              </Grid>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Classes="primary" Content="准备/恢复 Veyon helper"
                        Click="RequestPrepareMacVeyonHelper"
                        IsEnabled="{Binding CanPrepareMacVeyonHelper}" />
                <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsPreparingMacVeyonHelper}"
                             Width="80" Height="5" VerticalAlignment="Center" />
              </StackPanel>
            </StackPanel>
          </Border>
          <StackPanel Spacing="8">
            <TextBlock Text="登录时启动教师端" FontWeight="SemiBold" />
            <TextBlock Text="{Binding MacTeacherLoginStartStatus}" Classes="muted" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Classes="primary" Content="{Binding MacTeacherLoginStartActionLabel}"
                      Click="RequestChangeMacTeacherLoginStart"
                      IsEnabled="{Binding CanChangeMacTeacherLoginStart}" />
              <Button Content="刷新状态" Click="RequestRefreshMacTeacherLoginStart"
                      IsEnabled="{Binding CanRefreshMacTeacherLoginStart}" />
              <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsChangingMacTeacherLoginStart}"
                           Width="72" Height="5" VerticalAlignment="Center" />
            </StackPanel>
          </StackPanel>
          <TextBlock Text="此设置只让当前 macOS 用户登录后打开 TeacherConsole；macOS 的登录项服务要求应用包已代码签名。手机服务是否自动恢复，仍由手机控制页中的自动恢复设置决定。"
                     Classes="muted" TextWrapping="Wrap" />
          <Button Classes="primary" Content="下一步：管理地点与座位" Click="RequestTeacherSetupNext"
                  IsEnabled="{Binding CanProceedTeacherSetupToRooms}" HorizontalAlignment="Left" />
        </StackPanel>
      </Border>
      <Border Classes="card" IsVisible="{Binding IsTeacherSetupStep2}">
        <StackPanel Spacing="12">
          <TextBlock Text="机房地点与学生座位" FontSize="20" FontWeight="SemiBold" />
          <TextBlock Text="{Binding TeacherSetupRoomSummary}" Classes="muted" TextWrapping="Wrap" />
          <suki:InfoBar Message="有姓名的座位会生成学生电脑；空座位不会。"
                        Severity="Information" IsOpen="True" IsClosable="False" IsOpaque="False" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Classes="primary" Content="配置机房座位图" Click="RequestOpenRoomSetupFromTeacherWizard" />
            <Button Classes="primary" Content="下一步：生成学生配置包" Click="RequestTeacherSetupNext"
                    IsEnabled="{Binding IsTeacherSetupRoomComplete}" />
            <Button Content="暂时跳过机房设置" Click="RequestSkipTeacherSetupRoom"
                    IsEnabled="{Binding CanSkipTeacherSetupRoom}" />
          </StackPanel>
        </StackPanel>
      </Border>
      <Border Classes="card" IsVisible="{Binding IsTeacherSetupStep3}">
        <StackPanel Spacing="14">
          <TextBlock Text="生成学生配置包" FontSize="20" FontWeight="SemiBold" />
          <suki:InfoBar Message="{Binding TrustMigrationPackageGuidance}"
                        Severity="Information" IsOpen="True" IsClosable="False" IsOpaque="False" />
          <StackPanel Spacing="8" IsVisible="{Binding IsMacTeacherHost}">
            <TextBlock Text="原有学生配置包文件夹" FontWeight="SemiBold" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
              <TextBox Text="{Binding TrustMigrationSourcePackageDirectory}" IsReadOnly="True"
                       PlaceholderText="选择含 manifest.json 和 campus.json 的原配置包" HorizontalAlignment="Stretch" />
              <Button Grid.Column="1" Content="选择原配置包" Click="RequestChooseTrustMigrationSource"
                      IsEnabled="{Binding CanChooseTrustMigrationSourcePackage}" />
            </Grid>
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
              <flowery:DaisyStatusIndicator Color="Success" Size="Small"
                                            AccessibleText="原学生配置包已验证" VerticalAlignment="Top"
                                            IsVisible="{Binding IsTrustMigrationSourcePackageReady}" />
              <flowery:DaisyStatusIndicator Color="Info" Size="Small"
                                            AccessibleText="正在验证原学生配置包" VerticalAlignment="Top"
                                            IsVisible="{Binding IsValidatingTrustMigrationSourcePackage}" />
              <flowery:DaisyStatusIndicator Color="Warning" Size="Small"
                                            AccessibleText="原学生配置包未就绪" VerticalAlignment="Top"
                                            IsVisible="{Binding IsTrustMigrationSourcePackageNotReady}" />
              <TextBlock Grid.Column="1" Text="{Binding TrustMigrationSourcePackageValidationStatus}"
                         Classes="muted" TextWrapping="Wrap" />
            </Grid>
            <flowery:DaisyProgress IsIndeterminate="True" Variant="Info" Size="ExtraSmall"
                                   AccessibleText="正在验证原学生配置包"
                                   IsVisible="{Binding IsValidatingTrustMigrationSourcePackage}"
                                   Height="6" />
            <suki:InfoBar Message="{Binding MacVeyonPrivateKeyImportInstructions}"
                          Severity="Information" IsOpen="True" IsClosable="False" IsOpaque="False" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
              <suki:InfoBar Message="{Binding MacVeyonKeyImportStatus}"
                            Severity="Information" IsOpen="True" IsClosable="False" IsOpaque="False" />
              <Button Grid.Column="1" Content="选择私钥并导入钥匙串"
                      Click="RequestImportMacVeyonPrivateKey"
                      IsEnabled="{Binding CanImportMacVeyonPrivateKey}" />
            </Grid>
            <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsImportingMacVeyonKey}" Height="5" />
          </StackPanel>
          <StackPanel Spacing="8" IsVisible="{Binding IsWindowsTeacherHost}">
            <TextBlock Text="校区名称" FontWeight="SemiBold" />
            <TextBox Text="{Binding CampusId, Mode=TwoWay}" PlaceholderText="例如：一号校区" />
            <TextBlock Text="电脑编号前缀" FontWeight="SemiBold" />
            <TextBox Text="{Binding RoomPrefix, Mode=TwoWay}" PlaceholderText="例如：PC-" />
          </StackPanel>
          <TextBlock Text="输出文件夹（须为空）" FontWeight="SemiBold" />
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <TextBox Text="{Binding RoomOutputDir, Mode=TwoWay}" PlaceholderText="默认保存到桌面" HorizontalAlignment="Stretch" />
            <Button Grid.Column="1" Content="选择输出位置" Click="RequestChooseStudentPackageOutputDirectory" />
          </Grid>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Classes="primary" Content="生成学生配置包" Click="RequestGenerateStudentPackage"
                    IsEnabled="{Binding CanGenerateStudentPackage}" />
            <Button Content="取消生成" Click="RequestCancelStudentPackageGeneration"
                    IsVisible="{Binding CanCancelStudentPackageGeneration}" />
            <Button Content="确认替换不可用的 Windows 签名密钥并重新生成"
                    Click="RequestReplaceWebsiteSigningKey" IsVisible="{Binding CanReplaceWebsiteSigningKey}" />
          </StackPanel>
          <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsGeneratingStudentPackage}" Height="6" />
          <TextBlock Text="{Binding PackageGenerationStatus}" Classes="muted" TextWrapping="Wrap"
                     IsVisible="{Binding IsGeneratingStudentPackage}" />
          <Border Classes="status-panel success" Padding="12" IsVisible="{Binding HasPackageOutput}">
            <TextBlock Text="{Binding PackageOutput}" TextWrapping="Wrap" />
          </Border>
          <Border Classes="status-panel danger" Padding="12" IsVisible="{Binding HasPackageOutputError}">
            <TextBlock Text="{Binding PackageOutputError}" TextWrapping="Wrap" />
          </Border>
        </StackPanel>
      </Border>
    </StackPanel>
  </StackPanel>
</UserControl>
