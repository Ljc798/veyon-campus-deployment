<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VeyonCampus.App"
             x:Class="VeyonCampus.App.Presentation.Views.TeacherSetupView"
             x:DataType="vm:TeacherViewModel">
  <StackPanel Margin="24,24,24,28" Spacing="20">
    <StackPanel IsVisible="{Binding IsSetupPage}" Spacing="20">
      <Border Classes="card">
        <StackPanel Spacing="12">
          <TextBlock Text="教师端首次设置" FontSize="20" FontWeight="SemiBold" />
          <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
            <Button Classes="setup-step" Classes.current="{Binding IsTeacherSetupStep1}"
                    Content="{Binding TeacherSetupStep1Label}" Click="RequestTeacherSetupStep1" />
            <Button Grid.Column="1" Classes="setup-step" Classes.current="{Binding IsTeacherSetupStep2}"
                    Content="{Binding TeacherSetupStep2Label}" IsEnabled="{Binding CanOpenTeacherSetupStep2}"
                    Click="RequestTeacherSetupStep2" />
            <Button Grid.Column="2" Classes="setup-step" Classes.current="{Binding IsTeacherSetupStep3}"
                    Content="{Binding TeacherSetupStep3Label}" IsEnabled="{Binding CanOpenTeacherSetupStep3}"
                    Click="RequestTeacherSetupStep3" />
          </Grid>
          <ProgressBar Minimum="1" Maximum="3" Value="{Binding TeacherSetupWizardStep}" Height="5" />
          <TextBlock Text="依次确认教师端环境、填写机房桌位与学生姓名，再生成学生配置包。空姓名桌位只作物理桌位，不会生成学生电脑。"
                     Classes="muted" TextWrapping="Wrap" />
        </StackPanel>
      </Border>
      <Border Classes="card" IsVisible="{Binding IsTeacherSetupStep1}">
        <StackPanel Spacing="12">
          <TextBlock Text="教师端一键安装 Veyon" FontSize="20" FontWeight="SemiBold" />
          <TextBlock Text="{Binding TeacherInstallPlanText}" TextWrapping="Wrap" />
          <TextBlock Text="{Binding TeacherInstallSafetyText}" Foreground="{DynamicResource Teacher.Color.Danger}" TextWrapping="Wrap" />
          <Button Classes="primary" Content="安装/修复教师端 Veyon" Click="RequestInstallTeacherVeyon" IsEnabled="{Binding CanInstallTeacherVeyon}" HorizontalAlignment="Left" />
          <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsInstallingTeacherVeyon}" Height="6" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="重新检查 Veyon 状态" Click="RequestRefreshTeacherSetupVeyon"
                    IsEnabled="{Binding CanRefreshTeacherSetupVeyon}" />
            <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsCheckingTeacherSetupVeyon}"
                         Width="120" Height="6" VerticalAlignment="Center" />
          </StackPanel>
          <TextBlock Text="{Binding TeacherSetupVeyonStatus}" Classes="muted" TextWrapping="Wrap"
                     IsVisible="{Binding HasTeacherSetupVeyonStatus}" />
          <TextBlock Text="{Binding InstallerStatus}" Classes="muted" TextWrapping="Wrap"
                     IsVisible="{Binding HasInstallerStatus}" />
          <TextBlock Text="{Binding TeacherInstallResult}" Foreground="{DynamicResource Teacher.Color.Success}" IsVisible="{Binding HasTeacherInstallResult}" TextWrapping="Wrap" />
          <TextBlock Text="{Binding TeacherInstallIssue}" Foreground="{DynamicResource Teacher.Color.Danger}" IsVisible="{Binding HasTeacherInstallIssue}" TextWrapping="Wrap" />
          <Button Classes="primary" Content="下一步：配置机房与座位" Click="RequestTeacherSetupNext"
                  IsEnabled="{Binding CanProceedTeacherSetupToRooms}" HorizontalAlignment="Left" />
        </StackPanel>
      </Border>
      <Border Classes="card" IsVisible="{Binding IsTeacherSetupStep2}">
        <StackPanel Spacing="12">
          <TextBlock Text="机房地点与学生座位" FontSize="20" FontWeight="SemiBold" />
          <TextBlock Text="{Binding TeacherSetupRoomSummary}" Classes="muted" TextWrapping="Wrap" />
          <Border Classes="status-panel info" Padding="12">
            <TextBlock Text="座位图只记录桌位和学生姓名。填写姓名的桌位会生成学生电脑；未填写姓名的桌位只是空桌子，不会生成电脑。"
                       TextWrapping="Wrap" />
          </Border>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Classes="primary" Content="配置机房座位图" Click="RequestOpenRoomSetupFromTeacherWizard" />
            <Button Classes="primary" Content="下一步：生成学生配置包" Click="RequestTeacherSetupNext"
                    IsEnabled="{Binding IsTeacherSetupRoomComplete}" />
            <Button Content="暂时跳过机房设置" Click="RequestSkipTeacherSetupRoom"
                    IsEnabled="{Binding CanSkipTeacherSetupRoom}" />
          </StackPanel>
        </StackPanel>
      </Border>
    </StackPanel>
  </StackPanel>
</UserControl>
