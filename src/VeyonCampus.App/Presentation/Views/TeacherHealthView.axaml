<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VeyonCampus.App"
             xmlns:core="using:VeyonCampus.Core"
             xmlns:suki="clr-namespace:SukiUI.Controls;assembly=SukiUI"
             xmlns:flowery="clr-namespace:Flowery.Controls;assembly=Flowery.NET"
             xmlns:floweryTheme="clr-namespace:Flowery;assembly=Flowery.NET"
             x:Class="VeyonCampus.App.Presentation.Views.TeacherHealthView"
             x:DataType="vm:TeacherViewModel">
  <StackPanel Spacing="16" IsVisible="{Binding IsHealthCenterPage}">
    <Border Classes="section-card" IsVisible="{Binding IsMacTeacherHost}">
      <Border.Styles>
        <floweryTheme:DaisyUITheme />
      </Border.Styles>
      <StackPanel Spacing="12">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
          <TextBlock Text="Mac 屏幕巡视辅助环境" Classes="section-title" VerticalAlignment="Center" />
          <Button Grid.Column="1" Classes="primary" Content="准备 Veyon helper"
                  Click="RequestPrepareMacVeyonHelper" IsEnabled="{Binding CanPrepareMacVeyonHelper}" />
        </Grid>
        <suki:InfoBar Message="{Binding MacVeyonHelperStatus}" Severity="Success"
                      IsOpen="{Binding IsMacVeyonHelperReady}" IsClosable="False" IsOpaque="False" />
        <suki:InfoBar Message="{Binding MacVeyonHelperStatus}" Severity="Warning"
                      IsOpen="{Binding !IsMacVeyonHelperReady}" IsClosable="False" IsOpaque="False" />
        <flowery:DaisyProgress IsIndeterminate="True" Variant="Info" Size="ExtraSmall"
                               AccessibleText="正在准备 Mac Veyon helper"
                               IsVisible="{Binding IsPreparingMacVeyonHelper}" />
        <TextBlock Text="首次准备会从官方 Ubuntu 软件源和 Veyon 4.11.4 源码构建本机 ARM64 辅助环境。画面采集还需要与学生配置包匹配的 Veyon 私钥；helper 就绪不代表校园网或真实学生屏幕已验证。"
                   Classes="supporting-copy" TextWrapping="Wrap" />
      </StackPanel>
    </Border>

    <Border x:Name="DeviceStatusSection" Classes="section-card">
      <StackPanel Spacing="16">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
          <TextBlock Text="设备状态" Classes="section-title" VerticalAlignment="Center" />
          <Button Grid.Column="1" Classes="primary" Content="刷新设备状态"
                  Click="RequestReadStudentDeviceHealth" IsEnabled="{Binding CanReadDeviceHealth}"
                  ToolTip.Tip="刷新学生电脑状态；需要处理的问题会显示在下方。" />
        </Grid>
        <TextBlock Text="{Binding ClassroomRoomContextSummary}" Classes="supporting-copy" TextWrapping="Wrap" />
        <ComboBox ItemsSource="{Binding RoomProfiles}" SelectedItem="{Binding SelectedRoomProfile, Mode=TwoWay}"
                  IsVisible="{Binding HasMultipleRoomProfiles}" IsEnabled="{Binding !IsExecuting}"
                  PlaceholderText="选择学生所在教室" MinWidth="180">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="core:TeacherRoomProfile"><TextBlock Text="{Binding DisplayName}" /></DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <TextBlock Text="{Binding ClassroomDirectoryError}" Classes="supporting-copy" TextWrapping="Wrap"
                   IsVisible="{Binding HasClassroomDirectoryError}" />
        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
          <Border Background="{DynamicResource Teacher.Color.SuccessSubtle}" CornerRadius="10" Padding="12">
            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="4">
              <TextBlock Text="正常" Classes="muted" FontSize="12" />
              <TextBlock Grid.Row="1" Text="{Binding DeviceHealthHealthyCount}"
                         Foreground="{DynamicResource Teacher.Color.Success}" FontSize="23" FontWeight="Bold" />
              <Ellipse Grid.Row="1" Grid.Column="1" Width="8" Height="8"
                       Fill="{DynamicResource Teacher.Color.Success}" VerticalAlignment="Center" />
              <TextBlock Grid.Row="2" Text="最近状态已确认" Classes="muted" FontSize="12" TextWrapping="Wrap" />
            </Grid>
          </Border>
          <Border Grid.Column="1" Background="{DynamicResource Teacher.Color.WarningSubtle}" CornerRadius="10" Padding="12">
            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="4">
              <TextBlock Text="需处理" Classes="muted" FontSize="12" />
              <TextBlock Grid.Row="1" Text="{Binding DeviceHealthNeedsActionCount}"
                         Foreground="{DynamicResource Teacher.Color.Warning}" FontSize="23" FontWeight="Bold" />
              <Ellipse Grid.Row="1" Grid.Column="1" Width="8" Height="8"
                       Fill="{DynamicResource Teacher.Color.Warning}" VerticalAlignment="Center" />
              <TextBlock Grid.Row="2" Text="包含需人工核对的设备" Classes="muted" FontSize="12" TextWrapping="Wrap" />
            </Grid>
          </Border>
          <Border Grid.Column="2" Background="{DynamicResource Teacher.Color.InfoSubtle}" CornerRadius="10" Padding="12">
            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="4">
              <TextBlock Text="待确认" Classes="muted" FontSize="12" />
              <TextBlock Grid.Row="1" Text="{Binding DeviceHealthUnconfirmedCount}"
                         Foreground="{DynamicResource Teacher.Color.Info}" FontSize="23" FontWeight="Bold" />
              <Ellipse Grid.Row="1" Grid.Column="1" Width="8" Height="8"
                       Fill="{DynamicResource Teacher.Color.Info}" VerticalAlignment="Center" />
              <TextBlock Grid.Row="2" Text="无回执不等于离线" Classes="muted" FontSize="12" TextWrapping="Wrap" />
            </Grid>
          </Border>
        </Grid>
        <suki:InfoBar Message="{Binding DeviceRuntimeSummaryStatus}" Severity="Information"
                      IsOpen="{Binding HasDeviceHealthTargets}" IsClosable="False" IsOpaque="False" />
        <flowery:DaisyProgress IsIndeterminate="True" Variant="Info" Size="ExtraSmall"
                               AccessibleText="正在轮询学生电脑状态"
                               IsVisible="{Binding IsPollingDeviceRuntimeSummary}" />
        <StackPanel Spacing="6" IsVisible="{Binding IsReadingDeviceHealth}">
          <TextBlock Text="正在刷新设备状态…" Classes="supporting-copy" />
          <flowery:DaisyProgress IsIndeterminate="True" Variant="Info" Size="ExtraSmall"
                                 AccessibleText="正在刷新设备状态" />
        </StackPanel>
      </StackPanel>
    </Border>

    <Border x:Name="DeviceAlertsSection" Classes="section-card" IsVisible="{Binding HasDeviceHealthAlerts}">
      <Border.Styles>
        <floweryTheme:DaisyUITheme />
      </Border.Styles>
      <StackPanel Spacing="12">
        <flowery:DaisyAlert Variant="Warning">
          <StackPanel Spacing="4">
            <TextBlock Text="{Binding DeviceHealthAlertsHeader}" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock Text="{Binding DeviceHealthAlertsDescription}" TextWrapping="Wrap" />
          </StackPanel>
        </flowery:DaisyAlert>
        <ItemsControl ItemsSource="{Binding DeviceHealthAlerts}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:TeacherDeviceHealthAlert">
              <Border BorderBrush="{DynamicResource Teacher.Color.Border}" BorderThickness="0,1,0,0" Padding="0,4">
                <Expander Theme="{StaticResource App.DetailExpander}"
                          IsExpanded="{Binding IsDiagnosticsExpanded, Mode=TwoWay}">
                  <Expander.Header>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                      <StackPanel Spacing="5">
                        <TextBlock Text="{Binding DisplayTitle}" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding AffectedTargets}" Classes="supporting-copy" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                      </StackPanel>
                      <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <Border Background="{Binding SeverityBackground}" CornerRadius="12" Padding="9,3" HorizontalAlignment="Right">
                          <TextBlock Text="{Binding SeverityLabel}" Foreground="{Binding SeverityForeground}" FontSize="12" />
                        </Border>
                        <TextBlock Text="{Binding AffectedCountSummary}" Classes="supporting-copy" />
                      </StackPanel>
                    </Grid>
                  </Expander.Header>
                  <Border Background="{DynamicResource Teacher.Color.SurfaceSubtle}" CornerRadius="8" Padding="12" Margin="0,0,0,8"
                          HorizontalAlignment="Stretch">
                    <StackPanel Spacing="10">
                      <WrapPanel>
                        <Button Classes="secondary" Content="重新检测" Click="RequestRecheckDeviceHealthAlert"
                                IsEnabled="{Binding CanRecheck}" Margin="0,0,8,4" />
                        <Button Classes="tertiary" Content="查看设备" Click="RequestFocusDeviceHealthAlert" Margin="0,0,8,4" />
                        <Button Classes="tertiary" Content="{Binding AcknowledgementLabel}" Click="RequestAcknowledgeDeviceHealthAlert"
                                IsVisible="{Binding !IsCached}" IsEnabled="{Binding CanAcknowledge}" Margin="0,0,8,4" />
                        <Button Classes="secondary" Content="尝试可用修复" Click="RequestRepairDeviceHealthAlert"
                                IsVisible="{Binding CanAttemptRepair}" IsEnabled="{Binding CanAttemptRepair}" Margin="0,0,8,4" />
                      </WrapPanel>
                      <TextBlock Text="{Binding SeenSummary}" Classes="supporting-copy" />
                      <TextBlock Text="{Binding Diagnostics}" Classes="supporting-copy" />
                    </StackPanel>
                  </Border>
                </Expander>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>

    <Border x:Name="StudentRosterSection" Classes="section-card">
      <StackPanel Spacing="12">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
          <TextBlock Text="学生电脑" Classes="section-title" VerticalAlignment="Center" />
          <TextBlock Grid.Column="1" Text="{Binding DeviceHealthListSummary}" Classes="supporting-copy" VerticalAlignment="Center" />
        </Grid>
        <Border Classes="subtle-panel" Padding="12" IsVisible="{Binding HasDeviceHealthTargets}">
          <StackPanel Spacing="8">
            <TextBlock Text="本页统一设备选择" Classes="component-title" />
            <TextBlock Text="{Binding WebsitePolicyTargetSelectionSummary}" Classes="supporting-copy" />
            <WrapPanel Orientation="Horizontal">
              <Button Classes="secondary" Content="全选设备" Click="RequestSelectAllDeviceTargets"
                      IsEnabled="{Binding !IsExecuting}" Margin="0,0,8,4" />
              <Button Classes="secondary" Content="清空选择" Click="RequestClearDeviceTargets"
                      IsEnabled="{Binding !IsExecuting}" Margin="0,0,8,4" />
            </WrapPanel>
            <ScrollViewer MaxHeight="150" VerticalScrollBarVisibility="Auto" IsEnabled="{Binding !IsExecuting}">
              <ItemsControl ItemsSource="{Binding WebsitePolicyTargetChoices}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><UniformGrid Columns="3" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:TeacherPolicyTargetChoice">
                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" Margin="0,2">
                      <StackPanel Spacing="1">
                        <TextBlock Text="{Binding StudentName}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Target}" Classes="muted" TextWrapping="Wrap" />
                      </StackPanel>
                    </CheckBox>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </StackPanel>
        </Border>
        <Grid ColumnDefinitions="*,190" ColumnSpacing="10" IsVisible="{Binding HasDeviceHealthRows}">
          <TextBox Text="{Binding DeviceHealthSearchText, Mode=TwoWay}" PlaceholderText="搜索学生姓名或状态" />
          <ComboBox Grid.Column="1" ItemsSource="{Binding DeviceHealthCategoryFilters}"
                    SelectedIndex="{Binding DeviceHealthCategoryFilterIndex, Mode=TwoWay}" />
        </Grid>
        <Border Classes="subtle-panel" Padding="24" IsVisible="{Binding !HasDeviceHealthTargets}">
          <StackPanel Spacing="10" HorizontalAlignment="Center">
            <TextBlock Text="还没有学生电脑" Classes="component-title" HorizontalAlignment="Center" />
            <TextBlock Text="配置地点与学生名单后，这里会自动显示设备状态。" Classes="supporting-copy" />
            <Button Classes="secondary" Content="配置学生名单" Click="RequestOpenStudentRoster" HorizontalAlignment="Center" />
          </StackPanel>
        </Border>
        <TextBlock Text="没有符合条件的电脑，请调整搜索内容或状态筛选。" Classes="supporting-copy"
                   IsVisible="{Binding HasDeviceHealthFilterEmpty}" Margin="12,16" />
        <ItemsControl x:Name="DeviceHealthRowsList" ItemsSource="{Binding DeviceHealthPageRows}"
                      IsVisible="{Binding HasDeviceHealthFilteredRows}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:TeacherDeviceHealthRow">
              <Border Classes="device-health-row" BorderBrush="{DynamicResource Teacher.Color.Border}"
                      BorderThickness="1" CornerRadius="10" Background="{DynamicResource Teacher.Color.Surface}"
                      Margin="0,3">
                <Expander Theme="{StaticResource App.DetailExpander}" IsExpanded="{Binding IsDetailsExpanded, Mode=TwoWay}">
                  <Expander.Header>
                    <Grid ColumnDefinitions="32,*,Auto" ColumnSpacing="12">
                      <Border Background="{DynamicResource Teacher.Color.InfoSubtle}" CornerRadius="9" Width="32" Height="32" VerticalAlignment="Center">
                        <Path Data="M2,3 L18,3 L18,14 L2,14 Z M10,14 L10,18 M6,18 L14,18" Width="18" Height="18" Stretch="Uniform"
                              Stroke="{DynamicResource Teacher.Color.Primary}" StrokeThickness="1.5" />
                      </Border>
                      <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                        <TextBlock Text="{Binding StudentName}" FontWeight="SemiBold" FontSize="15" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding DeviceListIdentifier}" Classes="supporting-copy" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding CompactSummary}" Classes="supporting-copy" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                      </StackPanel>
                      <Border Grid.Column="2" Background="{Binding CategoryBackground}" CornerRadius="12" Padding="9,4" VerticalAlignment="Center">
                        <TextBlock Text="{Binding CategoryLabel}" Foreground="{Binding CategoryForeground}" FontSize="12" FontWeight="SemiBold" />
                      </Border>
                    </Grid>
                  </Expander.Header>
                  <Border Background="{DynamicResource Teacher.Color.SurfaceSubtle}" Padding="14">
                    <StackPanel Spacing="10">
                      <StackPanel Spacing="5">
                        <TextBlock Text="设备信息" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding DeviceIdentifierSummary}" Classes="supporting-copy" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding LastSeenSummary}" Classes="supporting-copy" />
                        <WrapPanel>
                          <TextBlock Text="{Binding AgentVersionSummary}" Classes="supporting-copy" Margin="0,0,12,0" />
                          <TextBlock Text="{Binding StudentSetupVersionSummary}" Classes="supporting-copy" Margin="0,0,12,0" />
                          <TextBlock Text="{Binding ServiceSummary}" Classes="supporting-copy" TextWrapping="Wrap" />
                        </WrapPanel>
                      </StackPanel>
                      <StackPanel Spacing="5">
                        <TextBlock Text="策略状态" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding WebsitePolicyDetailSummary}" Classes="supporting-copy" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding ApplicationPolicyDetailSummary}" Classes="supporting-copy" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding InputGuardSummary}" Classes="supporting-copy" Foreground="{Binding InputGuardForeground}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding LastAcknowledgementSummary}" Classes="supporting-copy" />
                      </StackPanel>
                      <StackPanel Spacing="5">
                        <TextBlock Text="安全与身份" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding IdentityVerificationSummary}" Classes="supporting-copy" TextWrapping="Wrap" />
                        <TextBox Text="{Binding FullIdentityFingerprints}" IsReadOnly="True" AcceptsReturn="True"
                                 TextWrapping="Wrap" Height="72" IsVisible="{Binding ShowFullIdentityFingerprints}" />
                        <WrapPanel>
                          <Button Classes="secondary" Content="{Binding IdentityFingerprintToggleText}"
                                  Click="RequestToggleDeviceHealthFingerprints"
                                  IsVisible="{Binding HasIdentityCandidate}" Margin="0,0,8,4" />
                          <Button Classes="tertiary" Content="复制完整指纹"
                                  Click="RequestCopyDeviceHealthFingerprint"
                                  IsVisible="{Binding HasIdentityCandidate}" Margin="0,0,8,4" />
                          <Button Classes="primary" Content="核对并固定身份"
                                  Click="RequestReviewDeviceHealthIdentity"
                                  IsVisible="{Binding CanReviewIdentity}" Margin="0,0,8,4" />
                        </WrapPanel>
                        <TextBlock Text="{Binding IdentityReviewStatus}" Classes="supporting-copy" TextWrapping="Wrap"
                                   IsVisible="{Binding HasIdentityReviewStatus}" />
                        <TextBlock Text="{Binding CopyStatus}" Classes="supporting-copy" IsVisible="{Binding HasCopyStatus}" />
                      </StackPanel>
                      <Expander Header="诊断信息" IsExpanded="False" IsVisible="{Binding HasDiagnosticsSummary}">
                        <StackPanel Spacing="8">
                          <TextBlock Text="{Binding UpdateSummary}" Classes="supporting-copy" TextWrapping="Wrap" />
                          <TextBox Text="{Binding DiagnosticsSummary}" IsReadOnly="True" AcceptsReturn="True"
                                   TextWrapping="Wrap" Height="128" />
                          <Button Classes="tertiary" Content="复制诊断信息"
                                  Click="RequestCopyDeviceHealthDiagnostic" HorizontalAlignment="Left" />
                        </StackPanel>
                      </Expander>
                      <WrapPanel>
                        <Button Classes="secondary" Content="启动 Veyon 服务" Click="RequestEnsureVeyonServiceRunning"
                                IsVisible="{Binding CanEnsureVeyonServiceRunning}" IsEnabled="{Binding CanEnsureVeyonServiceRunning}" Margin="0,0,8,4" />
                        <Button Classes="secondary" Content="同步网站策略" Click="RequestRefreshLegacyEdgePolicy"
                                IsVisible="{Binding CanRefreshLegacyEdgePolicy}" IsEnabled="{Binding CanRefreshLegacyEdgePolicy}" Margin="0,0,8,4" />
                      </WrapPanel>
                      <TextBlock Text="{Binding BatchOperationStatus}" Classes="supporting-copy" IsVisible="{Binding HasBatchOperationStatus}" />
                      <TextBlock Text="{Binding RepairStatus}" Classes="supporting-copy" IsVisible="{Binding HasRepairStatus}" />
                      <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsRepairing}" Height="3" />
                    </StackPanel>
                  </Border>
                </Expander>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" IsVisible="{Binding HasMultipleDeviceHealthPages}">
          <Button Classes="secondary" Content="上一页" Click="RequestPreviousDeviceHealthPage" IsEnabled="{Binding CanPreviousDeviceHealthPage}" />
          <TextBlock Text="{Binding DeviceHealthPageLabel}" Classes="supporting-copy" VerticalAlignment="Center" />
          <Button Classes="secondary" Content="下一页" Click="RequestNextDeviceHealthPage" IsEnabled="{Binding CanNextDeviceHealthPage}" />
        </StackPanel>
      </StackPanel>
    </Border>

    <Border x:Name="DeviceMaintenanceSection" Classes="section-card" Padding="8">
      <Expander Header="维护工具与诊断记录" Theme="{StaticResource App.DetailExpander}">
        <StackPanel Spacing="12" Margin="12,4,12,12">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <TextBlock Text="本机 Maintenance 运维概览" Classes="component-title"
                       VerticalAlignment="Center" />
            <Button Grid.Column="1" Classes="tertiary" Content="刷新本机记录"
                    Click="RequestRefreshMaintenanceOverview" IsEnabled="{Binding !IsExecuting}" />
          </Grid>
          <TextBlock Text="{Binding MaintenanceOverviewSummary}" Classes="supporting-copy" TextWrapping="Wrap" />
          <TextBlock Text="{Binding MaintenanceConfigurationOverviewSummary}" Classes="supporting-copy"
                     TextWrapping="Wrap" />
          <StackPanel Spacing="8" IsVisible="{Binding HasMaintenanceConfigurationItems}">
            <TextBlock Text="设备配置 Desired / Reported 对账明细" Classes="component-title" />
            <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto">
              <ItemsControl ItemsSource="{Binding MaintenanceConfigurationItems}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:TeacherMaintenanceConfigurationItem">
                    <Border Classes="device-row" Margin="0,0,0,7">
                      <StackPanel Spacing="4">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                          <StackPanel Spacing="2">
                            <TextBlock Text="{Binding DisplayName}" Classes="device-row-name"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Target}" Classes="muted"
                                       TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                          <Border Grid.Column="1" Background="{DynamicResource Teacher.Color.InfoSubtle}"
                                  CornerRadius="999" Padding="8,3" VerticalAlignment="Center">
                            <TextBlock Text="{Binding StateText}" Foreground="{DynamicResource Teacher.Color.Info}"
                                       FontWeight="SemiBold" />
                          </Border>
                        </Grid>
                        <TextBlock Text="{Binding ModuleText}" Classes="supporting-copy" />
                        <TextBlock Text="{Binding RevisionText}" Classes="device-row-detail" />
                        <TextBlock Text="{Binding LastReportedText}" Classes="muted" />
                        <TextBlock Text="{Binding AdviceText}" Classes="supporting-copy" TextWrapping="Wrap" />
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </StackPanel>
          <TextBlock Text="{Binding MaintenanceIdentityRotationStatus}" Classes="supporting-copy"
                     TextWrapping="Wrap" IsVisible="{Binding HasMaintenanceIdentityRotationStatus}" />
          <TextBlock Text="本机记录中没有待恢复、失败或待核对的维护事务。"
                     Classes="supporting-copy" IsVisible="{Binding !HasMaintenanceIssueItems}" />
          <StackPanel Spacing="8" IsVisible="{Binding HasPendingMaintenanceIdentityRotations}">
            <TextBlock Text="待审批的 Maintenance 服务密钥轮换" Classes="component-title" />
            <TextBlock Text="新密钥由已固定的 Agent 身份签名授权，但不会自动替换旧密钥。请核对现场变更后再批准；未批准前维护服务通道保持拒绝。"
                       Classes="supporting-copy" TextWrapping="Wrap" />
            <ItemsControl ItemsSource="{Binding PendingMaintenanceIdentityRotations}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:PendingMaintenanceIdentityRotationItem">
                  <Border Classes="device-row" Margin="0,0,0,7">
                    <StackPanel Spacing="6">
                      <TextBlock Text="{Binding DisplayName}" Classes="device-row-name" TextWrapping="Wrap" />
                      <TextBlock Text="{Binding Target}" Classes="muted" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding RequestedText}" Classes="muted" />
                      <TextBlock Text="{Binding AuthorizationText}" Classes="supporting-copy" TextWrapping="Wrap" />
                      <TextBlock Text="{Binding PreviousFingerprintText}"
                                 Classes="device-row-detail" FontFamily="Consolas" TextWrapping="Wrap" />
                      <TextBlock Text="{Binding CandidateFingerprintText}"
                                 Classes="device-row-detail" FontFamily="Consolas" TextWrapping="Wrap" />
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Classes="primary" Content="核对并批准轮换"
                                Click="RequestApproveMaintenanceIdentityRotation" IsEnabled="{Binding CanAct}" />
                        <Button Classes="tertiary" Content="拒绝请求"
                                Click="RequestRejectMaintenanceIdentityRotation" IsEnabled="{Binding CanAct}" />
                      </StackPanel>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
          <StackPanel Spacing="8" IsVisible="{Binding HasMaintenanceIssueItems}">
            <TextBlock Text="最近仍需处理的设备" Classes="component-title" />
            <ScrollViewer MaxHeight="360" VerticalScrollBarVisibility="Auto">
              <ItemsControl ItemsSource="{Binding MaintenanceIssueItems}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:TeacherMaintenanceIssueItem">
                    <Border Classes="device-row" Margin="0,0,0,7">
                      <StackPanel Spacing="5">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                          <StackPanel Spacing="3">
                            <TextBlock Text="{Binding DisplayName}" Classes="device-row-name"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Target}" Classes="muted" TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                          <Border Grid.Column="1" Background="{DynamicResource Teacher.Color.WarningSubtle}"
                                  CornerRadius="999" Padding="8,3" VerticalAlignment="Center">
                            <TextBlock Text="{Binding StateText}" Foreground="{DynamicResource Teacher.Color.Warning}"
                                       FontWeight="SemiBold" />
                          </Border>
                        </Grid>
                        <TextBlock Text="{Binding UpdatedText}" Classes="muted" />
                        <TextBlock Text="{Binding VersionsText}" Classes="muted" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Detail}" Classes="device-row-detail" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding RecoveryAdviceText}" Classes="supporting-copy" TextWrapping="Wrap" />
                        <TextBlock Text="设备不在当前名单中；刷新名单后才能对其操作。"
                                   Classes="muted" IsVisible="{Binding IsTargetUnavailable}" />
                        <Button Classes="tertiary" Content="{Binding ActionText}"
                                Click="RequestRetryMaintenanceIssue" IsEnabled="{Binding CanAct}"
                                HorizontalAlignment="Left" />
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </StackPanel>
          <TextBlock Text="{Binding DeviceHealthStatus}" Classes="supporting-copy" />
          <TextBlock Text="{Binding DeviceHealthCacheStatus}" Classes="supporting-copy" />
          <TextBlock Text="{Binding DeviceHealthBatchPreview}" Classes="supporting-copy" />
          <WrapPanel>
            <Button Classes="secondary" Content="批量启动 Veyon 服务" Click="RequestEnsureSelectedVeyonServicesRunning"
                    IsEnabled="{Binding CanBatchEnsureVeyonServiceRunning}" Margin="0,0,8,4" />
            <Button Classes="secondary" Content="批量同步网站策略" Click="RequestRefreshSelectedLegacyEdgePolicies"
                    IsEnabled="{Binding CanBatchRefreshLegacyEdgePolicy}" Margin="0,0,8,4" />
          </WrapPanel>
          <TextBlock Text="仅处理当前名单中有新鲜回执且符合修复条件的设备；其余设备会跳过。" Classes="supporting-copy" />
          <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsRunningDeviceHealthBatch}" Height="3" />
          <TextBlock Text="{Binding DeviceHealthBatchStatus}" Classes="supporting-copy" />
          <TextBlock Text="{Binding DeviceRuntimeSummaryDiagnostics}" Classes="supporting-copy" IsVisible="{Binding HasDeviceRuntimeSummaryDiagnostics}" />
          <TextBlock Text="未收到回执不代表电脑已关机；本机缓存不能证明当前在线或授权修复。" Classes="supporting-copy" />
        </StackPanel>
      </Expander>
    </Border>
  </StackPanel>
</UserControl>
