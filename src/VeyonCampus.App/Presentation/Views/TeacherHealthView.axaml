<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VeyonCampus.App"
             x:Class="VeyonCampus.App.Presentation.Views.TeacherHealthView"
             x:DataType="vm:TeacherViewModel">
  <StackPanel Margin="24,24,24,28" Spacing="20">
    <StackPanel IsVisible="{Binding IsHealthCenterPage}" Spacing="16">
      <Border Classes="card">
        <StackPanel Spacing="12">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
            <StackPanel Spacing="4">
              <TextBlock Text="设备状态概览" Classes="section-title" />
            </StackPanel>
            <Button Grid.Column="1" Classes="primary" Content="读取完整诊断"
                    ToolTip.Tip="手动读取详细 v4 健康快照；轻量设备状态会在此页自动更新。"
                    Click="RequestReadStudentDeviceHealth" IsEnabled="{Binding CanReadDeviceHealth}"
                    VerticalAlignment="Center" />
          </Grid>
          <UniformGrid Columns="5">
            <Border Classes="stat-card success" Margin="0,0,8,0">
              <Grid ColumnDefinitions="30,*" ColumnSpacing="8" VerticalAlignment="Center">
                <Border Classes="stat-icon success">
                  <Path Classes="stat-icon-shape" Data="M4,10 L8,14 L16,5" />
                </Border>
                <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                  <TextBlock Classes="stat-value" Text="{Binding DeviceHealthHealthyCount}" />
                  <TextBlock Classes="stat-label" Text="正常" />
                </StackPanel>
              </Grid>
            </Border>
            <Border Classes="stat-card warning" Margin="0,0,8,0">
              <Grid ColumnDefinitions="30,*" ColumnSpacing="8" VerticalAlignment="Center">
                <Border Classes="stat-icon warning">
                  <Path Classes="stat-icon-shape" Data="M10,3 L18,17 L2,17 Z M10,7 L10,11 M10,14 L10,14.5" />
                </Border>
                <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                  <TextBlock Classes="stat-value" Text="{Binding DeviceHealthAttentionCount}" />
                  <TextBlock Classes="stat-label" Text="需关注" />
                </StackPanel>
              </Grid>
            </Border>
            <Border Classes="stat-card danger" Margin="0,0,8,0">
              <Grid ColumnDefinitions="30,*" ColumnSpacing="8" VerticalAlignment="Center">
                <Border Classes="stat-icon danger">
                  <Path Classes="stat-icon-shape" Data="M4,4 L16,16 M16,4 L4,16" />
                </Border>
                <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                  <TextBlock Classes="stat-value" Text="{Binding DeviceHealthManualReviewCount}" />
                  <TextBlock Classes="stat-label" Text="需人工处理" />
                </StackPanel>
              </Grid>
            </Border>
            <Border Classes="stat-card unknown">
              <Grid ColumnDefinitions="30,*" ColumnSpacing="8" VerticalAlignment="Center">
                <Border Classes="stat-icon unknown">
                  <Path Classes="stat-icon-shape" Data="M10,4 L10,10 M10,14 L10,14.5" />
                </Border>
                <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                  <TextBlock Classes="stat-value" Text="{Binding DeviceHealthNoResponseCount}" />
                  <TextBlock Classes="stat-label" Text="未收到回执" />
                </StackPanel>
              </Grid>
            </Border>
            <Border Classes="stat-card unknown" Margin="8,0,0,0">
              <Grid ColumnDefinitions="30,*" ColumnSpacing="8" VerticalAlignment="Center">
                <Border Classes="stat-icon unknown">
                  <Path Classes="stat-icon-shape" Data="M5,3 L15,3 L15,6 L10,10 L15,14 L15,17 L5,17 L5,14 L10,10 L5,6 Z" />
                </Border>
                <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                  <TextBlock Classes="stat-value" Text="{Binding DeviceHealthPendingCount}" />
                  <TextBlock Classes="stat-label" Text="等待读取" />
                </StackPanel>
              </Grid>
            </Border>
          </UniformGrid>
          <Border Classes="loading-state" Padding="10">
            <StackPanel Spacing="6">
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                <TextBlock Text="实时状态" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding DeviceRuntimeSummaryStatus}" Classes="muted"
                           TextWrapping="Wrap" VerticalAlignment="Center" />
              </Grid>
              <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsPollingDeviceRuntimeSummary}"
                           Height="4" />
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                <TextBlock Text="完整诊断" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding DeviceHealthStatus}" Classes="muted"
                           TextWrapping="Wrap" VerticalAlignment="Center" />
              </Grid>
              <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsReadingDeviceHealth}" Height="4" />
            </StackPanel>
          </Border>
          <TextBlock Text="{Binding DeviceHealthCacheStatus}" Classes="muted" TextWrapping="Wrap" />
          <Expander Header="采集说明与诊断详情" IsExpanded="False">
            <StackPanel Spacing="6" Margin="0,6,0,0">
              <TextBlock Text="{Binding DeviceRuntimeSummaryDiagnostics}" Classes="muted"
                         TextWrapping="Wrap" IsVisible="{Binding HasDeviceRuntimeSummaryDiagnostics}" />
              <TextBlock Text="{Binding DeviceHealthBatchPreview}" Classes="muted" TextWrapping="Wrap" />
              <TextBlock Text="“未收到回执”表示连接或身份尚未确认，不代表电脑已关机。"
                         Classes="muted" FontSize="12" TextWrapping="Wrap" />
              <TextBlock Text="学生姓名以本软件名单为准；Veyon 电脑名用于定位和匹配。"
                         Classes="muted" FontSize="12" TextWrapping="Wrap" />
            </StackPanel>
          </Expander>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="批量确保 Veyon 服务运行" Click="RequestEnsureSelectedVeyonServicesRunning"
                    IsEnabled="{Binding CanBatchEnsureVeyonServiceRunning}" />
            <Button Content="批量排入 Edge 策略刷新" Click="RequestRefreshSelectedLegacyEdgePolicies"
                    IsEnabled="{Binding CanBatchRefreshLegacyEdgePolicy}" />
            <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsRunningDeviceHealthBatch}"
                         Width="96" Height="6" VerticalAlignment="Center" />
          </StackPanel>
          <TextBlock Text="{Binding DeviceHealthBatchStatus}" Classes="muted" TextWrapping="Wrap" />
          <Border IsVisible="{Binding HasDeviceHealthAlerts}" Background="#FBFCFD"
                  BorderBrush="#D8E0E3" BorderThickness="1" CornerRadius="8" Padding="12">
            <StackPanel Spacing="8">
              <StackPanel Spacing="3">
                <TextBlock Text="{Binding DeviceHealthAlertsHeader}" FontSize="17" FontWeight="SemiBold" />
                <TextBlock Text="{Binding DeviceHealthAlertsDescription}"
                           Classes="muted" FontSize="12" TextWrapping="Wrap" />
              </StackPanel>
              <ItemsControl ItemsSource="{Binding DeviceHealthAlerts}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:TeacherDeviceHealthAlert">
                    <Border BorderBrush="#D8E0E3" BorderThickness="0,1,0,0" Padding="0,8,0,4">
                      <StackPanel Spacing="6">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                          <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding AffectedCountSummary}" Classes="muted" />
                          </StackPanel>
                            <Border Grid.Column="1" Background="{Binding SeverityBackground}"
                                    CornerRadius="8" Padding="8,3" VerticalAlignment="Center">
                              <TextBlock Text="{Binding SeverityLabel}" Foreground="{Binding SeverityForeground}"
                                         FontWeight="SemiBold" />
                            </Border>
                        </Grid>
                        <TextBlock Text="{Binding AffectedTargets}" Classes="muted"
                                   TextWrapping="Wrap" />
                        <WrapPanel>
                          <Button Content="{Binding AcknowledgementLabel}" Click="RequestAcknowledgeDeviceHealthAlert"
                                  IsEnabled="{Binding CanAcknowledge}" Margin="0,0,8,4" />
                          <Button Content="重新检测" Click="RequestRecheckDeviceHealthAlert"
                                  IsEnabled="{Binding CanRecheck}" Margin="0,0,8,4" />
                          <Button Content="查看设备" Click="RequestFocusDeviceHealthAlert"
                                  Margin="0,0,8,4" />
                          <Button Content="尝试可用修复" Click="RequestRepairDeviceHealthAlert"
                                  IsEnabled="{Binding CanAttemptRepair}" Margin="0,0,8,4" />
                        </WrapPanel>
                        <Expander Header="诊断详情" IsExpanded="{Binding IsDiagnosticsExpanded, Mode=TwoWay}"
                                  HorizontalAlignment="Stretch">
                          <StackPanel Spacing="4" Margin="0,6,0,0">
                            <TextBlock Text="{Binding SeenSummary}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Diagnostics}" Classes="muted" TextWrapping="Wrap" />
                          </StackPanel>
                        </Expander>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="10">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <TextBlock Text="学生电脑" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{Binding DeviceHealthListSummary}" Classes="muted"
                       VerticalAlignment="Center" />
          </Grid>
          <Grid ColumnDefinitions="*,220" ColumnSpacing="10">
            <TextBox Text="{Binding DeviceHealthSearchText, Mode=TwoWay}"
                     PlaceholderText="搜索学生姓名、状态或异常原因" />
            <ComboBox Grid.Column="1" ItemsSource="{Binding DeviceHealthCategoryFilters}"
                      SelectedIndex="{Binding DeviceHealthCategoryFilterIndex, Mode=TwoWay}" />
          </Grid>
          <TextBlock Text="启动 Veyon 服务可恢复教师端屏幕监看或控制；同步 Edge 网站策略可重新应用当前有效的网站限制。设备状态未确认时，这些操作会保持禁用。"
                     Classes="muted" FontSize="12" TextWrapping="Wrap" />
          <TextBlock Text="打开此页后，所选电脑会自动出现在列表；状态未知时会明确显示为未知。"
                     Classes="muted"
                     IsVisible="{Binding !HasDeviceHealthRows}" />
          <TextBlock Text="没有符合条件的电脑，请调整搜索内容或状态筛选。" Classes="muted"
                     IsVisible="{Binding HasDeviceHealthFilterEmpty}" />
          <ListBox x:Name="DeviceHealthRowsList" ItemsSource="{Binding DeviceHealthPageRows}" Height="430"
                   IsVisible="{Binding HasDeviceHealthFilteredRows}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:TeacherDeviceHealthRow">
                <Border BorderBrush="#DDE5E9" BorderThickness="0,0,0,1" Background="#FFFFFF"
                        Padding="10,8">
                  <StackPanel Spacing="7">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                      <TextBlock Text="{Binding IdentitySummary}" FontWeight="SemiBold" FontSize="12"
                                 TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding IdentitySummary}"
                                 VerticalAlignment="Center" />
                      <Border Grid.Column="1" Background="{Binding CategoryBackground}" CornerRadius="8"
                              Padding="8,3" VerticalAlignment="Center">
                        <TextBlock Text="{Binding CategoryLabel}" Foreground="{Binding CategoryForeground}"
                                   FontWeight="SemiBold" FontSize="12" />
                      </Border>
                    </Grid>
                    <TextBlock Text="{Binding CompactSummary}" Classes="muted" FontSize="12"
                               TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                    <TextBlock Text="{Binding InputGuardSummary}" Foreground="{Binding InputGuardForeground}"
                               FontSize="12" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                    <WrapPanel>
                      <Button Content="启动 Veyon 服务" Click="RequestEnsureVeyonServiceRunning"
                              IsEnabled="{Binding CanEnsureVeyonServiceRunning}"
                              ToolTip.Tip="启动学生电脑上的 Veyon 服务，用于恢复教师端屏幕监看或控制。仅在设备回执确认服务可安全启动时启用。"
                              Margin="0,0,8,0" />
                      <Button Content="同步 Edge 网站策略" Click="RequestRefreshLegacyEdgePolicy"
                              IsEnabled="{Binding CanRefreshLegacyEdgePolicy}"
                              ToolTip.Tip="重新应用当前有效的网站限制。仅支持已确认使用旧版注册表模式且策略有效的设备。"
                              Margin="0,0,8,0" />
                    </WrapPanel>
                    <Expander Header="详情" IsExpanded="{Binding IsDetailsExpanded, Mode=TwoWay}"
                              HorizontalAlignment="Stretch">
                      <StackPanel Spacing="4" Margin="0,6,0,0">
                        <TextBlock Text="{Binding AgentSummary}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding ServiceSummary}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding PolicySummary}" Classes="muted" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding UpdateSummary}" Classes="muted" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding CollectedText}" Classes="muted" FontSize="12" />
                        <TextBlock Text="{Binding Detail}" Foreground="#9C4221" TextWrapping="Wrap"
                                   IsVisible="{Binding HasDetail}" />
                        <TextBlock Text="{Binding BatchOperationStatus}" Classes="muted" TextWrapping="Wrap"
                                   IsVisible="{Binding HasBatchOperationStatus}" />
                        <TextBlock Text="{Binding RepairStatus}" Classes="muted" TextWrapping="Wrap"
                                   IsVisible="{Binding HasRepairStatus}" />
                      </StackPanel>
                    </Expander>
                    <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsRepairing}"
                                 Width="96" Height="5" HorizontalAlignment="Left" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" HorizontalAlignment="Right">
            <Button Content="上一页" Click="RequestPreviousDeviceHealthPage"
                    IsEnabled="{Binding CanPreviousDeviceHealthPage}" />
            <TextBlock Grid.Column="1" Text="{Binding DeviceHealthPageLabel}" Classes="muted"
                       VerticalAlignment="Center" Margin="6,0" />
            <Button Grid.Column="2" Content="下一页" Click="RequestNextDeviceHealthPage"
                    IsEnabled="{Binding CanNextDeviceHealthPage}" />
          </Grid>
        </StackPanel>
      </Border>
    </StackPanel>
  </StackPanel>
</UserControl>
