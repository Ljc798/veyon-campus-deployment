<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VeyonCampus.App"
             xmlns:core="using:VeyonCampus.Core"
             x:Class="VeyonCampus.App.Presentation.Views.TeacherRoomView"
             x:DataType="vm:TeacherViewModel">
  <StackPanel Margin="24,24,24,28" Spacing="20">
    <StackPanel IsVisible="{Binding IsRoomPage}" Spacing="20">
      <Border Classes="card" IsVisible="{Binding HasCampusProfiles}">
        <StackPanel Spacing="10">
          <Grid ColumnDefinitions="*,16,*" ColumnSpacing="0">
            <StackPanel Spacing="6">
              <TextBlock Text="本机校区档案" FontWeight="SemiBold" />
              <ComboBox ItemsSource="{Binding CampusProfiles}"
                        SelectedItem="{Binding SelectedCampusProfile, Mode=TwoWay}"
                        IsEnabled="{Binding CanEditRoomPlan}" PlaceholderText="选择校区档案">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="core:TeacherCampusProfile">
                    <TextBlock Text="{Binding DisplayName}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </StackPanel>
            <StackPanel Grid.Column="2" Spacing="6">
              <TextBlock Text="已保存的地点" FontWeight="SemiBold" />
              <ComboBox ItemsSource="{Binding RoomProfiles}"
                        SelectedItem="{Binding SelectedRoomProfile, Mode=TwoWay}"
                        IsEnabled="{Binding CanEditRoomPlan}" PlaceholderText="选择地点">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="core:TeacherRoomProfile">
                    <TextBlock Text="{Binding DisplayName}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </StackPanel>
          </Grid>
          <TextBlock Text="校区档案与地点保存在教师电脑。从 Veyon 读取地点不会自动新建档案；删除校区档案会同时删除其下所有地点，但不会修改 Veyon。"
                     Classes="muted" TextWrapping="Wrap" />
          <TextBlock Text="{Binding VeyonRoomBindingStatus}" Classes="muted" TextWrapping="Wrap"
                     IsVisible="{Binding HasVeyonRoomBindingStatus}" />
          <TextBlock Text="{Binding CampusDirectoryStatus}" Classes="muted" TextWrapping="Wrap"
                     IsVisible="{Binding HasCampusDirectoryStatus}" />
        </StackPanel>
      </Border>
      <TextBlock Text="{Binding CampusDirectoryError}" Foreground="{DynamicResource Teacher.Color.Danger}"
                 IsVisible="{Binding HasCampusDirectoryError}" TextWrapping="Wrap" />
      <Border Classes="card">
        <StackPanel Spacing="12">
          <Grid ColumnDefinitions="*" ColumnSpacing="14">
            <StackPanel Spacing="4">
              <TextBlock Text="机房座位图" FontSize="20" FontWeight="SemiBold" />
              <TextBlock Text="{Binding SeatGridContext}" Classes="muted" TextWrapping="Wrap"
                         IsVisible="{Binding HasSeatMap}" />
              <TextBlock Text="座位图和学生姓名保存在教师电脑；从 Veyon 删除地点不会删除本机档案。"
                         Classes="muted" TextWrapping="Wrap" IsVisible="{Binding HasSeatMap}" />
            </StackPanel>
          </Grid>
          <Grid ColumnDefinitions="*,16,*" IsVisible="{Binding HasNoSeatMap}">
            <StackPanel Spacing="8">
              <TextBlock Text="配置包 / 校区名称" />
              <TextBox Text="{Binding RoomCampusName, Mode=TwoWay}" IsEnabled="{Binding CanEditRoomPlan}"
                       PlaceholderText="例如：东区校区" />
            </StackPanel>
            <StackPanel Grid.Column="2" Spacing="8">
              <TextBlock Text="机房名称" />
              <TextBox Text="{Binding RoomLocationName, Mode=TwoWay}" IsEnabled="{Binding CanEditRoomPlan}"
                       PlaceholderText="默认使用配置包名称" />
            </StackPanel>
          </Grid>
          <TextBlock Text="默认 15×15；可点按或按住鼠标拖动连续添加桌位。电脑编号固定跟随座位；填写姓名且编号留空时，从本机已登记地点的最大编号后续排。无姓名座位可手动填写编号并生成电脑；无编号座位不会生成电脑。"
                     Classes="muted" IsVisible="{Binding HasNoSeatMap}" TextWrapping="Wrap" />
          <Button Classes="primary" Content="开始编辑座位图" Click="RequestPrepareRoomSeatGrid"
                  IsEnabled="{Binding CanPrepareRoomSeatGrid}" IsVisible="{Binding HasNoSeatMap}"
                  HorizontalAlignment="Left" />
          <StackPanel IsVisible="{Binding HasSeatMap}">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Margin="0,4,0,8">
              <TextBlock Text="{Binding SeatGridSummary}" VerticalAlignment="Center" />
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button Content="{Binding SeatMapEditButtonLabel}" Click="RequestToggleSeatMapEditing"
                        IsEnabled="{Binding CanToggleSeatMapEditing}" />
                <Button Classes="secondary" Content="取消编辑" Click="RequestCancelSeatMapEditing"
                        IsEnabled="{Binding CanCancelSeatMapEditing}"
                        IsVisible="{Binding IsSeatMapEditing}" />
                <Button Content="打印座位表" Click="RequestPrintSeatChart"
                        IsEnabled="{Binding CanPrintSeatMap}" />
              </StackPanel>
            </Grid>
            <Expander Header="地点管理" Theme="{StaticResource App.DetailExpander}" Margin="0,0,0,8">
              <StackPanel Orientation="Horizontal" Spacing="8" Margin="8">
                <Button Classes="secondary" Content="打开 Veyon 配置器" Click="RequestOpenVeyonConfigurator"
                        IsEnabled="{Binding CanOpenVeyonConfigurator}" />
                <Button Classes="secondary" Content="删除本机机房" Click="RequestDeleteRoomProfile"
                        IsEnabled="{Binding CanDeleteRoomProfile}" />
              </StackPanel>
            </Expander>
            <TextBlock Text="预览 · 悬停查看桌位和学生姓名。" Classes="muted"
                       IsVisible="{Binding IsSeatMapPreview}" TextWrapping="Wrap" Margin="0,0,0,8" />
            <TextBlock Text="编辑 · 点击空格添加座位，点击座位修改姓名或编号；拖动座位可移动学生和电脑绑定。行列标题右键可删除空行或空列。按 Ctrl+Z 撤销，Ctrl+Shift+Z 重做。"
                       Classes="muted" IsVisible="{Binding IsSeatMapEditing}" TextWrapping="Wrap" Margin="0,0,0,8" />
            <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,0,0,8">
              <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                <Border Width="14" Height="14" Background="{DynamicResource Teacher.Color.SurfaceSubtle}" BorderBrush="{DynamicResource Teacher.Color.Border}"
                        BorderThickness="1" CornerRadius="4" />
                <TextBlock Text="过道" Classes="muted" VerticalAlignment="Center" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                <Border Width="14" Height="14" Background="{DynamicResource Teacher.Color.Surface}" BorderBrush="{DynamicResource Teacher.Color.Border}"
                        BorderThickness="1" CornerRadius="4" />
                <TextBlock Text="桌位" Classes="muted" VerticalAlignment="Center" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                <Border Width="14" Height="14" Background="{DynamicResource Teacher.Color.WarningSubtle}" BorderBrush="{DynamicResource Teacher.Color.Warning}"
                        BorderThickness="2" CornerRadius="4" />
                <TextBlock Text="姓名座位待编号" Classes="muted" VerticalAlignment="Center" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center"
                          IsVisible="{Binding IsSeatMapEditing}">
                <Border Width="14" Height="14" Background="{DynamicResource Teacher.Color.WarningSubtle}" BorderBrush="{DynamicResource Teacher.Color.Warning}"
                        BorderThickness="3" CornerRadius="4" />
                <TextBlock Text="本次新增" Classes="muted" VerticalAlignment="Center" />
              </StackPanel>
            </StackPanel>
            <TextBlock Text="{Binding SeatMapStatus}" Classes="muted"
                       IsVisible="{Binding HasSeatMapInfo}" TextWrapping="Wrap" />
            <TextBlock Text="{Binding SeatMapStatus}" Foreground="{DynamicResource Teacher.Color.Danger}"
                       IsVisible="{Binding HasSeatMapError}" TextWrapping="Wrap" />
            <Button Content="重试读取 Veyon 学生名单" Click="RequestRetryInitialSeatGridImport"
                    IsVisible="{Binding CanRetryInitialSeatGridImport}"
                    IsEnabled="{Binding !IsImportingInitialSeatGridFromVeyon}"
                    HorizontalAlignment="Left" />
            <Button Content="打开已有的冲突座位图" Click="RequestOpenInitialSeatGridConflictLocation"
                    IsVisible="{Binding CanOpenInitialSeatGridConflictLocation}"
                    HorizontalAlignment="Left" />
            <TextBlock Text="{Binding RoomCreateStatus}" Classes="muted"
                       IsVisible="{Binding HasRoomCreateStatus}" TextWrapping="Wrap" />
            <TextBlock Text="{Binding RoomCreateError}" Foreground="{DynamicResource Teacher.Color.Danger}"
                       IsVisible="{Binding HasRoomCreateError}" TextWrapping="Wrap" />
            <TextBlock Text="{Binding RoomCreateResult}" Foreground="{DynamicResource Teacher.Color.Success}"
                       IsVisible="{Binding HasRoomCreateResult}" TextWrapping="Wrap" />
            <Button Content="重试 Veyon 同步" Click="RequestRetrySeatMapSync"
                    IsVisible="{Binding CanRetrySeatMapSync}" HorizontalAlignment="Left" />
            <Grid ColumnDefinitions="Auto,Auto,Auto" RowDefinitions="Auto,Auto,Auto"
                  HorizontalAlignment="Left" Margin="0,4,0,0">
              <Border Grid.Row="0" Grid.Column="0" Width="24" Height="24" />
              <ItemsControl Grid.Row="0" Grid.Column="1" ItemsSource="{Binding SeatGridColumnHeaders}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:TeacherSeatGridAxis">
                    <Button Classes="seat-axis seat-axis-delete" Tag="{Binding Index}"
                            IsEnabled="{Binding CanEdit}"
                            PointerEntered="AxisHeaderPointerEntered" PointerExited="AxisHeaderPointerExited"
                            Click="RequestDeleteSeatAxis"
                            Margin="1" Width="24" Height="24" Padding="0">
                      <Grid>
                        <TextBlock Text="{Binding Label}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <TextBlock Text="−" IsVisible="False" FontSize="16" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Grid>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Border Grid.Row="0" Grid.Column="2" Width="24" Height="24" />
              <ItemsControl Grid.Row="1" Grid.Column="0" ItemsSource="{Binding SeatGridRowHeaders}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><StackPanel /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:TeacherSeatGridAxis">
                    <Button Classes="seat-axis seat-axis-delete" Tag="{Binding Index}"
                            IsEnabled="{Binding CanEdit}"
                            PointerEntered="AxisHeaderPointerEntered" PointerExited="AxisHeaderPointerExited"
                            Click="RequestDeleteSeatAxis"
                            Margin="1" Width="24" Height="24" Padding="0">
                      <Grid>
                        <TextBlock Text="{Binding Label}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <TextBlock Text="−" IsVisible="False" FontSize="16" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Grid>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <ItemsControl x:Name="SeatMapGrid" Grid.Row="1" Grid.Column="1" ItemsSource="{Binding SeatMapCells}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><UniformGrid Columns="{Binding SeatGridColumns}" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:TeacherSeatCell">
                    <Button Classes="seat-dot" Classes.aisle="{Binding IsAisle}"
                            Classes.seat="{Binding IsSeat}"
                            Classes.namedSeat="{Binding HasStudentName}"
                            Classes.needsComputerNumber="{Binding NeedsComputerNumber}"
                            Classes.newSeat="{Binding IsNewlyAdded}"
                            ToolTip.Tip="{Binding TooltipText}"
                            Click="RequestSeatCellClicked"
                            PointerPressed="SeatCellPointerPressed"
                            Margin="1" Width="24" Height="24" MinHeight="24" Padding="0">
                      <Button.ContextMenu>
                        <ContextMenu x:CompileBindings="False" Opening="SeatCellContextMenuOpening">
                          <MenuItem Header="删除此座位" IsVisible="{Binding ShowDeleteLocalSeat}"
                                    Click="RequestDeleteSeat" />
                          <MenuItem Header="解除本机电脑关联" IsVisible="{Binding CanClearVeyonTarget}"
                                    Click="RequestClearSeatVeyonTarget" />
                          <MenuItem Header="{Binding DeleteSeatComputerMenuLabel}"
                                    IsVisible="{Binding CanDeleteSeatComputer}"
                                    Click="RequestDeleteSeatComputer" />
                        </ContextMenu>
                      </Button.ContextMenu>
                      <TextBlock Text="{Binding GridLabel}" FontSize="12" FontWeight="SemiBold"
                                 HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Button Grid.Row="1" Grid.Column="2" Classes="seat-grid-add" Content="+"
                      IsVisible="{Binding IsSeatMapEditing}" IsEnabled="{Binding CanAddSeatGridColumn}"
                      Click="RequestAddSeatGridColumn" />
              <Button Grid.Row="2" Grid.Column="1" Classes="seat-grid-add" Content="+"
                      IsVisible="{Binding IsSeatMapEditing}" IsEnabled="{Binding CanAddSeatGridRow}"
                      Click="RequestAddSeatGridRow" />
            </Grid>
            <TextBlock Text="{Binding SeatMapDragFeedback}" Classes="muted"
                       IsVisible="{Binding HasSeatMapDragFeedback}"
                       TextWrapping="Wrap" Margin="0,6,0,0" />
          </StackPanel>
        </StackPanel>
      </Border>
    </StackPanel>
  </StackPanel>
</UserControl>
