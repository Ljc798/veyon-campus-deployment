<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VeyonCampus.App"
             xmlns:core="using:VeyonCampus.Core"
             x:Class="VeyonCampus.App.Presentation.Views.TeacherPolicyView"
             x:DataType="vm:TeacherViewModel">
  <StackPanel Margin="24,24,24,28" Spacing="20">
    <StackPanel IsVisible="{Binding IsClassroomPage}" Spacing="20">
      <Border Classes="section-card" IsVisible="{Binding IsWebsitePolicyPage}">
        <StackPanel Spacing="16">
          <TextBlock Text="第 1 步：选择学生电脑" Classes="section-title" />
          <Border Classes="subtle-panel">
          <StackPanel Spacing="12">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <StackPanel Spacing="8">
              <TextBlock Text="校区" FontWeight="SemiBold" />
              <ComboBox ItemsSource="{Binding WebsiteSigningCampuses}"
                        SelectedItem="{Binding SelectedWebsiteSigningCampus, Mode=TwoWay}"
                        Text="{Binding CampusId, Mode=TwoWay}" IsEditable="True" IsEnabled="{Binding !IsExecuting}"
                        PlaceholderText="选择已有校区或输入名称" />
            </StackPanel>
            <Button Grid.Column="1" Content="从 Veyon 读取电脑" Click="RequestFillWebsiteTargets"
                    IsEnabled="{Binding CanReadWebsiteLocations}" VerticalAlignment="Bottom" />
          </Grid>
          <StackPanel IsVisible="{Binding HasMultipleWebsiteLocations}" Spacing="8">
            <TextBlock Text="选择地点并填入电脑名单：" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
              <ComboBox ItemsSource="{Binding WebsiteLocationChoices}"
                        SelectedIndex="{Binding WebsiteLocationIndex, Mode=TwoWay}" />
              <Button Grid.Column="1" Content="填入所选电脑" Click="RequestFillSelectedWebsiteLocation"
                      IsEnabled="{Binding CanApplyWebsiteLocation}" />
            </Grid>
          </StackPanel>
          <TextBlock Text="{Binding WebsiteDirectoryStatus}" Classes="muted"
                     IsVisible="{Binding HasWebsiteDirectoryStatus}" TextWrapping="Wrap" />
          <TextBlock Text="{Binding WebsiteDirectoryError}" Foreground="#9C4221"
                     IsVisible="{Binding HasWebsiteDirectoryError}" TextWrapping="Wrap" />
          <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
            <TextBlock Text="{Binding WebsitePolicyTargetSelectionSummary}" Classes="muted"
                       VerticalAlignment="Center" />
            <Button Grid.Column="1" Content="全选" Click="RequestSelectAllWebsitePolicyTargets" IsEnabled="{Binding !IsExecuting}" />
            <Button Grid.Column="2" Content="清空" Click="RequestClearWebsitePolicyTargets" IsEnabled="{Binding !IsExecuting}" />
          </Grid>
          <ScrollViewer MaxHeight="170" VerticalScrollBarVisibility="Auto" IsEnabled="{Binding !IsExecuting}">
            <ItemsControl ItemsSource="{Binding WebsitePolicyTargetChoices}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <UniformGrid Columns="4" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:TeacherPolicyTargetChoice">
                  <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" Margin="0,2">
                    <TextBlock Text="{Binding StudentName}" FontWeight="SemiBold" />
                  </CheckBox>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
          <Expander Header="手动修改电脑名单">
            <TextBox Text="{Binding WebsiteTargets, Mode=TwoWay}" AcceptsReturn="True" IsEnabled="{Binding !IsExecuting}"
                     TextWrapping="Wrap" Height="80" PlaceholderText="每行一台电脑名称或地址" />
          </Expander>
          <Button Content="核对学生电脑身份" IsEnabled="{Binding CanTrustStudentAgentIdentities}"
                  Click="RequestTrustStudentAgentIdentities" HorizontalAlignment="Left" />
          <StackPanel Spacing="6">
            <TextBlock Text="{Binding StudentAgentIdentityStatus}" Classes="muted" TextWrapping="Wrap" />
            <ToggleButton Content="{Binding StudentAgentIdentityDetailsToggleText}"
                          IsChecked="{Binding ShowStudentAgentIdentityDetails, Mode=TwoWay}"
                          IsVisible="{Binding HasStudentAgentIdentityDetails}"
                          HorizontalAlignment="Left" />
            <TextBox Text="{Binding StudentAgentIdentityDetails}" IsReadOnly="True" AcceptsReturn="True"
                     TextWrapping="Wrap" Height="140" IsVisible="{Binding ShowStudentAgentIdentityDetails}" />
          </StackPanel>
          </StackPanel>
          </Border>
          <Border Height="1" Background="{DynamicResource Teacher.Color.Border}" />
          <TextBlock Text="第 2 步：选择网站访问方式" Classes="component-title" />
          <ComboBox SelectedIndex="{Binding WebsiteModeIndex, Mode=TwoWay}"
                    IsEnabled="{Binding !IsExecuting}">
            <ComboBoxItem Content="阻止指定网站（其他网站仍可访问）" />
            <ComboBoxItem Content="只允许指定网站（其他网站都会被阻止）" />
            <ComboBoxItem Content="阻止指定网站，并放行允许的例外" />
          </ComboBox>
          <Border Classes="status-panel info" Padding="12">
            <StackPanel Spacing="4">
              <TextBlock Text="{Binding WebsiteModeGuidance}" FontWeight="SemiBold" TextWrapping="Wrap" />
              <TextBlock Text="{Binding WebsitePolicyNextStepGuidance}" Classes="supporting-copy"
                         TextWrapping="Wrap" />
            </StackPanel>
          </Border>
          <TextBlock Text="第 3 步：核对网站名单" Classes="component-title" />
          <StackPanel Spacing="8">
              <StackPanel Spacing="8" IsVisible="{Binding IsWebsiteBlacklistEditorVisible}">
                <TextBlock Text="要阻止的网站" FontWeight="SemiBold" />
                <Button Content="导入常见娱乐网站" IsEnabled="{Binding CanImportCommonWebsiteBlacklist}"
                        Click="RequestImportCommonWebsiteBlacklist" HorizontalAlignment="Left" />
                <TextBox Text="{Binding WebsiteBlockDomains, Mode=TwoWay}" AcceptsReturn="True"
                         TextWrapping="Wrap" Height="100" PlaceholderText="每行一个域名，例如 game.example" />
              </StackPanel>
              <StackPanel Spacing="8" IsVisible="{Binding IsWebsiteAllowlistEditorVisible}">
                <TextBlock Text="允许的网站" FontWeight="SemiBold" />
                <Button Content="导入学习网站" IsEnabled="{Binding CanImportCommonWebsiteAllowlist}"
                        Click="RequestImportCommonWebsiteAllowlist" HorizontalAlignment="Left" />
                <TextBox Text="{Binding WebsiteAllowDomains, Mode=TwoWay}" AcceptsReturn="True"
                         TextWrapping="Wrap" Height="100" PlaceholderText="每行一个域名，例如 school.edu.cn" />
              </StackPanel>
            <TextBlock Text="名单按域名及其子域名匹配；粘贴完整网址时只使用其中的域名。"
                       Classes="muted" TextWrapping="Wrap" />
            <Expander Header="编辑常用网站名单（只影响之后导入）">
              <StackPanel Spacing="10" Margin="4,8,4,4">
                <TextBlock Text="每行输入一个域名。保存后，‘导入常见娱乐网站’和‘导入学习网站’会使用这里的内容；不会自动推送到学生电脑。"
                           Classes="supporting-copy" TextWrapping="Wrap" />
                <StackPanel Spacing="6">
                  <TextBlock Text="常见娱乐网站" FontWeight="SemiBold" />
                  <TextBox Text="{Binding CommonWebsiteBlacklistPresetDomains, Mode=TwoWay}"
                           AcceptsReturn="True" TextWrapping="Wrap" Height="92"
                           PlaceholderText="每行一个域名" />
                </StackPanel>
                <StackPanel Spacing="6">
                  <TextBlock Text="常见学习网站" FontWeight="SemiBold" />
                  <TextBox Text="{Binding CommonWebsiteAllowlistPresetDomains, Mode=TwoWay}"
                           AcceptsReturn="True" TextWrapping="Wrap" Height="72"
                           PlaceholderText="每行一个域名" />
                </StackPanel>
                <Button Content="保存常用名单" IsEnabled="{Binding CanSaveWebsitePolicyPresets}"
                        Click="RequestSaveCommonWebsitePolicyPresets" HorizontalAlignment="Left" />
                <TextBlock Text="{Binding WebsitePolicyPresetEditStatus}" Classes="muted"
                           IsVisible="{Binding HasWebsitePolicyPresetEditStatus}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding WebsitePolicyPresetStatus}" Classes="muted"
                           TextWrapping="Wrap" />
              </StackPanel>
            </Expander>
            <TextBlock Text="限制截止时间" FontWeight="SemiBold" />
            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
              <DatePicker SelectedDate="{Binding WebsiteDeadlineDate, Mode=TwoWay}" />
              <TimePicker Grid.Column="1" SelectedTime="{Binding WebsiteDeadlineTime, Mode=TwoWay}" />
            </Grid>
            <TextBlock Text="第 4 步：应用到已选学生电脑" Classes="component-title" />
            <TextBlock Text="{Binding WebsitePolicyDraftStatus}" Classes="muted" TextWrapping="Wrap" />
            <Border Classes="status-panel info" Padding="12">
              <StackPanel Spacing="8">
                <TextBlock Text="从浏览器地址添加" FontWeight="SemiBold" />
                <TextBox Text="{Binding WebsiteObservedAddress, Mode=TwoWay}"
                         PlaceholderText="粘贴网址或域名" />
                <TextBlock Text="详细网址会保存在此电脑；当前浏览器名单按域名及其子域名匹配。"
                           Classes="muted" TextWrapping="Wrap" />
                <WrapPanel Orientation="Horizontal">
                  <Button Content="加入阻止列表" IsEnabled="{Binding CanAddObservedWebsite}"
                          Click="RequestAddObservedWebsiteToBlacklist" Margin="0,0,8,8" />
                  <Button Content="加入允许列表" IsEnabled="{Binding CanAddObservedWebsite}"
                          Click="RequestAddObservedWebsiteToAllowlist" Margin="0,0,8,8" />
                </WrapPanel>
                <TextBlock Text="{Binding WebsiteEntryStatus}" Foreground="#246356"
                           IsVisible="{Binding HasWebsiteEntryStatus}" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
            <WrapPanel Orientation="Horizontal">
              <Button Classes="primary" Content="{Binding WebsitePolicyActionText}" IsEnabled="{Binding CanPushWebsitePolicy}" Click="RequestPushWebsitePolicy" Margin="0,0,8,6" />
              <Button Content="解除限制" IsEnabled="{Binding CanDisableWebsitePolicy}" Click="RequestDisableWebsitePolicy" Margin="0,0,8,6" />
              <Button Content="读取逐台状态" IsEnabled="{Binding CanReadWebsitePolicyStatus}" Click="RequestReadWebsitePolicyStatus" Margin="0,0,8,6" />
              <Button Content="{Binding EdgeRealtimeMigrationButtonLabel}" IsVisible="{Binding CanMigrateEdgeRealtime}" Click="RequestMigrateEdgeRealtime" Margin="0,0,8,6" />
              <Button Content="恢复 Edge 注册表策略" IsVisible="{Binding CanMigrateEdgeRealtime}" Click="RequestRestoreEdgeLegacy" Margin="0,0,8,6" />
              <Button Content="重试失败设备" IsVisible="{Binding CanFillFailedWebsiteTargets}" Click="RequestFillFailedWebsiteTargets" Margin="0,0,8,6" />
            </WrapPanel>
            <Expander Header="试用版 Edge 扩展加载说明" IsVisible="{Binding IsEdgeRealtimePilotBuild}">
              <TextBlock Text="试用版不会自动加载 Edge 扩展。请在学生机每个实际使用的 Edge 配置中手动加载扩展，Edge 打开后先读取状态；所有 Profile 显示“已读回应用”后再启用实时同步。"
                         Classes="supporting-copy" TextWrapping="Wrap" Margin="4,8,4,4" />
            </Expander>
            <TextBlock Text="{Binding WebsitePolicyHistoryText}" Classes="muted" IsVisible="{Binding HasWebsitePolicyHistory}" TextWrapping="Wrap" />
            <TextBlock Text="{Binding WebsitePolicyError}" Foreground="#9C4221" IsVisible="{Binding HasWebsitePolicyError}" TextWrapping="Wrap" />
            <StackPanel IsVisible="{Binding HasWebsitePolicyResult}" Spacing="6">
              <TextBlock Text="{Binding WebsitePolicyResult}" Foreground="#246356" TextWrapping="Wrap" />
              <ToggleButton Content="{Binding WebsitePolicyDetailsToggleText}"
                            IsChecked="{Binding ShowWebsitePolicyResultDetails, Mode=TwoWay}"
                            IsEnabled="{Binding HasWebsitePolicyResultDetails}" HorizontalAlignment="Left" />
              <TextBox Text="{Binding WebsitePolicyResultDetails}" IsReadOnly="True" AcceptsReturn="True"
                       TextWrapping="Wrap" Height="180" IsVisible="{Binding ShowWebsitePolicyResultDetails}" />
            </StackPanel>
          </StackPanel>
        </StackPanel>
      </Border>
      <Border Classes="section-card" IsVisible="{Binding IsApplicationPolicyPage}">
        <StackPanel Spacing="12">
          <TextBlock Text="学生应用限制" Classes="section-title" />
          <TextBlock Text="正式机房启用前请先在可还原的测试机完成验证；禁用软件前，请先检查影响并阅读结果。"
                     Classes="muted" TextWrapping="Wrap" />
          <Border Classes="status-panel info" Padding="12">
            <StackPanel Spacing="7">
              <TextBlock Text="长期软件运行保护" Classes="component-title" />
              <TextBlock Text="无需扫描软件目录；在系统限制中选择学生账户并开启即可。"
                         Classes="supporting-copy" TextWrapping="Wrap" />
              <Button Content="配置长期软件运行保护" Click="RequestOpenLongTermSoftwareProtection"
                      IsEnabled="{Binding !IsExecuting}" HorizontalAlignment="Left" />
              <Expander Header="查看保护范围与检查方式">
                <TextBlock Text="Student Agent 会先做系统与目录安全检查，再逐台应用并签名确认结果。AppLocker 仅管桌面 EXE；Appx 保留签名应用放行，MSI/Script 集合不由 AppLocker 修改。"
                           Classes="supporting-copy" TextWrapping="Wrap" Margin="4,8,4,4" />
              </Expander>
            </StackPanel>
          </Border>
          <Border Background="#EEF3F5" CornerRadius="12" Padding="4" HorizontalAlignment="Left">
            <StackPanel Orientation="Horizontal" Spacing="3">
              <RadioButton Classes="policy-tab" GroupName="ApplicationSteps" Content="1 账户" IsChecked="{Binding IsApplicationAccountsStep, Mode=TwoWay}" />
              <RadioButton Classes="policy-tab" GroupName="ApplicationSteps" Content="2 软件" IsChecked="{Binding IsApplicationSoftwareStep, Mode=TwoWay}" />
              <RadioButton Classes="policy-tab" GroupName="ApplicationSteps" Content="3 应用" IsChecked="{Binding IsApplicationApplyStep, Mode=TwoWay}" />
            </StackPanel>
          </Border>
          <StackPanel IsVisible="{Binding IsApplicationAccountsStep}" Spacing="10">
            <TextBlock Text="先勾选确实需要限制的学生账户。可按电脑名和账户名逐项选择。" Classes="muted" TextWrapping="Wrap" />
            <Button Content="读取目标电脑账户" IsEnabled="{Binding CanReadApplicationInventory}" Click="RequestReadStudentAccounts" HorizontalAlignment="Left" />
            <TextBlock Text="{Binding StudentAccountsStatus}" Classes="muted" IsVisible="{Binding HasStudentAccountsStatus}" TextWrapping="Wrap" />
            <TextBlock Text="{Binding StudentAccountSelectionSummary}" Classes="muted" IsVisible="{Binding HasStudentAccountChoices}" TextWrapping="Wrap" />
            <WrapPanel IsVisible="{Binding HasStudentAccountChoices}">
              <Button Content="全选已读取账户" Click="RequestSelectAllStudentAccounts" IsEnabled="{Binding !IsExecuting}" Margin="0,0,8,6" />
              <Button Content="清空选择" Click="RequestClearStudentAccountSelection" IsEnabled="{Binding !IsExecuting}" Margin="0,0,8,6" />
            </WrapPanel>
            <ScrollViewer Height="230" IsVisible="{Binding HasStudentAccountChoices}" IsEnabled="{Binding !IsExecuting}">
              <ItemsControl ItemsSource="{Binding StudentAccountChoices}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <VirtualizingStackPanel />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Padding="8" Margin="0,0,0,6" BorderBrush="#D8DFE8" BorderThickness="1" CornerRadius="6">
                      <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}">
                        <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" />
                      </CheckBox>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </StackPanel>
          <StackPanel IsVisible="{Binding IsApplicationSoftwareStep}" Spacing="10">
            <TextBlock Text="长期软件运行保护无需扫描；如需限制指定软件，可在高级选项中生成精确规则。"
                       Classes="supporting-copy" TextWrapping="Wrap" />
            <Expander Header="高级：从软件目录选择并限制指定软件">
              <StackPanel Spacing="10" Margin="4,8,4,4">
            <TextBlock Text="精确封禁只检查你勾选的产品：先读取轻量目录，再为选中条目生成发布者或哈希候选。"
                       Classes="supporting-copy" TextWrapping="Wrap" />
            <Button Content="快速读取所选电脑的软件目录" IsEnabled="{Binding CanReadApplicationInventory}"
                    Click="RequestReadApplicationCatalog" HorizontalAlignment="Left" />
            <TextBlock Text="{Binding ApplicationCatalogStatus}" Classes="muted"
                       IsVisible="{Binding HasApplicationCatalogStatus}" TextWrapping="Wrap" />
            <Expander Header="查看目录读取问题" IsVisible="{Binding HasApplicationCatalogFailureDetails}">
              <TextBlock Text="{Binding ApplicationCatalogFailureDetails}" Classes="muted"
                         TextWrapping="Wrap" Margin="4,0,4,8" />
            </Expander>
            <TextBox Text="{Binding ApplicationCatalogSearch, Mode=TwoWay}" PlaceholderText="按软件产品、公司或程序名搜索" />
            <TextBlock Text="{Binding ApplicationCatalogSelectionSummary}" Classes="muted" TextWrapping="Wrap" />
            <ScrollViewer Height="250" IsVisible="{Binding HasApplicationCatalogChoices}" IsEnabled="{Binding !IsExecuting}">
              <ItemsControl ItemsSource="{Binding ApplicationCatalogChoices}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <VirtualizingStackPanel />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Classes="device-row" Margin="0,0,0,6">
                      <StackPanel Spacing="4">
                        <CheckBox Content="{Binding Summary}" IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                        <TextBlock Text="{Binding Details}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
            <Button Classes="primary" Content="为选中产品生成精确候选" IsEnabled="{Binding CanGenerateApplicationCandidates}"
                    Click="RequestGenerateApplicationCandidates" HorizontalAlignment="Left" />
            <TextBox Text="{Binding ApplicationInventorySearch, Mode=TwoWay}"
                     PlaceholderText="筛选已生成候选：软件名、发布者、文件名、路径或电脑"
                     IsVisible="{Binding HasApplicationInventoryItems}" />
            <TextBlock Text="{Binding ApplicationInventoryStatus}" Classes="muted"
                       IsVisible="{Binding HasApplicationInventoryStatus}" TextWrapping="Wrap" />
            <Expander Header="查看候选生成问题" IsVisible="{Binding HasApplicationInventoryFailureDetails}">
              <TextBlock Text="{Binding ApplicationInventoryFailureDetails}" Classes="muted"
                         TextWrapping="Wrap" Margin="4,0,4,8" />
            </Expander>
            <Expander Header="查看已生成的精确候选" IsVisible="{Binding HasApplicationInventoryItems}" IsExpanded="True">
              <StackPanel Spacing="8">
                <TextBlock Text="核对实际文件与规则类型。发布者信息需能由 AppLocker 读取；哈希规则升级后需要重新生成。"
                           Classes="muted" TextWrapping="Wrap" />
                <WrapPanel>
                  <Button Content="勾选常见应用" Click="RequestSelectCommonApplicationChoices"
                          IsEnabled="{Binding !IsExecuting}" Margin="0,0,8,6" />
                  <Button Content="清空软件选择" Click="RequestClearApplicationChoiceSelection"
                          IsEnabled="{Binding !IsExecuting}" Margin="0,0,8,6" />
                </WrapPanel>
                <ScrollViewer Height="230" IsEnabled="{Binding !IsExecuting}">
                  <ItemsControl ItemsSource="{Binding ApplicationInventoryChoices}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <VirtualizingStackPanel />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border Classes="device-row" Margin="0,0,0,6">
                          <StackPanel Spacing="3">
                            <CheckBox Content="{Binding Summary}" IsChecked="{Binding IsSelected, Mode=TwoWay}" IsEnabled="{Binding CanSelect}" />
                            <TextBlock Text="{Binding FilePath}" FontSize="12" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding RuleAvailability}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
                <TextBlock Text="{Binding SelectedApplicationSummary}" Classes="muted" TextWrapping="Wrap" />
              </StackPanel>
            </Expander>
            <Expander Header="管理员工具：完整软件扫描和手工规则">
              <StackPanel Spacing="8" Margin="4,8,4,4">
                <TextBlock Text="完整扫描沿用现有读取 API：最多检查 400 个已登记 EXE，逐项计算文件哈希，最长约 45 秒；它不是完整软件盘点，也不会运行 AppLocker 安全预检。正式策略每次写入仍会独立完成全部安全预检。"
                           Classes="muted" TextWrapping="Wrap" />
                <Button Content="完整扫描（旧版读取 API）" IsEnabled="{Binding CanReadApplicationInventory}"
                        Click="RequestReadApplicationInventory" HorizontalAlignment="Left" />
                <Expander Header="手工设置账户和规则">
                  <StackPanel Spacing="8" Margin="4,8,4,4">
                    <CheckBox Content="启用手动规则输入" IsChecked="{Binding UseManualApplicationInputs, Mode=TwoWay}" />
                    <StackPanel IsVisible="{Binding UseManualApplicationInputs}" Spacing="8">
                      <TextBlock Text="手动 SID 仅支持单台电脑，会覆盖上方账户选择；系统限制仍按上方账户清单逐台选择。仅建议熟悉 Windows 账户的管理员使用。"
                                 Classes="muted" TextWrapping="Wrap" />
                      <TextBlock Text="学生账户 SID" />
                      <TextBox Text="{Binding ApplicationStudentSids, Mode=TwoWay}" AcceptsReturn="True"
                               TextWrapping="Wrap" Height="74" PlaceholderText="每行一个 SID" />
                      <TextBlock Text="应用规则" />
                      <TextBox Text="{Binding ApplicationRules, Mode=TwoWay}" AcceptsReturn="True"
                               TextWrapping="Wrap" Height="112" />
                      <Expander Header="查看手动输入格式">
                        <TextBlock Text="publisher|名称|发布者|产品|文件.exe|最低版本|最高版本；hash|名称|文件.exe|文件SHA256|AppLocker SHA256|字节数"
                                   Classes="muted" TextWrapping="Wrap" Margin="4,8,4,4" />
                      </Expander>
                      <Button Content="将勾选软件加入规则" IsEnabled="{Binding CanAddSelectedApplicationRules}"
                              Click="RequestAddSelectedApplicationRules" HorizontalAlignment="Left" />
                    </StackPanel>
                  </StackPanel>
                </Expander>
              </StackPanel>
            </Expander>
              </StackPanel>
            </Expander>
          </StackPanel>
          <StackPanel IsVisible="{Binding IsApplicationApplyStep}" Spacing="10">
          <ComboBox SelectedIndex="{Binding ApplicationPolicyModeIndex, Mode=TwoWay}">
            <ComboBoxItem Content="先检查影响（不禁用软件）" />
            <ComboBoxItem Content="禁用勾选软件（阻止后续启动）" />
          </ComboBox>
          <CheckBox Content="我已查看影响结果，确认应用限制" IsChecked="{Binding ApplicationEnforcementReviewed, Mode=TwoWay}" IsVisible="{Binding IsEnforceApplicationPolicy}" />
          <TextBlock Text="限制时长（到期自动恢复）" />
          <ComboBox SelectedIndex="{Binding ApplicationPolicyDurationIndex, Mode=TwoWay}">
            <ComboBoxItem Content="45 分钟" />
            <ComboBoxItem Content="60 分钟" />
            <ComboBoxItem Content="90 分钟" />
            <ComboBoxItem Content="120 分钟" />
            <ComboBoxItem Content="24 小时" />
          </ComboBox>
          <TextBlock Text="{Binding ApplicationPolicyPreview}" Classes="muted" TextWrapping="Wrap" />
          <WrapPanel Orientation="Horizontal">
            <Button Classes="primary" Content="应用当前设置" IsEnabled="{Binding CanPushApplicationPolicy}" Click="RequestPushApplicationPolicy" Margin="0,0,8,6" />
            <Button Content="解除应用限制" IsEnabled="{Binding CanDisableApplicationPolicy}" Click="RequestDisableApplicationPolicy" Margin="0,0,8,6" />
            <Button Content="查看影响结果" IsEnabled="{Binding CanReadApplicationPolicyAudit}" Click="RequestReadApplicationPolicyAudit" Margin="0,0,8,6" />
          </WrapPanel>
          <TextBlock Text="{Binding ApplicationPolicyHistoryText}" Classes="muted" IsVisible="{Binding HasApplicationPolicyHistory}" TextWrapping="Wrap" />
          <TextBlock Text="{Binding ApplicationPolicyError}" Foreground="#9C4221" IsVisible="{Binding HasApplicationPolicyError}" TextWrapping="Wrap" />
          <StackPanel IsVisible="{Binding HasApplicationPolicyResult}" Spacing="6">
            <TextBlock Text="{Binding ApplicationPolicyResult}" Foreground="#246356" TextWrapping="Wrap" />
            <ToggleButton Content="{Binding ApplicationPolicyDetailsToggleText}"
                          IsChecked="{Binding ShowApplicationPolicyResultDetails, Mode=TwoWay}"
                          IsEnabled="{Binding HasApplicationPolicyResultDetails}" HorizontalAlignment="Left" />
            <TextBox Text="{Binding ApplicationPolicyResultDetails}" IsReadOnly="True" AcceptsReturn="True"
                     TextWrapping="Wrap" Height="150" IsVisible="{Binding ShowApplicationPolicyResultDetails}" />
          </StackPanel>
          <TextBox Text="{Binding ApplicationAuditResult}" IsReadOnly="True" AcceptsReturn="True"
                   TextWrapping="Wrap" Height="180" IsVisible="{Binding HasApplicationAuditResult}" />
          </StackPanel>
        </StackPanel>
      </Border>
      <Border Classes="section-card" IsVisible="{Binding IsSystemPolicyPage}">
        <StackPanel Spacing="12">
          <TextBlock Text="系统限制" Classes="section-title" />
          <Border Classes="status-panel warning" Padding="12">
            <TextBlock Text="Agent 签名回执表示本机策略状态已读回，不代表限制效果已验证。Windows 10/11 效果仍待机房验收；请先在可还原测试机逐项验证。"
                       TextWrapping="Wrap" />
          </Border>
          <Border Classes="subtle-panel">
            <StackPanel Spacing="7">
              <TextBlock Text="建议先选择课堂基础限制" FontWeight="SemiBold" />
              <TextBlock Text="限制改时间、网络设置和账户管理；安装软件、壁纸及控制面板按机房需要单独选择。软件安装限制可能影响软件维护。"
                         Classes="muted" TextWrapping="Wrap" />
              <WrapPanel>
                <Button Content="选择基础限制" Click="RequestSelectRecommendedStudentSystemRestrictions"
                        IsEnabled="{Binding !IsExecuting}" Margin="0,0,8,0" />
                <Button Content="清空选择" Click="RequestClearStudentSystemRestrictionSelection"
                        IsEnabled="{Binding !IsExecuting}" />
              </WrapPanel>
            </StackPanel>
          </Border>
          <Border Classes="subtle-panel">
            <StackPanel Spacing="8">
              <TextBlock Text="目标学生账户" FontWeight="SemiBold" />
              <TextBlock Text="先勾选确实需要限制的学生账户。账户选择按电脑分别保存。" Classes="muted" TextWrapping="Wrap" />
              <Button Content="读取目标电脑账户" IsEnabled="{Binding CanReadApplicationInventory}"
                      Click="RequestReadStudentAccounts" HorizontalAlignment="Left" />
              <TextBlock Text="{Binding StudentAccountsStatus}" Classes="muted"
                         IsVisible="{Binding HasStudentAccountsStatus}" TextWrapping="Wrap" />
              <Expander Header="查看并选择账户" IsVisible="{Binding HasStudentAccountChoices}">
                <StackPanel Spacing="8">
                  <TextBlock Text="{Binding StudentAccountSelectionSummary}" Classes="muted" TextWrapping="Wrap" />
                  <WrapPanel>
                    <Button Content="全选已读取账户" Click="RequestSelectAllStudentAccounts" IsEnabled="{Binding !IsExecuting}" Margin="0,0,8,6" />
                    <Button Content="清空选择" Click="RequestClearStudentAccountSelection" IsEnabled="{Binding !IsExecuting}" Margin="0,0,8,6" />
                  </WrapPanel>
                  <ScrollViewer Height="180" IsEnabled="{Binding !IsExecuting}">
                    <ItemsControl ItemsSource="{Binding StudentAccountChoices}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <VirtualizingStackPanel />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Border Padding="8" Margin="0,0,0,6" BorderBrush="#D8DFE8" BorderThickness="1" CornerRadius="6">
                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}">
                              <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" />
                            </CheckBox>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ScrollViewer>
                </StackPanel>
              </Expander>
            </StackPanel>
          </Border>
          <TextBlock Text="{Binding StudentSystemPolicyPushGuidance}" Classes="muted" TextWrapping="Wrap" />
          <TextBlock Text="推送前检查账户和环境。不支持的壁纸或网络限制会跳过，其他选项仍可应用；检查失败的电脑不会应用任何系统限制。"
                     Classes="supporting-copy" TextWrapping="Wrap" />
          <StackPanel Spacing="2">
            <CheckBox Content="统一桌面壁纸" IsChecked="{Binding StudentSystemPolicyLockWallpaper, Mode=TwoWay}" />
            <TextBlock Text="把所选学生账户的桌面设为统一壁纸。" Classes="muted" FontSize="12" Margin="28,0,0,0" TextWrapping="Wrap" />
          </StackPanel>
          <StackPanel Spacing="2">
            <CheckBox Content="禁止修改系统日期、时间和时区" IsChecked="{Binding StudentSystemPolicyProhibitTimeChanges, Mode=TwoWay}" />
            <TextBlock Text="阻止所选学生账户更改日期、时间和时区。" Classes="muted" FontSize="12" Margin="28,0,0,0" TextWrapping="Wrap" />
          </StackPanel>
          <StackPanel Spacing="2">
            <CheckBox Content="禁止更改网络设置" IsChecked="{Binding StudentSystemPolicyProhibitNetworkChanges, Mode=TwoWay}" />
            <TextBlock Text="禁止修改网络配置；保留现有连接及 Veyon、学生代理通信。" Classes="muted" FontSize="12" Margin="28,0,0,0" TextWrapping="Wrap" />
          </StackPanel>
          <StackPanel Spacing="2">
            <CheckBox Content="长期软件运行保护（含部分安装限制）" IsChecked="{Binding StudentSystemPolicyProhibitSoftwareInstallation, Mode=TwoWay}" />
            <TextBlock Text="无需扫描软件目录；可能影响从用户目录运行的程序和软件维护。"
                       Classes="supporting-copy" FontSize="12" Margin="28,0,0,0" TextWrapping="Wrap" />
            <Expander Header="查看保护范围" Margin="28,0,0,0">
              <TextBlock Text="对所选学生账户启用 EXE 运行基线：保留系统与 Program Files 教育软件，限制未登记的便携程序；AppLocker 的 Appx 保持签名应用放行，MSI/Script 集合不由此功能修改。"
                         Classes="supporting-copy" FontSize="12" TextWrapping="Wrap" Margin="4,8,4,4" />
            </Expander>
          </StackPanel>
          <StackPanel Spacing="2">
            <CheckBox Content="禁止管理账户和修改本人密码" IsChecked="{Binding StudentSystemPolicyProhibitAccountManagement, Mode=TwoWay}" />
            <TextBlock Text="阻止学生管理本机账户或修改本人密码，教师管理员仍可维护。" Classes="muted" FontSize="12" Margin="28,0,0,0" TextWrapping="Wrap" />
          </StackPanel>
          <StackPanel Spacing="2">
            <CheckBox Content="禁止打开控制面板和设置" IsChecked="{Binding StudentSystemPolicyProhibitControlPanel, Mode=TwoWay}" />
            <TextBlock Text="限制所选学生账户打开控制面板和 Windows 设置。" Classes="muted" FontSize="12" Margin="28,0,0,0" TextWrapping="Wrap" />
          </StackPanel>
          <CheckBox Content="我已了解：学生可能无法安装或更新部分软件" IsChecked="{Binding StudentSystemPolicySoftwareInstallReviewed, Mode=TwoWay}" IsVisible="{Binding StudentSystemPolicyProhibitSoftwareInstallation}" />
          <TextBlock Text="{Binding StudentSystemPolicyPreview}" Classes="muted" TextWrapping="Wrap" />
          <CheckBox Content="我已阅读以上影响和目标预览，确认应用所选系统限制"
                    IsChecked="{Binding StudentSystemPolicyImpactReviewed, Mode=TwoWay}"
                    IsVisible="{Binding HasSelectedStudentSystemPolicy}" />
          <WrapPanel Orientation="Horizontal">
            <Button Classes="primary" Content="应用系统限制" IsEnabled="{Binding CanPushStudentSystemPolicy}" Click="RequestPushStudentSystemPolicy" Margin="0,0,8,6" />
            <Button Content="解除所选电脑的系统限制" IsEnabled="{Binding CanDisableStudentSystemPolicy}" Click="RequestDisableStudentSystemPolicy" Margin="0,0,8,6" />
          </WrapPanel>
          <TextBlock Text="{Binding StudentSystemPolicyResult}" Foreground="#246356" IsVisible="{Binding HasStudentSystemPolicyResult}" TextWrapping="Wrap" />
          <TextBox Text="{Binding StudentSystemPolicyDetails}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" Height="150" IsVisible="{Binding HasStudentSystemPolicyDetails}" />
          <TextBlock Text="{Binding StudentSystemPolicyError}" Foreground="#9C4221" IsVisible="{Binding HasStudentSystemPolicyError}" TextWrapping="Wrap" />
        </StackPanel>
      </Border>
    </StackPanel>
  </StackPanel>
</UserControl>
