<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VeyonCampus.App"
             x:Class="VeyonCampus.App.Presentation.Views.TeacherUpdatesView"
             x:DataType="vm:TeacherViewModel">
  <StackPanel Spacing="20">
    <StackPanel IsVisible="{Binding IsTeacherAboutPage}" Spacing="20">
      <Border x:Name="TeacherUpdateSection" Classes="section-card">
        <StackPanel Spacing="12">
          <TextBlock Text="教师端更新" Classes="section-title" />
          <TextBlock Text="{Binding TeacherUpdateVersionSummary}" Classes="supporting-copy" TextWrapping="Wrap" />
          <WrapPanel Orientation="Horizontal">
            <Button Content="检查更新" Click="RequestCheckTeacherUpdate" IsEnabled="{Binding CanCheckTeacherUpdate}" Margin="0,0,8,6" />
            <Button Classes="primary" Content="下载并重启" Click="RequestDownloadTeacherUpdate" IsEnabled="{Binding CanDownloadTeacherUpdate}" Margin="0,0,8,6" />
          </WrapPanel>
          <ProgressBar Minimum="0" Maximum="100" Value="{Binding TeacherUpdateProgressPercent}"
                       IsIndeterminate="{Binding TeacherUpdateProgressIsIndeterminate}"
                       IsVisible="{Binding IsTeacherUpdateProgressVisible}" Height="8" />
          <TextBlock Text="{Binding TeacherUpdateProgressText}" Classes="supporting-copy" TextWrapping="Wrap"
                     IsVisible="{Binding IsTeacherUpdateProgressVisible}" />
          <TextBlock Text="{Binding TeacherUpdateStatus}" Classes="supporting-copy" TextWrapping="Wrap" />
          <Expander Header="离线更新" Theme="{StaticResource App.DetailExpander}" IsExpanded="False">
            <StackPanel Spacing="8" Margin="0,8,0,0">
              <WrapPanel Orientation="Horizontal">
                <Button Content="导出离线更新包" Click="RequestExportOfflineTeacherUpdate" IsEnabled="{Binding CanExportOfflineTeacherUpdate}" Margin="0,0,8,6" />
                <Button Content="选择并验证安装器" Click="RequestVerifyOfflineTeacherUpdate" IsEnabled="{Binding CanVerifyOfflineTeacherUpdate}" Margin="0,0,8,6" />
                <Button Classes="primary" Content="安装并重启" Click="RequestInstallOfflineTeacherUpdate" IsEnabled="{Binding CanInstallOfflineTeacherUpdate}" Margin="0,0,8,6" />
              </WrapPanel>
              <TextBlock Text="{Binding OfflineTeacherUpdateStatus}" Classes="muted" TextWrapping="Wrap" />
            </StackPanel>
          </Expander>
        </StackPanel>
      </Border>
    </StackPanel>
    <StackPanel IsVisible="{Binding IsUpdatesPage}" Spacing="20">
      <Border x:Name="StudentUpdateSection" Classes="section-card">
        <StackPanel Spacing="12">
          <TextBlock Text="学生端维护" Classes="section-title" />
          <Border Classes="subtle-panel" Padding="12"
                  IsVisible="{Binding IsLocalTestStudentUpdateSourceAvailable}">
            <StackPanel Spacing="8">
              <TextBlock Text="本机测试包" Classes="component-title" />
              <CheckBox Content="使用本机测试包"
                        IsChecked="{Binding UseLocalTestStudentUpdateSource, Mode=TwoWay}" />
              <TextBlock Text="{Binding StudentUpdateSourceSummary}" Classes="muted" TextWrapping="Wrap" />
              <WrapPanel Orientation="Horizontal" IsVisible="{Binding UseLocalTestStudentUpdateSource}">
                <Button Classes="secondary" Content="选择 StudentSetup…"
                        Click="RequestSelectLocalStudentTestInstaller" Margin="0,0,8,4" />
                <TextBlock Text="{Binding LocalTestStudentSetupInstallerPath}" Classes="muted"
                           VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="720" />
              </WrapPanel>
              <WrapPanel Orientation="Horizontal" IsVisible="{Binding UseLocalTestStudentUpdateSource}">
                <Button Classes="secondary" Content="选择 MaintenanceService…"
                        Click="RequestSelectLocalTestMaintenanceInstaller" Margin="0,0,8,4" />
                <TextBlock Text="{Binding LocalTestMaintenanceInstallerPath}" Classes="muted"
                           VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="720" />
              </WrapPanel>
            </StackPanel>
          </Border>
          <WrapPanel Orientation="Horizontal">
            <Button Classes="primary" Content="一键静默更新全部学生端" Click="RequestMaintainStudentDevices" IsEnabled="{Binding CanOneClickUpdateAllStudentDevices}" Margin="0,0,8,6" />
          </WrapPanel>
          <TextBlock Text="{Binding StudentMaintenanceStatus}" Classes="supporting-copy" TextWrapping="Wrap" />
          <Border x:Name="ConfigurationSyncSection" Classes="subtle-panel">
            <StackPanel Spacing="9">
              <TextBlock Text="教师连接配置" Classes="component-title" />
              <TextBlock Text="{Binding StudentConfigurationSyncStatus}"
                         Classes="supporting-copy" TextWrapping="Wrap" />
              <ProgressBar Minimum="0" Maximum="100"
                           Value="{Binding StudentConfigurationSyncProgressPercent}"
                           IsVisible="{Binding IsStudentConfigurationSyncProgressVisible}" Height="8" />
              <TextBlock Text="{Binding StudentConfigurationSyncProgressText}"
                         Classes="muted" TextWrapping="Wrap"
                         IsVisible="{Binding IsStudentConfigurationSyncProgressVisible}" />
              <StackPanel Spacing="6" IsVisible="{Binding HasStudentConfigurationSyncTargetProgressItems}">
                <TextBlock Text="逐台同步结果" Classes="component-title" />
                <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto">
                  <ItemsControl ItemsSource="{Binding StudentConfigurationSyncTargetProgressItems}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <VirtualizingStackPanel />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:StudentConfigurationSyncTargetProgressItem">
                        <Border Classes="device-row" Margin="0,0,0,7">
                          <StackPanel Spacing="6">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                              <TextBlock Text="{Binding DisplayName}" Classes="device-row-name"
                                         TextTrimming="CharacterEllipsis" />
                              <Border Grid.Column="1" Background="{Binding StatusBackground}"
                                      CornerRadius="999" Padding="8,3" MaxWidth="220"
                                      VerticalAlignment="Center">
                                <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusForeground}"
                                           FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                              </Border>
                            </Grid>
                            <TextBlock Text="{Binding Target}" Classes="muted" TextWrapping="Wrap" />
                            <ProgressBar Minimum="0" Maximum="100" Value="{Binding ProgressPercent}"
                                         IsIndeterminate="{Binding IsIndeterminate}" Height="7" />
                            <TextBlock Text="{Binding Detail}" Classes="device-row-detail"
                                       TextWrapping="Wrap" />
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </StackPanel>
            </StackPanel>
          </Border>
          <StackPanel Spacing="6">
            <TextBlock Text="{Binding StudentUpdateStatus}" Classes="supporting-copy" TextWrapping="Wrap" />
            <StackPanel Spacing="5" IsVisible="{Binding HasStudentUpdatePerformanceReport}">
              <Button Content="导出本次性能汇总…" Click="RequestExportStudentUpdatePerformanceReport"
                      HorizontalAlignment="Left" />
              <TextBlock Text="{Binding StudentUpdatePerformanceReportExportStatus}"
                         Classes="muted" TextWrapping="Wrap" />
            </StackPanel>
            <ProgressBar Minimum="0" Maximum="100" Value="{Binding StudentUpdateProgressPercent}"
                         IsIndeterminate="{Binding StudentUpdateProgressIsIndeterminate}"
                         IsVisible="{Binding IsStudentUpdateProgressVisible}" Height="8" />
            <TextBlock Text="{Binding StudentUpdateProgressText}" Classes="muted" TextWrapping="Wrap"
                       IsVisible="{Binding IsStudentUpdateProgressVisible}" />
            <StackPanel Spacing="8" IsVisible="{Binding HasStudentUpdateTargetProgressItems}">
              <TextBlock Text="逐台进度与结果" Classes="component-title" />
              <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding StudentUpdateTargetProgressItems}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:StudentApplicationUpdateTargetProgressItem">
                      <Border Classes="device-row" Margin="0,0,0,7">
                        <StackPanel Spacing="7">
                          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <TextBlock Text="{Binding DisplayName}" Classes="device-row-name"
                                       TextTrimming="CharacterEllipsis" />
                            <Border Grid.Column="1" Background="{Binding StatusBackground}"
                                    CornerRadius="999" Padding="8,3" MaxWidth="300"
                                    VerticalAlignment="Center">
                              <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusForeground}"
                                         FontWeight="SemiBold" TextWrapping="NoWrap"
                                         TextTrimming="CharacterEllipsis" />
                            </Border>
                          </Grid>
                          <ProgressBar Classes="inline-progress" Minimum="0" Maximum="100" Value="{Binding ProgressPercent}"
                                       IsIndeterminate="{Binding IsIndeterminate}" Height="7" />
                          <StackPanel Spacing="3" IsVisible="{Binding HasMaintenanceFacts}">
                            <TextBlock Text="{Binding MaintenanceVersions}" Classes="muted" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding MaintenanceTransaction}" Classes="muted" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding MaintenanceConnection}" Classes="muted" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding MaintenanceDiagnostics}" Classes="muted" TextWrapping="Wrap" />
                          </StackPanel>
                          <TextBlock Text="{Binding Detail}" Classes="device-row-detail" TextWrapping="Wrap"
                                     IsVisible="{Binding HasDetail}" />
                          <Button Classes="tertiary" Content="{Binding RequeryButtonText}"
                                  Click="RequestRecheckStudentUpdateResult"
                                  IsVisible="{Binding CanRequery}" HorizontalAlignment="Left" />
                          <Expander Header="更新阶段耗时" Theme="{StaticResource App.DetailExpander}"
                                    IsVisible="{Binding HasPhaseTimings}">
                            <ItemsControl ItemsSource="{Binding PhaseTimings}">
                              <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:StudentUpdatePhaseTimingDisplayItem">
                                  <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10" Margin="0,3,0,0">
                                    <TextBlock Text="{Binding Phase}" Classes="device-row-detail" TextWrapping="Wrap" />
                                    <TextBlock Grid.Column="1" Text="{Binding Duration}" Classes="device-row-detail" />
                                    <TextBlock Grid.Column="2" Text="{Binding Outcome}" Classes="device-row-detail" />
                                  </Grid>
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                          </Expander>
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </StackPanel>
          </StackPanel>
        </StackPanel>
      </Border>
    </StackPanel>
  </StackPanel>
</UserControl>
