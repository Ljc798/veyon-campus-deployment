<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>VeyonCampus.Agent</AssemblyName>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <Version>0.4.55</Version>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../VeyonCampus.Core/VeyonCampus.Core.csproj" />
    <Content Include="Assets/StudentDefaultWallpaper-v1.jpg"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="GetStudentAgentBuildPayload" DependsOnTargets="Build" Returns="@(_StudentAgentBuildPayload)">
    <ItemGroup>
      <!-- Shared runtime dependencies may live outside the project when OutputPath is overridden. -->
      <_StudentAgentPayloadCandidate Include="@(FileWrites);@(FileWritesShareable);@(ReferenceCopyLocalPaths->'$(TargetDir)%(DestinationSubDirectory)%(Filename)%(Extension)')" />
      <_StudentAgentPayloadFullPath Include="@(_StudentAgentPayloadCandidate->'%(FullPath)')" />
      <_StudentAgentBuildPayload Include="@(_StudentAgentPayloadFullPath->Distinct())"
                                Condition="Exists('%(_StudentAgentPayloadFullPath.Identity)') and $([System.String]::Copy('%(_StudentAgentPayloadFullPath.Identity)').StartsWith('$(TargetDir)'))">
        <AgentRelativePath>$([MSBuild]::MakeRelative('$(TargetDir)', '%(_StudentAgentPayloadFullPath.Identity)'))</AgentRelativePath>
      </_StudentAgentBuildPayload>
    </ItemGroup>
    <Error Condition="'@(_StudentAgentBuildPayload)' == ''" Text="The Student Agent build did not report any payload files." />
  </Target>
</Project>
