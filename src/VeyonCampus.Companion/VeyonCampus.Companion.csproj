<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>VeyonCampus.StudentCompanion</AssemblyName>
    <Version>0.4.58</Version>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationIcon Condition="$([MSBuild]::IsOSPlatform('Windows'))">../VeyonCampus.App/Assets/veyon-campus.ico</ApplicationIcon>
    <ApplicationManifest Condition="$([MSBuild]::IsOSPlatform('Windows'))">StudentCompanion.manifest</ApplicationManifest>
    <VeyonCampusCoreLockFile Condition="'$(VeyonCampusCoreLockFile)' == ''">packages.win-x64.lock.json</VeyonCampusCoreLockFile>
  </PropertyGroup>
  <ItemGroup>
    <AvaloniaResource Include="../VeyonCampus.App/Assets/veyon-campus-mark.png" Link="Assets/veyon-campus-mark.png" />
    <AvaloniaResource Include="../VeyonCampus.App/Assets/veyon-campus.ico" Link="Assets/veyon-campus.ico" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.3" />
    <ProjectReference Include="../VeyonCampus.Core/VeyonCampus.Core.csproj"
                      AdditionalProperties="VeyonCampusCoreLockFile=packages.win-x64.lock.json" />
  </ItemGroup>
</Project>
