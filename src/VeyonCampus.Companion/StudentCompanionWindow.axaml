<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:VeyonCampus.Companion"
        x:Class="VeyonCampus.Companion.StudentCompanionWindow"
        x:DataType="vm:StudentCompanionViewModel"
        Title="Veyon Campus 课堂助手"
        Width="500" Height="380" MinWidth="460" MinHeight="360"
        WindowStartupLocation="CenterScreen" CanResize="False"
        Background="#F3F6F9">
  <Grid RowDefinitions="Auto,*,Auto" Margin="28,26">
    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
      <Image Width="38" Height="38" Source="avares://VeyonCampus.StudentCompanion/Assets/veyon-campus-mark.png" Stretch="Uniform" />
      <StackPanel Spacing="1" VerticalAlignment="Center">
        <TextBlock Text="课堂助手" FontSize="20" FontWeight="SemiBold" Foreground="#172B4D" />
        <TextBlock Text="VEYON CAMPUS" FontSize="10" LetterSpacing="1.2" Foreground="#73839A" />
      </StackPanel>
    </StackPanel>

    <Border Grid.Row="1" Margin="0,22,0,14" Padding="24" CornerRadius="16"
            Background="#FFFFFF" BorderBrush="#E3EAF1" BorderThickness="1">
      <Grid RowDefinitions="Auto,*,Auto">
        <TextBlock Text="{Binding StatusTitle}" FontSize="25" FontWeight="SemiBold"
                   Foreground="#172B4D" TextWrapping="Wrap" />
        <StackPanel Grid.Row="1" Margin="0,10,0,0" Spacing="8">
          <TextBlock Text="{Binding StatusDescription}" FontSize="14" Foreground="#596B80"
                     TextWrapping="Wrap" />
          <TextBlock Text="{Binding ClassroomSummary}" FontSize="13" Foreground="#7B8BA0"
                     IsVisible="{Binding HasClassroomSummary}" TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Grid.Row="2" Margin="0,18,0,0" Spacing="10">
          <TextBlock Text="{Binding HelpStatus}" FontSize="13" Foreground="#596B80"
                     IsVisible="{Binding HasHelpStatus}" TextWrapping="Wrap" />
          <Button Content="需要老师帮助" Height="42" HorizontalAlignment="Stretch"
                  IsVisible="{Binding IsClassroomActive}" IsEnabled="{Binding CanRequestHelp}"
                  Click="RequestHelpClicked" />
        </StackPanel>
      </Grid>
    </Border>

    <TextBlock Grid.Row="2" Text="登录后自动运行 · 关闭窗口后可从系统托盘重新打开"
               FontSize="12" Foreground="#7B8BA0" VerticalAlignment="Center" />
  </Grid>
</Window>
