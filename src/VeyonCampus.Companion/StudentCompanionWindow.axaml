<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:VeyonCampus.Companion"
        x:Class="VeyonCampus.Companion.StudentCompanionWindow"
        x:DataType="vm:StudentCompanionViewModel"
        Title="Veyon Campus 课堂助手"
        Width="390" Height="286" MinWidth="360" MinHeight="250"
        WindowStartupLocation="Manual" CanResize="False" WindowDecorations="None"
        ShowActivated="False" ShowInTaskbar="False"
        Background="#F3F6F9">
  <Grid RowDefinitions="Auto,*" Margin="12">
    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" VerticalAlignment="Center">
      <Image Width="30" Height="30" Source="avares://VeyonCampus.StudentCompanion/Assets/veyon-campus-mark.png" Stretch="Uniform" />
      <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
        <TextBlock Text="课堂助手" FontSize="16" FontWeight="SemiBold" Foreground="#172B4D" />
        <TextBlock Text="VEYON CAMPUS" FontSize="9" LetterSpacing="1.1" Foreground="#73839A" />
      </StackPanel>
      <Button Grid.Column="2" Width="30" Height="30" Padding="0"
              HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
              Click="HideClicked" ToolTip.Tip="收起；课堂助手会继续在后台运行。">
        <Path Data="M5,5 L19,19 M19,5 L5,19" Width="12" Height="12"
              Stretch="Uniform" Stroke="#526477" StrokeThickness="2" />
      </Button>
    </Grid>

    <Border Grid.Row="1" Margin="0,10,0,0" Padding="16" CornerRadius="14"
            Background="#FFFFFF" BorderBrush="#E3EAF1" BorderThickness="1">
      <Grid RowDefinitions="Auto,*,Auto">
        <TextBlock Text="{Binding StatusTitle}" FontSize="19" FontWeight="SemiBold"
                   Foreground="#172B4D" TextWrapping="Wrap" />
        <StackPanel Grid.Row="1" Margin="0,8,0,0" Spacing="7" VerticalAlignment="Center">
          <TextBlock Text="{Binding HelpStatus}" FontSize="13" Foreground="#596B80"
                     IsVisible="{Binding HasHelpStatus}" TextWrapping="Wrap" />
          <Button Content="打开课堂网址" Height="38" HorizontalAlignment="Stretch"
                  IsVisible="{Binding HasClassroomNoticeLink}"
                  Click="OpenClassroomNoticeLinkClicked" />
          <TextBlock Text="{Binding ClassroomNoticeOpenStatus}" FontSize="12" Foreground="#A64634"
                     IsVisible="{Binding HasClassroomNoticeOpenStatus}" TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Grid.Row="2" Margin="0,8,0,0" Spacing="7">
          <Button Content="{Binding HelpActionText}" Height="38" HorizontalAlignment="Stretch"
                  IsVisible="{Binding HasHelpAction}" IsEnabled="{Binding CanActivateHelpAction}"
                  Click="HelpActionClicked" />
          <Button Content="给老师发消息" Height="36" HorizontalAlignment="Stretch"
                  IsVisible="{Binding IsClassroomActive}" Click="OpenCommunicationClicked" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
