<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Version>0.4.53</Version>
  </PropertyGroup>
  <Target Name="ReadBundledStudentAgentVersion" BeforeTargets="GetAssemblyAttributes">
    <XmlPeek XmlInputPath="$(MSBuildThisFileDirectory)../VeyonCampus.Agent/VeyonCampus.Agent.csproj"
             Query="/Project/PropertyGroup/Version/text()">
      <Output TaskParameter="Result" PropertyName="BundledStudentAgentVersion" />
    </XmlPeek>
    <ItemGroup>
      <AssemblyMetadata Include="StudentAgentVersion" Value="$(BundledStudentAgentVersion)" />
    </ItemGroup>
  </Target>
  <PropertyGroup>
    <VeyonCampusReleasePublicKeyPath Condition="'$(VeyonCampusReleasePublicKeyPath)' == ''">$(VEYONCAMPUS_RELEASE_PUBLIC_KEY_PATH)</VeyonCampusReleasePublicKeyPath>
    <VeyonCampusTestReleasePublicKeyPath Condition="'$(VeyonCampusTestReleasePublicKeyPath)' == ''">$(VEYONCAMPUS_TEST_RELEASE_PUBLIC_KEY_PATH)</VeyonCampusTestReleasePublicKeyPath>
  </PropertyGroup>
  <PropertyGroup Condition="'$(VeyonCampusCoreLockFile)' != ''">
    <NuGetLockFilePath>$(MSBuildProjectDirectory)/$(VeyonCampusCoreLockFile)</NuGetLockFilePath>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="VeyonCampus.Checks" />
    <InternalsVisibleTo Include="VeyonCampus.App" />
    <InternalsVisibleTo Include="VeyonCampus.Teacher" />
    <InternalsVisibleTo Include="VeyonCampus.StudentSetup" />
    <EmbeddedResource Include="../../packaging/third-party/veyon-4.11.2.0-win64-setup.exe"
                      LogicalName="VeyonCampus.Core.VeyonInstaller.exe"
                      Condition="'$(VeyonCampusIncludeInstaller)' != 'false'" />
    <EmbeddedResource Include="$(VeyonCampusReleasePublicKeyPath)"
                      LogicalName="VeyonCampus.Core.ApplicationReleasePublicKey.pem"
                      Condition="'$(VeyonCampusReleasePublicKeyPath)' != ''" />
    <EmbeddedResource Include="$(VeyonCampusTestReleasePublicKeyPath)"
                      LogicalName="VeyonCampus.Core.ApplicationTestReleasePublicKey.pem"
                      Condition="'$(VeyonCampusTestReleasePublicKeyPath)' != ''" />
  </ItemGroup>

  <Target Name="ValidateApplicationReleasePublicKey" BeforeTargets="CoreCompile"
          Condition="'$(VeyonCampusReleasePublicKeyPath)' != '' and !Exists('$(VeyonCampusReleasePublicKeyPath)')">
    <Error Text="VeyonCampusReleasePublicKeyPath must point to the pinned Developer Release PEM public key." />
  </Target>
  <Target Name="ValidateApplicationTestReleasePublicKey" BeforeTargets="CoreCompile"
          Condition="'$(VeyonCampusTestReleasePublicKeyPath)' != '' and !Exists('$(VeyonCampusTestReleasePublicKeyPath)')">
    <Error Text="VeyonCampusTestReleasePublicKeyPath must point to the local test Developer Release PEM public key." />
  </Target>
</Project>
