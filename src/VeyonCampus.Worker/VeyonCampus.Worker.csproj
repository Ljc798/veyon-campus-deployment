<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>VeyonCampus.Worker</AssemblyName>
    <AssemblyTitle>Veyon Campus 系统维护</AssemblyTitle>
    <Product>Veyon Campus</Product>
    <Description>执行已确认的安装和系统维护操作</Description>
    <Version>0.4.55</Version>
    <VeyonCampusIncludeInstaller>false</VeyonCampusIncludeInstaller>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <ApplicationManifest Condition="$([MSBuild]::IsOSPlatform('Windows'))">app.manifest</ApplicationManifest>
    <ApplicationIcon Condition="$([MSBuild]::IsOSPlatform('Windows'))">../VeyonCampus.App/Assets/veyon-campus.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../VeyonCampus.Core/VeyonCampus.Core.csproj" />
  </ItemGroup>
</Project>
